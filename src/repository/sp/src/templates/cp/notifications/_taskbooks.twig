{% import "_includes/forms" as forms %}

{{ forms.textField ({
    label:			"Subject Step Assign",
    id:				"notifySubjectStepAssign",
    name:			"notifySubjectStepAssign",
    value:		    settings.notifySubjectStepAssign
}) }}

{{ forms.textareaField ({
    instructions:   "Default: You have been assigned for {{ step.reviewStepName }} ({{ type }}) for {{ user.fullname }} - {{ moduleGroup.title }}.",
    label:			"Message Step Assign",
    id:				"notifyStepAssign",
    name:			"notifyStepAssign",
    value:		    settings.notifyStepAssign
}) }}

{{ forms.textField ({
    label:			"Subject Step Update",
    id:				"notifySubjectStepUpdate",
    name:			"notifySubjectStepUpdate",
    value:		    settings.notifySubjectStepUpdate
}) }}

{{ forms.textareaField ({
    instructions:   "Default: Status update for {{ moduleGroup.title }}: result is {{ result }}. {{ step.reviewComment }}",
    label:			"Message Step Update",
    id:				"notifyStepUpdate",
    name:			"notifyStepUpdate",
    value:		    settings.notifyStepUpdate
}) }}

{{ forms.textField ({
    label:			"Subject Step Request",
    id:				"notifySubjectStepRequest",
    name:			"notifySubjectStepRequest",
    value:		    settings.notifySubjectStepRequest
}) }}

{{ forms.textareaField ({
    instructions:   "Default: Request for {{ step.reviewStepName }} ({{ type }}) for {{ user.fullname }} - {{ moduleGroup.title }}.",
    label:			"Message Step Request",
    id:				"notifyStepRequest",
    name:			"notifyStepRequest",
    value:		    settings.notifyStepRequest
}) }}

{{ forms.textField ({
    label:			"Subject Assessment",
    id:				"notifySubjectAssessment",
    name:			"notifySubjectAssessment",
    value:		    settings.notifySubjectAssessment
}) }}

{{ forms.textareaField ({
    instructions:   "Default: Assessment for {{ moduleGroup.title }}. \n\n {{ assessmentText }}",
    label:			"Message Assessment",
    id:				"notifyAssessment",
    name:			"notifyAssessment",
    value:		    settings.notifyAssessment
}) }}
