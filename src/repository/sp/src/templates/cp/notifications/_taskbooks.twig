{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    label:			"Enable New Package?",
    id:				"notifyEnableNewPackage",
    name:			"notifyEnableNewPackage",
    on:		        settings.notifyEnableNewPackage == 1
}) }}

{{ forms.textField ({
    label:			"Subject New Package",
    id:				"notifySubjectNewPackage",
    name:			"notifySubjectNewPackage",
    value:		    settings.notifySubjectNewPackage
}) }}

{{ forms.textareaField ({
    instructions:   "Default: New taskbook for {{ user.fullname }} - {{ moduleGroup.title }}.",
    label:			"Message New Package",
    id:				"notifyNewPackage",
    name:			"notifyNewPackage",
    value:		    settings.notifyNewPackage
}) }}

