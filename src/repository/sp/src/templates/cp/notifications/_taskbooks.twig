{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    instructions:   "Sent to scheme managers when ipn received from PayPal.",
    label:			"Enable New Package?",
    id:				"notifyEnableNewPackage",
    name:			"notifyEnableNewPackage",
    on:		        settings.notifyEnableNewPackage == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: New taskbook",
    label:			"Subject New Package",
    id:				"notifySubjectNewPackage",
    name:			"notifySubjectNewPackage",
    value:		    settings.notifySubjectNewPackage
}) }}

{{ forms.textField ({
    label:			"CC New Package",
    id:				"notifyCcNewPackage",
    name:			"notifyCcNewPackage",
    value:		    settings.notifyCcNewPackage
}) }}

{{ forms.textareaField ({
    instructions:   "Default: New taskbook for {{ user.fullname }} - {{ taskbook.title }}.",
    label:			"Message New Package",
    id:				"notifyNewPackage",
    name:			"notifyNewPackage",
    value:		    settings.notifyNewPackage
}) }}

<hr />

{{ forms.lightswitchField ({
    instructions:   "Sent to user managers when a user requests review.",
    label:			"Enable Step Request?",
    id:				"notifyEnableStepRequest",
    name:			"notifyEnableStepRequest",
    on:		        settings.notifyEnableStepRequest == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: $taskbookLabel Review Request",
    label:			"Subject Step Request",
    id:				"notifySubjectStepRequest",
    name:			"notifySubjectStepRequest",
    value:		    settings.notifySubjectStepRequest
}) }}

{{ forms.textField ({
    label:			"CC Step Request",
    id:				"notifyCcStepRequest",
    name:			"notifyCcStepRequest",
    value:		    settings.notifyCcStepRequest
}) }}

{{ forms.textareaField ({
    instructions:   "Default: Request for {{ step.reviewStepName }} ({{ type }}) for {{ user.fullname }} - {{ taskbook.title }}.",
    label:			"Message Step Request",
    id:				"notifyStepRequest",
    name:			"notifyStepRequest",
    value:		    settings.notifyStepRequest
}) }}

<hr />

{{ forms.lightswitchField ({
    instructions:   "Sent to user managers when a user requests review but no reveiwer has been assigned.",
    label:			"Enable Step Unassigned?",
    id:				"notifyEnableStepUnassigned",
    name:			"notifyEnableStepUnassigned",
    on:		        settings.notifyEnableStepUnassigned == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: $taskbookLabel Review Unassigned",
    label:			"Subject Step Unassigned",
    id:				"notifySubjectStepUnassigned",
    name:			"notifySubjectStepUnassigned",
    value:		    settings.notifySubjectStepUnassigned
}) }}

{{ forms.textField ({
    label:			"CC Step Unassigned",
    id:				"notifyCcStepUnassigned",
    name:			"notifyCcStepUnassigned",
    value:		    settings.notifyCcStepUnassigned
}) }}

{{ forms.textareaField ({
    instructions:   "Default: Reviewer not assigned for {{ step.reviewStepName }} ({{ type }}) for {{ user.fullname }} - {{ taskbook.title }}.",
    label:			"Message Step Unassigned",
    id:				"notifyStepUnassigned",
    name:			"notifyStepUnassigned",
    value:		    settings.notifyStepUnassigned
}) }}

<hr />

{{ forms.lightswitchField ({
    instructions:   "Sent to reviewer (manager) when they are assigned to a workflow step.",
    label:			"Enable Step Assign?",
    id:				"notifyEnableStepAssign",
    name:			"notifyEnableStepAssign",
    on:		        settings.notifyEnableStepAssign == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: $taskbookLabel Review Assignment",
    label:			"Subject Step Assign",
    id:				"notifySubjectStepAssign",
    name:			"notifySubjectStepAssign",
    value:		    settings.notifySubjectStepAssign
}) }}

{{ forms.textField ({
    label:			"CC Step Assign",
    id:				"notifyCcStepAssign",
    name:			"notifyCcStepAssign",
    value:		    settings.notifyCcStepAssign
}) }}

{{ forms.textareaField ({
    instructions:   "Default: You have been assigned for {{ step.reviewStepName }} ({{ type }}) for {{ user.fullname }} - {{ taskbook.title }}.",
    label:			"Message Step Assign",
    id:				"notifyStepAssign",
    name:			"notifyStepAssign",
    value:		    settings.notifyStepAssign
}) }}

<hr />

{{ forms.lightswitchField ({
    instructions:   "Sent to reviewer (manager) or user when a step has been reviewed.",
    label:			"Enable Step Update?",
    id:				"notifyEnableStepUpdate",
    name:			"notifyEnableStepUpdate",
    on:		        settings.notifyEnableStepUpdate == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: $taskbookLabel Update $step->reviewStepName ($result)",
    label:			"Subject Step Update",
    id:				"notifySubjectStepUpdate",
    name:			"notifySubjectStepUpdate",
    value:		    settings.notifySubjectStepUpdate
}) }}

{{ forms.textField ({
    label:			"CC Step Update",
    id:				"notifyCcStepUpdate",
    name:			"notifyCcStepUpdate",
    value:		    settings.notifyCcStepUpdate
}) }}

{{ forms.textareaField ({
    instructions:   "Default: Status update for {{ taskbook.title }}: result is {{ result }}. {{ step.reviewComment }}",
    label:			"Message Step Update",
    id:				"notifyStepUpdate",
    name:			"notifyStepUpdate",
    value:		    settings.notifyStepUpdate
}) }}

<hr />

{{ forms.lightswitchField ({
    instructions:   "Sent to user when an assesment is completed.",
    label:			"Enable Assessment?",
    id:				"notifyEnableAssessment",
    name:			"notifyEnableAssessment",
    on:		        settings.notifyEnableAssessment == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: $taskbookLabel Assessment",
    label:			"Subject Assessment",
    id:				"notifySubjectAssessment",
