    value:		    settings.notifySubjectAssessment
}) }}

{{ forms.textField ({
    label:			"CC Assessment",
    id:				"notifyCcAssessment",
    name:			"notifyCcAssessment",
    value:		    settings.notifyCcAssessment
}) }}

{{ forms.textareaField ({
    instructions:   "Default: Assessment for {{ taskbook.title }}. \n\n {{ assessmentText }}",
    label:			"Message Assessment",
