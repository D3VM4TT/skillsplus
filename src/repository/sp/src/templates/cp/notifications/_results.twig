    name:			"notifyCcResultExpiryOne",
    value:		    settings.notifyCcResultExpiryOne
}) }}

{{ forms.textareaField ({
    instructions:   "Default: {{ entry.title}} expired/expires on {{ entry.expiryDate|date('d-m-Y') }}.",
    label:			"Message Result Expiry One",
    id:				"notifyResultExpiryOne",
    name:			"notifyResultExpiryOne",
    value:		    settings.notifyResultExpiryOne
}) }}

