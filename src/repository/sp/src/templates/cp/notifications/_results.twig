{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    instructions:   "Sent to user manager when pending result is saved.",
    label:			"Enable Endorsement Result?",
    id:				"notifyEnableEndorsementResult",
    name:			"notifyEnableEndorsementResult",
    on:		        settings.notifyEnableEndorsementResult == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: Endorsement Required",
    label:			"Subject Endorsement Result",
    id:				"notifySubjectEndorsementResult",
    name:			"notifySubjectEndorsementResult",
    value:		    settings.notifySubjectEndorsementResult
}) }}

{{ forms.textField ({
    label:			"CC Endorsement Result",
    id:				"notifyCcEndorsementResult",
    name:			"notifyCcEndorsementResult",
    value:		    settings.notifyCcEndorsementResult
}) }}

{{ forms.textareaField ({
    instructions:   "Default: {{ user.fullName}} has submitted a result {{ entry.title }}.",
    label:			"Message Endorsement Result",
    id:				"notifyEndorsementResult",
    name:			"notifyEndorsementResult",
    value:		    settings.notifyEndorsementResult
}) }}

<hr />

{{ forms.lightswitchField ({
    instructions:   "Sent to user manager when user hits max attempts for unit test.",
    label:			"Enable Blocked Result?",
    id:				"notifyEnableBlockedResult",
    name:			"notifyEnableBlockedResult",
    on:		        settings.notifyEnableBlockedResult == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: Result Blocked",
    label:			"Subject Blocked Result",
    id:				"notifySubjectBlockedResult",
    name:			"notifySubjectBlockedResult",
    value:		    settings.notifySubjectBlockedResult
}) }}

{{ forms.textField ({
    label:			"CC Blocked Result",
    id:				"notifyCcBlockedResult",
    name:			"notifyCcBlockedResult",
    value:		    settings.notifyCcBlockedResult
}) }}

{{ forms.textareaField ({
    instructions:   "Default: {{ user.fullName}} has run out of attempts for unit {{ entry.title }} and the result is blocked.",
    label:			"Message Blocked Result",
    id:				"notifyBlockedResult",
    name:			"notifyBlockedResult",
    value:		    settings.notifyBlockedResult
}) }}

<hr />

{{ forms.lightswitchField ({
    instructions:   "Sent to user when result will expire or has expired.",
    label:			"Enable Result Expiry One?",
    id:				"notifyEnableResultExpiryOne",
    name:			"notifyEnableResultExpiryOne",
    on:		        settings.notifyEnableResultExpiryOne == 1
}) }}

{{ forms.textField ({
    label:			"Send Notification Days",
    id:				"notifyResultExpiryDaysOne",
    name:			"notifyResultExpiryDaysOne",
    value:		    settings.notifyResultExpiryDaysOne
}) }}

{{ forms.selectField({
    label: "Send Notification When",
    id: 'notifyResultExpiryWhenOne',
    name: 'notifyResultExpiryWhenOne',
    value: settings.notifyResultExpiryWhenOne,
    options: [
        {
            label: 'Before',
            value: '+'
        },
        {
            label: 'After',
            value: '-'
        }
    ]
}) }}

{{ forms.textField ({
    instructions:   "Default: Result Expiry",
    label:			"Subject Result Expiry One",
    id:				"notifySubjectResultExpiryOne",
    name:			"notifySubjectResultExpiryOne",
    value:		    settings.notifySubjectResultExpiryOne
}) }}

{{ forms.textField ({
