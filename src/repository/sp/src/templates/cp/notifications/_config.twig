{% import "_includes/forms" as forms %}
{{ forms.textField ({
    instructions:   "Default: No-Reply@skills-plus.net",
    label:			"Notify From Email",
    id:				"notifyFromEmail",
    name:			"notifyFromEmail",
    value:		    settings.notifyFromEmail
}) }}

{{ forms.textField ({
    instructions:   "Default: Skills+",
    label:			"Notify From Name",
    id:				"notifyFromName",
    name:			"notifyFromName",
    value:		    settings.notifyFromName
}) }}

{{ forms.textareaField ({
    instructions:   "Incldued on all notifications",
    label:			"Notify Footer",
    id:				"notifyFooter",
    name:			"notifyFooter",
    value:		    settings.notifyFooter
}) }}

{{ forms.lightswitchField ({
    label:			"Disable Endorsement Notification?",
    id:				"disableEndorsementNotify",
    name:			"disableEndorsementNotify",
    on:		        settings.disableEndorsementNotify == 1
}) }}
