{% import "_includes/forms" as forms %}
{{ forms.lightswitchField ({
    label:			"Disable All Notifications?",
    id:				"disableAllNotifications",
    name:			"disableAllNotifications",
    on:		        settings.disableAllNotifications == 1
}) }}

{{ forms.textField ({
    label:			"Test Email Address",
    instructions:   "For all servers other than <b>PRODUCTION</b>. Separate emails with commas.",
    id:				"schemeTestEmailAddress",
    name:			"schemeTestEmailAddress",
    value:		    settings.schemeTestEmailAddress
}) }}

{{ forms.textField ({
    instructions:   "Default: No-Reply@skills-plus.net",
    label:			"Notify From Email",
    id:				"notifyFromEmail",
    name:			"notifyFromEmail",
    value:		    settings.notifyFromEmail
}) }}

{{ forms.textField ({
    instructions:   "Default: Skills+",
    label:			"Notify From Name",
    id:				"notifyFromName",
    name:			"notifyFromName",
    value:		    settings.notifyFromName
}) }}

{{ forms.textareaField ({
    instructions:   "Incldued on all notifications",
    label:			"Notify Footer",
    id:				"notifyFooter",
    name:			"notifyFooter",
    value:		    settings.notifyFooter
}) }}

