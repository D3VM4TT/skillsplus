{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    label:			"Enable Cycle Start?",
    id:				"notifyEnableCycleStart",
    name:			"notifyEnableCycleStart",
    on:		        settings.notifyEnableCycleStart == 1
}) }}

{{ forms.textField ({
    label:			"Subject CPD Cycle Start",
    id:				"notifySubjectCycleStart",
    name:			"notifySubjectCycleStart",
    value:		    settings.notifySubjectCycleStart
}) }}

{{ forms.textareaField ({
    instructions:   "{{ user }} {{ module }} {{ cycle }}",
