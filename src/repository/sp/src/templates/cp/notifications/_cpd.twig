{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    instructions:   "Sent to user at start of cycle.",
    label:			"Enable Cycle Start?",
    id:				"notifyEnableCycleStart",
    name:			"notifyEnableCycleStart",
    on:		        settings.notifyEnableCycleStart == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: CPD Cycle Start",
    label:			"Subject CPD Cycle Start",
    id:				"notifySubjectCycleStart",
    name:			"notifySubjectCycleStart",
    value:		    settings.notifySubjectCycleStart
}) }}

{{ forms.textareaField ({
    instructions:   "Default: {{ module.title }} {{ cycle.name }} starts today.",
    label:			"Message CPD Cycle Start",
    id:				"notifyCycleStart",
    name:			"notifyCycleStart",
    value:		    settings.notifyCycleStart
}) }}

<hr />

{{ forms.lightswitchField ({
    instructions:   "Sent to user at end of cycle.",
