{% import "_includes/forms" as forms %}

{{ forms.textField ({
    label:			"Subject Step Assign",
    id:				"notifySubjectStepAssign",
    name:			"notifySubjectStepAssign",
    value:		    settings.notifySubjectStepAssign
}) }}

{{ forms.textareaField ({
    instructions:   "Default: You have been assigned for {{ step.stepReviewName }} ({{ type }}) for {{ user.fullname }} - {{ core.title }}.",
    label:			"Message Step Assign",
    id:				"notifyStepAssign",
    name:			"notifyStepAssign",
    value:		    settings.notifyStepAssign
}) }}

{{ forms.textField ({
    label:			"Subject Step Update",
    id:				"notifySubjectStepUpdate",
    name:			"notifySubjectStepUpdate",
    value:		    settings.notifySubjectStepUpdate
}) }}

{{ forms.textareaField ({
    instructions:   "Default: Status update for {{ core.title }}: result is {{ result }}. {{ step.reviewComment }}",
    label:			"Message Step Update",
    id:				"notifyStepUpdate",
    name:			"notifyStepUpdate",
    value:		    settings.notifyStepUpdate
}) }}
