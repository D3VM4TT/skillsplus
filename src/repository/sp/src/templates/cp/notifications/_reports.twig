{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    instructions:   "Sent to report recipeints if report frequency is set.",
    label:			"Enable Custom Report?",
    id:				"notifyEnableCustomReport",
    name:			"notifyEnableCustomReport",
    on:		        settings.notifyEnableCustomReport == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: {{ entry.title }}.",
    label:			"Subject Custom Report",
    id:				"notifySubjectCustomReport",
    name:			"notifySubjectCustomReport",
    value:		    settings.notifySubjectCustomReport
}) }}

{{ forms.textField ({
    label:			"CC Custom Report",
    id:				"notifyCcCustomReport",
    name:			"notifyCcCustomReport",
    value:		    settings.notifyCcCustomReport
}) }}

{{ forms.textareaField ({
    instructions:   "Default: Custom report: {{ entry.title }}.",
    label:			"Message Custom Report",
    id:				"notifyCustomReport",
    name:			"notifyCustomReport",
    value:		    settings.notifyCustomReport
}) }}