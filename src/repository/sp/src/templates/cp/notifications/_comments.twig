{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    instructions:   "Sent to all user managers when comment submitted (replies sent to user).",
    label:			"Enable Comment?",
    id:				"notifyEnableComment",
    name:			"notifyEnableComment",
    on:		        settings.notifyEnableComment == 1
}) }}

{{ forms.textField ({
    instructions:   "Default: New Comment",
    label:			"Subject Comment",
    id:				"notifySubjectComment",
    name:			"notifySubjectComment",
    value:		    settings.notifySubjectComment
}) }}

{{ forms.textareaField ({
    instructions:   "Default: {{ entry.title }} - {{ user.fullName}}: {{ comment }}",
    label:			"Message Comment",
    id:				"notifyComment",
    name:			"notifyComment",
    value:		    settings.notifyComment
}) }}