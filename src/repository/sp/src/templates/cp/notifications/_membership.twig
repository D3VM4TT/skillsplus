{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    label:			"Enable New Membership?",
    id:				"notifyEnableNewMembership",
    name:			"notifyEnableNewMembership",
    on:		        settings.notifyEnableNewMembership == 1
}) }}

{{ forms.textField ({
    label:			"Subject New Membership",
    id:				"notifySubjectNewMembership",
    name:			"notifySubjectNewMembership",
    value:		    settings.notifySubjectNewMembership
}) }}

{{ forms.textareaField ({
    instructions:   "Default: New Membership for {{ user.fullname }} - {{ jobRole.title }} - £{{ membership.cost }}.",
    label:			"Message New Membership",
    id:				"notifyNewMembership",
    name:			"notifyNewMembership",
    value:		    settings.notifyNewMembership
}) }}
