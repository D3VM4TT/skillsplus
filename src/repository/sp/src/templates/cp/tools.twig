{% extends "sp/cp/_layout" %}
{% import "_includes/forms" as forms %}
{% set title = 'Skills Plus Tools' %}
{% set selectedSubnavItem = 'tools' %}

{% set fullPageForm = false %}
{% set saveButton = null %}

{% block content %}
    <h3>Re-Save Elements</h3>
    <p><a href="{{ url('sp/tools?method=saveCompanies') }}" class="btn btn-small">Re-save all companies</a></p>
    <p><a href="{{ url('sp/tools?method=saveUnits') }}" class="btn btn-small">Re-save all units</a></p>
    <p><a href="{{ url('sp/tools?method=saveUsers') }}" class="btn btn-small">Re-save all users</a></p>
    <hr />
    <h3>Results</h3>
    <p>{{ dataCleanResultNotes }} results with notes.</p>
    <p><a href="{{ url('sp/tools?method=copyNotes') }}" class="btn btn-small">Copy result notes to comments.</a></p>
    <hr />
    <h3>Clean Usernames</h3>
    <p><a href="{{ url('sp/tools?method=cleanUsernames') }}" class="btn btn-small">Remove extra dots from usernames</a></p>
    <hr />
    <h3>Fix Last Names</h3>
    <p><a href="{{ url('sp/tools?method=fixLastNames') }}" class="btn btn-small">Split up names for users with empty last names</a></p>
    <hr />
    <h3>Set Read Only</h3>
    <p><a href="{{ url('sp/tools?method=setManagerReadOnly') }}" class="btn btn-small">Set all managers to read only</a></p>
    <hr />
    <h3>Remove Manager Duplicates</h3>
    {% set totalManagers = craft.users.status(null).group('companyManagers').count() %}
    <p><a href="{{ url('sp/tools?method=removeManagersChildren') }}" class="btn btn-small">Remove company manager duplicates from hierarchy (100)</a></p>
    <p>{{ dataCleanManagersChildrenTotal }}/{{ totalManagers }} managers processed.</p>
    <p><a href="{{ url('sp/tools?method=dataResetManagersChildren') }}" class="btn btn-small">Reset managers (data clean)</a></p>
    <hr />
    <h3>Set Managers User Company</h3>
    <p><a href="{{ url('sp/tools?method=set-manager-user-company') }}" class="btn btn-small">Add managers' company as user company (100)</a></p>
    <p>{{ dataCleanManagersUserCompanyTotal }}/{{ totalManagers }} managers processed.</p>
    <p><a href="{{ url('sp/tools?method=dataResetManagersUserCompany') }}" class="btn btn-small">Reset managers (data clean)</a></p>
    <hr />
    <h3>Set User Result Cache</h3>
    {% set totalUsers = craft.users.admin(false).count() %}
    <p><a href="{{ url('sp/tools?method=setResultCache') }}" class="btn btn-small">Set users result cache (500)</a></p>
    <p>{{ dataCleanResultCacheTotal }}/{{ totalUsers }} users processed.</p>
    <p><a href="{{ url('sp/tools?method=dataResetResultCache') }}" class="btn btn-small">Reset users result cache (data clean)</a></p>
    <hr />
    <h3>Set All Reports - Report Include Required</h3>
    <p><a href="{{ url('sp/tools?method=setReportIncludeRequired') }}" class="btn btn-small">Update all reports</a></p>
    <hr />
    <h3>Copy Database</h3>
    {% set server = getenv('ENVIRONMENT') %}
    {% if server == 'prod' or server == 'dev' or server == 'local' %}
        <p><a href="{{ url('sp/tools?method=copyDatabase') }}" class="btn btn-small">Copy DB to UAT</a></p>
    {% elseif server == 'uat' %}
        <p><a href="{{ url('sp/tools?method=copyDatabase') }}" class="btn btn-small">Copy DB to DEV</a></p>
        <p style="color:#FF0000"><strong>WARNING - LIVE DATA</strong></p>
        <p><a href="{{ url('sp/tools?method=copyDatabaseProd') }}" class="btn btn-small">Copy DB to PROD</a></p>
    {% endif %}
{% endblock %}