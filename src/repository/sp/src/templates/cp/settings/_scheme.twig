{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    label:			"Maintenance Mode",
    id:				"maintenanceMode",
    name:			"maintenanceMode",
    on:		        settings.maintenanceMode == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Scheme Teams",
    instructions:   "Enable teams for this scheme?",
    id:				"schemeTeams",
    name:			"schemeTeams",
    on:		        settings.schemeTeams == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Scheme User Read Only",
    instructions:   "Make all users read only on this scheme?",
    id:				"schemeUserReadOnly",
    name:			"schemeUserReadOnly",
    on:		        settings.schemeUserReadOnly == 1
}) }}

{{ forms.textField ({
    label:			"Scheme Email Domain",
    instructions:   "Used when importing users without a real email address i.e. lantra.co.uk",
    id:				"schemeEmailDomain",
    name:			"schemeEmailDomain",
    value:		    settings.schemeEmailDomain
}) }}

{{ forms.lightswitchField ({
    label:			"Enable Edit Credentials?",
    instructions:   "Allow managers to change member username and password, always available to Scheme Managers and Admins.",
    id:				"enableEditCredentials",
    name:			"enableEditCredentials",
    on:		        settings.enableEditCredentials == 1
}) }}
