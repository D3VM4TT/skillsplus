{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    label:			"Job Role Endorse",
    id:				"jobRoleEndorse",
    name:			"jobRoleEndorse",
    on:		        settings.jobRoleEndorse == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Disable Result Cache?",
    id:				"disableResultCache",
    name:			"disableResultCache",
    on:		        settings.disableResultCache == 1,
}) }}

{{ forms.lightswitchField ({
    label:			"Manager Confirm Submit?",
    id:				"managerConfirmSubmit",
    name:			"managerConfirmSubmit",
    on:		        settings.managerConfirmSubmit == 1,
}) }}

{{ forms.textField ({
    label:			"Manager Confirm Text",
    id:				"managerConfirmText",
    name:			"managerConfirmText",
    value:		    settings.managerConfirmText,
}) }}

{% set skillsMatrixUsersOptions = [
    {
        label: 'All Users',
        value: 'all'
    },
    {
        label: 'Hierarchy Subordinates',
        value: 'hierarchy'
    },
    {
        label: 'Direct Subordinates',
        value: 'direct'
    }
] %}

{{ forms.selectField({
    label: "Skills Matrix Users",
    id: 'skillsMatrixUsers',
    name: 'skillsMatrixUsers',
    value: settings.skillsMatrixUsers,
    options: skillsMatrixUsersOptions
}) }}


