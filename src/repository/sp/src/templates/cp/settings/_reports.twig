{% import "_includes/forms" as forms %}

{% set groupOptions = [
    {
        label: 'Scheme Managers',
        value: 'schemeManagers'
    },
    {
        label: 'Company Managers',
        value: 'companyManagers'
    },
    {
        label: 'Job Role',
        value: 'userRole'
    }
] %}

<table class="data fullwidth fixed-layout">
    <thead>
        <tr>
            <th width="15%">Report</th>
            <th>Active</th>
            <th>Group</th>
            <th>Roles</th>
            <th>Description</th>
            <th width="10%">Page Limit</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Users</td>
            <td>
                {{ forms.lightswitchField ({
                    id:				"reports-standardUsers-active",
                    name:			"reports[standardUsers][active]",
                    on:		        settings.reports.standardUsers.active|default(false)
                }) }}
                {{ forms.hidden ({
                    name:			"reports[standardUsers][title]",
                    value:		     "Users"
                }) }}
            </td>
            <td>
                {{ forms.selectField({
                    id: 'reports-standardUsers-group',
                    name: 'reports[standardUsers][group]',
                    value: settings.reports.standardUsers.group|default('schemeManagers'),
                    options: groupOptions
                }) }}
            </td>
            <td>
                {{ forms.elementSelectField ({
                    id:				    "reports-standardUsers-roles",
                    name:			    "reports[standardUsers][roles]",
                    elementType:        config.categoryElementType,
                    sources:            config.jobRoleCategoryGroup,
                    criteria:           '',
                    sourceElementId:    '',
                    elements:           settings.reports.standardUsers.roles|default([]),
                    storageKey:         '',
                    viewMode:           'list'
                }) }}
            </td>
            <td>
                {{ forms.textareaField ({
                    id:				"reports-standardUsers-description",
                    name:			"reports[standardUsers][description]",
                    value:		    settings.reports.standardUsers.description|default(),
                    rows:           2,
                    cols:           50
                }) }}
            </td>
            <td>
                {{ forms.textField ({
                    id:				"reports-standardUsers-pageLimit",
                    name:			"reports[standardUsers][pageLimit]",
                    value:		    settings.reports.standardUsers.pageLimit|default(),
