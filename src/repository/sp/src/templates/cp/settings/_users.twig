{% import "_includes/forms" as forms %}

<p>Note: First Name, Last Name and Email are always included in register form.  In addition, Date of Birth, Address, Phone and Custom Fields can be added. </p>
<p>Table Column can include id, legacyId, fullName, userCompany, userLocation, role and lastLogin.</p>

{% set profileFieldOptions =  {
    'fullName':' Name',
    'email':'Email',
    'userAddress':'Address',
    'userTelephone':'Phone',
    'userStartDate':'Start Date',
    'userDateOfBirth':'Date of Birth',
    'userRole': 'Role',
    'photo': 'Photo',

    'id': 'User ID',
    'userCompany': 'User Company',
    'userLocation': 'User Location',
    'userManager': 'User Manager',
    'managerCompanies': 'Manager Companies',
    'lastLogin': 'Last Login',
    'legacyId': 'Legacy ID',
} %}

{{ forms.editableTableField ({
    label:			"User Profile Fields",
    instrunctions:  "Name, Email,  ",
    id:				"userProfileFields",
    name:			"userProfileFields",
    addRowLabel:    "Add a user profile field",
    cols:
    {
        field:       {heading: "Field", type: "select", options:profileFieldOptions},
        label:       {heading: "Label", type: "text"},
        tableColumn:   {heading: "Table Column?", type: "checkbox"},
        accountInformation:   {heading: "Account Information?", type: "checkbox"},
        profile:   {heading: "Profile Page?", type: "checkbox"},
        userEdit:   {heading: "User Edit?", type: "checkbox"},
        managerEdit:   {heading: "Manager Edit?", type: "checkbox"},
        register:   {heading: "Register Form?", type: "checkbox"},
        required:   {heading: "Required", type: "checkbox"}
    },
    rows:           settings.userProfileFields
}) }}

{{ forms.editableTableField ({
    label:			"User Custom Fields",
    instrunctions:  "Enter a name (lowercase, no spaces) and label text for each custom user field.",
    id:				"userEditCustomFields",
    name:			"userEditCustomFields",
    addRowLabel:    "Add a custom field",
    cols:
    {
        name:       {heading: "Name", type: "singleline"},
        label:      {heading: "Label", type: "singleline"},
        profile:   {heading: "Profile Page?", type: "checkbox"},
        userEdit:   {heading: "User Edit?", type: "checkbox"},
        register:   {heading: "Register Form?", type: "checkbox"},
        required:   {heading: "Required", type: "checkbox"}
    },
    rows:           settings.userEditCustomFields
}) }}

{{ forms.lightswitchField ({
    label:			"User Privacy Required?",
    id:				"userPrivacyConfirm",
    name:			"userPrivacyConfirm",
    on:		        settings.userPrivacyConfirm == 1
}) }}

{{ forms.textareaField ({
    label:			"User Privacy Message",
    id:				"userPrivacyMessage",
    name:			"userPrivacyMessage",
    value:		    settings.userPrivacyMessage,
    rows:           4,
    cols:           50
}) }}
