{% import "_includes/forms" as forms %}

{{ forms.textField ({
    label:			"Taskbook Label",
    id:				"taskbookLabel",
    name:			"taskbookLabel",
    value:		    settings.taskbookLabel
}) }}

{{ forms.elementSelectField ({
    label:			    "Taskbook Intro",
    id:				    "taskbookIntro",
    name:			    "taskbookIntro",
    elementType:        config.entryElementType,
    sources:            config.pagesSection,
    criteria:           '',
    sourceElementId:    '',
    elements:           settings.taskbookIntro ? settings.taskbookIntro,
    storageKey:         '',
    viewMode:           'list',
    limit:              ''
}) }}

{{ forms.lightswitchField ({
    label:			"Taskbook Levels",
    id:				"taskbookLevels",
    name:			"taskbookLevels",
    on:		        settings.taskbookLevels == 1
}) }}

{{ forms.elementSelectField ({
    label:			    "Default Taskbook Job Role",
    id:				    "taskbookJobRole",
    name:			    "taskbookJobRole",
    elementType:        config.categoryElementType,
    sources:            config.jobRoleCategoryGroup,
    criteria:           '',
    sourceElementId:    '',
    elements:           settings.taskbookJobRole ? settings.taskbookJobRole,
    storageKey:         '',
    viewMode:           'list',
    limit:              1
}) }}