{% import "_includes/forms" as forms %}

<h2>General Settings</h2>

{{ forms.lightswitchField ({
    label:			"Enable Taskbooks?",
    id:				"taskbooks",
    name:			"taskbooks",
    on:		        settings.taskbooks == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Enable New Taskbook?",
    id:				"taskbookNew",
    name:			"taskbookNew",
    on:		        settings.taskbookNew == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Enable Create Taskbook (new users)?",
    id:				"enableCreateAccount",
    name:			"enableCreateAccount",
    on:		        settings.enableCreateAccount == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Limit taskbooks by company?",
    id:				"taskbookCompanies",
    name:			"taskbookCompanies",
    on:		        settings.taskbookCompanies == 1
}) }}

<hr />
<h2>Levels</h2>

{{ forms.lightswitchField ({
    label:			"Taskbook Levels",
    id:				"taskbookLevels",
    name:			"taskbookLevels",
    on:		        settings.taskbookLevels == 1
}) }}

{{ forms.editableTableField ({
    label:			"Taskbook Level Labels",
    id:				"taskbookLevelLabels",
    name:			"taskbookLevelLabels",
    addRowLabel:    "Add a level label",
    cols:
    {
        value:       {heading: "Level", type: "number"},
        label:       {heading: "Label", type: "text"}
    },
    rows:           settings.taskbookLevelLabels
}) }}

<hr />
<h2>Registration</h2>

{{ forms.elementSelectField ({
    label:			    "Default Taskbook Job Role",
    id:				    "taskbookJobRole",
    name:			    "taskbookJobRole",
    elementType:        config.categoryElementType,
    sources:            config.jobRoleCategoryGroup,
    criteria:           '',
    sourceElementId:    '',
    elements:           settings.taskbookJobRole ? settings.taskbookJobRole,
    storageKey:         '',
    viewMode:           'list',
    limit:              1
}) }}

{{ forms.elementSelectField ({
    label:			    "Default Taskbook Company",
    id:				    "defaultTaskbookCompany",
    name:			    "defaultTaskbookCompany",
    elementType:        config.entryElementType,
    sources:            config.companiesSection,
    criteria:           '',
    sourceElementId:    '',
    elements:           settings.defaultTaskbookCompany ? settings.defaultTaskbookCompany,
    storageKey:         '',
    viewMode:           'list',
    limit:              1
}) }}

{{ forms.elementSelectField ({
    label:			    "Taskbook Registration Companies",
    id:				    "taskbookRegistrationCompanies",
    name:			    "taskbookRegistrationCompanies",
    elementType:        config.entryElementType,
    sources:            config.companiesSection,
    criteria:           '',
    sourceElementId:    '',
    elements:           settings.taskbookRegistrationCompanies ? settings.taskbookRegistrationCompanies,
    storageKey:         '',
    viewMode:           'list'
}) }}

<hr />
<h2>Config</h2>

{{ forms.lightswitchField ({
    label:			"Enable Taskbook Reset (set all results to pending)?",
    id:				"taskbookReset",
    name:			"taskbookReset",
    on:		        settings.taskbookReset == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Enable Menu My Taskbooks",
    id:				"themeMyTaskbooks",
    name:			"themeMyTaskbooks",
    on:		        settings.themeMyTaskbooks == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Enable Taskbooks on Dashboard?",
    id:				"enableTaskbooks",
    name:			"enableTaskbooks",
    on:		        settings.enableTaskbooks == 1
}) }}

{{ forms.elementSelectField ({
    label:			    "Default Workflow",
    id:				    "defaultWorkflow",
    name:			    "defaultWorkflow",
    elementType:        config.entryElementType,
    sources:            config.workflowsSection,
    criteria:           '',
    sourceElementId:    '',
    elements:           settings.defaultWorkflow ? settings.defaultWorkflow,
    storageKey:         '',
    viewMode:           'list',
    limit:              1
}) }}