{% import "_includes/forms" as forms %}

{{ forms.lightswitchField ({
    label:			"Enable Taskbooks?",
    id:				"taskbooks",
    name:			"taskbooks",
    on:		        settings.taskbooks == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Enable Purchase Taskbook?",
    id:				"taskbookNew",
    name:			"taskbookNew",
    on:		        settings.taskbookNew == 1
}) }}

{{ forms.textField ({
    label:			"Taskbook Label",
    id:				"taskbookLabel",
    name:			"taskbookLabel",
    value:		    settings.taskbookLabel
}) }}

{{ forms.textareaField ({
    label:			"Taskbook Intro New",
    instructions:   "For members with unpaid taskbooks.",
    id:				"taskbookIntroNew",
    name:			"taskbookIntroNew",
    value:		    settings.taskbookIntroNew,
    rows:           5,
    cols:           50
}) }}

{{ forms.textareaField ({
    label:			"Taskbook Intro Current",
    instructions:   "For members with paid taskbooks.",
    id:				"taskbookIntroCurrent",
    name:			"taskbookIntroCurrent",
    value:		    settings.taskbookIntroCurrent,
    rows:           5,
    cols:           50
}) }}

{{ forms.lightswitchField ({
    label:			"Taskbook Levels",
    id:				"taskbookLevels",
    name:			"taskbookLevels",
    on:		        settings.taskbookLevels == 1
}) }}

{{ forms.elementSelectField ({
    label:			    "Default Taskbook Job Role",
    id:				    "taskbookJobRole",
    name:			    "taskbookJobRole",
    elementType:        config.categoryElementType,
    sources:            config.jobRoleCategoryGroup,
    criteria:           '',
    sourceElementId:    '',
    elements:           settings.taskbookJobRole ? settings.taskbookJobRole,
    storageKey:         '',
    viewMode:           'list',
    limit:              1
}) }}

{{ forms.lightswitchField ({
    label:			"Enable Menu My Taskbooks",
    id:				"themeMyTaskbooks",
    name:			"themeMyTaskbooks",
    on:		        settings.themeMyTaskbooks == 1
}) }}

{{ forms.lightswitchField ({
    label:			"Enable Taskbooks on Dashboard?",
    id:				"enableTaskbooks",
    name:			"enableTaskbooks",
    on:		        settings.enableTaskbooks == 1
}) }}

{{ forms.elementSelectField ({
    label:			    "Default Workflow",
    id:				    "defaultWorkflow",
    name:			    "defaultWorkflow",
    elementType:        config.entryElementType,
    sources:            config.workflowsSection,
    criteria:           '',
    sourceElementId:    '',
    elements:           settings.defaultWorkflow ? settings.defaultWorkflow,
    storageKey:         '',
    viewMode:           'list',
    limit:              1
}) }}