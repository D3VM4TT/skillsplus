<!DOCTYPE html>
<html>
<head>
    <title>{{ filename }}</title>
    <style>
        body {
            font-family: sans-serif;
        }
        th, td {
            padding:5px;
        }
        th {
            text-align: left;
            border-bottom: 2px solid #000000;
        }
        td {
            border:1px solid #999999;
        }
        tr:first-child td {
            border-top:none;
        }
    </style>
</head>
<body>
<table style="width: 100%;" cellspacing="0">
    <thead>
        <tr>
        {% for value in header %}
            <th>{{ value }}</th>
        {% endfor %}
        </tr>
    </thead>
    <tbody>
    {% for row in rows %}
        <tr>
        {% for value in row %}
            <td>{{ value }}</td>
        {% endfor %}
        </tr>
    {% endfor %}
    </tbody>
</table>
</body>
</html>