#!/bin/bash

# get branch name from ref head
if ! [ -t 0 ]; then
  read -a ref
fi

IFS='/' read -ra REF <<< "${ref[2]}"
BRANCH="${REF[2]}"

# call lantra script /home/git/bin/lantra
if [ "$BRANCH" == "develop" ]; then
  #craft3 dev tag
  #craft3 dev all
# see special craft3 -> demo3 script
elif [ "$BRANCH" == "craft3" ]; then
  craft3
elif [ "$BRANCH" == "uat" ]; then
  # craft3 uat tag
  # craft3 uat all
elif [ "$BRANCH" == "master" ]; then
  craft3 prod tag
fi