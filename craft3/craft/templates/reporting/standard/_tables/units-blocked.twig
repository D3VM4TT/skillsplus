<div class="page-header secondary-bg">
    <h2>Units Blocked Report</h2>
    {% include '_includes/filter' with{filterDays:filterDays, reportType:'units-blocked'} %}
</div>
{% if reportEntries|length %}
<div class="page-content">
    <table width="100%" class="data">
        <thead>
            <tr>
                <th>User</th>
                <th>Team</th>
                <th>Unit</th>
                <th>Total Attempts</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for entry in reportEntries %}
        {% set userTeam = entry.author.userTeam.one() %}
        {% set resultUnit = entry.resultUnit.one() %}
        <tr>
            <td>{{ entry.author.getFullName() }}</td>
            <td>{{ userTeam.title|default('') }}</td>
            <td>{{ resultUnit.title|default('') }}</td>
            <td>{{ entry.resultAttempts|length }}</td>
            <td><a class="action" href="#" data-action="lantra/entries/resetResult" data-id="{{ entry.id }}">Reset Result</a></td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
