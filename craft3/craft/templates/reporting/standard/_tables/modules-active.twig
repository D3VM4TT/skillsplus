<div class="page-header secondary-bg">
    <h2>Modules Active Report</h2>
    {% include '_includes/filter' with{filterDays:false, reportType:'modules-active'} %}
</div>
{% if reportEntries|length %}
<div class="page-content">
    <table width="100%" class="data">
        <thead>
            <tr>
                <th>User</th>
                <th>Team</th>
                <th>Module</th>
            </tr>
        </thead>
        <tbody>
        {% for entry in reportEntries %}
        {% set userTeam = entry.author.userTeam.one() %}
        {% set resultModule = entry.resultModule.one() %}
        <tr>
            <td>{{ entry.author.getFullName() }}</td>
            <td>{{ userTeam.title|default('') }}</td>
            <td>{{ resultModule.title|default('') }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}