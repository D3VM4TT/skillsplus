{% requirePermission 'editEntries:1d590683-b16e-4955-be62-315accb3e628' %}

{% extends "_layout" %}

{% set metaTitle = "Reporting > Custom Reports > " ~ entry.title %}
{% set dateFormat = 'd/m/y G:i:s' %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}

{% set criteria = entry.reportData.limit(pageLimit) %}
{% if criteria %}{% paginate criteria as pageInfo, reportData %}{% endif %}

{% block content %}
<div class="page-subHeader primary-bg">
<a class="back-link" href="/reporting/custom">&laquo; back</a>
{% include '_includes/topNavigation' %}
</div>
    <section class="page">
        <div class="page-header">
            <h2>{{ entry.title }}</h2>
        </div>
        {% if reportData is defined and reportData|length %}
                <table class="data">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Created</th>
                        <th>File</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for dataAsset in reportData %}
                    <tr class="item">
                        <td>{{ dataAsset.id }}</td>
                        <td>{{ dataAsset.dateCreated|date(dateFormat) }}</td>
                        <td>
                            <a target="_blank" href="/internal/{{ dataAsset.id }}">{{ dataAsset.filename }}</a></td>
                    </tr>
                    {%  endfor %}
                    </tbody>
                </table>
            {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
        {% else %}
            <div class="page-content">
                <h3>There is no data to display.</h3>
            </div>
        {% endif %}
    </section>
{% endblock %}