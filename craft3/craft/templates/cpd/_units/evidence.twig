{% if resultEntry %}
    <p>You submitted evidence for this unit on {{ resultEntry.postDate|date(dateFormat) }} and your result status is {{ resultEntry.resultStatus }}.</p>
    <p>&nbsp;</p>
{% endif %}
{% import "_macros" as ui %}
{% if entry is defined %}
    {{ ui.errorList(entry.getFirstErrors()) }}
{% endif %}
{# result is locked when a result entry is pending or endorsed #}
{% set resultLocked = account.id == currentUser.id and resultEntry and resultEntry.resultStatus == 'endorsed' %}
{# undo result locked #}
{% set resultLocked = false %}
<form method="post" role="form" accept-charset="UTF-8" enctype="multipart/form-data">
    {{ csrfInput() }}
    {% if resultEntry is defined and resultEntry %}
        <div id="name-fields">
            <div class="col-6 field--wrapper">
                <h3>Result ID: {{ resultEntry.id }}</h3>
            </div>
        </div>
    {% endif %}
    {{ csrfInput() }}
    <input type="hidden" name="action" value="entries/save-entry">
    {{ redirectInput('cpd/' ~ account.id ~ '/?ref=' ~ craft.app.request.getParam('ref')) }}
    <input type="hidden" name="typeId" value="10">
    <input type="hidden" name="sectionId" value="10">
    <input type="hidden" name="enabled" value="1">
    {% if resultEntry is defined and resultEntry and resultEntry.id %}
        <input type="hidden" name="entryId" value="{{ resultEntry.id }}">
    {% endif %}
    {% if account.id != currentUser.id %}
        <input type="hidden" name="author[]" value="{{ userId }}">
        <input type="hidden" name="title" value="[unit {{ entry.id }}] {{ account.firstName }} {{ account.lastName }}">
    {% endif %}
    <input type="hidden" name="fields[resultStatus]" value="{{ resultEntry.resultStatus|default('pending') }}">
    <input type="hidden" name="fields[resultUnit][]" value="{{ entry.id }}">
    {% include 'cpd/_units/fields' with {moduleGroup:moduleGroup, resultEntry:resultEntry, accountId:account.id, resultLocked:resultLocked, isManager:isManager} %}
    {% if not resultLocked %}
        <div class="col-pd-btm"><p>Click 'Save as draft' if you would like to add more evidence at a later date.</p></div>
        <div class="container-btn">
            <button class="button primary-bg status" data-status="draft" type="button">Save as draft</button>
        </div>
        {% if isManager %}
            <div class="container-btn">
                {% if resultEntry and resultEntry.resultStatus == 'draft' %}
                    <button class="button primary-bg status" data-status="pending" type="button">Save and endorse</button>
                {% else %}
                    <button class="button primary-bg" type="submit">{{ resultEntry ? 'Update result' : 'Save and endorse' }}</button>
                {% endif %}
            </div>
        {% elseif not craft.lantra.setting('jobRoleEndorse', false) %}
            <div class="col-pd-btm"><p>Click 'Request endorsement' if you would like to submit this unit for endorsement.</p></div>
            <div class="container-btn">
                {% if resultEntry and (resultEntry.resultStatus == 'draft' or resultEntry.resultStatus == 'endorsed') %}
                    <button class="button primary-bg status" data-status="pending" type="button">Request endorsement</button>
                {% else %}
                    <button class="button primary-bg" type="submit">{{ resultEntry ? 'Update result' : 'Request endorsement' }}</button>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</form>
