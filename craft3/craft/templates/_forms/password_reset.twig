<form class="public" id="form-password" method="post" accept-charset="UTF-8">
    <h2>Reset password</h2>
    {{ getCsrfInput() }}
    <input type="hidden" name="action" value="users/sendPasswordResetEmail">
    <input type="hidden" name="redirect" value="">
    <p>Enter the email address you use to log in to your account and we'll email you with
        instructions on how you can reset your password.</p>
    <div class="field--wrapper" style="">
        <label for="loginName" style="" class="no-float">Email address</label>
        <input type="text" id="loginName" name="loginName" class="float-label" placeholder="Email address"
               value="{% if loginName is defined %}{{ loginName }}{% else %}{{ craft.session.rememberedUsername }}{% endif %}">
    </div>
    <div class="container-btn">
        <button class="button primary-bg"><span>Send reset password instructions</span></button>
    </div>
    <div class="sml-link toggle">
        <a href="/login" class="reset">Back to Log in</a>
    </div>
</form>
