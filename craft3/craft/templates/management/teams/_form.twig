{% requirePermission 'editEntries:5' %}

{% extends "_layout" %}
{% import "_macros" as ui %}
{% set metaTitle = "Management > Teams" %}

{% set entryId = craft.app.request.getSegment(4) %}
{% if entryId and entry is not defined %}
    {% set entry = craft.entries.id(entryId).first %}
{% endif %}

{% set hierarchyNode = craft.app.request.getParam('node') %}
{% set hierarchyCompany = craft.app.request.getParam('company') %}

    {% block content %}
<div class="page-subHeader primary-bg">
     {% if hierarchyNode %}
        <a class="back-link" href="/management/teams?node={{ hierarchyNode }}">&laquo; back</a>
    {% else %}
        <a class="back-link" href="/management/teams">&laquo; back</a>
    {% endif %}
    {% include '_includes/topNavigation' %}
    </div>

    <div class="page-header secondary-bg">
    {% if entry is defined and entry.id %}
        <h2>Edit team</h2>
    {% else %}
        <h2>Create a new team</h2>
    {% endif %}
                {% if hierarchyNode %}
        <p><a href="/management/hierarchy?node={{ hierarchyNode }}">&laquo; back</a></p>
        {% else %}
        <p><a href="/management/teams">&laquo; back</a></p>
        {% endif %}
    </div>
    {% if entry is defined %}
        {{ ui.errorList(entry.getFirstErrors()) }}
    {% endif %}
    <form class="page-form" method="post" role="form" accept-charset="UTF-8">
        {{ getCsrfInput() }}
        <input type="hidden" name="action" value="entries/saveEntry">
        {% if hierarchyNode %}
            <input type="hidden" name="redirect" value="/management/hierarchy?node={{ hierarchyNode }}">
        {% else %}
            <input type="hidden" name="redirect" value="management/teams">
        {% endif %}
        <input type="hidden" name="sectionId" value="5">
        <input type="hidden" name="enabled" value="1">
        <input type="hidden" name="entryId" value="{{ entry.id|default('') }}">
        <div class="field--wrapper">
            <label for="title" class="no-float">Team name:</label>
            <input type="text" id="title" name="fields[teamName]" class="float-label" placeholder="Enter the team name" value="{{ entry.teamName|default('') }}">
        </div>
        <div class="field--wrapper">
            <label for="teamCompany">Team company:</label>
            {% if currentUser.isInGroup('schemeManagers') %}
                {% set companyEntries = craft.entries.section('companies') %}
            {% else %}
                {% set companyEntries = craft.entries.section('companies').id('not ' ~ craft.lantra.individualCompanyId()) %}
            {% endif %}
            <select data-relation="fields[teamCompany]" data-value="{{ entry.teamCompany.first().id|default(hierarchyCompany) }}" id="teamCompany" >
                {% for companyEntry in companyEntries %}
                    <option value="{{ companyEntry.id }}">{{ companyEntry.title }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field--wrapper">
            <label for="teamPrimaryManager">Team primary manager:</label>
            {% set usersTeamManagers = craft.users.group('teamManagers') %}
            <select data-relation="fields[teamPrimaryManager]" id="teamPrimaryManager" data-value="{{ entry.teamPrimaryManager.first().id|default('') }}">
                {% for userEntry in usersCompanyManagers %}
                    <option value="{{ userEntry.id }}">{{ userEntry.getFullName() }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field--wrapper">
            <label for="teamSecondaryManagers">Team secondary managers:</label>
            <input type="hidden" name="fields[teamSecondaryManagers]" value="" />
            <select multiple class="js-select2" name="fields[teamSecondaryManagers][]" id="teamSecondaryManagers">
                {% for userEntry in usersTeamManagers %}
                <option value="{{ userEntry.id }}"
                    {% if entry is defined and userEntry.id in entry.teamSecondaryManagers.ids() %} selected="selected{% endif %}">{{ userEntry.getFullName() }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="container-btn">
            <button class="button primary-bg" type="submit">Save team</button>
        </div>
    </form>
{% endblock %}
