{% requirePermission 'editEntries:3' %}

{% extends "_layout" %}

{% set metaTitle = "Management > companies" %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}
{% set filterSearch = craft.app.request.getParam('search')|default('') %}
{% set lantraLicences = not craft.lantra.setting('lantraDisableLicences') %}

{% set criteria = craft.lantra.companyCriteria(filterSearch, pageLimit, 'companyLabel') %}

{% if criteria %}{% paginate criteria as pageInfo, companyEntries %}{% endif %}

{% block content %}
<div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
        </div>
<section class="page">
     <div class="page-header secondary-bg">
         <h2>Companies</h2>
         <p>Add / Edit and Delete companies within in your scheme.</p>
            <div class="header-controls">
                <div class="header-search">{% include '_includes/filter' with{filterDays:false} %}</div>
                {% if not currentUser.managerReadOnly %}
                    <div class="container-btn primary-bg">
                    {#<button class="btn-add-new primary-bg">#}
                    <a class="btn-add-new" href="/management/companies/new">Add a New Company</a>
                    {#</button>#}
                    </div>
               {% endif %}
           </div>

     </div>
     {% if companyEntries is defined and companyEntries|length %}
     <div class="page-content">

         <table class="data">
             <thead>
                 <tr>
                    <th>ID</th>
                     <th class="title">Name</th>
                     <th class="title">Location</th>
                     <th class="title">Primary Managers</th>
                     {% if lantraLicences %}
                        <th class="">Licences</th>
                     {% endif %}
                     <th class="">Users</th>
                     <th class=""></th>
                 </tr>
            <tbody>
            {% for company in companyEntries %}
            {% set parent = company.companyParent.first %}
            {% set userCount = craft.lantra.userCount(company.id, 'both') %}
                <tr>
                    <td><p class="td-title-responsive">ID: </p>{{ company.id }}</td>
                    <td><p class="td-title-responsive">Name: </p>{{ company.title }}</td>
                    <td><p class="td-title-responsive">Location: </p>{{ company.companyLabel }}</td>
                    <td>
                        {% if company.companyPrimaryManagers.total %}
                            <p class="td-title-responsive">Primary Managers: </p>
                            {% for primaryManager in company.companyPrimaryManagers %}
                                <a href="/management/users/edit/{{ primaryManager.id }}">{{ primaryManager.fullName }}</a>
                                {% if not loop.last %}<br />{% endif %}
                            {% endfor %}
                        {% endif %}
                    </td>
                    {% if lantraLicences %}
                    <td>
                        <p class="td-title-responsive">Licences: </p>
                        {{ company.companyRemainingLicences }}
                    </td>
                    {% endif %}
                    <td>
                        <p class="td-title-responsive">Users: </p>
                        {% if not currentUser.managerReadOnly and userCount %}
                            <a href="/management/users/company/{{ company.id }}">{{ userCount }}</a>
                         {% else %}
                            {{ userCount }}
                        {% endif %}
                    </td>
                    <td class="icons" style="width:140px;text-align:right">
                        {% if not currentUser.managerReadOnly %}
                            {% set companyEmails = craft.lantra.emailList(company.id) %}
                            {% if companyEmails %}
                                <a class="icon" href="mailto:{{ currentUser.email }}?bcc={{ companyEmails }}"><img src="/assets/img/email.svg" title="Email" /></a>
                            {% endif %}
                        {% endif %}
                        {% if not currentUser.managerReadOnly %}
                            <a class="icon" href="/management/companies/edit/{{ company.id }}"><img src="/assets/img/edit.svg" title="Edit" /></a>
                            <a class="icon action" href="#" data-action="entries/delete-entry" data-id="{{ company.id }}"><img src="/assets/img/delete.svg" title="Delete" /></a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
        <div class="page-content">
            <h3>There are no companies to display.</h3>
    {% endif %}
    </div>
</section>
{% endblock %}
