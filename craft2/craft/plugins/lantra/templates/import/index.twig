{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% set title = 'Lantra Import' %}

{% set fullPageForm = false %}

{% set saveButton = null %}

{% block content %}

    <div>

        {% if log %}
            <h2>Process Log</h2>
            {% for l in log %}
                <p style="color:#FF0000">{{ l }}</p>
            {% endfor %}
            <hr />
        {% endif %}

        <h2>Upload Import Data</h2>
        <p>Column order <strong>MUST</strong> be accurate or the process will fail.</p>

        <form method="post" action="" enctype="multipart/form-data">
            <input type="hidden" name="action" value="lantra/import/upload">
            {{ forms.fileField ({
                id:				"data",
                name:			"data"
            }) }}
            <div>
                <label>Data Type:</label>
                <select name="type">
                    <option value="companies">Companies</option>
                    <option value="roles">Roles</option>
                    <option value="users">Users</option>
                    <option value="results">Results</option>
                    <option value="companyUsers">Company Users</option>
                    <option value="companyManagers">Company Managers</option>
                </select>
            </div>
            <p>
                <input type="submit" class="btn submit" value="{{ 'Upload' }}">
            </p>
        </form>

        <hr />

            <h2>Unprocessed Data</h2>

            <table class="data fullwidth">
                <tr>
                    <th>Companies</th>
                    <th>Roles</th>
                    <th>Users</th>
                    <th>Results</th>
                    <th>Company Users</th>
                    <th>Company Managers</th>
                </tr>
                <tr>
                    <td>{{ unprocessed.companies }}</td>
                    <td>{{ unprocessed.roles }}</td>
                    <td>{{ unprocessed.users }}</td>
                    <td>{{ unprocessed.results }}</td>
                    <td>{{ unprocessed.companyUsers }}</td>
                    <td>{{ unprocessed.companyManagers }}</td>
                </tr>
                <tr>
                    <td><a href="/admin/lantra/import?process=removeCompanies" class="btn btn-small">Delete Companies</a></td>
                    <td><a href="/admin/lantra/import?process=removeRoles" class="btn btn-small">Delete Roles</a></td>
                    <td><a href="/admin/lantra/import?process=removeUsers" class="btn btn-small">Delete Users</a></td>
                    <td><a href="/admin/lantra/import?process=removeResults" class="btn btn-small">Delete Results</a></td>
                    <td><a href="/admin/lantra/import?process=removeCompanyUsers" class="btn btn-small">Delete Company Users</a></td>
                    <td><a href="/admin/lantra/import?process=removeCompanyManagers" class="btn btn-small">Delete Company Managers</a></td>
                </tr>
                <tr>
                    <td><a href="/admin/lantra/import?process=resetCompanies" class="btn btn-small">Reset Companies</a></td>
                    <td><a href="/admin/lantra/import?process=resetRoles" class="btn btn-small">Reset Roles</a></td>
                    <td><a href="/admin/lantra/import?process=resetUsers" class="btn btn-small">Reset Users</a></td>
                    <td><a href="/admin/lantra/import?process=resetResults" class="btn btn-small">Reset Results</a></td>
                    <td><a href="/admin/lantra/import?process=resetCompanyUsers" class="btn btn-small">Reset Company Users</a></td>
                    <td><a href="/admin/lantra/import?process=resetCompanyManagers" class="btn btn-small">Reset Company Managers</a></td>
                </tr>
            </table>

            <hr />

            <h2>Import Data To Craft</h2>

            <form method="post" action="" enctype="multipart/form-data">
                <input type="hidden" name="action" value="lantra/import/import">
                <div>
                    <label>Data Type:</label>
                    <select name="type">
                        <option value="companies">Create Companies</option>
                        <option value="roles">Create Roles</option>
                        <option value="users">Create Users</option>
                        <option value="results">Create Results</option>
                        <option value="companyManagers">Assign Company Managers</option>
                        <option value="companyUsers">Assign Company Users</option>
                    </select>
                    <label>Limit:</label>
                    <select name="limit">
                        <option>100</option>
                        <option>250</option>
                        <option>500</option>
                        <option>1000</option>
                        <option>2000</option>
                        <option>5000</option>
                    </select>
                </div>
                <p>
                    <input type="submit" class="btn submit" value="{{ 'Import' }}">
                </p>
            </form>

            <hr />

            <h2>Build Hierarchy ({{ limit }} each request)</h2>

            <p><a href="/admin/lantra/import?process=buildHierarchy" class="btn btn-small">Update Company Parent</a></p>

            {% set totalCompanies = craft.entries.section('companies').total() %}

            <p>{{ dataClean.companies }}/{{ totalCompanies }} processed</p>

            <hr />

            <h2>Assign Job Roles ({{ limit }} each request)</h2>

            <p><a href="/admin/lantra/import?process=assignJobRoles" class="btn btn-small">Assign Job Roles</a></p>

            {% set totalUsers = craft.users.admin('not 1').total() %}

            <p>{{ dataClean.users }}/{{ totalUsers }} processed</p>

            <hr />

            <h2>Set Usernames firstname.lastname ({{ limit }} each request)</h2>

            <p><a href="/admin/lantra/import?process=setUsernames" class="btn btn-small">Set Usernames</a></p>

            <p>{{ dataClean.usernames }}/{{ totalUsers }} processed</p>

            <hr />

            <h2>Set Passwords DOB ({{ limit }} each request)</h2>

            <p><a href="/admin/lantra/import?process=setPasswords" class="btn btn-small">Set Passwords</a></p>

            <p>{{ dataClean.passwords }}/{{ totalUsers }} processed</p>

            <p>If DOB empty password will be set to 010101.</p>

            <hr />

            <h2>Batch Update Users</h2>

            <form method="post" action="" enctype="multipart/form-data">
                <input type="hidden" name="action" value="lantra/import/users">
                <div>
                    <label>ID:</label>
                    <select name="refId">
                        <option value="legacyId">legacyId</option>
                        <option value="userId">userId</option>
                    </select>
                    <label>Action:</label>
                    <select name="userAction">
                        <option value="suspend">Suspend</option>
                        <option value="restore">Restore</option>
                        <option value="setManagerReadOnly">Set Manager Read Only</option>
                        <option value="unsetManagerReadOnly">Unset Manager Read Only</option>
                        <option value="delete">Delete</option>
                    </select>
                </div>
                <div style="margin:20px 0 20px 0;">
                    <textarea rows="6" name="ids" class="fullwidth"></textarea>
                    <p>Copy comma separated list of legacyId or userId (i.e. Craft id) and select action.</p>
                </div>
                <p>
                    <input type="submit" class="btn submit" value="{{ 'Update' }}">
                </p>
            </form>

            <hr />

            <h2>Column Order</h2>

            <p>Companies<br />title, legacyId, legacyCompanyId</p>
            <p>Company Managers<br />legacyId, legacyCompanyId</p>
            <p>Company Users<br />legacyId, legacyCompanyId</p>
            <p>Results<br />type, legacyUserId, legacyUnitId, title, postDate, startDate, endDate, expiryDate, resultLocation, resultHours, resultValue, resultEndorsedDate, resultStatus, resultNotes, legacyResultFiles</p>
            <p>Roles<br />title, legacyId</p>
            <p>Users<br />username, name, email, legacyId, legacyJobRoleId, userDateOfBirth, userStartDate, userAddress, userMembershipNumber</p>

            <hr />

            <h2>Dangerous Stuff - Delete Craft Data (imported only)</h2>

            <p><a href="/admin/lantra/import?process=deleteCompanies" class="btn btn-small">Delete Imported Companies</a></p>

            <p><a href="/admin/lantra/import?process=deleteResults" class="btn btn-small">Delete Imported Results</a></p>

            <p><a href="/admin/lantra/import?process=deleteUsers" class="btn btn-small">Delete Imported Users</a></p>

            <p><a href="/admin/lantra/import?process=deleteRoles" class="btn btn-small">Delete Imported Roles</a></p>
    </div>

{% endblock %}