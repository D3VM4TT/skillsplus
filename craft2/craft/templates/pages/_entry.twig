{% extends "_layout" %}

{% block content %}
<div class="page-subHeader primary-bg">
{% include '_includes/topNavigation' %}
</div>
<div class="content-top secondary-bg">
    <div class="content-col left content-top-txt">
        <h1>{{ entry.title }}</h1>
        <h2>{{ entry.pageHeading }}</h2>
    </div>
    {%  if entry.pageImage|length %}
    <div class="content-col right img-responsive">
        <img src="{{ entry.pageImage.first().url }}">
    </div>
    {% endif %}
</div>
<div class="content-main">
{%  for block in entry.pageContent %}
    <div class="content-col">
        <h2>{{ block.columnTitle }}</h2>
        <p>{{ block.columnHtml }}</p>
    </div>
{% endfor %}
</div>
{% endblock %}
