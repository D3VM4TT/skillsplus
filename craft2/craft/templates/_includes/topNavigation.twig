{% if not currentUser %}
<nav class="topNavigation">
<div id="toggle">
  <div class="one"></div>
  <div class="two"></div>
  <div class="three"></div>
</div>
<div id="menu">
<ul>
{% for pageEntry in craft.lantra.setting('themeNavigationPublic') %}
<li>
<a class="" href="{{ pageEntry.getUrl() }}">{{ pageEntry.title }}</a>
</li>
{% endfor %}
</ul>
</div>
{% endif %}

{% if currentUser %}
<a class="link-bold" href="/">My Dashboard</a>
