{% set reports = craft.entries.section('reports').find() %}
{% if reports|length %}
    <section class="section-dashboard">
        <h2>Reporting</h2>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Header</th>
                    <th>Header</th>
                    <th>Header</th>
                    <th>Header</th>
                </tr>
                </thead>
                <tbody>
                {% for report in reports %}
                <tr>
                    <td>{{ report.id }}</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endif %}