<div class="page-header secondary-bg">
    <h2>Units Endorsed Report</h2>
    {% include '_includes/filter' with{filterDays:filterDays, reportType:'units-endorsed'} %}
</div>
{% if reportEntries|length %}
<div class="page-content">
    <table width="100%" class="data table-striped">
        <thead>
            <tr>
                <th>User</th>
                <th>Team</th>
                <th>Unit</th>
                <th>Type</th>
                <th>Endorsed Date</th>
            </tr>
        </thead>
        <tbody>
        {% for entry in reportEntries %}
        {% set userTeam = entry.author.userTeam.first() %}
        {% set resultUnit = entry.resultUnit.first() %}
        <tr>
            <td>{{ entry.author.getFullName() }}</td>
            <td>{{ userTeam.title|default('') }}</td>
            <td>{{ resultUnit.title|default('') }}</td>
            <td>{{ resultUnit.unitType }}</td>
            <td>{{ entry.resultEndorsedDate|date(dateFormat) }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
