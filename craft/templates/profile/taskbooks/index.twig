{% requireLogin %}

{% extends "_layout" %}

{% set account = currentUser %}
{% set accountPhoto = account.getPhoto() %}
{% set accountPhotoUrl = accountPhoto ? accountPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg' %}

{% block content %}
<section class="page dashboard">
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <a href="/">
            <img src="{{ accountPhotoUrl }}" width="150" height="150" class="right rounded-circle" alt="{{ account.fullName }}">
        </a>
        {{ currentUserCompany|default('') }}
        <h2>My taskbooks</h2>
        <p>Manage your taskbook packages.</p>
    </div>
    <div class="page-content">
        {% if currentUser.userPackages.count %}
        <table class="data">
            <thead>
                <tr>
                    <th>Date Created</th>
                    <th>Job Role</th>
                    <th>Modules</th>
                <tr>
            </thead>
            <tbody>
                {% for package in currentUser.userPackages.all %}
                <tr>
                    <td>{{ package.packageDateCreated|date('d/m/y') }}</td>
                    <td>{{ package.packageJobRole.count ? package.packageJobRole.one.title : 'None' }}</td>
                    <td>
                        {% for packageModuleBlock in package.packageModules.all %}
                            {% set module = packageModuleBlock.packageModule.one %}
                            {{ module.title }} ({{ packageModuleBlock.packageModuleLevel.label }})<br />
                        {% endfor %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
        <div class="container-btn">
            <p><a href="/profile/taskbooks/new" class="button primary-bg">Add New Taskbook</a></p>
        </div>
    </div>
</section>
{% endblock %}
