{% requireLogin %}

{% extends "_layout" %}

{% set account = currentUser %}
{% set accountPhoto = account.getPhoto() %}
{% set accountPhotoUrl = accountPhoto ? accountPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg' %}

{% set packages = craft.entries.section('packages').authorId(currentUser.id) %}
{% set taskbookLabel = craft.lantra.setting('taskbookLabel', 'Taskbook') %}

{% block content %}
<section class="page dashboard">
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <a href="/">
            <img src="{{ accountPhotoUrl }}" width="150" height="150" class="right rounded-circle" alt="{{ account.fullName }}">
        </a>
        {{ currentUserCompany|default('') }}
        <h2>Manage {{ taskbookLabel|pluralize }}</h2>
        <p>Manage your {{ taskbookLabel }} packages.</p>
    </div>
    <div class="page-content">
        {% if packages.count %}
        <table class="data taskbooks">
            <thead>
                <tr>
                    <th>Date Created</th>
                    <th>Module Group</th>
                    <th>Level</th>
                    <th>Optional Module Groups</th>
                    <th>Cost</th>
                    <th></th>
                <tr>
            </thead>
            <tbody>
                {% for package in packages.all %}
                    {% set hasPayment = package.userPayments.count %}
                    {% set packageTitle = package.moduleGroup.title ~ ' ' ~ craft.lantra.taskbookLevel(package.packageLevel) %}
                    <tr>
                        <td>{{ package.dateCreated|date('d/m/y') }}</td>
                        {% if not package.moduleGroup %}
                            <td style="color:red">Invalid Module Group</td>
                        {% else %}
                            <td>
                                {% if package.packagePaid and hasPayment %}
                                    <a href="/cpd/{{ currentUser.id }}/taskbooks/{{ package.id }}">{{ packageTitle }}</a>
                                {% else %}
                                    {{ packageTitle }}
                                {% endif %}
                            </td>
                        {% endif %}
                        <td>{{ craft.lantra.taskbookLevel(package.packageLevel) }}</td>
                        <td>
                            {% for optionalModuleGroupBlock in package.packageOptionalModuleGroups.all %}
                                {% set moduleGroup = optionalModuleGroupBlock.optionalModuleGroup.one %}
                                {% if not moduleGroup %}
                                    Invalid Optional Module Group<br />
                                {% else %}
                                    {{ moduleGroup.title }} ({{ craft.lantra.taskbookLevel(optionalModuleGroupBlock.optionalLevel) }})<br />
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>£{{ package.packageCost }}</td>
                        <td>
                            {% if package.packagePaid %}
                                {% if hasPayment %}
                                    {% set payment = package.userPayments.one %}
                                    {{ payment.payer_email }} ({{ payment.txn_id }})
                                {% else %}
                                    Unconfirmed
                                {% endif %}
                            {% else %}
                                {{ craft.lantra.payPalButton(packageTitle, package.packageCost, 'Pay Now', siteUrl('sp/packages/pay/' ~ package.id), {'packageId':package.id})|raw }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
        <div class="container-btn">
            <p><a href="/profile/taskbooks/new" class="button primary-bg">New {{ taskbookLabel }}</a></p>
        </div>
    </div>
</section>
{% endblock %}
