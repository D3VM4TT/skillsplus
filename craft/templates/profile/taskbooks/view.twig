{% requireLogin %}

{% set account = currentUser %}
{% set accountPhoto = account.getPhoto() %}
{% set accountPhotoUrl = accountPhoto ? accountPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg' %}

{% set package = craft.lantra.getUserPackage(packageId, account.id) %}
{% if not package %}{% redirect '/profile/taskbooks' %}{% endif %}

{% extends "_layout" %}

{% set packageTitle = package.coreModuleGroup.title ~ ' ' ~ craft.lantra.taskbookLevel(package.packageCoreLevel) %}

{% block content %}
<section class="page dashboard">
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <a href="/">
            <img src="{{ accountPhotoUrl }}" width="150" height="150" class="right rounded-circle" alt="{{ account.fullName }}">
        </a>
        {{ currentUserCompany|default('') }}
        <h2>My taskbooks</h2>
        <p>Manage your taskbook packages.</p>
    </div>
    <div class="page-content">
        <h2>{{ packageTitle }}</h2>
        <p>Created {{ package.packageDateCreated|date('d/m/y') }}</p>
        {% for optionalModuleGroupBlock in package.packageOptionalModuleGroups.all %}
            {% set moduleGroup = optionalModuleGroupBlock.optionalModuleGroup.one %}
            <p>{{ moduleGroup.title }} ({{ craft.lantra.taskbookLevel(optionalModuleGroupBlock.optionalLevel) }})</p>
        {% endfor %}
        <p><strong>£{{ package.packageCost }}</strong>

        {% if not package.packagePaid %}
            <div class="container-btn">
                {{ craft.lantra.payPalButton(packageTitle, package.packageCost, 'Pay Now', siteUrl('profile/taskbooks/view/' ~ package.id), {'packageId':package.id})|raw }}
    </div>
        {% else %}
            PAID
        {% endif %}
        </p>
    </div>
</section>
{% endblock %}
