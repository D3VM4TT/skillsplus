{% extends "_layout" %}

{% block content %}
    <section class="page dashboard">
        <div class="page-subHeader primary-bg">
            {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <a href="../"><img src="{{ (currentUser.photoUrl ? currentUser.getPhotoUrl(150) : '/assets/img/img-team-management.jpg') }}" width="150" height="150" class="right rounded-circle" alt="{{ currentUser.fullName }}"></a>
            {{ currentUserCompany|default('') }}
            <h2>Edit password</h2>
            {% set cpdUser = currentUser %}
            {% include '_includes/switchUser' with {redirect: '/profile/password'} %}
        </div>
        <div class="page-content">
            {% if currentUser.isLinked %}
                <p style="margin-bottom: 20px;"><strong>Linked to user account #{{ currentUser.linkedUser.id }} {{ currentUser.linkedUser.fullName }}</strong></p>
                <p style="margin-bottom: 20px;color:#FF0000">Switch to your primary account to edit password.</p>
            {% else %}
            <form class="public" id="form-password" method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('users/save-user') }}
                {{ redirectInput('profile') }}
                {{ hiddenInput('userId', currentUser.id) }}
                {% if errors is defined %}
                    {{ ui.errorList(errors) }}
                {% endif %}
                <div class="field--wrapper">
                    <label for="password">Existing Password</label>
                    <input id="password" type="password" name="password">
                </div>
                <div class="field--wrapper">
                    <label for="newPassword">New Password</label>
                    <input id="newPassword" type="password" name="newPassword">
                </div>
                <input class="button primary-bg" type="submit" value="Submit">
            </form>
            {% endif %}
        </div>
    </section>
{% endblock %}