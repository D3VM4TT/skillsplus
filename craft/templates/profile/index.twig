{% set currentUserCompany = craft.lantra.userCompany() %}
{% set primaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: currentUser, field: 'companyPrimaryManager'}).limit(null) %}
{% set secondaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: currentUser, field: 'companySecondaryManagers'}).limit(null) %}
{% set managerCompanies = primaryManagerCompanies|merge(secondaryManagerCompanies) %}
{% extends "_layout" %}

{% block content %}
    <section class="page dashboard">
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <a href="../"><img src="{{ (currentUser.photoUrl ? currentUser.getPhotoUrl(150) : '/assets/img/img-team-management.jpg') }}" width="150" height="150" class="right rounded-circle" alt="{{ currentUser.fullName }}"></a>
            {{ currentUserCompany|default('') }}
            <h2>My profile</h2>
            <p>A snapshot of your personal information, Companies and Job roles.</p>
        </div>
        <div class="page-content">
            {% set currentUserCompany = craft.lantra.userCompany() %}
            <p class="profile">
                <span class="label">Name:</span> {{ currentUser.fullName }}<br/>
                <span class="label">Email address:</span> {{ currentUser.email }}<br/>
                <span class="label">User type:</span> {{ craft.lantra.userType() }}<br/>
                {% if currentUserCompany %}
                    <span class="label">User Company:</span> {{ currentUserCompany }}<br />
                {% endif %}
                {% if managerCompanies|length %}
                    <span class="label">Manager {{ managerCompanies|length == 1 ? 'Company' : 'Companies' }}:</span>
                    {% for company in managerCompanies %}
                        {{ company.title }}{{ not loop.last ? ', ' }}
                    {% endfor %}
                {% endif %}
                <span class="label">Legacy User ID:</span>{{ currentUser.legacyId == 0 ? '~' : currentUser.legacyId }}<br/>
                <span class="label">Job Role:</span>
                {% if currentUser.userRole.total %}
                    {% for role in currentUser.userRole %}{{ role.title }}{% if loop.index != loop.length %}, {% endif %}{% endfor %}
                {% else %}
                    ~
                {% endif %}
            </p>
            {% if not globalsScheme.schemeUserReadOnly %}
                {% include '_forms/profile' %}
            {% endif %}
        </div>
    </section>
{% endblock %}
