{% set jsDateFormat = craft.lantra.setting('jsDateFormat', 'dd-mm-yyyy') %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}

{% set currentUserCompany = craft.lantra.userCompany() %}
{% set currentUserManagers = craft.lantra.userManagers(currentUser, 0 , false) %}
{% set primaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: currentUser, field: 'companyPrimaryManagers'}).limit(null) %}
{% set secondaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: currentUser, field: 'companySecondaryManagers'}).limit(null) %}
{% set managerCompanies = primaryManagerCompanies|merge(secondaryManagerCompanies) %}
{% set readOnly = (craft.lantra.setting('schemeUserReadOnly') or (currentUser['userReadOnly'] is defined and currentUser.userReadOnly)) %}

{% set currentUserPhoto = currentUser ? currentUser.getPhoto() %}

{% extends "_layout" %}

{% block content %}
    <section class="page dashboard">
        <div class="page-subHeader primary-bg">
            {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <a href="../">
                <img src="{{ (currentUserPhoto ? currentUserPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg') }}"
                        width="150" height="150" class="right rounded-circle" alt="{{ currentUser.fullName }}"></a>
            <h2>My profile</h2>
            <p>A snapshot of your personal information, Companies and Job roles.</p>
            <div class="header-controls">
                {% if not readOnly %}
                    <div class="container-btn primary-bg" style="margin-left:0;">
                        <a class="btn-add-new" href="/profile/edit">Edit profile</a>
                    </div>
                {% endif %}
                <div class="container-btn primary-bg">
                    <a class="btn-add-new" href="/profile/password">Edit password</a>
                </div>
            </div>
        </div>
        <div class="page-content">
            <div class="field--wrapper">
                <div class="col-3">
                    <h2>{{ currentUser.fullName }}</h2>
                </div>
                <div class="col-9">
                    {% set email = craft.lantra.userProfileField('email', 'profile') %}
                    {% if email %}
                           <h6 class="primary">email: {{ currentUser.userDummyEmail ? 'Not Specified' : currentUser.email }}</h6>
                    {% endif %}
                    {% set userId = craft.lantra.userProfileField('id', 'profile') %}
                    {% if userId %}
                        <h6 class="primary">user id: {{ currentUser.id }}</h6>
                    {% endif %}
                </div>
            </div>

            <h6>User Profile</h6>

            {% for row in craft.lantra.userProfileFields('profile') %}
                {% switch row.field %}
                    {% case 'userStartDate' %}
                        <p>{{ row.label ?: 'Start Date' }}:  {{ currentUser.userStartDate ? currentUser.userStartDate|date(dateFormat) : '~' }}</p>
                    {% case 'userDateOfBirth' %}
                        <p>{{ row.label ?: 'Date of Birth' }}: {{ currentUser.userDateOfBirth ? currentUser.userDateOfBirth|date(dateFormat) : '~' }}</p>
                    {% case 'userAddress' %}
                        <p>{{ currentUser.userAddress }}</p>
                    {% case 'userTelephone' %}
                        <p>{{ currentUser.userTelephone }}</p>
                    {% case 'userRole' %}
                        <p>
                            {{ row.label ?: 'Job Role(s)' }}:
                            {% if not  currentUser.userRole.count %}~{% endif %}
                            {% for role in currentUser.userRole %}{{ role.title }}{% if loop.index != loop.length %}, {% endif %}{% endfor %}
                        </p>
                    {% case 'legacyId' %}
                        <p>{{ row.label ?: 'Legacy ID' }}: {{ currentUser.legacyId == 0 ? '~' : currentUser.legacyId }}</p>
                {% endswitch %}
            {% endfor %}

            {% set userCustomFields = craft.lantra.setting('userEditCustomFields') %}
            {% for block in userCustomFields %}
                {% set userCustomBlock = currentUser.userCustomFields.customName('='~block.name).one() %}
                <p>{{ block.label }}: {{ userCustomBlock.customValue|default('~') }}</p>
            {% endfor %}

            {% set showUserCompany = craft.lantra.userProfileField('userCompany', 'profile') %}
            {% set showUserManagers = craft.lantra.userProfileField('userManagers', 'profile') %}

            {% if showUserCompany or showUserManagers %}
                <p>&nbsp;</p>
                <p>&nbsp;</p>
                <h6>Company Profile</h6>
                {% if currentUserCompany %}
                    <h6 class="primary">{{ currentUserCompany }}</h6>
                {% endif %}
                {% if currentUserManagers|length %}
                    <p>Manager(s):
                    {% for manager in currentUserManagers %}
                        {{ manager.fullName }}{{ not loop.last ? ', ' }}
                    {% endfor %}
                    </p>
                {% endif %}
            {% endif %}

            {% set showManagerCompanies = craft.lantra.userProfileField('managerCompanies', 'profile') %}
            {% if showManagerCompanies and managerCompanies|length %}
                <p>&nbsp;</p>
                <p>&nbsp;</p>
                <h6>Company Management</h6>
                <p>
                    {% for company in managerCompanies %}
                        {{ company.title }}{{ not loop.last ? ', ' }}
                    {% endfor %}
                </p>
            {% endif %}
        </div>
    </section>
{% endblock %}
