{% set jsDateFormat = craft.lantra.setting('jsDateFormat', 'dd-mm-yyyy') %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}

{% set currentUserCompany = craft.lantra.userCompany() %}
{% set currentUserManagers = craft.lantra.userManagers(currentUser, 0 , false) %}
{% set primaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: currentUser, field: 'companyPrimaryManagers'}).limit(null) %}
{% set secondaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: currentUser, field: 'companySecondaryManagers'}).limit(null) %}
{% set managerCompanies = primaryManagerCompanies|merge(secondaryManagerCompanies) %}
{% set readOnly = (craft.lantra.setting('schemeUserReadOnly') or (currentUser['userReadOnly'] is defined and currentUser.userReadOnly)) %}

{% set currentUserPhoto = currentUser ? currentUser.getPhoto() %}

{% extends "_layout" %}

{% block content %}
    <section class="page dashboard">
        <div class="page-subHeader primary-bg">
            {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <a href="../"><img
                        src="{{ (currentUserPhoto ? currentUserPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg') }}"
                        width="150" height="150" class="right rounded-circle" alt="{{ currentUser.fullName }}"></a>
            {{ currentUserCompany|default('') }}
            <h2>My profile</h2>
            <p>A snapshot of your personal information, Companies and Job roles.</p>
        </div>
        <div class="page-content">
            {% for row in craft.lantra.userProfileFields('profile') %}
                {% switch row.field %}
                    {% case 'fullName' %}
                        <div class="field--wrapper">
                            <h4>{{ currentUser.fullName }}</h4>
                        </div>
                    {% case 'email' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'Email' }}</label>
                            <h4>{{ currentUser.email }}</h4>
                        </div>
                    {% case 'userStartDate' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'Start Date' }}</label>
                            <span class="label">{{ currentUser.userStartDate ? currentUser.userStartDate|date(dateFormat) : '~' }}</span>
                        </div>
                    {% case 'userDateOfBirth' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'Date of Birth' }}</label>
                            <span class="label">{{ currentUser.userDateOfBirth ? currentUser.userDateOfBirth|date(dateFormat) : '~' }}</span>
                        </div>
                    {% case 'userAddress' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'Address' }}</label>
                            <span class="label">{{ currentUser.userAddress }}</span>
                        </div>
                    {% case 'userTelephone' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'Telephone' }}</label>
                            <span class="label">{{ currentUser.userTelephone }}</span>
                        </div>
                    {% case 'userRole' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'Role' }}</label>
                            {% if not  currentUser.userRole.count %}~{% endif %}
                            {% for role in currentUser.userRole %}{{ role.title }}{% if loop.index != loop.length %}, {% endif %}{% endfor %}
                        </div>
                    {% case 'userCompany' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'User Company' }}</label>
                            <span class="label">{{ currentUserCompany  ? currentUserCompany : '~' }}</span>
                        </div>
                    {% case 'userManagers' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'User Managers' }}</label>
                            {% if not currentUserManagers|length %}~{% endif %}
                            {% for manager in currentUserManagers %}
                                {{ manager.fullName }}{{ not loop.last ? ', ' }}
                            {% endfor %}
                            </span>
                        </div>
                    {% case 'managerCompanies' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'Manager Companies' }}</label>
                            {% if not managerCompanies|length %}~{% endif %}
                            {% for company in managerCompanies %}
                                {{ company.title }}{{ not loop.last ? ', ' }}
                            {% endfor %}
                        </div>
                    {% case 'legacyId' %}
                        <div class="field--wrapper">
                            <label class="no-float primary-color">{{ row.label ?: 'Legacy ID' }}:</label>
                            <span class="label">{{ currentUser.legacyId == 0 ? '~' : currentUser.legacyId }}</span>
                        </div>
                {% endswitch %}
            {% endfor %}

            {% set userCustomFields = craft.lantra.setting('userEditCustomFields') %}
            {% for block in userCustomFields %}
                {% set userCustomBlock = currentUser.userCustomFields.customName('='~block.name).one() %}
                <div class="field--wrapper">
                    <label class="no-float primary-color">{{ block.label }}</label>
                    <span class="label">{{ userCustomBlock.customValue|default('~') }}</span>
                </div>
            {% endfor %}
            {% if not readOnly %}
                <div class="container-btn col-pd-top">
                    <a class="button primary-bg" href="/profile/edit">Edit profile</a>
                </div>
            {% endif %}
            <div class="container-btn col-pd-top">
                <a class="button primary-bg" href="/profile/password">Edit password</a>
            </div>
        </div>
    </section>
{% endblock %}
