{% set jsDateFormat = craft.lantra.setting('jsDateFormat', 'dd-mm-yyyy') %}
{% set dateFormat = craft.lantra.setting('dateFormat', 'd-m-Y') %}

{% set currentUserCompany = craft.lantra.userCompany() %}
{% set currentUserManagers = craft.lantra.userManagers(currentUser, 0 , false) %}
{% set primaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: currentUser, field: 'companyPrimaryManagers'}).limit(null) %}
{% set secondaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: currentUser, field: 'companySecondaryManagers'}).limit(null) %}
{% set managerCompanies = primaryManagerCompanies|merge(secondaryManagerCompanies) %}
{% extends "_layout" %}

{% block content %}
    <section class="page dashboard">
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <a href="../"><img src="{{ (currentUser.photoUrl ? currentUser.getPhotoUrl(150) : '/assets/img/img-team-management.jpg') }}" width="150" height="150" class="right rounded-circle" alt="{{ currentUser.fullName }}"></a>
            {{ currentUserCompany|default('') }}
            <h2>My profile</h2>
            <p>A snapshot of your personal information, Companies and Job roles.</p>
        </div>
        <div class="page-content">
        <div class="field--wrapper">
            <h4>{{ currentUser.fullName }}</h4>
        </div>
        <div class="field--wrapper">
            <label class="no-float primary-color">Email address:</label>
            <h4>{{ currentUser.email }}</h4>
        </div>
        {% if currentUser.userStartDate %}
            <div class="field--wrapper">
                <label class="no-float primary-color">Start date:</label>
                <span class="label">{{ currentUser.userStartDate|date(dateFormat) }}</span>
            </div>
        {% endif %}
        {% if currentUser.userDateOfBirth %}
            <div class="field--wrapper">
                <label class="no-float primary-color">Date of Birth:</label>
                <span class="label">{{ currentUser.userDateOfBirth|date(dateFormat)  }}</span>
            </div>
        {% endif %}
        {% if currentUser.userAddress %}
            <div class="field--wrapper">
                <label class="no-float primary-color">Address:</label>
                <span class="label">{{ currentUser.userAddress }}</span>
            </div>
        {% endif %}
        {% if currentUser.userTelephone %}
            <div class="field--wrapper">
                <label class="no-float primary-color">Telephone:</label>
                <span class="label">{{ currentUser.userTelephone }}</span>
            </div>
        {% endif %}
        {% if currentUserCompany %}
            <div class="field--wrapper">
                <label class="no-float primary-color">User Company:</label>
                <span class="label">{{ currentUserCompany }}</span>
            </div>
        {% endif %}
        {% if not currentUser.admin and not currentUser.isInGroup('schemeManagers') and currentUserManagers %}
            <div class="field--wrapper">
                <label class="no-float primary-color">User Managers:</label>
                <span class="label">
                    {% for manager in currentUserManagers %}
                        {{ manager.fullName }}{{ not loop.last ? ', ' }}
                    {% endfor %}
                </span>
            </div>
        {% endif %}
        {% if managerCompanies|length %}
            <div class="field--wrapper">
                <label class="no-float primary-color">Manager:</label>
                <span class="label">{{ managerCompanies|length == 1 ? 'Company' : 'Companies' }}:</span>
                {% for company in managerCompanies %}
                    {{ company.title }}{{ not loop.last ? ', ' }}
                {% endfor %}
            </div>
        {% endif %}
        <div class="field--wrapper">
            <label class="no-float primary-color">Legacy User ID:</label>
            <span class="label">{{ currentUser.legacyId == 0 ? '~' : currentUser.legacyId }}</span>
        </div>
        {% if not craft.lantra.setting('userEditRole') %}
            <div class="field--wrapper">
                <label class="no-float primary-color">Job Role:</label>
                {% if currentUser.userRole.total %}
                    {% for role in currentUser.userRole %}{{ role.title }}{% if loop.index != loop.length %}, {% endif %}{% endfor %}
                {% else %}
                ~
                {% endif %}
                <br/>
            {% set userCustomFields = craft.lantra.setting('userEditCustomFields') %}
            {% for block in userCustomFields %}
                {% set userCustomBlock = currentUser.userCustomFields.customName('='~block.name).first() %}
                <span class="label">{{ block.label }}:</span> {{ userCustomBlock.customValue|default('~') }}<br />
            {% endfor %}
            </div>
        {% endif %}
        {% if not craft.lantra.setting('schemeUserReadOnly') %}
            <div class="container-btn col-pd-top">
                <a class="button primary-bg" href="/profile/edit">Edit profile</a>
            </div>
            <div class="container-btn col-pd-top">
                <a class="button primary-bg" href="/profile/password">Edit password</a>
            </div>
        {% endif %}
        </div>
    </section>
{% endblock %}
