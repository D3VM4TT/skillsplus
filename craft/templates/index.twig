{% set defaultHome = craft.lantra.setting('themeDefaultHome') %}
{% if defaultHome == 'taskbooks' %}
    {% redirect 'cpd/' ~ currentUser.id ~ '/taskbooks'  %}
{% elseif defaultHome == 'products' %}
    {% redirect 'management/products' %}
{% elseif defaultHome == 'profile' %}
    {% redirect 'profile' %}
{% endif %}

{% set currentUserCompany = craft.lantra.userCompany() %}
{% extends "_layout" %}

{% set currentUserPhoto = currentUser ? currentUser.getPhoto() %}
{% set jobRoleLabel = craft.lantra.setting('labelJobRole', 'Job Role') %}

{% block content %}
    <section class="page dashboard">
        <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <a href="/profile"><img src="{{ (currentUserPhoto ? currentUserPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg') }}" width="150" height="150" class="right rounded-circle" alt="{{ currentUser.fullName }}"></a>
            {#
            {{ currentUserCompany|default('') }}
            #}
            <h2>Hello {{ currentUser.firstName }},</h2>
            <p class="welcome-back" style="padding:0;">welcome back to your {{ craft.lantra.setting('schemeName') }} dashboard.</p>
            {% if currentUser.userRole|length %}
                <p  style="padding:0;">Allocated {{ jobRoleLabel|pluralize(currentUser.userRole|length) }}: {% for role in currentUser.userRole %}{{ role.title }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
            {% endif %}
        </div>
        <div class="page-content">
            {{ globalsHtml.pageDashboard }}
            {% include 'record/_modules' with{cpdUser:currentUser} %}
             {% if craft.lantra.canManage() %}
                {% set pendingEntryCount = craft.lantra.managerCountEndorsementUsers() %}
                {% if not currentUser.managerReadOnly and pendingEntryCount %}
                    <article class="endorsements-pending col-pd-btm secondary-bg">
                    <h4>Endorsements</h4>
                    <div class="status right">
                    <p>You have <a href="/management/endorsements">{{ pendingEntryCount }} result(s)</a> to endorse.</p>
                    </div>
                    </article>
                {% endif %}
            {% endif %}
        </div>
    </section>
{% endblock %}
