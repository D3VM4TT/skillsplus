{% set currentUserCompany = craft.lantra.userCompany() %}
{% extends "_layout" %}

{% block content %}
    <section class="page dashboard">
        <div class="page-header">
            <img src="/assets/img/img-team-management.jpg" width="150" height="150" class="right rounded-circle" alt="Generic placeholder thumbnail">
            <h2>{{ currentUser.fullName }}</h2>
            {{ currentUserCompany|default('') }}
            <p class="welcome-back">
                <strong>Hello {{ currentUser.firstName }}, welcome back to the Lantra dashboard.</strong>
            </p>
        </div>
        <div class="page-content">
            {% include '_includes/profile' %}
            {% include '_includes/cpd' with{cpdUser:currentUser} %}
            {% include '_includes/results' with{cpdUser:currentUser} %}
            {% if craft.lantra.canManage(null, true) %}
                {% include '_includes/scheme' %}
            {% endif %}
            {% if craft.lantra.canManage() %}
                {% include '_includes/admin' %}
            {% endif %}
        </div>
    </section>
{% endblock %}
