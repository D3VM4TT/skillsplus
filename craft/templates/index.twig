{% set currentUserCompany = craft.lantra.userCompany() %}
{% extends "_layout" %}

{% block content %}
    <div class="dashboard">
        <img src="/assets/img/img-team-management.jpg" width="150" height="150" class="img-fluid rounded-circle" alt="Generic placeholder thumbnail">
        <h2>{{ currentUser.fullName }}</h2>
        <div class="text-muted">
            {{ currentUserCompany|default('') }}
        </div>

        <div class="welcome-back">
            <p class="text-bold">Hello {{ currentUser.firstName }}, welcome back to the Lantra dashboard.</p>
        </div>

        {% include '_includes/cpd' with{cpdUser:currentUser} %}

        {% if craft.lantra.canManage(null, true) %}
            {% include '_includes/scheme' %}
        {% endif %}

        {% if craft.lantra.canManage() %}
            {% include '_includes/admin' %}
        {% endif %}
    </div>
{% endblock %}
