<div style="margin-top:20px;margin-bottom:20px">
    <h4>Evidence</h4>
    {#<a href="#" data-target="evidence" class="primary-bg button open-lantra-browser">Upload New Evidence</a>#}
    <a href="#" class="primary-bg button open-lantra-evidence-upload" data-target="evidence" data-package-id="{{ package.id }}">Upload New Evidence</a>
</div>

{% set evidence = package.evidence %}

{% if not evidence|length %}
    <p>No evidence has been uploaded for this {{ taskbookLabel|lower }}.</p>
{% else %}
    <table class="data">
        <thead>
        <tr>
            <th>Filename</th>
            <th>Uploaded By</th>
            <th>Uploaded Date</th>
            <th>Size</th>
            <th>Location</th>
            <th>Unit IDs</th>
        </tr>
        </thead>
        <tbody>
        {% for row in evidence %}
            <tr>
                <td>{{ row.asset.filename }}</td>
                <td>{{ row.asset.uploader ? row.asset.uploader.fullName : '~' }}</td>
                <td>{{ row.asset.dateCreated|date(dateFormat) }}</td>
                <td>{{ row.asset.size|filesize }}</td>
                <td>
                    {% if row.asset.location|coordinates %}
                        <a href="http://www.google.com/maps/place/{{ row.asset.location|coordinates  }}"><i class="fa fa-map-marker" aria-hidden="true"></i></a>
                    {% endif %}
                </td>
                <td>
                    {% for unit in row.units %}
                        {{ unit.id }}<br />
                    {% endfor %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}