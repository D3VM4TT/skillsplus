<div style="margin-top:20px;margin-bottom:20px">
    <h4>Evidence</h4>
</div>

{% set evidence = package.evidence %}

{% if not evidence|length %}
    <p>No evidence has been uploaded for this {{ taskbookLabel }}.</p>
{% else %}
    <table class="data">
        <thead>
        <tr>
            <th>Filename</th>
            <th>Units</th>
        </tr>
        </thead>
        <tbody>
        {% for row in evidence %}
            <tr>
                <td>{{ row.asset.filename }}</td>
                <td>
                    {% for unit in row.units %}
                        {{ unit.title }}<br />
                    {% endfor %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}