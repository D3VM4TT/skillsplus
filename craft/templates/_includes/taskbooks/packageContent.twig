<table class="data" width="100%">
    <thead>
    <tr>
        <th>Module Group</th>
        <th style="text-align: right;">Level</th>
    </tr>
    </thead>
    <tbody>
{% for moduleGroup in package.moduleGroups %}
    <tr>
        <td><a href="/cpd/{{ cpdUser.id }}/taskbooks/{{ package.id }}/{{ moduleGroup.category.id }}">{{ moduleGroup.category.magicTitle }}</a></td>
        <td style="text-align: right">{{ moduleGroup.level }}</td>
    </tr>
{% endfor %}
    </tbody>
</table>