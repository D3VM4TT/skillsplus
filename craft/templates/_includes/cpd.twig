{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set existingResultIds = [] %}
{% set isManager = false %}
{% set readOnly = (craft.lantra.setting('schemeUserReadOnly') or (cpdUser['userReadOnly'] is defined and cpdUser.userReadOnly)) %}
{% if cpdUser.id != currentUser.id %}
    {% set isManager = true %}
    {% set readOnly = currentUser.managerReadOnly %}
{% endif %}

{% set jobRoleEndorse = craft.lantra.setting('jobRoleEndorse', false) %}

<article id="cpd-wrapper" class="cpd" data-ref="{{ craft.app.request.getParam('ref')|default('') }}">
{% set resultArchive = craft.entries.section('results').type('userResult', 'unitResult').authorId(cpdUser.id).status('live, expired') %}
    <div id="job-role-cpd">
{% if not cpdUser.userRole.count %}
    <h2>Job Role</h2>
    <div class="col-pd-btm col-flex">
    <img src="/assets/img/delete.svg" class="test-icon" alt="">
    <p>
        {% if isManager %}
            This user has no job role(s) allocated to their account.
        {% else %}
            You have no job role(s) allocated to your account.
        {% endif %}
    </p>
    </div>
{% else %}
    {% for role in cpdUser.userRole.all() %}
        <div class="job-role" style="position: relative;">
        {# number of results to complete - line 123 #}
        {% set jobRoleNoResult = 0 %}
        <div class="align-vertical">
            <div class="align-horizontal"><img src="/assets/img/tool-job-role-management.svg" width="120" height="120" class="" alt=""></div>
            <div class="align-horizontal">
                <div><h4>{{ craft.lantra.setting('labelJobRole', 'Job Role') }}</h4></div>
                <div><h2>{{ role.title }}</h2></div>
                {% if jobRoleEndorse %}
                    <a class="jobroleEndorseExpand" href="javascript:" data-target="#j{{ role.id }}"><img src="/assets/img/img-arrow-down.png"></a>
                {% endif %}
            </div>
        </div>
    <div id="j{{ role.id }}" {% if jobRoleEndorse %}class="closed"{% endif %}>
        {% set allModules = craft.entries.section('modules').relatedTo(role).orderBy('title') %}
        {% if not allModules|length %}
            <p>No modules have been assigned to this role.</p>
        {% else %}
            <div class="module-group-tabs">
                <ul class="tabs clearfix" data-tabgroup="groups-tab-group-{{ role.id }}">
                {% set moduleGroups = craft.categories.group('moduleGroups').relatedTo({sourceElement: allModules, field: 'moduleGroup'}) %}
                {% for moduleGroup in moduleGroups.all() %}
                    {% set moduleGroupElementId = role.id ~ moduleGroup.id %}
                    <li>
                        <a href="#tab{{ moduleGroupElementId }}" class="primary-bg">
                            <h4>{{ moduleGroup.title }}</h4>
                        </a>
                    </li>
                {% endfor %}
                </ul>
            </div>
            <section id="groups-tab-group-{{ role.id }}" class="tabgroup">
                {% for moduleGroup in moduleGroups.all() %}
                    {% set moduleGroupElementId = role.id ~ moduleGroup.id %}
                <div class="groups-tab-group" id="tab{{ moduleGroupElementId }}">
                    <div class="module-tabs">
                        <ul class="tabs clearfix" data-tabgroup="tab-group-{{ moduleGroup.id }}">
                            <div class="tabs-group">
                            {% set modules = craft.entries.relatedTo(
                                ['and',
                                    { targetElement: role, field: 'moduleRoles' },
                                    { targetElement: moduleGroup, field: 'moduleGroup' }
                                ]) %}
                            {% if not modules.count %}
                                No modules have been added to this module group.
                            {% endif %}
                            {% for module in modules.all() %}
                                {% set moduleElementId = role.id ~ moduleGroup.id ~ module.id %}
                                {% set moduleResultEntry = craft.entries.section('results').type('moduleResult').authorId(cpdUser.id).relatedTo(module).resultStatus('complete').status('live, expired').one() %}
                                <li>
                                    <a href="#module{{ moduleElementId }}" class="module-status">
                                        {% if moduleResultEntry %}
                                            <span class="status-complete"></span>
                                        {% else %}
                                            <span class="status-inprogress"></span>
                                        {% endif %}
                                        {{ module.title }}
                                    </a>
                                </li>
                                {% if not loop.last and loop.index is divisible by(4) %}
                                </div>
                                <div class="tabs-group">
                                {% endif %}
                            {% endfor %}
                            </div>
                        </ul>
                    </div>
                    <div id="tab-group-{{ moduleGroup.id }}" class="tabgroup module-wrapper">
                    {% for module in modules.all() %}
                        {% set moduleElementId = role.id ~ moduleGroup.id ~ module.id %}
                        {% set moduleResultEntry = craft.entries.section('results').type('moduleResult').authorId(cpdUser.id).relatedTo(module).resultStatus('complete').status('live, expired') .one() %}
                        <div id="module{{ moduleElementId }}" class="module open">
                            {% set totalPoints = 0 %}
                            <div class="header" data-target="#m{{ role.id ~ module.id }}">
                                <h4>{{ module.title }}</h4>
                                <!--
                                <div class="status module-status">
                                    {% if moduleResultEntry %}<span class="module-status-complete">Complete</span>{% else %}<span class="module-status-inprogress">In Progress</span>{% endif %}
                                </div>
                                -->
                            </div>
                            <div id="m{{ role.id ~ module.id }}" class="unit-groups">
                                {% for unitGroup in module.moduleUnitGroups.all() %}
                                    {% set unitGroupEntries = unitGroup.unitEntries %}
                                    <div class="unit-group">
                                        <div class="header primary-bg" data-target="#u{{ role.id ~ module.id ~ unitGroup.id }}">
                                            <h5>{{ unitGroup.groupName|default('') }}&nbsp;</h5>
                                            <div class="status">
                                                View status and Endorsements
                                                <img src="/assets/img/img-arrow-down-white-trans.png">
                                            </div>
                                        </div>
                                        <div id="u{{ role.id ~ module.id ~ unitGroup.id }}" class="units">
                                            <table class="data">
                                                <thead>
                                                <tr>
                                                    <th>Unit title</th>
                                                    {% include '_includes/columnLayout' with {header:true,  columnLayout:moduleGroup.columnLayout, isManager:isManager} %}
                                                </tr>
                                                </thead>
                                                <tbody>
                                                {% for unitEntry in unitGroupEntries.all() %}
                                                    {% set unitResultEntry = craft.entries.section('results').authorId(cpdUser.id).relatedTo(unitEntry).status('live, expired').orderBy('dateCreated desc').one() %}
                                                    {# if no result set jobRoleComplete to false #}
                                                    {% if not unitResultEntry %}{% set jobRoleNoResult = jobRoleNoResult + 1 %}{% endif %}
                                                    {% set totalComments = unitResultEntry ? unitResultEntry.resultComments.count : 0 %}
                                                    {% set unreadComments = unitResultEntry ? craft.lantra.unreadComments(unitResultEntry) : 0 %}
                                                    {% if unitResultEntry %}
                                                        {% set existingResultIds = existingResultIds|merge([unitResultEntry.id]) %}
                                                    {% endif %}
                                                    {% if unitResultEntry and unitResultEntry.resultStatus == 'endorsed' %}
                                                        {% set totalPoints = totalPoints + unitEntry.unitValue %}
                                                    {% endif %}
                                                    <tr>
                                                        <td>
                                                            {% if readOnly %}
                                                                {{ unitEntry.title }}
                                                                {{ unitEntry['unitHeading'] is defined and unitEntry.unitHeading ? unitEntry.unitHeading : '' }}
                                                            {% else %}
                                                                <a href="/cpd/{{ cpdUser.id }}/{{ module.id }}/{{ unitEntry.id }}?ref=module{{ moduleElementId }}" >
                                                                    {{ unitEntry.title }}
                                                                    {{ unitEntry['unitHeading'] is defined and unitEntry.unitHeading ? unitEntry.unitHeading : '' }}
                                                                </a>
                                                            {% endif %}
                                                            <div class="cpd-icons">
                                                                <a href="#" data-tooltip title="{{ unitEntry.unitDescription|raw }}">
                                                                    <img src="/assets/img/files.svg" width="16" height="16" class="" alt="">
                                                                </a>
                                                                {% if not readOnly and unitResultEntry and craft.lantra.isManager(cpdUser.id) %}
                                                                    {% set managerDelete = unitResultEntry.resultOwner.count and unitResultEntry.resultOwner.one.id == currentUser.id %}
                                                                    {% set managerEndorse = craft.lantra.canEndorse(unitResultEntry) %}
                                                                    {% if currentUser.admin or currentUser.isInGroup('schemeManagers') or managerDelete %}
                                                                        <a class="action" href="#" data-ref="module{{ moduleElementId }}" data-action="entries/delete-entry" data-id="{{ unitResultEntry.id }}"
                                                                            data-tooltip title="Delete this result">
                                                                            <img src="/assets/img/delete.svg" width="16" height="16" class="" alt="">
                                                                        </a>
                                                                    {% endif %}
                                                                    {% if managerEndorse and unitResultEntry.resultStatus == 'pending' %}
                                                                        <a class="action" href="#" data-ref="module{{ moduleElementId }}" data-action="entries/endorse-evidence" data-id="{{ unitResultEntry.id }}"
                                                                        data-tooltip title="Endorse this result">
                                                                        <img src="/assets/img/endorse.svg" width="16" height="16" class="" alt=""></a>
                                                                    {% endif %}
                                                                {% endif %}
                                                                {% if totalComments %}
                                                                <div class="cpd-comment" data-tooltip title="Click the Unit title above to view comments">
                                                                    <div class="cpd-comment-number">
                                                                        <p>{{ totalComments }}</p>
                                                                    </div>
                                                                    <div class="cpd-comment-txt">
                                                                        comment{{ unreadComments != 1 ? 's' }}
                                                                    </div>
                                                                </div>
                                                                {% endif %}
                                                            </div>
                                                        </td>
                                                        {% include '_includes/columnLayout' with {
                                                            unitType: unitEntry.unitType,
                                                            unitValue: unitEntry.unitValue,
                                                            resultEntry: unitResultEntry,
                                                            columnLayout: moduleGroup.columnLayout,
                                                            isManager: isManager
                                                        } %}
                                                    </tr>
                                                {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                {% endfor %}
                                {# get user results related to module #}
                                {% set moduleUserResults = craft.entries.section('results').type('userResult').authorId(cpdUser.id).relatedTo(module.id).status('live, expired').limit(null) %}
                                {% if moduleUserResults|length %}
                                    {% set existingResultIds = existingResultIds|merge(moduleUserResults.ids()) %}
                                    <div class="unit-group">
                                        <div class="header" data-target="#u{{ role.id ~ module.id }}-user">
                                            <h5>My Achievements</h5>
                                            <div class="status">
                                                View status and Endorsements
                                                <img src="/assets/img/img-arrow-down-trans.png">
                                            </div>
                                        </div>
                                        <div id="u{{ role.id ~ module.id }}-user" class="units">
                                            <table class="data">
                                                <thead>
                                                <tr>
                                                    <th>Result title</th>
                                                    {% include '_includes/columnLayout' with {header:true, columnLayout:moduleGroup.columnLayout, isManager: isManager} %}
                                                </tr>
                                                </thead>
                                                <tbody>
                                                {% for userResultEntry in moduleUserResults %}
                                                    {% set totalComments = userResultEntry.resultComments.count %}
                                                    {% set unreadComments = craft.lantra.unreadComments(userResultEntry) %}
                                                    <tr>
                                                        <td>
                                                            {% if readOnly %}
                                                                {{ userResultEntry.title }}
                                                            {% else %}
                                                                <a href="/cpd/{{ cpdUser.id }}/result/{{ userResultEntry.id }}">
                                                                    {{ userResultEntry.title }}
                                                                </a>
                                                            {% endif %}
                                                            <div class="cpd-icons">
                                                            {% if not readOnly and userResultEntry and craft.lantra.isManager(cpdUser.id) %}
                                                                {% set managerDelete = userResultEntry.resultOwner.count and userResultEntry.resultOwner.one.id == currentUser.id %}
                                                                {% set managerEndorse = craft.lantra.canEndorse(userResultEntry) %}
                                                                {% if currentUser.admin or currentUser.isInGroup('schemeManagers') or managerDelete %}
                                                                    <a class="action" href="#" data-ref="module{{ moduleElementId }}" data-action="entries/delete-entry" data-id="{{ userResultEntry.id }}"
                                                                        data-tooltip title="Delete this result">
                                                                        <img src="/assets/img/delete.svg" width="16" height="16" class="" alt="">
                                                                    </a>
                                                                {% endif %}
                                                                {% if managerEndorse and userResultEntry.resultStatus == 'pending' %}
                                                                    <a class="action" href="#" data-ref="module{{ moduleElementId }}" data-action="entries/endorse-evidence" data-id="{{ userResultEntry.id }}"
                                                                    data-tooltip title="Endorse this result">
                                                                    <img src="/assets/img/endorse.svg" width="16" height="16" class="" alt=""></a>
                                                                {% endif %}
                                                            {% endif %}
                                                            {% if totalComments %}
                                                                <div class="cpd-comment" data-tooltip title="Click the Unit title above to view comments">
                                                                    <div class="cpd-comment-number">
                                                                        <p>{{ totalComments }}</p>
                                                                    </div>
                                                                    <div class="cpd-comment-txt">
                                                                        comment{{ unreadComments != 1 ? 's' }}
                                                                    </div>
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                        </td>
                                                        {% include '_includes/columnLayout' with {
                                                            unitType: 'evidence',
                                                            unitValue: userResultEntry.unitValue,
                                                            resultEntry :userResultEntry,
                                                            columnLayout:moduleGroup.columnLayout,
                                                            isManager: isManager
                                                        } %}
                                                    </tr>
                                                    {% if (userResultEntry.resultStatus == 'endorsed') %}
                                                        {% set totalPoints = totalPoints + userResultEntry.resultValue %}
                                                    {% endif %}
                                                {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                {% endif %}
                                {% if moduleGroup.addAchievement and not module.addAchievementHide and not readOnly %}
                                    <a class="button no-shadow primary-bg" href="/cpd/{{ cpdUser.id }}/achievement/{{ module.id }}">
                                        <span>Add</span>
                                    </a>
                                {% endif %}
                                <!--
                                <div class="summary">
                                    {% if module.resultDisplayValue %}
                                        <h3>Module Points: {{ totalPoints }}/{{ module.moduleCompletedValue }}</h3>
                                    {% endif %}
                                    <h3>Module Status: {% if moduleResultEntry %}Complete{% else %}In progress{% endif %}</h3>
                                    {% if moduleResultEntry %}
                                        <h3>Result Expires: {{ moduleResultEntry.expiryDate is empty ? "Never" : moduleResultEntry.expiryDate|date(dateFormat) }}</h3>
                                        {% if moduleResultEntry and not craft.lantra.setting('themeDisableCertificates') %}
                                            <h3><a href="/public/certificate/{{ cpdUser.id }}/{{ moduleResultEntry.id }}">Download Certificate</a></h3>
                                        {% endif %}
                                    {% endif %}
                                </div>
                                -->
                            </div>
                        </div>
                    {% endfor %}
                    </div>
                </div>
                {% endfor %}
            </section>
        {% endif %}
        </div>
        {% if jobRoleEndorse %}
            <p class="jobroleEndorse">
            {% if jobRoleNoResult == 0 %}
                <a class="action button no-shadow primary-bg" href="#" data-id="{{ role.id }}" data-ref="jobRole"
                   data-userid="{{ cpdUser.id }}" data-action="entries/pending-result">Submit for Endorsement</a>
            {% else %}
                Complete {{ jobRoleNoResult }} more unit(s) and then submit for endorsement.
            {% endif %}
            </p>
        {% endif %}
    </div>
    {% endfor %}
    {% if existingResultIds|length %}
        {# get all the results no longer related to existing job role #}
        {% set existingResultIdsString = existingResultIds | join(', not ') %}
        {% set resultArchive = craft.entries.section('results').type('userResult', 'unitResult').authorId(cpdUser.id).status('live, expired').id('and, not ' ~ existingResultIdsString) %}
    {% endif %}
{% endif %}
    </div>
    {% if not craft.lantra.setting('themeDisableResultHistory') and resultArchive|length %}
        {% include '_includes/resultArchive' with {resultEntries:resultArchive, isManager:isManager, readOnly:readOnly} %}
    {% endif %}
    <p style="text-align:right">
        {% if craft.lantra.setting('themeResultHistoryLink') and resultArchive|length %}
            <a class="button no-shadow primary-bg" href="/cpd/{{ cpdUser.id }}/archive">
                <span>{{ craft.lantra.setting('themeResultHistoryTitle', 'Result History') }}</span>
            </a>
        {% endif %}
        <a class="button no-shadow primary-bg" target="_blank" href="/cpd/{{ cpdUser.id }}/print">
            <span>Print Version</span>
        </a>
    </p>

</article>
