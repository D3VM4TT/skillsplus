{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set existingResultIds = [] %}
{% if cpdUser.userRole.total %}
    <article class="cpd">
        {% for role in cpdUser.userRole %}
            <h2>Job Role: {{ role.title }}</h2>
            {% set allModules = craft.entries.relatedTo(role).order('title') %}
            {% if not allModules|length %}
                <p>No modules have been assigned to this role.</p>
            {% else %}
                <div class="module-group-tabs">
                    <ul class="tabs clearfix" data-tabgroup="groups-tab-group">
                    {% set moduleGroups = craft.categories.group('moduleGroups').relatedTo({sourceElement: allModules, field: 'moduleGroup'}) %}
                    {% for moduleGroup in moduleGroups %}
                        <li>
                            <a href="#tab{{ moduleGroup.id }}" class="secondary-bg-hover">
                                <h4>{{ moduleGroup.title }}</h4>
                            </a>
                        </li>
                    {% endfor %}
                    </ul>
                </div>
                <section id="groups-tab-group" class="tabgroup">
                    {% for moduleGroup in moduleGroups %}
                    <div class="groups-tab-group" id="tab{{ moduleGroup.id }}">
                        <div class="module-tabs">
                            <ul class="tabs clearfix" data-tabgroup="tab-group-{{ moduleGroup.id }}">
                            {% set modules = craft.entries.relatedTo('and', {targetElement: role, field: 'moduleRoles'}, {targetElement: moduleGroup, field: 'moduleGroup'}).order('title') %}
                            {% for module in modules %}
                                {% set moduleResultEntry = craft.entries.section('results').type('moduleResult').authorId(cpdUser.id).relatedTo(module).resultStatus('complete').first() %}
                                <li>
                                    <a href="#module{{ module.id }}" class="module-status">
                                        {% if moduleResultEntry %}
                                            <span class="status-complete"></span>
                                        {% else %}
                                            <span class="status-inprogress"></span>
                                        {% endif %}
                                        {{ module.title }}
                                    </a>
                                </li>
                                {% if not loop.last and loop.index is divisible by(4) %}
                            </ul>
                            <ul class="module-links">
                                {% endif %}
                            {% endfor %}
                            </ul>
                        </div>
                        <div id="tab-group-{{ moduleGroup.id }}" class="tabgroup module-wrapper">
                        {% for module in modules %}
                            {% set moduleResultEntry = craft.entries.section('results').type('moduleResult').authorId(cpdUser.id).relatedTo(module).resultStatus('complete').first() %}
                            <div id="module{{ module.id }}" class="module open">
                                {% set totalPoints = 0 %}
                                <div class="header" data-target="#m{{ role.id ~ module.id }}">
                                    <h4>{{ module.title }}</h4>
                                    <div class="status module-status">
                                        {% if moduleResultEntry %}<span class="module-status-complete">Complete</span>{% else %}<span class="module-status-inprogress">In Progress</span>{% endif %}
                                    </div>
                                </div>
                                <div id="m{{ role.id ~ module.id }}" class="unit-groups">
                                    {% for unitGroup in module.moduleUnitGroups %}
                                        {% set unitGroupEntries = unitGroup.unitEntries %}
                                        <div class="unit-group">
                                            <div class="header" data-target="#u{{ role.id ~ module.id ~ unitGroup.id }}">
                                                <h5>{{ unitGroup.groupName|default('') }}&nbsp;</h5>
                                                <div class="status">
                                                    View status and Endorsements
                                                    <img src="/assets/img/img-arrow-down-trans.png">
                                                </div>
                                            </div>
                                            <div id="u{{ role.id ~ module.id ~ unitGroup.id }}" class="units open">
                                                <table class="data">
                                                    <thead>
                                                    <tr>
                                                        <th>Unit title</th>
                                                        {% for row in moduleGroup.columnLayout %}
                                                            <th>{{ row.fieldLabel|default(row.fieldType.label) }}</th>
                                                        {% endfor %}
                                                    </tr>
                                                    </thead>
                                                    <tbody>
                                                    {% for unitEntry in unitGroupEntries %}
                                                        {% set unitResultEntry = craft.entries.section('results').authorId(cpdUser.id).relatedTo(unitEntry).first() %}
                                                        {% if unitResultEntry %}
                                                            {% set existingResultIds = existingResultIds|merge([unitResultEntry.id]) %}
                                                        {% endif %}
                                                        {% if unitResultEntry and unitResultEntry.resultStatus == 'endorsed' %}
                                                            {% set totalPoints = totalPoints + unitEntry.unitValue %}
                                                        {% endif %}
                                                        <tr>
                                                            <td>
                                                                {% if craft.lantra.isManager(cpdUser.id) and unitResultEntry %}
                                                                    [<a class="action" href="#" data-action="lantra/entries/deleteEntry" data-id="{{ unitResultEntry.id }}">x</a>]
                                                                {% endif %}
                                                                <a href="/cpd/{{ module.id }}/unit/{{ unitEntry.id }}/user/{{ cpdUser.id }}" data-toggle="tooltip" title="{{ unitEntry.unitDescription|raw }}">{{ unitEntry.title }}</a>
                                                            </td>
                                                            {% for row in moduleGroup.columnLayout %}
                                                                {% if row.fieldType == 'unitType' %}
                                                                    <td class="unitType">{{ unitEntry.unitType == 'evidence' ? 'Evidence' : 'E-Learning' }}</td>
                                                                {% elseif row.fieldType == 'unitValue'  %}
                                                                    <td class="unitValue">{{ unitEntry.unitValue }}</td>
                                                                {% elseif row.fieldType == 'resultStatus'  %}
                                                                    <td class="resultStatus">{{ unitResultEntry ? unitResultEntry.resultStatus|ucwords|default('Incomplete') }}</td>
                                                                {% elseif row.fieldType == 'resultEndorsedDate'  %}
                                                                    <td class="resultEndorsedDate">{{ unitResultEntry and unitResultEntry.resultEndorsedDate ? unitResultEntry.resultEndorsedDate|date(dateFormat) : '-' }}</td>
                                                                {% elseif row.fieldType == 'resultExpiryDate'  %}
                                                                    <td class="expiryDate">{{ unitResultEntry and unitResultEntry.expiryDate ? unitResultEntry.expiryDate|date(dateFormat) : '-' }}</td>
                                                                {% elseif row.fieldType == 'resultStartDate'  %}
                                                                    <td class="resultStartDate">{{ unitResultEntry and unitResultEntry.resultStartDate ? unitResultEntry.resultStartDate|date(dateFormat) : '-' }}</td>
                                                                {% elseif row.fieldType == 'resultFinishDate'  %}
                                                                    <td class="resultFinishDate">{{ unitResultEntry and unitResultEntry.resultFinishDate ? unitResultEntry.resultFinishDate|date(dateFormat) : '-' }}</td>
                                                                {% elseif row.fieldType == 'resultLocation'  %}
                                                                    <td class="resultLocation">{{ unitResultEntry ? unitResultEntry.resultLocation|default('-') }}</td>
                                                                {% elseif row.fieldType == 'resultHours'  %}
                                                                    <td class="resultHours">{{ unitResultEntry ? unitResultEntry.resultHours|default('-') }}</td>
                                                                {% elseif row.fieldType == 'resultEvidence'  %}
                                                                    <td class="resultEvidence">
                                                                        {% if unitResultEntry and unitResultEntry.resultEvidence|length %}
                                                                            {% for resultEvidenceAsset in unitResultEntry.resultEvidence %}
                                                                                <a target="_blank" href="/internal/{{ resultEvidenceAsset.id }}">{{ resultEvidenceAsset.filename }}</a><br />
                                                                            {% endfor %}
                                                                        {% endif %}
                                                                        {{ unitResultEntry ? unitResultEntry.resultComments }}
                                                                    </td>
                                                                {% endif %}
                                                            {% endfor %}
                                                        </tr>
                                                    {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    {% endfor %}
                                    {# get user results related to module #}
                                    {% set moduleUserResults = craft.entries.section('results').type('userResult').authorId(cpdUser.id).relatedTo(module.id).limit(null) %}
                                    {% if moduleUserResults|length %}
                                        {% set existingResultIds = existingResultIds|merge(moduleUserResults.ids()) %}
                                        <div class="unit-group">
                                            <div class="header" data-target="#u{{ role.id ~ module.id }}-user">
                                                <h5>My Achievements</h5>
                                                <div class="status">
                                                    View status and Endorsements
                                                    <img src="/assets/img/img-arrow-down-trans.png">
                                                </div>
                                            </div>
                                            <div id="u{{ role.id ~ module.id }}-user" class="units closed">
                                                <table class="data">
                                                    <thead>
                                                    <tr>
                                                        <th>Result title</th>
                                                        {% for row in moduleGroup.columnLayout %}
                                                            <th>{{ row.fieldLabel|default(row.fieldType.label) }}</th>
                                                        {% endfor %}
                                                    </tr>
                                                    </thead>
                                                    <tbody>
                                                    {% for userResultEntry in moduleUserResults %}
                                                        <tr>
                                                            <td>
                                                                {% if craft.lantra.isManager(cpdUser.id) %}
                                                                    [<a class="action" href="#" data-action="lantra/entries/deleteEntry" data-id="{{ userResultEntry.id }}">x</a>]
                                                                {% endif %}
                                                                {{ userResultEntry.title }}
                                                            </td>
                                                            {% for row in moduleGroup.columnLayout %}
                                                                {% if row.fieldType == 'unitType' %}
                                                                    <td class="unitType">Evidence</td>
                                                                {% elseif row.fieldType == 'unitValue'  %}
                                                                    <td class="unitValue">{{ userResultEntry.unitValue }}</td>
                                                                {% elseif row.fieldType == 'resultStatus'  %}
                                                                    <td class="resultStatus">{{ userResultEntry.resultStatus|ucwords|default('Incomplete') }}</td>
                                                                {% elseif row.fieldType == 'resultEndorsedDate' %}
                                                                    <td class="resultEndorsedDate">{{ userResultEntry.resultEndorsedDate ? userResultEntry.resultEndorsedDate|date(dateFormat) : '-' }}</td>
                                                                {% elseif row.fieldType == 'resultExpiryDate'  %}
                                                                    <td class="expiryDate">{{ userResultEntry.expiryDate ? userResultEntry.expiryDate|date(dateFormat) : '-' }}</td>
                                                                {% elseif row.fieldType == 'resultStartDate'  %}
                                                                    <td class="resultStartDate">{{ userResultEntry.resultStartDate ? userResultEntry.resultStartDate|date(dateFormat) : '-'  }}</td>
                                                                {% elseif row.fieldType == 'resultFinishDate'  %}
                                                                    <td class="resultFinishDate">{{ userResultEntry.resultFinishDate ? userResultEntry.resultFinishDate|date(dateFormat) : '-'  }}</td>
                                                                {% elseif row.fieldType == 'resultLocation'  %}
                                                                    <td class="resultLocation">{{ userResultEntry.resultLocation|default('-') }}</td>
                                                                {% elseif row.fieldType == 'resultHours'  %}
                                                                    <td class="resultHours">{{ userResultEntry.resultHours|default('-') }}</td>
                                                                {% elseif row.fieldType == 'resultEvidence'  %}
                                                                    <td class="resultEvidence">
                                                                        {% if userResultEntry and userResultEntry.resultEvidence|length %}
                                                                            {% for resultEvidenceAsset in userResultEntry.resultEvidence %}
                                                                                <a target="_blank" href="/internal/{{ resultEvidenceAsset.id }}">{{ resultEvidenceAsset.filename }}</a><br />
                                                                            {% endfor %}
                                                                        {% endif %}
                                                                        {{ userResultEntry ? userResultEntry.resultComments }}
                                                                    </td>
                                                                {% endif %}
                                                            {% endfor %}
                                                        </tr>
                                                        {% if (userResultEntry.resultStatus == 'endorsed') %}
                                                            {% set totalPoints = totalPoints + userResultEntry.resultValue %}
                                                        {% endif %}
                                                    {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    {% endif %}
                                    {% if moduleGroup.addAchievement %}
                                        <a class="button no-shadow primary-bg" href="/cpd/achievement/module/{{ module.id }}/user/{{ cpdUser.id }}">
                                            <span>Add an achievement</span>
                                        </a>
                                    {% endif %}
                                    <div class="summary">
                                        {% if module.resultDisplayValue %}
                                            <h3>Module Points: {{ totalPoints }}/{{ module.moduleCompletedValue }}</h3>
                                        {% endif %}
                                        <h3>Module Status: {% if moduleResultEntry %}Complete{% else %}In progress{% endif %}</h3>
                                        {% if moduleResultEntry %}
                                            <h3>Result Expires: {{ moduleResultEntry.expiryDate is empty ? "Never" : moduleResultEntry.expiryDate|date(dateFormat) }}</h3>
                                            {% if moduleResultEntry %}
                                                <h3><a href="/public/certificate/{{ cpdUser.id }}/{{ moduleResultEntry.id }}">Download Certificate</a></h3>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </section>
            {% endif %}
        {% endfor %}
        {% set existingResultIdsString = existingResultIds | join(', not ') %}
        {% set enrelatedResults = craft.entries.section('results').type('userResult', 'unitResult').authorId(cpdUser.id).id('and, not ' ~ existingResultIdsString) %}
        {% if enrelatedResults|length %}
            <section id="archive">
                <h2>Result Archive</h2>
                {% for resultEntry in enrelatedResults %}
                    <article>
                        <p>{{ resultEntry.title }}</p>
                    </article>
                {% endfor %}
            </section>
        {% endif %}
    </article>
{% endif %}