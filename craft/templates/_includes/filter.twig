<form class="filter" action="">
    {% if filterDays %}
    <p>Show results {% if reportType == 'modules-expiring' or reportType == 'units-expiring' %}expiring{% else %}completed{% endif %} in:&#160;
    <span>
    <select name="days">
            <option value="1"{% if filterDays == '1' %} selected="selected"{% endif %}>a day</option>
            <option value="7"{% if filterDays == '7' %} selected="selected"{% endif %}>a week</option>
            <option value="28"{% if filterDays == '28' %} selected="selected"{% endif %}>four weeks</option>
            <option value="365"{% if filterDays == '365' %} selected="selected"{% endif %}>a year</option>
            <option value="all"{% if filterDays == 'all' %} selected="selected"{% endif %}>all time</option>
    </select>
    </span>
    </p>
    {% endif %}
    {% if filterHideSearch is not defined %}
        <input type="text" class="text-search" placeholder="search" name="search" value="{{ filterSearch }}" />
    {% endif %}
    {% if filterUserStatus is defined and filterUserStatus %}
        <select name="status" class="sp-select">
            <option value="active"{% if filterUserStatus == 'active' %} selected="selected"{% endif %}>Active Users</option>
            <option value="suspended"{% if filterUserStatus == 'suspended' %} selected="selected"{% endif %}>Suspended Users</option>
            <option value="orphaned"{% if filterUserStatus == 'orphaned' %} selected="selected"{% endif %}>Orphaned Users</option>
            <option value="all"{% if filterUserStatus == 'all' %} selected="selected"{% endif %}>All Users</option>
        </select>
    {% endif %}
    {% if filterPackage is defined and filterPackage %}
        <select name="filter" class="sp-select">
            {% set packageTypes = craft.lantra.packageTypes(currentUser, false) %}
            {% for type in packageTypes %}
                <option value="{{ type.name }}"{% if filterPackage == type.name %} selected="selected"{% endif %}>{{ type.name }}</option>
            {% endfor %}
            <option value="all"{% if filterPackage == 'all' %} selected="selected"{% endif %}>All Packages</option>
        </select>
    {% endif %}
    {% if filterExternalStatus is defined and filterExternalStatus %}
        <select name="filter" class="sp-select" style="width: 240px;">
            <option value="notSelected"{% if filterExternalStatus == 'notSelected' %} selected="selected"{% endif %}>Not Selected (complete)</option>
            <option value="selected"{% if filterExternalStatus == 'selected' %} selected="selected"{% endif %}>Selected</option>
            <option value="sampled"{% if filterExternalStatus == 'sampled' %} selected="selected"{% endif %}>Sampled</option>
            <option value="all"{% if filterExternalStatus == 'all' %} selected="selected"{% endif %}>All External</option>
        </select>
    {% endif %}
    {% if filterDateFrom is defined %}
        <input placeholder="Date From" value="{{ filterDateFrom }}" type="text" name="date-from" class="date-field date-search" />
        <input placeholder="Date To" value="{{ filterDateTo }}" type="text" name="date-to" class="date-field date-search" />
    {% endif %}
    {% if filterUnit is defined %}
        <select name="filterUnit" class="sp-select" style="width: 160px;">
            <option value="all"{% if filterUnit == 'all' %} selected="selected"{% endif %}>All Skills</option>
            {% for unitEntry in unitEntries %}
                <option value="{{ unitEntry.id }}"{% if filterUnit == unitEntry.id %} selected="selected"{% endif %}>{{ unitEntry.title }}</option>
            {% endfor %}
        </select>
    {% endif %}
    {% if filterMinSkill is defined and filterMaxSkill is defined %}
        {% set skillLevels = craft.categories.group('skillLevels').all %}
        <select name="filterMinSkill" class="sp-select" style="width: 160px;">
            <option value="none"{% if filterMinSkill == 'none' %} selected="selected"{% endif %}>Min Skill Level</option>
            {% for skillLevel in skillLevels %}
                <option value="{{ skillLevel.id }}"{% if filterMinSkill == skillLevel.id %} selected="selected"{% endif %}>{{ skillLevel.title }}</option>
            {% endfor %}
        </select>
        <select name="filterMaxSkill" class="sp-select" style="width: 160px;">
            <option value="none"{% if filterMaxSkill == 'none' %} selected="selected"{% endif %}>Max Skill Level</option>
            {% for skillLevel in skillLevels %}
                <option value="{{ skillLevel.id }}"{% if filterMaxSkill == skillLevel.id %} selected="selected"{% endif %}>{{ skillLevel.title }}</option>
            {% endfor %}
        </select>
    {% endif %}
    <button type="submit" class="btn-search primary-bg">Search</button>
    {% if filterCompany is defined %}
        <div style="margin-top:10px;">
            <select name="company" class="sp-select" style="width: 360px;">
                <option value="all"{% if filterCompany == 'all' %} selected="selected"{% endif %}>All companies</option>
                {% for company in currentUser.userExternalCompanies %}
                    <option value="{{ company.id }}"{% if filterCompany == company.id %} selected="selected"{% endif %}>{{ company.title }}</option>
                {% endfor %}
            </select>
        </div>
    {% endif %}
</form>