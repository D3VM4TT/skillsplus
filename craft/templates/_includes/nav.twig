<nav class="cpd">
    {% include '_includes/navUser' %}
    {% if craft.lantra.canManage() %}
        {% include '_includes/navManager' %}
    {% elseif craft.lantra.settingReports() %}
        <ul>
            {% include '_includes/navReports' %}
        </ul>
    {% elseif craft.lantra.packagesCount() %}
        {% include '_includes/navReviewer' %}
    {% endif %}

    {% set isExternal = craft.lantra.isExternal(currentUser) %}
    {% set reviewCount = craft.lantra.packagesCount() %}
    {% if craft.lantra.isLantraAdmin or reviewCount or isExternal %}
        <li class="{% if craft.app.request.getSegment(2) == 'taskbooks' %}nav-open{% else %}nav-closed{% endif %}">
            <a class="secondary-bg-hover" href="#">{{ taskbookLabel|pluralize }}</a>
            <ul>
                <li>
                    <a href="/management/taskbooks">All {{ taskbookLabel|pluralize }}</a>
                </li>
                {% set packageTypes = craft.lantra.packageTypes() %}
                {% for type in packageTypes %}
                    <li>
                        <a href="/management/taskbooks?filter={{ type.name }}">{{ type.name }}</a>
                    </li>
                {% endfor %}
                {% if craft.lantra.isExternal(currentUser) %}
                    <li>
                        <a href="/management/taskbooks/external">External</a>
                    </li>
                {% endif %}

            </ul>
        </li>
    {% endif %}

    {% include '_includes/navLinks' %}
</nav>
