{% set schemeLogo = craft.lantra.setting('schemeLogo') %}
    <div class="container-sidebar">
    {% if not currentUser %}
        <div class="sidebar-form">
        <div class="scheme-logo">
        <a href="/">
            {% if schemeLogo %}
                <img src="{{ schemeLogo.url }}">
            {% else %}
                {{ craft.lantra.setting('schemeName') }}
            {% endif %}
        </a>
        </div>
        <div class="container-form-toggle center">
            {% include '_forms/login_combined' %}
            {#
            <div class="container-create-account-btn center">
                <div class="sml-link center">
                    <p>Not registered?</p>
                </div>
                <button class="button hollow secondary-bg"><a href="/public/register">Create account</a></button>
            </div>
            #}
        </div>
        </div>
    {% endif %}
    {% if currentUser %}
    <div class="sidebar-form">
        <div class="scheme-logo">
            <a href="/">
                {% if schemeLogo %}
                    <img src="{{ schemeLogo.url }}">
                {% else %}
                    {{ craft.lantra.setting('schemeName') }}
                {% endif %}
            </a>
        </div>
    </div>
    {% include '_includes/nav_cpd' %}
    {% endif %}
    </div>
