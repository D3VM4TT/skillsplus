{% set schemeLogo = craft.lantra.setting('schemeLogo') %}
{% if not currentUser %}
    <div class="sidebar-form">
        <div class="scheme-logo">
            <a href="/">
                {% if schemeLogo %}
                    <img src="{{ schemeLogo.url }}">
                {% else %}
                    {{ craft.lantra.setting('schemeName') }}
                {% endif %}
            </a>
        </div>
        <div class="container-form-toggle center">
            {% include '_forms/login_combined' %}
        </div>
    </div>
{% endif %}
