{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set primaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: cpdUser, field: 'companyPrimaryManagers'}).limit(null) %}
{% set secondaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: cpdUser, field: 'companySecondaryManagers'}).limit(null) %}
{% set managerCompanies = primaryManagerCompanies|merge(secondaryManagerCompanies) %}
{% set accountSettings = craft.lantra.setting('userAccountInformation') %}
<div id="account-details-expand" class="acc-info">
    <div class="col-3">
        {% if accountSettings.userId is defined and accountSettings.userId %}
        <div class="col-pd-btm">
            <h5 class="primary-color">Account ID:</h5>
            <p class="link-bold">{{ cpdUser.id }}</p>
        </div>
        {% endif %}
        {% if accountSettings.startDate is defined and accountSettings.startDate %}
            <h5 class="primary-color">Start Date:</h5>
            <p class="link-bold">{{ cpdUser.userStartDate|date(dateFormat) }}</p>
        {% endif %}
    </div>
    <div class="col-9">
        {% if accountSettings.userCompany is defined and accountSettings.userCompany %}
            {% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
            {% if cpdUser.userCompany|length %}
                <h5 class="primary-color">User Company:</h5>
                <p class="link-bold">{{ craft.lantra.companyLabel(cpdUser.userCompany.first) }}</p>
            {% endif %}
        {% endif %}
        {% if accountSettings.managerCompanies is defined and accountSettings.managerCompanies %}
            {% if managerCompanies|length %}
                <h5 class="primary-color">Manager {{ managerCompanies|length == 1 ? 'Company' : 'Companies' }}:</h5>
                {% for company in managerCompanies %}
                    {{ company.title }}{{ not loop.last ? ', ' }}
                {% endfor %}
            {% endif %}
        {% endif %}
    </div>
</div>
<div class="link-toggle">
    <a class="link-toggle-expand show" href="#"><img src="/assets/img/img-arrow-down-trans.png"></a>
    <a class="link-toggle-collapse hide" href="#"><img src="/assets/img/img-arrow-up-trans.png"></a>
</div>
<div class="account-details-toggle">
    <p class="link-bold link-expand show">Expand account information</p>
    <p class="link-bold link-collapse hide">Collapse account information</p>
</div>


