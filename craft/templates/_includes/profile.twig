{% set currentUserCompany = craft.lantra.userCompany() %}
<section class="my-profile" style="padding:20px;">
    <p>
        <strong>My Profile</strong><br />
        <span class="label" style="display:inline-block;width:50%;">Name:</span> {{ currentUser.fullName }}<br />
        <span class="label" style="display:inline-block;width:50%">Email address:</span> {{ currentUser.email }}<br />
        <span class="label" style="display:inline-block;width:50%;">User type:</span> {{ craft.lantra.userType() }}<br />
        <span class="label" style="display:inline-block;width:50%;">Company:</span> {{ craft.lantra.userCompany()|default('~') }}<br />
        <span class="label" style="display:inline-block;width:50%;">Job Role:</span>
        {% if currentUser.userRole.total %}
            {% for role in currentUser.userRole %}{{ role.title }}{% if loop.index != loop.length %}, {% endif %}{% endfor %}
        {% else %}
            ~
        {% endif %}
    </p>
</section>