<table class="data">
    <thead>
    <tr>
        <th>Title</th>
        <th>Cost</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    {% for categoryGroup in availableTaskbookGroups %}
        <tr>
            <td>{{ categoryGroup.title }}</td>
            <td>£{{ categoryGroup.moduleSingleCost }}</td>
            <td style="text-align: right;"><a href="/cpd/{{ cpdUser.id }}/taskbooks/single?type=optional&taskbookGroupId={{ categoryGroup.id }}">Buy Now</a></td>
        </tr>
    {% endfor %}
    </tbody>
</table>
