{% set taskbookLabel = craft.lantra.setting('taskbookLabel', 'Taskbook') %}
<ul>
    <li class="{% if craft.app.request.getSegment(1) == 'management' %}nav-open{% else %}nav-closed{% endif %}">
        <a class="secondary-bg-hover" href="#">Management</a>
        <ul>
            {% if craft.lantra.canManage(null, true) %}
                <li>
                    <a class="{% if craft.app.request.getSegment(2) == 'scheme' %}active{% endif %}" href="/management/scheme">Scheme</a>
                </li>
            {% endif %}
            <li>
                <a class="{% if craft.app.request.getSegment(2) == 'hierarchy' %}active{% endif %}" href="/management/hierarchy">Hierarchy</a>
            </li>
            {% if craft.lantra.can('editCompanies') %}
                <li>
                    <a class="{% if craft.app.request.getSegment(2) == 'companies' %}active{% endif %}" href="/management/companies">Companies</a>
                </li>
            {%  endif %}
            {% if craft.lantra.setting('schemeTeams', false) and craft.lantra.can('editTeams') %}
                <li>
                    <a class="{% if craft.app.request.getSegment(2) == 'teams' %}active{% endif %}" href="/management/teams">Teams</a>
                </li>
            {%  endif %}
            {% if craft.lantra.can('editUsers') %}
                <li>
                    <a class="{% if craft.app.request.getSegment(2) == 'users' %}active{% endif %}" href="/management/users">Users</a>
                </li>
            {% endif %}
            {% if craft.lantra.can('editModules') %}
                <li>
                    <a class="{% if craft.app.request.getSegment(2) == 'modules' %}active{% endif %}" href="/management/modules">Roles / Modules</a>
                </li>
            {%  endif %}
        </ul>
    </li>
    {% if craft.lantra.settingReports() %}
        {% include '_includes/navReports' %}
    {% endif %}
    {% if alias('@site') != 'poultrypassport' %}
        {% set pendingEndorsementCount = craft.lantra.managerCountEndorsementUsers() %}
        {% if not currentUser.managerReadOnly %}
            <li class="{% if craft.app.request.getSegment(2) == 'endorsements' %}nav-open{% else %}nav-closed{% endif %}">
                <a class="secondary-bg-hover" href="#">Endorsements ({{ pendingEndorsementCount }})</a>
                <ul>
                    <li>
                        <a href="/management/endorsements">All Members</a>
                    </li>
                    <li>
                        <a href="/management/endorsements?direct=true">My Direct Members</a>
                    </li>
                </ul>
            </li>
        {% endif %}
        {% if craft.lantra.isLantraAdmin or (craft.lantra.can('editTaskbooks') and craft.lantra.packagesCount()) %}
            <li class="{% if craft.app.request.getSegment(2) == 'taskbooks' %}nav-open{% else %}nav-closed{% endif %}">
                <a class="secondary-bg-hover" href="#">{{ taskbookLabel|pluralize }}</a>
                <ul>
                    <li>
                        <a href="/management/taskbooks">All {{ taskbookLabel|pluralize }}</a>
                    </li>
                    {% set packageTypes = craft.lantra.packageTypes() %}
                    {% for type in packageTypes %}
                        <li>
                            <a href="/management/taskbooks?filter={{ type.name }}">{{ type.name }}</a>
                        </li>
                    {% endfor %}
                    {% if craft.lantra.isExternal(currentUser) %}
                        <li>
                            <a href="/management/taskbooks/external">External ({{ craft.lantra.packagesCount('external')  }})</a>
                        </li>
                    {% endif %}

                </ul>
            </li>
        {% endif %}

    {% endif %}
</ul>