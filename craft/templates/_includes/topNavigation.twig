{% if not currentUser %}
<nav class="topNavigation">
<div id="toggle">
  <div class="one"></div>
  <div class="two"></div>
  <div class="three"></div>
</div>
<div id="menu">
<ul>
{% for pageEntry in craft.lantra.setting('themeNavigationPublic') %}
<li>
<a class="" href="{{ pageEntry.getUrl() }}">{{ pageEntry.title }}</a>
</li>
{% endfor %}
</ul>
</div>
{% endif %}

{% if currentUser %}
  {% if isTaskbooks is defined and isTaskbooks %}
    {% set taskbookLabel = craft.lantra.setting('taskbookLabel', 'Taskbook') %}
    {% set account = account is defined ? account : currentUser %}
      {% if account.id == currentUser.id %}
        <a class="link-bold" href="/cpd/{{ account.id }}/taskbooks">My {{ taskbookLabel|pluralize }}</a>
      {% endif %}
    {% else %}
  <a class="link-bold" href="/">My Dashboard</a>
{% endif %}
<a class="link-bold" href="{{ logoutUrl }}" style=float:right;>Sign out</a>
{#
<nav class="topNavigation secondary-bg">
<div id="toggle">
