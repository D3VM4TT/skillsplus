{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
<article class="administrator-tools">
<h2>Administrator tools</h2>
{% if currentUser.can('editEntries:3') or currentUser.can('editEntries:5') or currentUser.can('editUsers') %}
    <section class="row text-center admin">
        {% if currentUser.can('editEntries:3') %}
        <div class="col-2">
            <img src="/assets/img/tool-company-management.svg" width="150" height="150" class="" alt="">
            <h3>Company Management</h3>
            <div class="text-muted">
                <a href="/management/companies">Edit and create companies</a>
            </div>
        </div>
        {% endif %}
        {% if craft.lantra.setting('schemeTeams', false) and currentUser.can('editEntries:5') %}
        <div class="col-2">
            <img src="/assets/img/tool-team-management.svg" width="150" height="150" class="" alt="">
            <h3>Team Management</h3>
            <div class="text-muted">
                <a href="/management/teams">Edit and create teams</a>
            </div>
        </div>
        {% endif %}
        {% if currentUser.can('editUsers') %}
        <div class="col-2">
            <img src="/assets/img/tool-hierarchy-management.svg" width="150" height="150" class="" alt="">
            <h3>Hierarchy Management</h3>
            <div class="text-muted">
                <a href="/management/hierarchy">Manage scheme hierarchy</a>
            </div>
        </div>
        {% endif %}
        {% if currentUser.can('editCategories:1') or currentUser.can('editEntries:6') or currentUser.can('editEntries:7') %}

    {% if currentUser.can('editCategories(1)') %}
    <div class="col-2">
        <img src="/assets/img/tool-job-role-management.svg" width="150" height="150" class="" alt="">
        <h3>Job Role Management</h3>
        <div class="text-muted">
            <a href="/management/roles">Edit and create Job Roles</a>
        </div>
    </div>
    {% endif %}
    {% if currentUser.can('editEntries:6') %}
    <div class="col-2">
        <img src="/assets/img/tool-modules-management.svg" width="150" height="150" class="" alt="">
        <h3>Modules Management</h3>
        <div class="text-muted">
            <a href="/management/modules">Assign job roles to modules</a>
        </div>
    </div>
    {% endif %}
    <div class="col-2">
        <img src="/assets/img/tool-reporting-management.svg" width="150" height="150" class="" alt="">
        <h3>Reporting</h3>
        <div class="text-muted">
            <a href="/reporting">View reports</a>
        </div>
    </div>
    </section>
{% endif %}



</article>
{% endif %}
</article>