        <div class="text-muted">
            <a href="/management/roles">Edit and create Job Roles</a>
        </div>
    </div>
    {% endif %}
    {% if currentUser.can('editEntries:e9e30b72-2c16-4035-b4b9-e1e4c42ebb3a') %}
    <div class="col-2">
        <img src="/assets/img/tool-modules-management.svg" width="150" height="150" class="" alt="">
        <h3>Modules Management</h3>
        <div class="text-muted">
            <a href="/management/modules">Assign job roles to modules</a>
        </div>
    </div>
    {% endif %}
    <div class="col-2">
        <img src="/assets/img/tool-reporting-management.svg" width="150" height="150" class="" alt="">
        <h3>Reporting</h3>
        <div class="text-muted">
            <a href="/reporting">View reports</a>
        </div>
    </div>
