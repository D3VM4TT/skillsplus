            <div class="text-muted">
                <a href="/management/teams">Edit and create teams</a>
            </div>
        </div>
        {% endif %}
        {% if currentUser.can('editUsers') %}
        <div class="col-2">
            <img src="/assets/img/tool-hierarchy-management.svg" width="150" height="150" class="" alt="">
            <h3>Hierarchy Management</h3>
            <div class="text-muted">
                <a href="/management/hierarchy">Manage scheme hierarchy</a>
            </div>
        </div>
        {% endif %}
        {% if currentUser.can('editCategories:d83da856-af9d-458e-8b34-08ff74c012b5') or currentUser.can('editEntries:e9e30b72-2c16-4035-b4b9-e1e4c42ebb3a') or currentUser.can('editEntries:090b3c24-a9ac-4935-a919-c4fc8a3099b0') %}

    {% if currentUser.can('editCategories(1)') %}
