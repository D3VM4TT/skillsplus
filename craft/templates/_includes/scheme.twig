{% set usersAll = craft.users.group('users, teamManagers, companyManagers, schemeManagers').status(null).total() %}
{% set usersActive = craft.users.group('users, teamManagers, companyManagers, schemeManagers').status('active').total() %}
{% set licencesCompany = craft.lantra.totalCompanyLicences() %}
{% set licencesScheme = globalsScheme.schemeRemainingLicences|default(0) %}
{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
<h2>Scheme Profile</h2>
<p class="profile">
    <span class="label">Scheme Name:</span> {{ globalsScheme.schemeName|default('unknown') }}<br />
    <span class="label">Scheme Renewal Date:</span> {{ globalsScheme.schemeExpiryDate|date(dateFormat) }}<br />
    <span class="label">Active Users (inc. Managers):</span> {{ usersActive }}<br />
    <span class="label">Inactive users:</span> {{ usersAll - usersActive }}<br />
    <span class="label">Scheme Licences:</span>{{ licencesScheme }}<br />
    <span class="label">Company Licences:</span> {{ licencesCompany }}<br />
    <span class="label">Total Remaining:</span> {{ licencesScheme + licencesCompany }}
</p>