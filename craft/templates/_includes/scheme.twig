            <img src="/assets/img/tool-company-management.svg" width="150" height="150" class="" alt="">
            <h3>Company Management</h3>
            <div class="text-muted">
                <a href="/management/companies">Edit and create companies</a>
            </div>
        </div>
        {% endif %}
        {% if craft.lantra.setting('schemeTeams', false) and currentUser.can('editEntries:bcf0ea1d-9495-423e-ac83-ef089790460c') %}
        <div class="col-2">
            <img src="/assets/img/tool-team-management.svg" width="150" height="150" class="" alt="">
