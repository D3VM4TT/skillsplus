{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
<article class="administrator-tools">
<h2>Administrator tools</h2>
{% if currentUser.can('editEntries:86faf121-d218-4348-8ab8-de457b46aa63') or currentUser.can('editEntries:bcf0ea1d-9495-423e-ac83-ef089790460c') or currentUser.can('editUsers') %}
    <section class="row text-center admin">
        {% if currentUser.can('editEntries:86faf121-d218-4348-8ab8-de457b46aa63') %}
