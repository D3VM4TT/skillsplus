<!DOCTYPE html>
<html>
<head>
    <title></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <style>
        @font-face {
            src: url("/assets/fonts/OpenSans-Regular.ttf") format("truetype");
            font-family: "Open Sans";
            font-weight: normal;
            font-style: normal;
        }

        @font-face {
            src: url("/assets/fonts/OpenSans-Bold.ttf") format("truetype");
            font-family: "Open Sans";
            font-weight: bold;
            font-style: normal;
        }

        @page {
            margin: 0;
        }

        html {
            margin: 0;
        }

        html, body {
            color: #000;
            font-family: "Open Sans", sans-serif;
        }

        body {
            margin:30px;
            padding:30px;
            border:2px solid {{ craft.lantra.setting('themeColorSecondary') }};
        }
        header, footer, section#main {
            text-align: center;
        }

        header {
            padding-top: 5%;
            padding-bottom:0;
        }

        header img {
            max-height: 150px;
            margin:0;
        }

        header h2 {
            margin:0;
            font-size: 50px;
            color: {{ craft.lantra.setting('themeColorPrimary') }}
        }

        footer {
            position: absolute;
            width: 100%;
            bottom: 0;
        }

        footer p {
            font-size: small;
            margin: 0;
            padding: 0;
        }
    </style>
</head>
<body>
<header>
    {% if certLogo %}
        <img src="{{ certLogo.url|trim('/', 'left') }}">
    {% endif %}
    <h2>{{ certHeader }}</h2>
    {% if certSubheader %}
        <h3>{{ certSubheader }}</h3>
    {% endif %}
</header>
<section id="main">
    <h1>{{ certFullName }}</h1>
    <p>{{ certTextOne }}</p>
    <h2>{{ certTitle }}</h2>
    <p>{{ certTextTwo }}</p>
    <h2>{{ certDate }}</h2>
</section>
<footer>
    {% if certFooter %}
        <h3>{{ certFooter }}</h3>
    {% endif %}
</footer>
</body>
</html>
