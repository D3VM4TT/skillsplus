{% if cpdUser.hasLinkedUsers %}
    <div>
        <select data-user="{{ userId }}" id="switchUser" name="switchUser">
            {% for user in cpdUser.allUsers %}
                {% set linkedCompany = user.userCompany.one %}
                <option {% if user.id == userId %}selected="selected"{% endif %}
                        value="{{ user.id }}">{{ linkedCompany.title }}
                </option>
            {% endfor %}
        </select>
    </div>
{% endif %}