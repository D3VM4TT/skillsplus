{% if cpdUser.hasSwitchUsers %}
    <div style="margin-bottom:20px;">
        <select data-user="{{ cpdUser.id }}" {% if redirect is defined %}data-redirect="{{ redirect }}"{% endif %} id="switchUser" name="switchUser">
            {% for user in cpdUser.switchUsers %}
                {% set linkedCompany = user.userCompany.one %}
                <option {% if user.id == cpdUser.id %}selected="selected"{% endif %}
                        value="{{ user.id }}">{{ linkedCompany.title }}{% if user.id == cpdUser.primaryUser.id %} [primary]{% endif %}
                </option>
            {% endfor %}
        </select>
    </div>
{% endif %}
