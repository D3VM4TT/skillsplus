{% if package.packageReviews|length %}
    <table class="data">
        <thead>
        <tr>
            <th>Step</th>
            <th>Passed</th>
            <th>Comment</th>
            <th>Date</th>
            {% if admin %}
                <th>User</th>
            {% endif %}
        </tr>
        </thead>
        <tbody>
        {% for step in package.packageReviews %}
            {% set user = step.reviewUser ? step.reviewUser.one %}
            <tr>
                <td>{{ step.reviewStepName }}</td>
                <td>{{ step.reviewDate ? (step.reviewPassed ? 'yes' : 'no') : '' }}</td>
                <td>{{ step.reviewDate ? step.reviewDate|date('d/m/y') }}</td>
                <th>{{ step.reviewComment }}</th>
                {% if admin %}
                    <td>{{ user ? user.fullName }}</td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
