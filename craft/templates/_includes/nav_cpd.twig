<nav class="cpd">
    <ul>
        <li>
            <a class="secondary-bg-hover" href="/">My Dashboard</a>
        </li>
        <li>
            <a class="secondary-bg-hover" href="/public/passport/{{ currentUser.id }}">My Passport</a>
        </li>
        <li>
            <a class="secondary-bg-hover" href="/cpd/qualifications">My Qualifications</a>
        </li>
    </ul>
    {% if craft.lantra.canManage() %}
    <ul>
        <li class="nav-closed">
            <a class="secondary-bg-hover" href="#">Management</a>
            <ul>
                <li><a href="/management/hierarchy">Hierarchy</a></li>
                {% if currentUser.can('editEntries:3') %}
                    <li><a href="/management/companies">Companies</a></li>
                {%  endif %}
                {% if globalsScheme.schemeTeams|default(false) and currentUser.can('editEntries:5') %}
                    <li><a href="/management/teams">Teams</a></li>
                {%  endif %}
                {% if currentUser.can('editCategories:1') %}
                    <li><a href="/management/roles">Roles</a></li>
                {%  endif %}
                {% if currentUser.can('editEntries:6') %}
                    <li><a href="/management/modules">Module Roles</a></li>
                {%  endif %}
                {% if currentUser.can('editUsers') %}
                    <li><a href="/management/users">Users</a></li>
                {%  endif %}
            </ul>
        </li>
        <li class="nav-closed">
            <a class="secondary-bg-hover" href="#">Reporting</a>
            <ul>
                {% if currentUser.can('editEntries:13') %}
                    <li><a href="/management/reports">Custom Reports</a></li>
                {%  endif %}
                <li><a href="/reporting/users">Users Report</a></li>
                <li><a href="/reporting/modules-expiring">Modules Expiring Report</a></li>
                <li><a href="/reporting/modules-completed">Modules Completed Report</a></li>
                <li><a href="/reporting/modules-active">Modules Active Report</a></li>
                <li><a href="/reporting/units-blocked">Units Blocked Report</a></li>
                <li><a href="/reporting/units-endorsed">Units Endorsed Report</a></li>
                <li><a href="/reporting/units-expiring">Units Expiring Report</a></li>
            </ul>
        </li>
        {% set pendingEntryCount = craft.lantra.managerEndorsementResults(null, null, true) %}
        {% if (pendingEntryCount) %}
            <li class="secondary-bg-hover">
                <a href="/management/endorsements">Endorsements ({{ pendingEntryCount }})</a>
            </li>
        {% endif %}
    </ul>
    {% endif %}
    <ul>
        <li>
            <strong><a class="secondary-bg-hover" href="{{ logoutUrl }}">Sign out</a></strong>
        </li>
    </ul>
</nav>
