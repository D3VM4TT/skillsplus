<nav class="cpd">
    <ul>
        <li>
            <a class="secondary-bg-hover" href="/">My Dashboard</a>
        </li>
        {#<li><a class="secondary-bg-hover" href="/cpd/achievements">My Achievements</a></li>#}
        <li>
            {#<a class="secondary-bg-hover" href="/public/passport/{{ currentUser.id }}">My Passport</a>#}
        </li>
        <li>
            <a class="secondary-bg-hover" href="/profile">My Profile</a>
        </li>
    </ul>
    {% if craft.lantra.canManage() %}
    <ul>
        <li class="{% if craft.request.getSegment(1) == 'management' %}nav-open{% else %}nav-closed{% endif %}">
            <a class="secondary-bg-hover" href="#">Management</a>
            <ul>
                {% if craft.lantra.canManage(null, true) %}
                <li>
                    <a class="{% if craft.request.getSegment(2) == 'scheme' %}active{% endif %}" href="/management/scheme">Scheme</a>
                </li>
                {% endif %}
                <li>
                    <a class="{% if craft.request.getSegment(2) == 'hierarchy' %}active{% endif %}" href="/management/hierarchy">Hierarchy</a>
                </li>
                {% if currentUser.can('editEntries:3') %}
                    <li>
                        <a class="{% if craft.request.getSegment(2) == 'companies' %}active{% endif %}" href="/management/companies">Companies</a>
                    </li>
                {%  endif %}
                {% if globalsScheme.schemeTeams|default(false) and currentUser.can('editEntries:5') %}
                    <li>
                        <a class="{% if craft.request.getSegment(2) == 'teams' %}active{% endif %}" href="/management/teams">Teams</a>
                    </li>
                {%  endif %}
                {% if currentUser.can('editUsers') %}
                <li>
                <a class="{% if craft.request.getSegment(2) == 'users' %}active{% endif %}" href="/management/users">Users</a>
                </li>
                {%  endif %}
                {#
                {% if currentUser.can('editCategories:1') %}
                    <li>
                        <a class="{% if craft.request.getSegment(2) == 'roles' %}active{% endif %}" href="/management/roles">Roles</a>
                    </li>
                {%  endif %}
                #}
                {% if currentUser.can('editEntries:6') %}
                    <li>
                        <a class="{% if craft.request.getSegment(2) == 'modules' %}active{% endif %}" href="/management/modules">Roles / Modules</a>
                    </li>
                {%  endif %}
            </ul>
        </li>
        <li class="{% if craft.request.getSegment(1) == 'reporting' %}nav-open{% else %}nav-closed{% endif %}">
            <a class="secondary-bg-hover" href="#">Reporting</a>
            <ul>
                {% if currentUser.can('editEntries:13') %}
                    <li>
                        <a class="{% if craft.request.getSegment(2) == 'custom' %}active{% endif %}" href="/reporting/custom">Custom Reports</a>
                    </li>
                {%  endif %}
                <li>
                    <a class="{% if craft.request.getSegment(2) == 'users' %}active{% endif %}" href="/reporting/users">Users Report</a>
                </li>
                <li>
                    <a class="{% if craft.request.getSegment(2) == 'modules-expiring' %}active{% endif %}" href="/reporting/modules-expiring">Modules Expiring Report</a>
                </li>
                <li>
                    <a class="{% if craft.request.getSegment(2) == 'modules-completed' %}active{% endif %}" href="/reporting/modules-completed">Modules Completed Report</a>
                </li>
                <li>
                    <a class="{% if craft.request.getSegment(2) == 'modules-active' %}active{% endif %}" href="/reporting/modules-active">Modules Active Report</a>
                </li>
                <li>
                    <a class="{% if craft.request.getSegment(2) == 'units-blocked' %}active{% endif %}" href="/reporting/units-blocked">Units Blocked Report</a>
                </li>
                <li>
                    <a class="{% if craft.request.getSegment(2) == 'units-endorsed' %}active{% endif %}" href="/reporting/units-endorsed">Units Endorsed Report</a>
                </li>
                <li>
                    <a class="{% if craft.request.getSegment(2) == 'units-expiring' %}active{% endif %}" href="/reporting/units-expiring">Units Expiring Report</a>
                </li>
            </ul>
        </li>
        {% set pendingEntryCount = craft.lantra.managerEndorsementResults(null, null, true) %}
        {% if (pendingEntryCount) %}
            <li class="secondary-bg-hover">
                <a href="/management/endorsements">Endorsements ({{ pendingEntryCount }})</a>
            </li>
        {% endif %}
    </ul>
    {% endif %}

</nav>
