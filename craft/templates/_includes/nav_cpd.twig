<nav class="cpd">
    <ul>
        <li>
            <a href="/">My Dashboard</a>
        </li><li>
            <a href="/public/passport/{{ currentUser.id }}">My Passport</a>
        </li>
        <li>
            <a href="/cpd/qualifications">My Qualifications</a>
        </li>
    </ul>
    {% if craft.lantra.canManage() %}
    <ul>
        <li class="nav-closed">
            <a href="#">Management</a>
            <ul>
                <li><a href="/management/hierarchy" class="nav-link">Hierarchy</a></li>
                {% if currentUser.can('editEntries:3') %}
                    <li><a href="/management/companies" class="nav-link">Companies</a></li>
                {%  endif %}
                {% if globalsScheme.schemeTeams|default(false) and currentUser.can('editEntries:5') %}
                    <li><a href="/management/teams" class="nav-link">Teams</a></li>
                {%  endif %}
                {% if currentUser.can('editCategories:1') %}
                    <li><a href="/management/roles" class="nav-link">Roles</a></li>
                {%  endif %}
                {% if currentUser.can('editEntries:6') %}
                    <li><a href="/management/modules" class="nav-link">Module Roles</a></li>
                {%  endif %}
                {% if currentUser.can('editUsers') %}
                    <li><a href="/management/users" class="nav-link">Users</a></li>
                {%  endif %}
            </ul>
        </li>
        <li class="nav-closed">
            <a href="#">Reporting</a>
            <ul>
                {% if currentUser.can('editEntries:13') %}
                    <li><a href="/management/reports" class="nav-link">Custom Reports</a></li>
                {%  endif %}
                <li><a href="/reporting/users" class="nav-link">Users Report</a></li>
                <li><a href="/reporting/modules-expiring" class="nav-link">Modules Expiring Report</a></li>
                <li><a href="/reporting/modules-completed" class="nav-link">Modules Completed Report</a></li>
                <li><a href="/reporting/modules-active" class="nav-link">Modules Active Report</a></li>
                <li><a href="/reporting/units-blocked" class="nav-link">Units Blocked Report</a></li>
                <li><a href="/reporting/units-endorsed" class="nav-link">Units Endorsed Report</a></li>
                <li><a href="/reporting/units-expiring" class="nav-link">Units Expiring Report</a></li>
            </ul>
        </li>
        {% set pendingEntryCount = craft.lantra.managerEndorsementResults(null, null, true) %}
        {% if (pendingEntryCount) %}
            <li>
                <a href="/management/endorsements">Endorsements ({{ pendingEntryCount }})</a>
            </li>
        {% endif %}
    </ul>
    {% endif %}
    <ul>
        <li class="sign-out">
            <strong><a href="{{ logoutUrl }}">Sign out</a></strong>
        </li>
    </ul>
</nav>
