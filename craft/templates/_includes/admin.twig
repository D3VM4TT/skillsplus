<article class="administrator-tools">
<h2>Administrator tools</h2>
{% if craft.lantra.can('editCompanies') or craft.lantra.can('editTeams') or craft.lantra.can('editUsers') %}
    <section class="row text-center admin">
        {% if craft.lantra.can('editCompanies') %}
        <div class="col-2">
            <img src="/assets/img/img-company-management.jpg" width="150" height="150" class="" alt="">
            <h3>Company Management</h3>
            <div class="text-muted">
                <a href="/management/companies">Edit and create companies</a>
            </div>
        </div>
        {% endif %}
        {% if craft.lantra.setting('schemeTeams', false) and craft.lantra.can('editTeams') %}
        <div class="col-2">
            <img src="/assets/img/img-team-management.jpg" width="150" height="150" class="" alt="">
            <h3>Team Management</h3>
            <div class="text-muted">
                <a href="/management/teams">Edit and create teams</a>
            </div>
        </div>
        {% endif %}
        {% if craft.lantra.can('editUsers') %}
        <div class="col-2">
            <img src="/assets/img/img-user-management.jpg" width="150" height="150" class="" alt="">
            <h3>User Management</h3>
            <div class="text-muted">
                <a href="/management/users">Edit and create users</a>
            </div>
        </div>
        {% endif %}
    </section>
{% endif %}

{% if craft.lantra.can('editRoles') or craft.lantra.can('editModules') or craft.lantra.can('editReports') %}
<section class="row text-center admin">
    {% if craft.lantra.can('editRoles') %}
    <div class="col-2">
        <img src="/assets/img/img-job-role-management.jpg" width="150" height="150" class="" alt="">
        <h3>Job Role Management</h3>
        <div class="text-muted">
            <a href="/management/roles">Edit and create Job Roles</a>
        </div>
    </div>
    {% endif %}
    {% if craft.lantra.can('editModules')  %}
    <div class="col-2">
        <img src="/assets/img/img-skills-management.jpg" width="150" height="150" class="" alt="">
        <h3>Modules Management</h3>
        <div class="text-muted">
            <a href="/management/modules">Assign job roles to modules</a>
        </div>
    </div>
    {% endif %}
    <div class="col-2">
        <img src="/assets/img/img-skills-management.jpg" width="150" height="150" class="" alt="">
        <h3>Reporting</h3>
        <div class="text-muted">
            <a href="/reporting">View reports</a>
        </div>
    </div>
</section>
</article>
{% endif %}
