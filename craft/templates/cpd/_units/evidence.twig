{% import "_macros" as ui %}
{% if entry is defined %}
    {{ ui.errorList(entry.getAllErrors()) }}
{% endif %}
<form method="post" role="form" accept-charset="UTF-8" enctype="multipart/form-data">
    {{ getCsrfInput() }}
    <input type="hidden" name="action" value="entries/saveEntry">
    <input type="hidden" name="typeId" value="10">
    <input type="hidden" name="sectionId" value="10">
    <input type="hidden" name="enabled" value="1">
    {% if userId != currentUser.id %}
        <input type="hidden" name="authorId" value="{{ userId }}">
    {% endif %}
    <input type="hidden" name="fields[resultStatus]" value="pending">
    <input type="hidden" name="fields[resultUnit][]" value="{{ entry.id }}">
    <div class="field--wrapper">
        <label for="address" class="float">Expiry date (if applicable):</label>
        <input name="userExpiryDate" type="text" class="float-label datepicker-here" placeholder="Expiry date (if applicable)" data-language="en" data-position='top left' value="" data-date-format="yyyy-mm-dd">
    </div>
    <div class="field--wrapper">
        <input type="file" name="fields[resultEvidence][]" multiple>
    </div>
    <div class="field--wrapper">
        <textarea name="fields[resultNotes]"></textarea>
    </div>
    <div class="container-btn">
        <button class="button primary-bg" type="submit">Submit evidence</button>
    </div>
</form>
