{% set resultEndorsed = resultEntry is defined and resultEntry and resultEntry.resultStatus == 'endorsed' %}
{% set resultExists = resultEntry is defined and resultEntry %}
{% for row in moduleGroup.columnLayout %}
    {% set label = row.fieldLabel|default(row.fieldType.label) %}
    {% if row.fieldType == 'unitValue' %}
        <div class="field--wrapper">
            <label for="fields[resultValue]" class="">{{ label }} (if applicable)</label>
            <input name="fields[resultValue]" type="number" placeholder="{{ label }}"
                   value="{{ resultExists ? resultEntry.resultValue|default(1) }}"/>
        </div>
    {% elseif row.fieldType == 'resultExpiryDate' %}
        <div class="field--wrapper">
            <label for="userExpiryDate" class="">{{ label }} (if applicable)</label>
            <input name="userExpiryDate" type="text" class="float-label datepicker-here" placeholder="{{ label }}"
                   value="{{ resultExists ? resultEntry.expiryDate|format('yyyy-mm-dd') }}" data-language="en"
                   data-position='top left' value="" data-date-format="yyyy-mm-dd">
        </div>
    {% elseif row.fieldType == 'resultStartDate' %}
        <div class="field--wrapper">
            <label for="userStartDate" class="">{{ label }} (if applicable)</label>
            <input name="userStartDate" type="text" class="float-label datepicker-here" placeholder="{{ label }}"
                   value="{{ resultExists ? resultEntry.resultStartDate|format('yyyy-mm-dd') }}" data-language="en"
                   data-position='top left' value="" data-date-format="yyyy-mm-dd">
        </div>
    {% elseif row.fieldType == 'resultFinishDate' %}
        <div class="field--wrapper">
            <label for="userFinishDate" class="">{{ label }} (if applicable)</label>
            <input name="userFinishDate" type="text" class="float-label datepicker-here" placeholder="{{ label }}"
                   value="{{ resultExists ? resultEntry.resultFinishDate|format('yyyy-mm-dd') }}" data-language="en"
                   data-position='top left' value="" data-date-format="yyyy-mm-dd">
        </div>
    {% elseif row.fieldType == 'resultLocation' %}
        <div class="field--wrapper">
            <label for="resultLocation" class="">{{ label }} (if applicable)</label>
            <input name="fields[resultLocation]" type="text" class="float-label" placeholder="{{ label }}"
                   value="{{ resultExists ? resultEntry.resultLocation|default('') }}">
        </div>
    {% elseif row.fieldType == 'resultHours' %}
        <div class="field--wrapper">
            <label for="resultLocation" class="">{{ label }} (if applicable)</label>
            <input name="fields[resultHours]" type="text" class="float-label" placeholder="{{ label }}"
                   value="{{ resultExists ? resultEntry.resultHours|default('') }}">
        </div>
    {% elseif row.fieldType == 'resultEvidence' %}
        {% set resultEvidence = resultExists ? resultEntry.resultEvidence : false %}
        <div class="field--wrapper">
            <span class="btn btn-success fileinput-button primary-bg">
                    <i class="glyphicon glyphicon-plus"></i>
                    <span>Add files...</span>
                    <input id="fileupload" type="file" name="assets-upload" multiple data-folderid="{{ craft.lantra.evidenceFolderId(accountId) }}">
            </span>
            <br>
            <br>
            <div id="progress" class="progress">
                <div class="progress-bar progress-bar-success"></div>
            </div>
            <div id="files" class="files">
                {% if resultEvidence %}
                    {% for resultAsset in resultEntry.resultEvidence %}
                    <p>
                        <input type="hidden" name="fields[resultEvidence][]" value="{{ resultAsset.id }}" />
                        [<a href="#" class="delete-file" data-id="{{ resultAsset.id }}" style="color:#FF0000">delete</a>]
                        <a target="_blank" href="/internal/{{ resultAsset.id }}">{{ resultAsset.filename }}</a>
                    </p>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endfor %}
<div class="field--wrapper">
    <label for="resultComment" style="" class="">Comments</label>
    {% if resultExists and resultEntry.resultComments|length %}
        {% for comment in resultEntry.resultComments %}
            <p>
                <span style="font-weight:700;">{{ comment.date|date('d/m/y') }}</span> {{ comment.user.first.fullName }}
                : <em>{{ comment.comment }}</em>
                {% if not comment.read %}
                    <span style="color:#008800;">[new]</span>
                    {{ craft.lantra.readComment(comment) }}
                {% endif %}
            </p>
        {% endfor %}
    {% endif %}
    <textarea placeholder="Add new comment" id="resultComment" name="comment"></textarea>
</div>
