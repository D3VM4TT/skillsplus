<form class="page-form" method="post" role="form" accept-charset="UTF-8" enctype="multipart/form-data">
    {{ getCsrfInput() }}
    <input type="hidden" name="action" value="entries/saveEntry">
    <input type="hidden" name="typeId" value="17">
    <input type="hidden" name="sectionId" value="10">
    <input type="hidden" name="enabled" value="1">
    {%  if author %}
        <input type="hidden" name="authorId" value="{{ author.id }}">
    {%  endif %}
    <input type="hidden" name="fields[resultStatus]" value="pending">
    <div class="field--wrapper">
        <label for="title" class="show">Qualification Title</label>
        <input type="input" name="title" class="float-label" placeholder="Enter the qualification title" />
    </div>
    <div class="field--wrapper date-field">
        <label class="show">Enter expiry date dd/mm/yyyy (if applicable)</label>
        <div>
            <select class="date-day" name="userExpiryDate[day]">
                <option value="">-</option>
                {% for d in 1..31 %}
                    <option value="{{ d }}">{{ d }}</option>
                {% endfor %}
            </select>
            /
            <select class="date-month" name="userExpiryDate[month]">
                <option value="">-</option>
                {% for m in 1..12 %}
                    <option value="{{ m }}">{{ m }}</option>
                {% endfor %}
            </select>
            /
            <select class="date-year" name="userExpiryDate[year]">
                <option value="">-</option>
                {% set year = 'now'|date('Y') %}
                {% for y in year..(year+20) %}
                    <option value="{{ y }}">{{ y }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
    <div class="field--wrapper">
        <input type="file" name="fields[resultEvidence][]" multiple class="5000">
    </div>
    <div class="field--wrapper">
        <label for="resultNotes" style="" class="show">Qualification Notes</label>
        <textarea id="resultNotes" name="fields[resultNotes]"></textarea>
    </div>
    <div class="container-btn">
        <button class="button primary-bg" type="submit">Submit result</button>
    </div>
</form>
