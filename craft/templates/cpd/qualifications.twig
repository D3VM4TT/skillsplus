{% extends "_layout" %}

{% set userId = craft.request.getSegment(3) %}
{% if userId %}
    {% set account = craft.users.id(userId).first %}
    {% if not account or not craft.lantra.isManager(account.id) %}{% exit 404 %}{% endif %}
{% else %}
    {% set account = currentUser %}
{% endif %}

{% set metaTitle = 'Qualifications > ' ~ account.fullname %}

{% block content %}
    <section class="list">
        <div class="page-header">
            <h1>Qualification for {{ account.fullname }}</h1>
        </div>
        {%  include 'cpd/_qualifications/table' with {author:account} %}
        {%  include 'cpd/_qualifications/form' with {author:(userId ? account : null)} %}
    </section>
{% endblock %}
