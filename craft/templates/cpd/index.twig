{% extends "_layout" %}

{% set userId = craft.request.getSegment(2) %}
{% if userId %}
    {% set account = craft.users.id(userId).first %}
    {% if not account or not craft.lantra.isManager(account.id) %}{% exit 403 %}{% endif %}
{% else %}
    {% set account = currentUser %}
{% endif %}

{% set metaTitle = 'CPD > ' ~ account.fullname %}

{% block content %}
<section class="pge">
    <div class="page-header">
        <h2>{{ account.fullname }} ~ Dashboard</h2>
        <a href="/management/users">Back to Users</a>
    </div>
    <div class="page-content">
        {% include '_includes/results' with{cpdUser:account} %}
        {% include '_includes/cpd' with{cpdUser:account} %}
    </div>
</section>
{% endblock %}
