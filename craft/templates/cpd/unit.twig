{% extends "_layout" %}

{% set userId = craft.request.segment(6) %}
{% if userId != currentUser.id %}
    {% set account = craft.users.id(userId).first %}
    {% if not account or not craft.lantra.isManager(account.id) %}{% exit 403 %}{% endif %}
    {%  set dashboardUri = '/cpd/' ~ userId %}
{% else %}
    {% set account = currentUser %}
    {%  set dashboardUri = '/' %}
{% endif %}

{% set moduleEntry = craft.entries.id(craft.request.getSegment(2)).first() %}
{% if not moduleEntry %}{% exit 404 %}{% endif %}
{% set unitEntry = craft.entries.id(craft.request.getSegment(4)).first() %}
{% if not unitEntry %}{% exit 404 %}{% endif %}
{% set resultEntry = craft.entries.section('results').authorId(account.id).relatedTo(unitEntry).first() %}
{% set remainingAttempts = craft.lantra.remainingAttempts(unitEntry, resultEntry, account.id) %}

{% set metaTitle = moduleEntry.title ~ ' ' ~ unitEntry.title %}
{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}

{% block content %}
<section class="page">
    <div class="page-header">
        <h2>{% if  userId != currentUser.id %}{{ account.fullname }} ~ {% endif %}{{ moduleEntry.title }}</h2>
        <h3 style="color:#FFFFFF">{{ unitEntry.title }}</h3>
        {{ unitEntry.unitDescription }}
        <p>
            <a href="{{ dashboardUri }}">&laquo back to dashboard</a>
        </p>
    </div>
    <div class="page-content">
        {% if unitEntry.unitImage|length %}
            {% set unitImage = unitEntry.unitImage.first %}
            <p><img alt="{{ unitEntry.title }}" src="{{ unitImage.url }}" /></p>
        {% endif %}
        {% if unitEntry.unitUrl %}
            <p><a target="_blank" href="{{ unitEntry.unitUrl }}">View the unit content</a></p>
        {% endif %}
        {% if unitEntry.unitType == 'elearning' %}
            {% if resultEntry|length and resultEntry.resultStatus == 'endorsed' %}
                <p>You have passed this test.</p>
            {% elseif not remainingAttempts %}
                <p>You have no remaining attempts, contact your team manager.</p>
            {% else %}
                {% if resultEntry|length %}
                    <p>You have made {{ resultEntry.resultAttempts|length }} attempts and you have {{ remainingAttempts }} attempts remaining.</p>
                {% endif %}
                {% if craft.request.getSegment(7) == 'test' %}
                    {% include 'cpd/_units/test' with{unitEntry:unitEntry, userId:userId, moduleEntry:moduleEntry} %}
                {% elseif unitEntry.testQuestions|length %}
                    <p><a href="/cpd/{{ moduleEntry.id }}/unit/{{ unitEntry.id }}/user/{{ userId }}/test">Complete unit test</a></p>
                {% endif %}
            {% endif %}
        {% else %}
            {% if resultEntry|length %}
                <p>You submitted evidence for this unit on {{ resultEntry.postDate|date(dateFormat) }} and your result status is {{ resultEntry.resultStatus }}.</p>
            {% else %}
                {% include 'cpd/_units/evidence' with{entry:unitEntry, userId:userId} %}
            {% endif %}
        {% endif %}
    </div>
</section>
{% endblock %}
