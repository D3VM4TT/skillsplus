<form class="page-form" method="post" role="form" accept-charset="UTF-8" enctype="multipart/form-data">
    {{ getCsrfInput() }}
    <input type="hidden" name="action" value="entries/saveEntry">
    <input type="hidden" name="typeId" value="17">
    <input type="hidden" name="sectionId" value="10">
    <input type="hidden" name="enabled" value="1">
    {%  if author %}
        <input type="hidden" name="authorId" value="{{ author.id }}">
    {%  endif %}
    <input type="hidden" name="fields[resultStatus]" value="pending">
    <input type="hidden" name="fields[unitEndorsementManagerLevel]" value="1">
    <div class="field--wrapper">
        <label for="title" class="float">Title</label>
        <input type="text" name="title" class="float-label" placeholder="Enter the result title" />
    </div>
    <div class="field--wrapper">
        <label for="resultStartDate" class="float">Start date (if applicable)</label>
        <input name="fields[resultStartDate]" type="text" class="float-label datepicker-here" placeholder="Start date (if applicable)" data-language="en" data-position='top left' value="" data-date-format="yyyy-mm-dd">
    </div>
    <div class="field--wrapper">
        <label for="resultFinishDate" class="float">Finish date (if applicable)</label>
        <input name="fields[resultFinishDate]" type="text" class="float-label datepicker-here" placeholder="Finish date (if applicable)" data-language="en" data-position='top left' value="" data-date-format="yyyy-mm-dd">
    </div>
    <div class="field--wrapper">
        <label for="resultLocation" class="float">Location (if applicable)</label>
        <input name="fields[resultLocation]" type="text" class="float-label" placeholder="Location (if applicable)">
    </div>
    <div class="field--wrapper">
        <label for="userExpiryDate" class="float">Expiry date (if applicable)</label>
        <input name="userExpiryDate" type="text" class="float-label datepicker-here" placeholder="Expiry date (if applicable)" data-language="en" data-position='top left' value="" data-date-format="yyyy-mm-dd">
    </div>
    <div class="field--wrapper">
        <label for="file" class="">Upload files</label>
        <input type="file" name="fields[resultEvidence][]" multiple class="5000">
    </div>
    <div class="field--wrapper">
        <label for="resultNotes" style="" class="">Notes</label>
        <textarea id="resultNotes" name="fields[resultNotes]"></textarea>
    </div>
    <div class="container-btn">
        <button class="button primary-bg" type="submit">Submit result</button>
    </div>
</form>
