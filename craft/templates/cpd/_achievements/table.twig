{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set userResults = craft.entries.section('results').type(['userResult', 'unitResult']).authorId(author.id) %}
{% if userResults|length %}
    <table class="data table-striped">
        <thead>
        <tr>
            <th style="width: 30%">Title</th>
            <th>Type</th>
            <th>Status</th>
            <th>Expiry Date</th>
            <th>Evidence &amp; Comments</th>
        </tr>
        </thead>
        <tbody>
        {% for userResultEntry in userResults %}
            <tr>
                <td>
                    {% if userResultEntry.type == 'unitResult' %}
                        {% set resultUnit = userResultEntry.resultUnit.first %}
                        {{ resultUnit.title }}
                    {% else %}
                        {{ userResultEntry.title }}
                    {% endif %}
                </td>
                <td>{{ userResultEntry.type.name }}</td>
                <td>{{ userResultEntry.resultStatus|ucwords }}</td>
                <td>{% if userResultEntry.expiryDate %}{{ userResultEntry.expiryDate|date(dateFormat) }}{% endif %}</td>
                <td>
                    {% if userResultEntry.resultEvidence|length %}
                        {% for resultEvidenceAsset in userResultEntry.resultEvidence %}
                            <a target="_blank" href="/internal/{{ resultEvidenceAsset.id }}">{{ resultEvidenceAsset.filename }}</a><br />
                        {% endfor %}
                    {% endif %}
                    {{ userResultEntry.resultComments }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}