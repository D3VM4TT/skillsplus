{% set sidebar = 'closed' %}
{% extends "_layout" %}

{% if currentUser %}
    {% set membership = craft.lantra.membership(currentUser) %}
{% endif %}

{% block content %}
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <section class="page">
        {% if craft.app.request.segment(4) == 'thanks' %}
            <div class="page-header secondary-bg">
                <h2>Thank You</h2>
                <p>You will be redirected to your dashboard...</p>
                <script>setTimeout(function () {window.location.href = "/";}, 5000);</script>
            </div>
        {% else %}
            <div class="page-header secondary-bg">
                <h2>Create account</h2>
            </div>
            {% if currentUser %}
                <div class="content-main">
                    {{ globalsHtml.pageMembership }}
                    {% set paymentMeta = {
                        'product' : membership.title,
                        'isMembership' : 1,
                        'redirect' : '/'
                    } %}
                    {{ craft.lantra.basePaypalButton(currentUser.id, membership.cost, 'membership', paymentMeta, 'Pay £' ~ membership.cost)|raw }}
                </div>
            {% else %}
                {% include '_forms/register' with {isMembership:true} %}
            {% endif %}
        {% endif %}
    </section>
{% endblock %}