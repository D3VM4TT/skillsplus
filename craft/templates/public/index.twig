<header>
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
</header>
<section class="slides">
    {% for slide in globalsTheme.homeSlider.all() %}
        <article class="slide{% if loop.index == 1 %} active{% endif %}"{% if slide.slideImage.count() %} style="background-image: url('{{ slide.slideImage.one().url }}');opacity: 1;"{% endif %}>
            <div class="container secondary-bg">
                <div class="caption">
                    <h2>{{ slide.slideTitle }}</h2>
                    <p>{{ slide.slideHeading }}</p>
                    {{ slide.slideContent }}
                </div>
            </div>
        </article>
    {% endfor %}
</section>
{% endblock %}
{% block css %}
    <link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
{% endblock %}
{% block js %}
    <script type="text/javascript" src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script>
        $slideshow = $('.slides').slick({
            dots: false,
            arrows: false,
            autoplay: true,
            infinite: true,
            speed: 4000,
            fade: true,
            cssEase: 'linear',
        });

        $('.slides article').click(function() {
            $slideshow.slick('slickNext');
        });
    </script>
{% endblock %}