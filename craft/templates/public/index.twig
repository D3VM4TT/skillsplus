{% if currentUser %}{% redirect "/cpd" %}{% endif %}
{% extends "_layout" %}

{% block content %}
<section class="slides">
    {% for slide in globalsTheme.homeSlider %}
        <article class="slide{% if loop.index == 1 %} active{% endif %}" style="background-image: url('{{ slide.slideImage.first().url }}');opacity: 1;">
            <div class="container">
                <div class="caption">
                    <h2>{{ slide.slideTitle }}</h2>
                    <p>{{ slide.slideHeading }}</p>
                </div>
                <div class="buttons">
                    <div class="button hollow white">
                        <a href="/about-us">About us</a>
                    </div>
                    <div class="button hollow white">
                        <a href="/contact-us">Contact us</a>
                    </div>
                </div>
            </div>
        </article>
    {% endfor %}
</section>
{% endblock %}
{% block css %}
    <link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
{% endblock %}
{% block js %}
    <script type="text/javascript" src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script>
        $slideshow = $('.slides').slick({
            dots: false,
            arrows: false,
            autoplay: true,
            infinite: true,
            speed: 4000,
            fade: true,
            cssEase: 'linear'
        });

        $('.slides article').click(function() {
            $slideshow.slick('slickNext');
        });
    </script>
{% endblock %}