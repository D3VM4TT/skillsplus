{% set resultEntry = craft.entries.section(section).authorId(userId).id(resultId).one() %}

{% if not resultEntry or (
        (resultEntry.section.handle == 'packages' and resultEntry.packageStatus != 'complete') or
        (resultEntry.type == 'moduleResult' and resultEntry.resultStatus != 'complete') or
        (resultEntry.type == 'unitResult' and resultEntry.resultStatus != 'endorsed')) %}
    {% exit 404 %}
{% endif %}

{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}

{% if resultEntry.section.handle == 'packages' %}
    {% set certTitle = resultEntry.moduleGroup.title %}
    {% set certDate = resultEntry.getCompleteDate()|date(dateFormat) %}
{% elseif resultEntry.type == 'moduleResult' %}
    {% set certTitle = resultEntry.resultModule.one.title %}
    {% set certDate = resultEntry.resultEndorsedDate|date(dateFormat) %}
{% else %}
    {% set certTitle = resultEntry.resultUnit.count ? resultEntry.resultUnit.one.title : resultEntry.title %}
    {% set certDate = resultEntry.resultEndorsedDate|date(dateFormat) %}
{% endif %}

{% set settings = {
    type: 'render',
    compress: true,
    filename: userId ~ '-' ~ resultId,
    isHtml5ParserEnabled: false,
    isRemoteEnabled: true,
    fontDir: "/tmp",
    tempDir: "/tmp",
    defaultPaperOrientation: "portrait"
} %}
{% set vars = {
    certLogo: craft.lantra.setting('certificateLogo', craft.lantra.setting('schemeLogo')),
    certHeader: craft.lantra.setting('certificateHeader'),
    certSubheader: craft.lantra.setting('certificateSubheader'),
    certTextOne: craft.lantra.setting('certificateTextOne'),
    certTextTwo: craft.lantra.setting('certificateTextTwo'),
    certFooter: craft.lantra.setting('certificateFooter'),
    certTitle: certTitle,
    certDate: certDate,
    certFullName: resultEntry.author.fullName,
    nowDate: now|date(dateFormat)
} %}
{{ craft.superpdf.template('_includes/certificate', settings, vars) }}
{# {% include '_includes/certificate' with vars %} #}
