{% set firstSegment = craft.app.request.getSegment(1) %}
{% if firstSegment != "actions" and firstSegment != "sp" and firstSegment != "public" %}
    {% if currentUser and craft.app.request.segment(2) != "licence" and currentUser.isInGroup('individuals') and not currentUser.isInGroup('users') %}
        {% redirect "public/licence" %}
    {% elseif currentUser and craft.app.request.segment(3) != "taskbooks" and currentUser.isInGroup('usersTaskbookPending') %}
        {% redirect "cpd/" ~ currentUser.id ~ "/taskbooks/new" %}
    {% elseif currentUser and craft.app.request.segment(3) != "membership" and currentUser.isInGroup('usersMembershipPending') %}
        {% redirect "public/register/membership" %}
    {% else %}
        {% requireLogin %}
    {% endif %}
{% endif %}
{% set pageClass = '' %}
{% if craft.app.request.getSegment(3) == 'archive' %}
    {% set pageClass = 'archive' %}
{% elseif craft.app.request.getSegment(3) == 'print' %}
    {% set pageClass = 'print' %}
{% endif %}
{% set lightbox = craft.app.request.getParam('lightbox') %}
<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Basic Page Needs
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta charset="utf-8">
    <title>{{ craft.lantra.setting('schemeName') }}</title>
    <meta name="description" content="{{ craft.lantra.setting('schemeDescription') }}">
    <meta name="author" content="{{ craft.lantra.setting('schemeName') }}">

    <!-- Mobile Specific Metas
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- FONT
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">

    <!-- CSS
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="stylesheet" href="/assets/css/lantra.css?{{ random(10000, 99999) }}">
    <link rel="stylesheet" href="/assets/js/vendor/datepicker/css/datepicker.min.css">

    <!-- File Upload
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    {#
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
    #}
    <link rel="stylesheet" href="/assets/js/vendor/fileupload/css/jquery.fileupload.css">

    <!-- Favicon
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon/favicon-16x16.png">
    <link rel="manifest" href="/assets/img/favicon/site.webmanifest">
    <link rel="mask-icon" href="/assets/img/favicon/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

    <style>
        .primary-bg,
        .primary-bg.active,
        .primary-bg.show,
        .button.hollow:hover{
            background-color: {{ craft.lantra.setting('themeColorPrimary') }}
        }

        .primary-color,
        .button.hollow a,
        form label {
            color: {{ craft.lantra.setting('themeColorPrimary') }}
        }

        .button.hollow,
        .primary-border,
        .button.hollow.white:hover {
            border-color:{{ craft.lantra.setting('themeColorPrimary') }}
        }

        .secondary-color {
            color: {{ craft.lantra.setting('themeColorSecondary') }}
        }
        .secondary-bg,
        .secondary-bg-hover:hover,
        .nav-open > a {
            background-color: {{ craft.lantra.setting('themeColorSecondary') }}
        }

        .secondary-border {
            border-color: {{ craft.lantra.setting('themeColorSecondary') }}
        }

        .secondary-bg,
        .button.primary-bg:hover {
            background-color: {{ craft.lantra.setting('themeColorSecondary') }}
        }
    </style>

    {% block css %}{% endblock %}

</head>

<body class="{% if currentUser %}logged-in{% endif %} {{ pageClass }}{% if lightbox %} lightbox{% endif %}">

        {% set server = alias('@server') %}
        {% if server != 'prod' %}
            <div id="server">server: {{ server }}</div>
        {% endif %}

        <div class="loading">
            <div class="spinner"></div>
            <div id="auto-logout">You will be logged out automatically after <span></span> seconds..!</div>
        </div>

        <!-- Main Container
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->

        <div class="container-main">

        {% if not lightbox %}

        <!-- Flex Container
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        <div class="container-flex">

        <!-- Sidebar
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        <div class="sidebar">
        <div class="sidebar-not-sticky">
        {% include '_includes/sidebar' %}
        </div>

        </div>

        {% endif %}

        <!-- Content
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        <div class="content">


            {% if craft.app.request.getSegment(1) != '' %}
                {% include '_includes/notifications' %}
            {% endif %}
            {% block content %}{% endblock %}

            <!-- Footer below content
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->

        <footer class="footer">
            <div class="col-copyright"><img src="/assets/img/lantra_footer_grey_logo.png"></div>
            <div class="col-copyright"><img src="/assets/img/iso_27001.png"></div>
            <div class="col-terms"><p>&copy; {{ "now"|date("Y") }} Lantra. All rights reserved. <a href="/terms">Terms &amp; Privacy</a><br />{{ craft.lantra.release }}</p></div>
        </footer>

        </div>

        <!-- Close Flex Container
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        </div>

        <!-- Close Main Container
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        </div>

        {% if currentUser %}
            {% include '_includes/evidence/browser' %}
        {% endif %}


        <!-- Scripts
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
        <script type="text/javascript">
            window.csrfTokenName = "{{ craft.app.config.general.csrfTokenName|e('js') }}";
            window.csrfTokenValue = "{{ craft.app.request.csrfToken|e('js') }}";
        </script>
        <script src="/assets/js/lantra.js?{{ random(10000, 99999) }}" async defer></script>
        <script src="/assets/js/tooltip.js" async defer></script>
        <script src="/assets/js/vendor/datepicker/js/datepicker.min.js"></script>
        <script src="/assets/js/vendor/datepicker/js/i18n/datepicker.en.js"></script>
        
