        {% block js %}{% endblock %}


        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/css/select2.min.css" rel="stylesheet" />
        <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
        <script>
            $(document).ready(function() {
                $('.js-select2').select2();
            });
        </script>

        <script src="/assets/js/vendor/fileupload/js/vendor/jquery.ui.widget.js"></script>
        <script src="/assets/js/vendor/fileupload/js/jquery.fileupload.js"></script>
        <script src="/assets/js/vendor/fileupload/js/jquery.fileupload-process.js"></script>
        <script src="/assets/js/vendor/fileupload/js/jquery.fileupload-validate.js"></script>
        <script>

            $(document).ready(function () {

                $('#files').on('click', 'a.delete-file', function(e){
                    e.preventDefault();
                    var a = $(this),
                        url = '{{ url('sp/assets/delete-evidence') }}',
                        p = a.closest('p');
                    $.post(url, {fileId: a.data('id')}, function(data) {
                        if(data.success) {
                            p.fadeOut(function () {
                                p.remove();
                            })
                        }
                        else {
                            alert('Could not delete this file. ' + data.message);
                        }
                    });
                });

                var url = '{{ url('sp/assets/upload-evidence') }}';
                $('#fileupload').fileupload({
                    url: url,
                    dataType: 'json',
                    autoUpload: true,
                    multiple: true,
                    formData: [{name: 'folderId', value: $('#fileupload').data('folderid')}],
                    start: function (e) {
                        $('body').addClass('loading');
                    },
                    stop: function (e) {
                        $('body').removeClass('loading');
                    },
                    done: function (e, data) {
                        $('body').removeClass('loading');
                        if(data.result.success) {
                            var fileId = data.result.asset.id,
                                fileName = data.result.asset.filename,
                                coordinates = data.result.asset.location.coordinates,
                                node = $('<p/>')
                                    .append('<input type="hidden" name="fields[resultEvidence][]" value="' + fileId + '" />')
                                    .append('[<a href="#" class="delete-file" data-id="' + fileId + '" style="color:#FF0000">delete</a>] ')
                                    .append('<a target="_blank" href="/internal/' + fileId + '">' + fileName + '</a>');

                                if (coordinates) {
                                    node.append('<a class="icon" href="https://maps.google.co.uk?q=' + coordinates + '" target="_blank"><img src="/assets/img/marker.svg"></a>');
                                }
                            node.appendTo($('#files'));
                        }
                        else {
                            $('body').removeClass('loading');
                            alert(data.result.message);
                        }
                    },
                    error: function (e, data) {
                        $('body').removeClass('loading');
                        alert('Could not upload this file.');
                    }
                }).on('fileuploadprogressall', function (e, data) {
                    var progress = parseInt(data.loaded / data.total * 100, 10);
                    $('#progress .progress-bar').css('width',  progress + '%');
                }).on('fileuploadsend', function (e, data) {
                    $('#progress .progress-bar').css('width', 0);

                });
            });
        </script>

        {% if currentUser %}
            <script>let idleMinutes = {{ craft.lantra.setting('idleMinutes', 15) }};</script>
            <script src="/assets/js/logout.js"></script>
        {% endif %}
</body>
</html>
