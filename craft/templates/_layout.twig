{% if craft.request.firstSegment != "actions" and craft.request.firstSegment != "public" %}
    {% if currentUser and craft.request.segment(2) != "licence" and currentUser.isInGroup('individuals') and not currentUser.isInGroup('users') %}
        {% redirect "public/licence" %}
    {% else %}
        {% requireLogin %}
    {% endif %}
{% endif %}
<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Basic Page Needs
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta charset="utf-8">
    <title>{{ globalsTheme.schemeName }}</title>
    <meta name="description" content="{{ globalsTheme.schemeDescription }}">
    <meta name="author" content="{{ globalsTheme.schemeName }}">

    <!-- Mobile Specific Metas
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- FONT
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">

    <!-- CSS
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="stylesheet" href="/assets/css/lantra.css">
    <link rel="stylesheet" href="/assets/js/vendor/datepicker/css/datepicker.min.css">

    <!-- Favicon
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon/favicon-16x16.png">
    <link rel="manifest" href="/assets/img/favicon/site.webmanifest">
    <link rel="mask-icon" href="/assets/img/favicon/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

    <style>
        .primary-bg,
        .primary-bg.active,
        .primary-bg.show,
        .button.hollow:hover{
            background-color: {{ globalsTheme.themeColorPrimary }}
        }

        .primary-color,
        .button.hollow a,
        form label {
            color: {{ globalsTheme.themeColorPrimary }}
        }

        .button.hollow,
        .primary-border,
        .button.hollow.white:hover {
            border-color:{{ globalsTheme.themeColorPrimary }}
        }

        .secondary-color {
            color: {{ globalsTheme.themeColorSecondary }}
        }
        .secondary-bg,
        .secondary-bg-hover:hover,
        .nav-open > a {
            background-color: {{ globalsTheme.themeColorSecondary }}
        }

        .secondary-border {
            border-color: {{ globalsTheme.themeColorSecondary }}
        }

        .secondary-bg,
        .button.primary-bg:hover {
            background-color: {{ globalsTheme.themeColorSecondary }}
        }
    </style>

    {% block css %}{% endblock %}

</head>
<body class="{% if currentUser %}logged-in{% endif %}">
    <div class="container-fluid">
        <!-- Sidebar
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        {% include '_includes/sidebar' %}

        <!-- Content
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        <div class="container-content">
            {% if craft.request.firstSegment != '' %}
                {% include '_includes/notifications' %}
            {% endif %}
            {% block content %}{% endblock %}
        </div>

        <!-- Footer
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        <footer class="footer">
            <div class="col-copyright"><img src="/assets/img/lantra-footer-logo.jpg"></div>
            <div class="col-terms"><p>&copy; 2018 Lantra. <a href="/terms">Terms &amp; Privacy</a></p></div>
        </footer>

        <!-- Scripts
        –––––––––––––––––––––––––––––––––––––––––––––––––– -->
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
        <script type="text/javascript">
            window.csrfTokenName = "{{ craft.config.csrfTokenName|e('js') }}";
            window.csrfTokenValue = "{{ craft.request.csrfToken|e('js') }}";
        </script>
        <script src="/assets/js/lantra.js" async defer></script>
        <script src="/assets/js/vendor/datepicker/js/datepicker.min.js"></script>
        <script src="/assets/js/vendor/datepicker/js/i18n/datepicker.en.js"></script>
        {% block js %}{% endblock %}
    </div>
</body>
</html>
