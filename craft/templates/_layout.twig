{% if craft.request.firstSegment != "actions" and craft.request.firstSegment != "public" %}
    {% if currentUser and craft.request.segment(2) != "licence" and currentUser.isInGroup('individuals') and not currentUser.isInGroup('users') %}
        {% redirect "public/licence" %}
    {% else %}
        {% requireLogin %}
    {% endif %}
{% endif %}
<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Basic Page Needs
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta charset="utf-8">
    <title>{{ globalsTheme.schemeName }}</title>
    <meta name="description" content="{{ globalsTheme.schemeDescription }}">
    <meta name="author" content="{{ globalsTheme.schemeName }}">

    <!-- Mobile Specific Metas
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- FONT
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">

    <!-- CSS
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="stylesheet" href="/assets/css/cpd.css">
    <link rel="stylesheet" href="/assets/css/frontend.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.0/css/bootstrap.min.css">

    <style>
        .primary-bg,
        .primary-bg.active,
        .primary-bg.show,
        .button.hollow:hover{
            background-color: {{ globalsTheme.themeColorPrimary }}
        }

        .secondary-bg,
        .button.primary-bg:hover {
            background-color: {{ globalsTheme.themeColorSecondary }}
        }

        .primary-color,
        .button.hollow a,
        form label {
            color: {{ globalsTheme.themeColorPrimary }}
        }

        .button.hollow,
        .primary-border {
            border-color: {{ globalsTheme.themeColorPrimary }}
        }
        .secondary-color {
            color: {{ globalsTheme.themeColorSecondary }}
        }
        .secondary-bg {
            background-color: {{ globalsTheme.themeColorSecondary }}
        }
        .secondary-border {
            border-color: {{ globalsTheme.themeColorSecondary }}
        }
    </style>

    {% block css %}{% endblock %}

    <!-- Favicon
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon/favicon-16x16.png">
    <link rel="manifest" href="/assets/img/favicon/site.webmanifest">
    <link rel="mask-icon" href="/assets/img/favicon/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

</head>
<body class="{% if currentUser %}logged-in{% endif %}">
    <div class="container-fluid">
        <div class="container-sidebar">
            <div class="primary-bg menu-tab">
                <div id="one"></div>
                <div id="two"></div>
                <div id="three"></div>
            </div>
            <div class="primary-bg menu-hide">
                <div class="menu-intro">
                    <h1>{{ globalsTheme.schemeName }}</h1>
                    <p>{{ globalsTheme.schemeDescription }}</p>
                </div>
                    {% include '_includes/nav_public' %}
                    <div class="container-footer-menu">
                        <div class="container-footer-links-menu">
                            <div class="row">
                                <div class="col-6 col-copyright">
                                    <img src="/assets/img/lantra_footer_wht_logo.png">
                                </div>
                                <div class="col-6 col-terms">
                                    <p>&copy; 2018 Lantra. <a href="/terms">Terms &amp; Privacy</a></p>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
            {% if currentUser %}
                {% include '_includes/nav_cpd' %}
            {%  else %}
                <div class="log-in-form">
                    <div class="row scheme-logo">
                        <a href="/">
                            {%  if globalsTheme.schemeLogo|length %}
                                <img src="{{ globalsTheme.schemeLogo.first().url }}">
                            {% else %}
                                {{  globalsTheme.schemeName }}
                            {% endif %}
                        </a>
                    </div>
                    <div class="container-form-toggle">
                        {% include '_forms/login_combined' %}
                    </div>
                    <div class="container-btn">
                        <div class="sml-link center">
                            <p>Not registered?</p>
                        </div>
                        <div class="button hollow">
                            <a href="/public/register">Create account</a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="container-content">
        {% if craft.request.firstSegment != '' %}
            {% include '_includes/notifications' %}
        {% endif %}
        {% block content %}{% endblock %}
    </div>
    <footer class="footer" style="position:fixed!important;">
        <div class="container-footer">
            <div class="container-footer-links">
                <div class="row">
                    <div class="col-6 col-copyright">
                        <img src="/assets/img/lantra-footer-logo.jpg">
                    </div>
                    <div class="col-6 col-terms">
                        <p>&copy; 2018 Lantra. <a href="/terms">Terms &amp; Privacy</a></p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js"></script>
    <script src="/assets/js/frontend.js"></script>
    <script src="/assets/js/plugins.js"></script>
    <script src="/assets/js/main.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js" integrity="sha384-b/U6ypiBEHpOf/4+1nzFpr53nxSS+GLCkfwBdFNTxtclqqenISfwAzpKaMNFNmj4" crossorigin="anonymous"></script>
    <script src="/assets/js/ie10-viewport-bug-workaround.js"></script>
    <script type="text/javascript">
        window.csrfTokenName = "{{ craft.config.csrfTokenName|e('js') }}";
        window.csrfTokenValue = "{{ craft.request.csrfToken|e('js') }}";
    </script>
    <script src="/assets/js/lantra.js" async defer></script>

    <link href="/assets/js/vendor/datepicker/css/datepicker.min.css" rel="stylesheet" type="text/css">
    <script src="/assets/js/vendor/datepicker/js/datepicker.min.js"></script>
    <script src="/assets/js/vendor/datepicker/js/i18n/datepicker.en.js"></script>
{% block js %}{% endblock %}
</body>
</html>
