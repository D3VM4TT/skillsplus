<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Basic Page Needs
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta charset="utf-8">
    <title>{{ siteName }} - {{ globalsScheme.schemeDescription }}</title>
    <meta name="description" content="{{ globalsScheme.schemeDescription }}">
    <meta name="author" content="{{ siteName }}">

    <!-- Mobile Specific Metas
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- FONT
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">

    <!-- CSS
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="stylesheet" href="/assets/css/frontend.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.0/css/bootstrap.min.css">


    <!-- Scripts
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js"></script>
    <script src="/assets/js/frontend.js"></script>


    <!-- Favicon
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon/favicon-16x16.png">
    <link rel="manifest" href="/assets/img/favicon/site.webmanifest">
    <link rel="mask-icon" href="/assets/img/favicon/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

</head>
<body class="{% if currentUser %}logged-in{% endif %}">
    <div class="container-fluid">
        <div class="container-sidebar">
            <div class="menu-tab">
                <div id="one"></div>
                <div id="two"></div>
                <div id="three"></div>
            </div>
            <div class="menu-hide">
                <div class="menu-intro">
                    <h1>{{ globalsScheme.schemeName }}</h1>
                    <p>{{ globalsScheme.schemeDescription }}</p>
                </div>
                    {% include '_includes/nav_public' %}
                    <div class="container-footer-menu">
                        <div class="container-footer-links-menu">
                            <div class="row">
                                <div class="col-6 col-copyright">
                                    <img src="/assets/img/lantra_footer_wht_logo.png">
                                </div>
                                <div class="col-6 col-terms">
                                    <p>&copy; 2018 Lantra. <a href="/terms">Terms &amp; Privacy</a></p>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
            {% if currentUser %}
                {% include '_includes/nav_scheme' %}
            {%  else %}
                <div class="log-in-form">
                    <div class="row scheme-logo">
                        <a href="/">
                            <img src="{{ globalsTheme.schemeLogo.first().url }}">
                        </a>
                    </div>
                    <div class="container-form-toggle">
                        <h1>User Log in</h1>
                        {% include '_forms/login_combined' %}
                    </div>
                    <div class="container-btn container-create-account-btn">
                        <div class="sml-link center">
                            <p>Not registered?</p>
                        </div>
                        <div class="create-account-btn">
                            <a href="/login/register">Create account</a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="container-content">
        {% set notice = craft.session.getFlash('notice') %}
        {% set error = craft.session.getFlash('error') %}
        <div id="notifications">
            {% if notice %}
                <div class="alert alert-success">
                    <strong>Success!</strong>
                    {% if notice is iterable %}{% for n in notice %}{{ n.notice }} {% endfor %}{% else %}{{ notice }}{% endif %}
                </div>
            {% endif %}
            {% if error %}
                <div class="alert alert-warning">
                    <strong>Error!</strong>
                    {% if error is iterable %}{% for e in error %}{{ e.error }}{% endfor %}{% else %}{{ error }}{% endif %}
                </div>
            {% endif %}
        </div>
        {% block content %}{% endblock %}
    </div>
    <footer class="footer" style="position:fixed!important;">
        <div class="container-footer">
            <div class="container-footer-links">
                <div class="row">
                    <div class="col-6 col-copyright">
                        <img src="/assets/img/lantra-footer-logo.jpg">
                    </div>
                    <div class="col-6 col-terms">
                        <p>&copy; 2018 Lantra. <a href="/terms">Terms &amp; Privacy</a></p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
