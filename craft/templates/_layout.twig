<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Basic Page Needs
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta charset="utf-8">
    <title>{{ siteName }} - {{ globalsScheme.schemeDescription }}</title>
    <meta name="description" content="{{ globalsScheme.schemeDescription }}">
    <meta name="author" content="{{ siteName }}">

    <!-- Mobile Specific Metas
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- FONT
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">

    <!-- CSS
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="stylesheet" href="/assets/css/frontend.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.0/css/bootstrap.min.css">


    <!-- Scripts
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js"></script>
    <script src="/assets/js/frontend.js"></script>


    <!-- Favicon
    –––––––––––––––––––––––––––––––––––––––––––––––––– -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon/favicon-16x16.png">
    <link rel="manifest" href="/assets/img/favicon/site.webmanifest">
    <link rel="mask-icon" href="/assets/img/favicon/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

</head>
<body>

<div class="container-fluid">
    <div class="container-log-in">

        <div class="menu-tab">
            <div id="one"></div>
            <div id="two"></div>
            <div id="three"></div>
        </div>

        <div class="menu-hide">
            <div class="menu-intro">
                <h1>{{ globalsScheme.schemeName }}</h1>
                <p>{{ globalsScheme.schemeDescription }}</p>
            </div>
            <nav>
                <ul>
                    {% for pageEntry in globalsTheme.themeNavigation %}
                        <li><a href="{{ pageEntry.url }}">{{ pageEntry.title }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
            <div class="container-btn container-create-account-btn">
                <div class="sml-link center"><p>Not registered?</p></div>
                <div class="create-account-btn"><a href="create-account.html">Create account</a></div>
            </div>
            <div class="container-footer-menu">
                <div class="container-footer-links-menu">
                    <div class="row">
                        <div class="col-6 col-copyright"><img src="/assets/img/lantra_footer_wht_logo.png"></div>
                        <div class="col-6 col-terms"><p>&copy; 2018 Lantra. <a href="terms.html">Terms &amp; Privacy</a>
                            </p></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="log-in-form">
            <div class="row scheme-logo">
                <a href="/"><img src="{{ globalsTheme.schemeLogo.first().url }}"></a>
            </div>
            <div class="container-form-toggle">
                <h1>User Log in</h1>
                <form action="">
                    <div class="login-form">

                        <!-- Login -->
                        <div class="log-in-toggle" id="log-in-div">
                            <div class="field--wrapper" style="">
                                <label for="fname" style="" class="show">Email address</label>
                                <input class="float-label" placeholder="Email address" style="">
                            </div>
                            <div class="field--wrapper last" style="">
                                <label for="fname" style="" class="show">Password</label>
                                <input type="password" name="password" id="password" class="float-label"
                                       placeholder="Password" style="">
                                <span class="password-showhide">
                              <span class="trigger-password">Show</span>
                              </span>
                                <div class="sml-link right" id="remember-me">
                                    <label>
                                        <input type="checkbox" name="rememberMe" value="1">
                                        <span class="remember-me-txt">Remember me</span>
                                    </label>
                                </div>

                            </div>
                        </div>

                        <!-- Reset -->
                        <div class="reset-form-toggle" id="reset-div">
                            <p>Enter the email address you use to log in to your account and we'll email you with
                                instructions on how you can reset your password.</p>
                            <div class="field--wrapper" style="">
                                <label for="fname" style="" class="show">Email address</label>
                                <input class="float-label" placeholder="Email address" style="">
                            </div>
                        </div>

                        <!-- Submit -->
                        <div class="container-btn container-log-in-btn">
                            <input type="submit" id="submit" class="log-in-btn" value="Log in">
                        </div>

                        <!-- Help -->
                        <div class="sml-link reset">
                            <a href="reset-password.htm" class="reset">Forgotten your password?</a>
                        </div>
                </form>
            </div><!-- container-form-toggle -->

            <div class="container-btn container-create-account-btn">
                <div class="sml-link center"><p>Not registered?</p></div>
                <div class="create-account-btn"><a href="create-account.html">Create account</a></div>
            </div>
        </div>
    </div>
</div>
</div>
{% block content %}{% endblock %}
<footer class="footer">
    <div class="container-footer">
        <div class="container-footer-links">
            <div class="row">
                <div class="col-6 col-copyright"><img src="/assets/img/lantra-footer-logo.jpg"></div>
                <div class="col-6 col-terms"><p>&copy; 2018 Lantra. Terms &amp; Privacy</p></div>
            </div>
        </div>
    </div>
</footer>
</body>
</html>
