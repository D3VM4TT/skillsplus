{% extends "_layout" %}
{% import "_macros" as ui %}
{% set metaTitle = "Result > Edit" %}

{% set entryId = craft.app.request.getSegment(2) %}
{% if entryId and entry is not defined %}
    {% set entry = craft.entries.id(entryId).status('live, expired').one %}
{% endif %}

{% if currentUser.id == entry.authorId %}
    {% set isAuthor = true %}
    {% set isManager = false %}
    {% set resultLocked = entry.resultStatus == 'endorsed' %}
{% else %}
    {% set isAuthor = true %}
    {% set isManager = craft.lantra.isManager(entry.authorId) %}
    {% set resultLocked = false %}
{% endif %}

{% if not currentUser.id == entry.authorId and not isManager %}{% exit 403 %}{% endif %}

{% set section = craft.app.sections.getSectionByHandle('results') %}

{% block content %}
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <h2>Edit result</h2>
        <p>{{ entry.title }}</p>
    </div>

    {% if entry is defined %}
        {{ ui.errorList(entry.getFirstErrors()) }}
    {% endif %}

    <form class="page-form" method="post" role="form" accept-charset="UTF-8">
        {{ csrfInput() }}
        {% if craft.app.request.referrer %}
            {{ redirectInput(craft.app.request.referrer) }}
        {% endif %}
        <input type="hidden" name="action" value="entries/save-entry">
        <input type="hidden" name="sectionId" value="{{ section.id }}">
        <input type="hidden" name="enabled" value="1">
        <input type="hidden" name="entryId" value="{{ entry.id }}">

        <div id="name-fields">
            <div class="col-6 field--wrapper">
                <h3>Result ID: {{ entry.id }}</h3>
            </div>
        </div>
        {% include 'record/_units/fields' with {
            columnLayout: globalsTheme.columnLayout,
            resultEntry: entry,
            accountId: entry.authorId,
            resultLocked:resultLocked,
            isManager:isManager
        } %}
        {% if isManager %}
            <div class="field--wrapper">
                <label for="resultStatus" class="">Result Status</label>
                <select name="fields[resultStatus]">
                    <option value="draft"{% if entry.resultStatus == 'draft' %} selected{% endif %}>Draft</option>
                    <option value="pending"{% if entry.resultStatus == 'pending' %} selected{% endif %}>Pending</option>
                    <option value="endorsed"{% if entry.resultStatus == 'endorsed' %} selected{% endif %}>Endorsed</option>
                </select>
            </div>
        {% endif %}
        <div class="container-btn">
            <button class="button primary-bg" type="submit">Save result</button>
        </div>
    </form>
{% endblock %}
