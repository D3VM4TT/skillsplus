<form class="page-form" id="form-register" method="post" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('users/save-user') }}
    {% if isTaskbook is defined %}
        {{ hiddenInput('taskbook', 'true') }}
        {{ redirectInput('/') }}
        {% set taskbookCompanies = craft.lantra.setting('taskbookRegistrationCompanies') %}
        {% set defaultTaskbookCompany = craft.lantra.setting('defaultTaskbookCompany') %}
        {% set defaultTaskbookJobRole = craft.lantra.setting('taskbookJobRole') %}
        {% if taskbookCompanies|length %}
            <div class="field--wrapper" style="">
                <label for="userCompany" class="no-float">Company</label>
                <select name="fields[userCompany][]" id="userCompany">
                    {% set companies = craft.lantra.setting('taskbookRegistrationCompanies') %}
                    {% for company in companies %}
                        <option value="{{ company.id }}">{{ company.title }}</option>
                    {% endfor %}
                </select>
            </div>
        {% elseif defaultTaskbookCompany|length %}
            {{ hiddenInput('fields[userCompany][]', defaultTaskbookCompany.id) }}
        {% endif %}
        {% if defaultTaskbookJobRole|length %}
            <input type="hidden" name="fields[userRole][]" value="{{ defaultTaskbookJobRole }}" />
        {% endif %}
    {% else %}
        {{ redirectInput('') }}
    {% endif %}
    {% if isMembership is defined %}
        {{ hiddenInput('membership', 'true') }}
        <div class="field--wrapper" style="">
            <label for="userRole" class="no-float">Membership</label>
            <select name="fields[userRole][]" id="userRole">
                {% set options = craft.lantra.setting('membershipOptions') %}
                {% for row in options %}
                    {% set jobRole = craft.categories.id(row.jobRole).one() %}
                    <option value="{{ jobRole.id }}">{{ jobRole.title }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field--wrapper" style="">
            <label for="registerCompany" class="no-float">Company ID (if known)</label>
            <input id="registerCompany" type="number" placeholder="Company ID" name="registerCompany" />
        </div>
    {% endif %}
    <div class="field--wrapper" style="">
        <label for="registerFirstName" class="no-float">First Name</label>
        <input required id="registerFirstName" type="text" placeholder="First Name" name="firstName" {% if user is defined %} value="{{ user.firstName }}"{% endif %}>
    </div>
    <div class="field--wrapper">
        <label for="registerLastName" class="no-float">Last Name</label>
        <input required id="registerLastName" type="text" placeholder="Last Name"
               name="lastName" {% if user is defined %} value="{{ user.lastName }}"{% endif %}>
    </div>
    <div class="field--wrapper">
        <label for="registerEmail" class="no-float">Email</label>
        <input required id="registerEmail" type="text" placeholder="Email" name="email" {% if user is defined %} value="{{ user.email }}"{% endif %}>
    </div>
    {% for row in craft.lantra.userProfileFields('register') %}
        {% switch row.field %}
        {% case 'userDateOfBirth' %}
            <div class="field--wrapper">
                {% include '_includes/date' with {label: row.label ?: 'Date of birth', name:'fields[userDateOfBirth]', value: user is defined ? user.userDateOfBirth, ys: now.year - 10, ye: now.year - 100} %}
            </div>
        {% case 'userAddress' %}
            <div class="field--wrapper">
                <label for="address" class="no-float">{{ row.label ?: 'Address' }}</label>
                <textarea {{ row.required ? 'required' }} id="address" name="fields[userAddress]" class="float-label"
                placeholder="Enter the address">{{ user is defined ? user.userAddress|default('') }}</textarea>
            </div>
        {% case 'userTelephone' %}
            <div class="field--wrapper">
                <label for="telephone" class="no-float">{{ row.label ?: 'Telephone' }}</label>
                <input {{ row.required ? 'required' }} type="text" id="telephone" name="fields[userTelephone]" class="float-label"
                placeholder="Enter the telephone" value="{{ user is defined ? user.userTelephone|default('') }}">
            </div>
        {% endswitch %}
    {% endfor %}
    {% for row in craft.lantra.userCustomFields('register') %}
        <div class="field--wrapper">
            <label for="custom-{{ row.name }}" class="no-float">{{ row.label }}:</label>
            {% set userCustomBlock = user is defined ? user.customFields.customName('='~row.name).one() : [] %}
            {% set fieldId = userCustomBlock|length ? userCustomBlock.id : 'new'~loop.index %}
            <input type="hidden" name="fields[customFields][{{ fieldId }}][type]" value="customField">
            <input type="hidden" name="fields[customFields][{{ fieldId }}][enabled]" value="1">
            <input type="hidden" name="fields[customFields][{{ fieldId }}][fields][customName]"
                   value="{{ row.name }}"/>
            <input {{ row.required ? 'required' }} type="text" id="custom-{{ row.name }}" class="float-label"
            name="fields[customFields][{{ fieldId }}][fields][customValue]"
            value="{{ userCustomBlock|length ? userCustomBlock.customValue|default('') }}">
        </div>
    {% endfor %}
    <div class="field--wrapper">
        <label for="registerPassword" class="no-float">Password</label>
        <input id="registerPassword" type="password" name="password" placeholder="Password">
    </div>
    <div class="container-btn">
        <button class="button primary-bg" type="submit">Register</button>
    </div>
</form>
