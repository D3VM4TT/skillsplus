<form class="page-form" id="form-register" method="post" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('users/save-user') }}
    {% if isTaskbook is defined %}
        {{ hiddenInput('taskbook', 'true') }}
        {{ redirectInput('/') }}
    {% else %}
        {{ redirectInput('') }}
    {% endif %}
    {% if isMembership is defined %}
        {{ hiddenInput('membership', 'true') }}
        <div class="field--wrapper" style="">
            <label for="userRole" class="no-float">Membership</label>
            <select name="fields[userRole][]" id="userRole">
                {% set options = craft.lantra.setting('membershipOptions') %}
                {% for row in options %}
                    {% set jobRole = craft.categories.id(row.jobRole).one() %}
                    <option value="{{ jobRole.id }}">{{ jobRole.title }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field--wrapper" style="">
            <label for="registerCompany" class="no-float">Company ID (if known)</label>
            <input id="registerCompany" type="number" placeholder="Company ID" name="registerCompany" />
        </div>
    {% endif %}
    <div class="field--wrapper" style="">
        <label for="registerFirstName" class="no-float">First Name</label>
        <input id="registerFirstName" type="text" placeholder="First Name" name="firstName" {% if user is defined %} value="{{ user.firstName }}"{% endif %}>
    </div>
    <div class="field--wrapper">
        <label for="registerLastName" class="no-float">Last Name</label>
        <input id="registerLastName" type="text" placeholder="Last Name"
               name="lastName" {% if user is defined %} value="{{ user.lastName }}"{% endif %}>
    </div>
    <div class="field--wrapper">
        <label for="registerEmail" class="no-float">Email</label>
        <input id="registerEmail" type="text" placeholder="Email" name="email" {% if user is defined %} value="{{ user.email }}"{% endif %}>
    </div>
    <div class="field--wrapper">
        <label for="registerPassword" class="no-float">Password</label>
        <input id="registerPassword" type="password" name="password" placeholder="Password">
    </div>

    <div class="container-btn">
        <button class="button primary-bg" type="submit">Register</button>
    </div>
</form>
