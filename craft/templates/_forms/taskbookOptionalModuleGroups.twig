<table class="data">
    <thead>
    <tr>
        <th width="50%">Optional</th>
        {% if craft.lantra.setting('taskbookLevels') %}
            <th>Level</th>
        {% endif %}
        <th style="text-align: right;padding-right:0;">Selected</th>
    </tr>
    </thead>
    <tbody>
    {% for optionalModuleGroup in optionalModuleGroups %}
        {% set category = optionalModuleGroup.category  %}
        {% set packageModuleGroupBlock = package is defined ? package.moduleGroupBlock(category.id) : null  %}
        <tr class="optional-module" data-category-id="{{ category.id }}">
            <td>
                {{ category.magicTitle }}
            </td>
            {% if craft.lantra.setting('taskbookLevels') %}
                <td>
                    {% if optionalModuleGroup.level %}
                        <strong>{{ craft.lantra.taskbookLevel(optionalModuleGroup.level) }}</strong>
                        <input class="optional-level-hidden" type="hidden" name="optional[{{ category.id  }}][level]" value="{{ optionalModuleGroup.level }}" />
                    {% else %}
                        <select class="optional-level" name="optional[{{ category.id  }}][level]">
                            {% for option in craft.lantra.taskbookLevels() %}
                                <option {% if packageModuleGroupBlock and packageModuleGroupBlock.moduleLevel == option.value %}selected {% endif %} value="{{ option.value }}">{{ option.label }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </td>
            {% endif %}
            <td style="text-align: right">
                <span class="module-select {% if packageModuleGroupBlock %}module-selected{% endif %}">
                    <i class="fas fa-check"></i>
                    <i class="fas fa-times"></i>
                    <input type="hidden" name="optional[{{ category.id }}][selected]" value="{{ packageModuleGroupBlock ? 1 : 0 }}">
                </span>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>