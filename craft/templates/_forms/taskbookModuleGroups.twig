{% set mandatoryModuleGroupCategories = taskbook.moduleGroupCategories('mandatory') %}
{% set optionalModuleGroupCategories = taskbook.moduleGroupCategories('optional') %}
<div class="taskbook-optional taskbook-optional-{{ taskbook.id }}">
    {% if mandatoryModuleGroupCategories|length  %}
        <label>Below are the mandatory modules for this {{ taskbookLabel }}</label>
        <table class="data">
            <thead>
            <tr>
                <th width="50%">Module Group</th>
                <th width="50%"></th>
            </tr>
            </thead>
            <tbody>
            {% for mandatoryModuleGroupCategory in mandatoryModuleGroupCategories %}
            {% set packageModuleGroupRow = craft.lantra.getModuleGroupRow(entry, mandatoryModuleGroupCategory.id)  %}
            <tr class="optional-module">
                <td>{{ mandatoryModuleGroupCategory.title }}</td>
                <td></td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
    {% if optionalModuleGroupCategories|length  %}
        <label>Below are the optional modules you can choose to complete along with core.
        {% if taskbook.moduleMinimumOptional %}
           <br />You must select at least {{ taskbook.moduleMinimumOptional }} optional {{ 'module'|pluralize(qty=taskbook.moduleMinimumOptional) }}.
        {% endif %}
        </label>
        <table class="data">
            <thead>
            <tr>
                <th width="50%">Module Group</th>
                <th width="50%">Selected</th>
            </tr>
            </thead>
            <tbody>
            {% for optionalModuleGroupCategory in optionalModuleGroupCategories %}
                {% set packageModuleGroupRow = craft.lantra.getModuleGroupRow(entry, optionalModuleGroupCategory.id)  %}
                <tr class="optional-module">
                    <td>{{ optionalModuleGroupCategory.title }}</td>
                    {% if craft.lantra.setting('taskbookLevels') %}
                    <td>
                        <select class="optional-level" name="optionalLevel">
                            {% for option in craft.lantra.taskbookLevels() %}
                                <option {% if packageOptionalModuleGroupRow and packageOptionalModuleGroupRow.moduleLevel == option.value %}selected {% endif %} value="{{ option.value }}">{{ option.label }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    {% endif %}
                    <td>
                        <input class="optional" type="checkbox" name="optionalModuleGroup" value="{{ optionalModuleGroupCategory.id }}" {% if packageModuleGroupRow %}checked{% endif %}>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div style="font-size: 12px; font-style: italic; margin-bottom:20px; text-align: right;">
        {% for row in taskbook.moduleCosts %}
           Core + {{ row.optionalModules }} module: £{{ row.cost }}<br />
        {% endfor %}
            Max Cost: £{{ taskbook.moduleMaxCost }}</p>
        {% if taskbook.moduleMinimumOptional %}
            Minimum optional modules: {{ taskbook.moduleMinimumOptional }}
        {% endif %}
        </div>
    {% else %}
        <p>There are currently no optional modules for {{ taskbook.title }}.</p>
        <p>&nbsp;</p>
    {% endif %}
</div>