{% set mandatoryModuleGroups = taskbook.moduleGroups('mandatory') %}
{% set optionalModuleGroups = taskbook.moduleGroups('optional') %}
<div class="taskbook-optional taskbook-optional-{{ taskbook.id }}">

    {% include '_includes/taskbooks/taskbookRequired' with {taskbook: taskbook} %}
    <p>&nbsp;</p>

    {% if mandatoryModuleGroups|length  %}
        <label>Below are the mandatory modules for this {{ taskbookLabel }}</label>
        <table class="data">
            <thead>
            <tr>
                <th width="50%">Mandatory</th>
                {% if craft.lantra.setting('taskbookLevels') and taskbook.taskbookFixedLevels %}
                    <th>Level</th>
                {% endif %}
                {% if taskbook.moduleMinimumCredits %}
                    <th>Credit</th>
                {% endif %}
                <th width="20%"></th>
            </tr>
            </thead>
            <tbody>
            {% for mandatoryModuleGroup in mandatoryModuleGroups %}
                {% set category = mandatoryModuleGroup.category  %}
                {% set packageModuleGroupRow = craft.lantra.getModuleGroupRow(entry, category.id)  %}
                <tr class="optional-module">
                    <td>{{ category.magicTitle }}</td>
                    {% if craft.lantra.setting('taskbookLevels') and taskbook.taskbookFixedLevels %}
                        <td>{{ craft.lantra.taskbookLevel(mandatoryModuleGroup.level) }}</td>
                    {% endif %}
                    {% if taskbook.moduleMinimumCredits %}
                        <td>{{ mandatoryModuleGroup.credit }}</td>
                    {% endif %}
                    <td></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
    {% if optionalModuleGroups|length  %}
        <label>Below are the optional modules you can choose to complete along with mandatory.
        {% if taskbook.moduleMinimumOptional %}
           <br />You must select at least {{ taskbook.moduleMinimumOptional }} optional {{ 'module'|pluralize(taskbook.moduleMinimumOptional) }}.
        {% endif %}
        </label>
        {% include '_forms/taskbookOptionalModuleGroups' with {optionalModuleGroups:optionalModuleGroups} %}
        <div style="font-size: 12px; font-style: italic; margin-bottom:20px; text-align: right;">
        {% for row in taskbook.moduleCosts %}
           Core + {{ row.optionalModules }} module: £{{ row.cost }}<br />
        {% endfor %}
            Max Cost: £{{ taskbook.moduleMaxCost }}</p>
        {% if taskbook.moduleMinimumOptional %}
            Minimum optional modules: {{ taskbook.moduleMinimumOptional }}
        {% endif %}
        </div>
    {% else %}
        <p>There are currently no optional modules for {{ taskbook.title }}.</p>
        <p>&nbsp;</p>
    {% endif %}
</div>