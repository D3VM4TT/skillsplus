{% set jsDateFormat = craft.lantra.setting('jsDateFormat', 'dd-mm-yyyy') %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}

{% set formUser = user is defined ? user : currentUser %}

<form id="profile" method="post" accept-charset="UTF-8" enctype="multipart/form-data">
    {{ csrfInput() }}
    {{ actionInput('sp/users/save-profile') }}
    {{ redirectInput('profile') }}
    {{ hiddenInput('userId', currentUser.id) }}

    {% if currentUser.isLinked %}
        <p style="margin-bottom: 20px;"><strong>Linked to user account #{{ currentUser.linkedUser.id }}</strong></p>
    {% endif %}

    {% for row in craft.lantra.userProfileFields('userEdit') %}
        {% switch row.field %}
            {% case 'fullName' %}
                <div class="field--wrapper">
                    <label for="firstName" class="no-float">First Name</label>
                    {% if currentUser.isLinked %}
                        <p>{{ currentUser.linkedUser.firstName }}</p>
                    {% else %}
                        <input {{ row.required ? 'required' }} name="firstName" type="text" class="float-label" placeholder="Enter your first name"
                            value="{{ formUser.firstName }}">
                    {% endif %}
                </div>
                <div class="field--wrapper">
                    <label for="lastName" class="no-float">Last Name</label>
                    {% if currentUser.isLinked %}
                        <p>{{ currentUser.linkedUser.lastName }}</p>
                    {% else %}
                        <input {{ row.required ? 'required' }} name="lastName" type="text" class="float-label" placeholder="Enter your last name"
                            value="{{ formUser.lastName }}">
                    {% endif %}
                </div>
            {% case 'email' %}
                <div class="field--wrapper">
                    <label for="email" class="no-float">{{ row.label ?: 'Email'  }}</label>
                    {% if currentUser.isLinked %}
                        <p>{{ currentUser.linkedUser.email }}</p>
                    {% else %}
                        <input {{ row.required ? 'required' }} name="email" type="text" class="float-label" placeholder="Enter your email"
                            value="{{ formUser.email }}">
                    {% endif %}
                </div>
            {% case 'userDateOfBirth' %}
                <div class="field--wrapper">
                    {% if currentUser.isLinked %}
                        <label>Date of birth</label>
                        <p>{{ currentUser.linkedUser.userDateOfBirth|date(dateFormat) }}</p>
                    {% else %}
                        {% include '_includes/date' with {label: row.label ?: 'Date of birth', name:'fields[userDateOfBirth]', value: formUser.userDateOfBirth, ys: now.year - 10, ye: now.year - 100} %}
                    {% endif %}
                </div>
            {% case 'userAddress' %}
                <div class="field--wrapper">
                    <label for="address" class="no-float">{{ row.label ?: 'Address' }}</label>
                    {% if currentUser.isLinked %}
                        <p>{{ currentUser.linkedUser.userAddress }}</p>
                    {% else %}
                        <textarea {{ row.required ? 'required' }} id="address" name="fields[userAddress]" class="float-label"
                            placeholder="Enter the address">{{ formUser.userAddress|default('') }}</textarea>
                    {% endif %}
                </div>
            {% case 'userTelephone' %}
                <div class="field--wrapper">
                    <label for="telephone" class="no-float">{{ row.label ?: 'Telephone' }}</label>
                    {% if currentUser.isLinked %}
                        <p>{{ currentUser.linkedUser.userTelephone }}</p>
                    {% else %}
                        <input {{ row.required ? 'required' }} type="text" id="telephone" name="fields[userTelephone]" class="float-label"
                            placeholder="Enter the telephone" value="{{ formUser.userTelephone|default('') }}">
                    {% endif %}
                </div>
            {% case 'userStartDate' %}
                <div class="field--wrapper">
                    {% include '_includes/date' with {label: row.label ?: 'Start date', name:'fields[userStartDate]', value: formUser.userStartDate, ys: now.year + 5, ye: now.year - 50} %}
                </div>
            {% case 'userRole' %}
                <div class="field--wrapper">
                    <label for="telephone" class="no-float">{{ row.label ?: 'Role' }}</label>
                    {% set roleCategories = craft.categories.group('roles').all() %}
                    <input type="hidden" name="fields[userRole]" value=""/>
                    <select multiple class="js-select2" name="fields[userRole][]" id="userRole">
                        {% for roleCategory in roleCategories %}
                            <option value="{{ roleCategory.id }}"
                                    {% if roleCategory.id in formUser.userRole.ids() %}
                                    selected="selected{% endif %}">{{ roleCategory.title }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% case 'photo' %}
                {% if craft.lantra.userProfileField('photo', 'userEdit') %}
                    <p class="profile">{{ row.label ?: 'Change your profile picture:' }}</p>
                    {{ input('file', 'photo', null, {
                        id: 'photo',
                        accept: 'image/png,image/jpeg',
                    }) }}
                {% endif %}
        {% endswitch %}
    {% endfor %}

    {% for row in craft.lantra.userCustomFields('userEdit') %}
        <div class="field--wrapper">
            <label for="custom-{{ row.name }}" class="no-float">{{ row.label }}:</label>
            {% set userCustomBlock = formUser.customFields.customName('='~row.name).one() %}
            {% set fieldId = userCustomBlock|length ? userCustomBlock.id : 'new'~loop.index %}
            <input type="hidden" name="fields[customFields][{{ fieldId }}][type]" value="customField">
            <input type="hidden" name="fields[customFields][{{ fieldId }}][enabled]" value="1">
            <input type="hidden" name="fields[customFields][{{ fieldId }}][fields][customName]"
                   value="{{ row.name }}"/>
            <input {{ row.required ? 'required' }} type="text" id="custom-{{ row.name }}" class="float-label"
                   name="fields[customFields][{{ fieldId }}][fields][customValue]"
                   value="{{ userCustomBlock.customValue|default('') }}">
        </div>
    {% endfor %}

    <div class="container-btn">
        <button class="button no-shadow primary-bg" style="margin:0px;"><span>Save Profile</span></button>
    </div>
</form>
