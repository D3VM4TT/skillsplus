{% set taskbookGroups = craft.categories.group('taskbookGroups').level(1).all() %}
{% if packageUserId is not defined %}
    {% set packageUserId = currentUser.id %}
{% endif %}
{% if not taskbookGroups|length %}
    <div class="field--wrapper">
        <p style="color:red;">There are currently no {{ taskbookLabel }} groups available.</p>
    </div>
{% else %}
    <div class="field--wrapper">
        <label for="packageTaskbookGroup" class="no-float">Please select which {{ taskbookLabel|lower }}
            you wish to create:</label>
        <select class="package-taskbook-group" name="fields[packageTaskbookGroup][]">
            {% for taskbookGroup in taskbookGroups %}
                {% set packageExists = craft.lantra.packageExists(packageUserId, taskbookGroup.id) %}
                <option {% if entry is defined and packageTaskbookGroup and packageTaskbookGroup.id == taskbookGroup.id %}selected {% endif %}
                        data-minimum="{{ taskbookGroup.moduleMinimumOptional }}"
                        data-revision="{{ packageExists ? 1 : 0 }}"
                        value="{{ taskbookGroup.id }}">{{ taskbookGroup.title }}{{ packageExists ? ' (revision)' : '' }}</option>
            {% endfor %}
        </select>
        <input id="package-revision" type="hidden" name="fields[packageRevision]" value="0" />
    </div>
    {% if craft.lantra.setting('taskbookLevels') %}
        <div class="field--wrapper">
            <label for="packageLevel" class="no-float">Please select the level you would like to
                achieve:</label>
            <select class="package-level" name="fields[packageLevel]">
                {% for option in craft.lantra.taskbookLevels() %}
                    <option {% if entry is defined and entry.packageLevel == option.value %}selected {% endif %}
                            value="{{ option.value }}">{{ option.label }}</option>
                {% endfor %}
            </select>
        </div>
    {% endif %}
    {% for taskbookGroup in taskbookGroups %}
        {% set optionalTaskbookGroups = craft.categories.group('taskbookGroups').descendantOf(taskbookGroup).level(2).all() %}
        {% if optionalTaskbookGroups|length %}
            {% include '_forms/taskbookOptional' with {optionalTaskbookGroups: optionalTaskbookGroups, taskbookGroup: taskbookGroup, entry: entry is defined ? entry} %}
        {% endif %}
    {% endfor %}
{% endif %}
<script id="input-template" type="text/template">
    {% set blocktype = craft.lantra.spBlockType('packageOptionalTaskbookGroups') %}
    <input type="hidden" class="optional-hidden" name="fields[packageOptionalTaskbookGroups][new{n}][type]"
           value="{{ blocktype.id }}"/>
    <input type="hidden" class="optional-hidden" name="fields[packageOptionalTaskbookGroups][new{n}][enabled]" value="1"/>
    <input type="hidden" class="optional-hidden"
           name="fields[packageOptionalTaskbookGroups][new{n}][fields][optionalTaskbookGroup][]"
           value="{optionalTaskbookGroupId}"/>
    {% if craft.lantra.setting('taskbookLevels') %}
        <input type="hidden" class="optional-hidden"
               name="fields[packageOptionalTaskbookGroups][new{n}][fields][optionalLevel]" value="{optionalLevel}"/>
    {% endif %}
</script>

{% if options is defined and options %}
    {{ hiddenInput('fields[packagePaid]', 0) }}
    <div class="field--wrapper">
        <label for="packagePaid">
            <input type="checkbox" id="packagePaid" name="fields[packagePaid]" value="1"
               {% if entry is not defined or entry.packagePaid %}checked="checked"{% endif %}>
            <span>Set as paid?</span>
        </label>
    </div>
{% endif %}