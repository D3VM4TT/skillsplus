{% set taskbooks = craft.entries.section('taskbooks').all() %}
{% if packageUserId is not defined %}
    {% set packageUserId = currentUser.id %}
{% endif %}
{% if not taskbooks|length %}
    <div class="field--wrapper">
        <p style="color:red;">There are currently no {{ taskbookLabel|pluralize }} available.</p>
    </div>
{% else %}
    <div class="field--wrapper">
        <label for="packageModuleGroup" class="no-float">Please select which {{ taskbookLabel|lower }}
            you wish to create:</label>
        <select class="package-taskbook" name="fields[packageTaskbook][]">
            {% for taskbook in taskbooks %}
                {% set packageExists = craft.lantra.packageExists(packageUserId, taskbook.id) %}
                <option {% if entry is defined and packageTaskbook and packageTaskbook.id == taskbook.id %}selected {% endif %}
                        data-minimum="{{ taskbook.moduleMinimumOptional }}"
                        data-revision="{{ packageExists ? 1 : 0 }}"
                        value="{{ taskbook.id }}">{{ taskbook.title }}{{ packageExists ? ' (revision)' : '' }}</option>
            {% endfor %}
        </select>
        <input id="package-revision" type="hidden" name="fields[packageRevision]" value="0" />
    </div>
    {% if craft.lantra.setting('taskbookLevels') %}
        <div class="field--wrapper">
            <label for="packageLevel" class="no-float">Please select the level you would like to
                achieve:</label>
            <select class="package-level" name="fields[packageLevel]">
                {% for option in craft.lantra.taskbookLevels() %}
                    <option {% if entry is defined and entry.packageLevel == option.value %}selected {% endif %}
                            value="{{ option.value }}">{{ option.label }}</option>
                {% endfor %}
            </select>
        </div>
    {% endif %}
    {% for taskbook in taskbooks %}
        {% include '_forms/taskbookModuleGroups' with {taskbook: taskbook, entry: entry is defined ? entry} %}
    {% endfor %}
{% endif %}
<script id="input-template" type="text/template">
    <input type="hidden" class="optional-hidden" name="optional[{n}][id]" value="{moduleGroupId}"/>
    {% if craft.lantra.setting('taskbookLevels') %}
        <input type="hidden" class="optional-hidden" name="optional[{n}][level]" value="{moduleGrouplLevel}"/>
    {% endif %}
</script>

{% if options is defined and options %}
    {{ hiddenInput('fields[packagePaid]', 0) }}
    <div class="field--wrapper">
        <label for="packagePaid">
            <input type="checkbox" id="packagePaid" name="fields[packagePaid]" value="1"
               {% if entry is not defined or entry.packagePaid %}checked="checked"{% endif %}>
            <span>Set as paid?</span>
        </label>
    </div>
{% endif %}