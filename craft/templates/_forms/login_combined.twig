<form method="post" accept-charset="UTF-8">
    {{ getCsrfInput() }}
    <input type="hidden" id="loginAction" name="action" value="users/login">
    <input type="hidden" name="redirect" value="/">
    {% if errors is defined %}
        {{ ui.errorList(errors) }}
    {% endif %}
    {% if errorMessage is defined %}
        <p>{{ errorMessage }}</p>
    {% endif %}
    <div class="login-form">
        <div class="log-in-toggle" id="log-in-div">
            <div class="field--wrapper" style="">
                <label for="fname" style="" class="show">Email address</label>
                <input name="loginName" class="float-label" placeholder="Email address" value="{{ craft.session.rememberedUsername }}">
            </div>
            <div class="field--wrapper last" style="">
                <label for="fname" style="" class="show">Password</label>
                <input type="password" name="password" id="password" class="float-label"
                       placeholder="Password" style="">
                <span class="password-showhide">
                              <span class="trigger-password">Show</span>
                              </span>
                <div class="sml-link right" id="remember-me">
                    <label>
                        <input type="checkbox" name="rememberMe" value="1">
                        <span class="remember-me-txt">Remember me</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="reset-form-toggle" id="reset-div">
            <p>Enter the email address you use to log in to your account and we'll email you with
                instructions on how you can reset your password.</p>
            <div class="field--wrapper" style="">
                <label for="fname" style="" class="show">Email address</label>
                <input name="loginName" class="float-label" placeholder="Email address" style="">
            </div>
        </div>
        <div class="container-btn container-log-in-btn">
            <input type="submit" id="submit" class="log-in-btn" value="Log in">
        </div>
        <div class="sml-link reset">
            <a href="/login/reset" class="reset">Forgotten your password?</a>
        </div>
    </div>
</form>