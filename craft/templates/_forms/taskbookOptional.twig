<div class="taskbook-optional taskbook-optional-{{ taskbookGroup.id }}">
    {% if optionalTaskbookGroups|length  %}
        <label>Below are the optional modules you can choose to complete along with core.
        {% if taskbookGroup.moduleMinimumOptional %}
           <br />You must select at least {{ taskbookGroup.moduleMinimumOptional }} optional {{ 'module'|pluralize(qty=taskbookGroup.moduleMinimumOptional) }}.
        {% endif %}
        </label>
        <table class="data">
            <thead>
            <tr>
                <th width="50%">Module Group</th>
                <th width="50%">Selected</th>
            </tr>
            </thead>
            <tbody>
            {% for optionalTaskbookGroup in optionalTaskbookGroups %}
                {% set packageOptionalTaskbookGroupRow = craft.lantra.getOptionalTaskbookGroupRow(entry, optionalTaskbookGroup.id)  %}
                <tr class="optional-module">
                    <td>{{ optionalTaskbookGroup.title }}</td>
                    {% if craft.lantra.setting('taskbookLevels') %}
                    <td>
                        <select class="optional-level" name="optionalLevel">
                            {% for option in craft.lantra.taskbookLevels() %}
                                <option {% if packageOptionalTaskbookGroupRow and packageOptionalTaskbookGroupRow.moduleLevel == option.value %}selected {% endif %} value="{{ option.value }}">{{ option.label }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    {% endif %}
                    <td>
                        <input class="optional" type="checkbox" name="optionalTaskbookGroup" value="{{ optionalTaskbookGroup.id }}" {% if packageOptionalTaskbookGroupRow %}checked{% endif %}>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div style="font-size: 12px; font-style: italic; margin-bottom:20px; text-align: right;">
        {% for row in taskbookGroup.moduleCosts %}
           Core + {{ row.optionalModules }} module: £{{ row.cost }}<br />
        {% endfor %}
            Max Cost: £{{ taskbookGroup.moduleMaxCost }}</p>
        {% if taskbookGroup.moduleMinimumOptional %}
            Minimum optional modules: {{ taskbookGroup.moduleMinimumOptional }}
        {% endif %}
        </div>
    {% else %}
        <p>There are currently no optional modules for {{ taskbookGroup.title }}.</p>
        <p>&nbsp;</p>
    {% endif %}
</div>