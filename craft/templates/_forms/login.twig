<form id="formLogin" method="post" accept-charset="UTF-8">
    {{ getCsrfInput() }}
    <input type="hidden" name="action" value="users/login">
    <input type="hidden" name="redirect" value="/">
    <div class="field--wrapper" style="">
        <label for="loginName" style="" class="show">Email address</label>
        <input id="loginName" name="loginName" class="float-label" placeholder="Email address" value="{{ craft.session.rememberedUsername }}">
    </div>
    <div class="field--wrapper last" style="">
        <label for="password" style="" class="show">Password</label>
        <input type="password" name="password" id="password" class="float-label" placeholder="Password" style="">
        <span class="password-showhide">
            <span class="trigger-password">Show</span>
        </span>
        <div class="sml-link right" id="remember-me">
            <label>
                <input type="checkbox" name="rememberMe" value="1">
                <span class="remember-me-txt">Remember me</span>
            </label>
        </div>
    </div>
    <div class="container-btn container-log-in-btn">
        <input type="submit" id="submit" class="log-in-btn" value="Log in">
    </div>
    <div class="sml-link toggle">
        <a href="/login/reset" class="reset">Forgotten your password?</a>
    </div>
</form>
