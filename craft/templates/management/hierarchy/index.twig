{% set hierarchyNode = craft.request.getParam('node') %}

{% extends "_layout" %}
{% block content %}
    <section class="page">
        <div class="page-header">
            <h2>Hierarchy</h2>
            <p>Navigate your scheme hierarchy and Add / Edit Companies and Users.</p>
        </div>
        <div class="page-content">
            <div id="jstree">
                <ul>
                    <li>Hierarchy
                        <ul>
                            <li>Loading...</li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </section>
{% endblock %}
{% block js %}
<script type="text/javascript" src="/assets/js/vendor/jqtree/jstree.min.js"></script>
<script type="text/javascript" src="/assets/js/vendor/jqtree/jstree-actions.min.js"></script>
<script>
    $(function () {
        $('#jstree').jstree({
            'core' : {
                'data' : [
                    {{ craft.lantra.jsTreeData(currentUser.id, craft.request.getParam('node'))|raw }}
                ]
            },
            "plugins" : ["actions"]
        }).bind('ready.jstree', function (event, data) {
            {% if hierarchyNode %}
                $("#jstree").jstree('select_node', 'node-{{ hierarchyNode }}');
                $("#jstree").jstree('open_node', 'node-{{ hierarchyNode }}', function(e,d) {
                    for (var i = 0; i < e.parents.length; i++) {
                        $("#jstree").jstree('open_node', e.parents[i]);
                    };
                });
            {%  endif %}
        });

        $('#jstree').jstree(true).add_action("all", {
            "id"        : "action_edit",
            "class"     : "button-hierarchy button-edit pull-right",
            "title"     : "Edit",
            "text"      : "Edit",
            "after"     : true,
            "selector"  : "a",
            "event"     : "click",
            "callback": function(node_id, node, action_id, action_el){
                var nodeType    = node.original.nodeType,
                    nodeId      = node.original.nodeId,
                    elementId   = node.original.elementId;
                location.href="/management/" + nodeType + "/edit/" + elementId + "?node=" + nodeId;
            }
        });
        $('#jstree').jstree(true).add_action("all", {
            "id"        : "action_company",
            "class"     : "button-hierarchy button-company pull-right",
            "title"     : "Add Company",
            "text"      : "Add Company",
            "after"     : true,
            "selector"  : "a",
            "event"     : "click",
            "callback": function(node_id, node, action_id, action_el){
                var nodeId      = node.original.nodeId,
                    elementId      = node.original.elementId;
                location.href="/management/companies/new/?node=" + nodeId + "&parent=" + elementId;
            }
        });
        {% if globalsScheme.schemeTeams|default(false) %}
        $('#jstree').jstree(true).add_action("all", {
            "id"        : "action_team",
            "class"     : "button-hierarchy button-team pull-right",
            "title"     : "Add Team",
            "text"      : "Add Team",
            "after"     : true,
            "selector"  : "a",
            "event"     : "click",
            "callback": function(node_id, node, action_id, action_el){
                var nodeId      = node.original.nodeId,
                    elementId      = node.original.elementId;
                location.href="/management/teams/new/?node=" + nodeId + "&company=" + elementId;
            }
        });
        {%  endif %}
        $('#jstree').jstree(true).add_action("all", {
            "id"        : "action_user",
            "class"     : "button-hierarchy button-user pull-right",
            "title"     : "Add User",
            "text"      : "Add User",
            "after"     : true,
            "selector"  : "a",
            "event"     : "click",
            "callback": function(node_id, node, action_id, action_el){
                var nodeId      = node.original.nodeId,
                    nodeType    = node.original.nodeType,
                    elementId   = node.original.elementId;
                location.href="/management/users/new/?node=" + nodeId + "&" + (nodeType == 'companies' ? 'company' : 'team') + "=" + elementId;
            }
        });
    });
    </script>
{% endblock %}

{% block css %}
    <link rel="stylesheet" type="text/css" href="/assets/js/vendor/jqtree/themes/default/style.min.css" />
    <style>
    .button-hierarchy {
        background: #1C2B39;
        padding:3px 5px 3px 3px;
        display: inline-block;
        border-radius: 3px;
        font-size: 10px;
        color:white;
        cursor: pointer;
        line-height: 10px;
        text-align: center;
        margin-right:5px;
    }
    #j1_1 > i.button-hierarchy,
    .type-label > i.button-hierarchy,
    .type-users > i.button-team,
    .type-users > i.button-company,
    .type-users > i.button-user,
    .type-teams > i.button-team,
    .type-teams > i.button-company {
        display:none !important;
    }
    .jstree-default .jstree-clicked {
        background: #c3e2ff;
        border-radius: 2px;
        box-shadow: none;
    }
    </style>
{% endblock %}