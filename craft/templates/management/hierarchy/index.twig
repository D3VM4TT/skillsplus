{% requirePermission 'editCategories:1' %}

{% extends "_layout" %}

{# {% set metaTitle = "Management > Roles" %} #}
{# {% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set pageLimit = globalsSystem.defaultLimit|default(10) %} #}

{# {% set criteria = craft.categories('roles').limit(pageLimit) %}
{% if criteria %}{% paginate criteria as pageInfo, roleCategories %}{% endif %} #}

{% block content %}
<section class="list">
    
    <div class="page-header">
        <h2>Hierarchy</h2>
    </div>
    <div class="table-actions">
        <a href="/management/companies/new?openat=-1" class="button primary-bg button--lg">Create Company</a>
        <a href="/management/teams/new?openat=-1" class="button primary-bg button--lg">Create Team</a>
        <a href="/management/users/new?openat=-1" class="button primary-bg button--lg">Create User</a>
    </div>
    <div id="container">
        <ul>
            <li>Companies
                <ul>
                    <li>Loading...</li>
                </ul>
            </li>
        </ul>
    </div>
</section>
{% endblock %}

{% if currentUser.isInGroup('schemeManagers') %}
    {% set companies = craft.entries.section('companies').order('title') %}
{% else %}
    {% set companies = craft.entries.section('companies').id('not ' ~ craft.lantra.individualCompanyId()).order('title') %}
{% endif %}

{% block js %}
<script type="text/javascript" src="/assets/js/vendor/jqtree/jstree.min.js"></script>
<script type="text/javascript" src="/assets/js/vendor/jqtree/jstree-actions.min.js"></script>
<script>
$(document).ready(function() {
    $('#container').jstree({
        'core' : {
            'data' : [
                {
                    "icon"  : '/assets/img/tree-root.png',
                    "text" : "Companies",
                    "state" : {"opened" : true },
                    "children" : [


                    {% for company in companies if company.companyParent | length == 0 %}
                            {% set companyTitle = company.title %}
                            {% set companyManager = company.companyManager %}
                        {
                            "text" : "{{ company.title }}",
                            "entryId"    : "{{ company.id }}",
                            "recipients"    : "companyId={{ company.id }}",
                            "nodeType" : "companies",
                            "icon"  : '/assets/img/group.svg',
                            {% if company.id == craft.request.getParam('openat') %}
                            "state"       : {
                                "opened"    : true,
                                "selected" : true
                            },
                            {% endif %}
                            {% set teams = craft.entries.section('teams').id('not ' ~ craft.lantra.individualTeamId()).search(companyTitle) %}
                            "children" : 
                            [

                                {% include 'management/hierarchy/tree--leaves' %}

                                {% set childCompanies = craft.entries.section('companies').relatedTo(company) %}

                                {% if childCompanies | length > 0 %}
                                    
                                    {% for childCompany in childCompanies %}
                                        {% set companyTitle = childCompany.title %}
                                        {% set companyManager = childCompany.companyManager %}
                                        {% set teams = craft.entries.section('teams').id('not ' ~ craft.lantra.individualTeamId()).search(companyTitle) %}
                                {
                                    "text" : "{{ childCompany.title }}",
                                    "entryId"    : "{{ childCompany.id }}",
                                    "recipients"    : "companyId={{ childCompany.id }}",
                                    "nodeType" : "companies",
                                    "icon"  : '/assets/img/group.svg',
                                    "children" : [
                                            {% include 'management/hierarchy/tree--leaves' with {
                                                'company' : childCompany
                                            } %}
                                        ]
                                    },
                                    {% endfor %}

                                
                                {% endif %}


                                ]

                        },
                    {% endfor %}

                    ]
                }
            ]
        },
        "plugins" : ["actions"]
    });
    $('#container').jstree(true).add_action("all", {
        "id": "action_edit",
        "class": "button-hierarchy pull-right",
        "title": "Edit",
        "text": "Edit",
        "after": true,
        "selector": "a",
        "event": "click",
        "callback": function(node_id, node, action_id, action_el){
            var nodeType = node.original.nodeType;
            var entryId = node.original.entryId;
            location.href="/management/"+nodeType+"/edit/"+entryId+"?openat="+entryId;
        }
    });
    {% if currentUser.admin %}        
    $('#container').jstree(true).add_action("all", {
        "id": "action_email",
        "class": "button-hierarchy button--green pull-right",
        "title": "Email",
        "text": "Email",
        "after": true,
        "selector": "a",
        "event": "click",
        "callback": function(node_id, node, action_id, action_el){
            var nodeType = node.original.nodeType;
            var recipients = node.original.recipients;
            window.open("/admin/mailer/?"+recipients);
        }
    });
    {% endif %}

});
</script>

{% endblock %}

{% block css %}
<link rel="stylesheet" type="text/css" href="/assets/js/vendor/jqtree/themes/default/style.min.css" />
<style>
#action--buttons {
    margin:1em 0;
}
.table-actions .button {
    width: 200px;
    margin: 0 20px;
    text-align: center;
}

.button-hierarchy {
    background: #1C2B39;
    padding:3px 5px 3px 3px;
    display: inline-block;
    border-radius: 3px;
    font-size: 10px;
    color:white;
    cursor: pointer;
    line-height: 10px;
    text-align: center;
    margin-right:5px;
}
.button--green {
    background: green;
}
.button--lg {
    padding:1em;
    font-size:16px;
}
.button--lg:hover {
    text-decoration: underline;
    color:white;
    background-color: rgba(28,43,57, 0.7);
}
#j1_1 > i.button-hierarchy.pull-right {display:none;}
.hide-actions > i.button-hierarchy {display:none;}
.jstree-default .jstree-clicked {
    background: #c3e2ff;
    border-radius: 2px;
    box-shadow: none;
}
</style>
{% endblock %}