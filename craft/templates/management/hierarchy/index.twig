{% set hierarchyNode = craft.app.request.getParam('node') %}

{% extends "_layout" %}
{% block content %}
<div class="page-subHeader primary-bg">
{% include '_includes/topNavigation' %}
</div>
    <section class="page">
        <div class="page-header secondary-bg">
            <h2>Hierarchy</h2>
            <p>Add / Edit Companies, Teams and Users within your Scheme Hierarchy.</p>
        </div>
        <div class="page-content">
            <div style="margin-bottom:20px;">
                <a class="button no-shadow primary-bg" href="/sp/users/refresh-hierarchy" style="margin-left:0;">
                    <span>Refresh Hierarchy</span>
                </a>
            </div>
            <div id="jstree"></div>
        </div>
    </section>
{% endblock %}
{% block js %}
<script type="text/javascript" src="/assets/js/vendor/jqtree/jstree.min.js"></script>
<script type="text/javascript" src="/assets/js/vendor/jqtree/jstree-actions.min.js"></script>
<script>
    $(function () {

        // copy hover effect to parent li
        $("#jstree").on('mouseenter', '.jstree-anchor', function() {
            if ($(this).attr('id') != 'j1_1_anchor') {
                $(this).closest('li').addClass('row-hover');
            }
        });
        $("#jstree").on('mouseleave', '.jstree-anchor', function() {
            if ($(this).attr('id') != 'j1_1_anchor') {
                $(this).closest('li').removeClass('row-hover');
            }
        });
        $("#jstree").on("select_node.jsTree", function (evt, data) {
            if (data.node.a_attr.href != "#" & data.event.bubbles) {
                window.open(data.node.a_attr.href, data.node.a_attr.target);
            }
        });
        // load hierarchy
        $('body').addClass('loading');
        $('#jstree').jstree({
            'plugins' : ['actions', 'json_data'],
            'core': {
                'data': {
                    'url': function (node) {
                        if (node.id == '#') {
                            return "/sp/users/hierarchy";
                        }
                        return "/sp/users/hierarchy?companyId=" + node.original.elementId +"&type=" + node.original.nodeType;
                    }
                }
            }
        }).bind('ready.jstree', function (event, data) {
            $('body').removeClass('loading');
            {% if hierarchyNode %}
            {# opening node only works if we know the id #}
            $("#jstree").jstree('select_node', 'node-{{ hierarchyNode }}');
            $("#jstree").jstree('open_node', 'node-{{ hierarchyNode }}', function(e,d) {
                for (var i = 0; i < e.parents.length; i++) {
                    $("#jstree").jstree('open_node', e.parents[i]);
                };
            });
            {%  endif %}
        });

        /*
        $('#jstree').jstree(true).add_action("all", {
            "id"        : "action_dashboard",
            "class"     : "button-hierarchy button-dashboard pull-right",
            "title"     : "Dashboard",
            "text"      : "Dashboard",
            "after"     : true,
            "selector"  : "a",
            "event"     : "click",
            "callback": function(node_id, node, action_id, action_el){
                var nodeId      = node.original.nodeId,
                    elementId   = node.original.elementId;
                location.href="/cpd/" + elementId;
            }
        });
        */

        {% if not currentUser.managerReadOnly %}

        $('#jstree').jstree(true).add_action("all", {
            "id"        : "action_edit",
            "class"     : "button-hierarchy button-edit pull-right",
            "title"     : "Edit",
            "text"      : "",
            "after"     : true,
            "selector"  : "a",
            "event"     : "click",
            "callback": function(node_id, node, action_id, action_el){
                var nodeType    = node.original.nodeType,
                    nodeId      = node.original.nodeId,
                    elementId   = node.original.elementId;
                if (nodeType == 'company') {
                    var page = 'companies';
                }
                if (nodeType == 'user') {
                    var page = 'users';
                }
                if (nodeType == 'team') {
                    var page = 'teams';
                }
                location.href="/management/" + page + "/edit/" + elementId + "?node=" + nodeId;
            }
        });
        $('#jstree').jstree(true).add_action("all", {
            "id"        : "action_company",
            "class"     : "button-hierarchy button-company pull-right",
            "title"     : "Add Company",
            "text"      : "",
            "after"     : true,
            "selector"  : "a",
            "event"     : "click",
            "callback": function(node_id, node, action_id, action_el){
                var nodeId      = node.original.nodeId,
                    elementId      = node.original.elementId;
                location.href="/management/companies/new/?node=" + nodeId + "&parent=" + elementId;
            }
        });
        {% if craft.lantra.setting('schemeTeams', false) %}
        $('#jstree').jstree(true).add_action("all", {
            "id"        : "action_team",
            "class"     : "button-hierarchy button-team pull-right",
            "title"     : "Add Team",
            "text"      : "",
            "after"     : true,
            "selector"  : "a",
            "event"     : "click",
            "callback": function(node_id, node, action_id, action_el){
                var nodeId      = node.original.nodeId,
                    elementId      = node.original.elementId;
                location.href="/management/teams/new/?node=" + nodeId + "&company=" + elementId;
            }
        });
        {%  endif %}
        $('#jstree').jstree(true).add_action("all", {
            "id"        : "action_user",
            "class"     : "button-hierarchy button-user pull-right",
            "title"     : "Add User",
            "text"      : "",
            "after"     : true,
            "selector"  : "a",
            "event"     : "click",
            "callback": function(node_id, node, action_id, action_el){
                var nodeId      = node.original.nodeId,
                    nodeType    = node.original.nodeType,
                    elementId   = node.original.elementId;
                location.href="/management/users/new/?node=" + nodeId + "&" + (nodeType == 'company' ? 'company' : 'team') + "=" + elementId;
            }
        });

        $('#jstree').on('activate_node.jstree', function (e, data) {
            if (data == undefined || data.node == undefined || data.node.id == undefined)
                return;
            if (data.node.original.nodeType == 'user')
                location.href="/cpd/" + data.node.original.elementId;
        });

        {%  endif %}
    });

    </script>
{% endblock %}

{% block css %}
    <link rel="stylesheet" type="text/css" href="/assets/js/vendor/jqtree/themes/default/style.min.css" />
    <style>
    .button-hierarchy {
        background: #1C2B39;
        padding:3px 5px 3px 3px;
        display: inline-block;
        border-radius: 3px;
        font-size: 10px;
        color:white;
        cursor: pointer;
        line-height: 10px;
        text-align: center;
        margin-right:5px;
    }
    #j1_1 > i.button-hierarchy,
    .type-label > i.button-hierarchy,
    .type-label > i.button-dashboard,
    .type-users > i.button-hierarchy,
    .type-teams > i.button-hierarchy,
    .type-managers > i.button-hierarchy,
    .type-children > i.button-hierarchy,
    .type-company > i.button-dashboard,
    .type-team > i.button-dashboard,
    .type-user > i.button-user,
    .type-user > i.button-company {
        display:none !important;
    }{
        display:none !important;
    }
    .jstree-default .jstree-hovered {
        background: none!important;
    }
    li.type-user.row-hover,
    li.type-company.row-hover {
        background-color: #f7f7fa!important;
    }
    li.row-hover ul.jstree-children,
    .jstree .jstree-open > .jstree-children {
        background-color: #FFF!important;
    }
    </style>
{% endblock %}