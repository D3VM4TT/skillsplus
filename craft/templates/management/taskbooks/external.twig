{% if not craft.lantra.setting('taskbooks')  %}
    {% exit 404 %}
{% endif %}
{% do craft.lantra.requirePermission('editTaskbooks') %}
{% extends "_layout" %}
{% set taskbookLabel = craft.lantra.setting('taskbookLabel', 'Taskbook') %}
{% set metaTitle = "Management > " ~ taskbookLabel|pluralize ~ " > External" %}
{% set pageTitle = taskbookLabel|pluralize ~ " - External" %}

{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}
{% set filterSearch = craft.app.request.getParam('search')|default('') %}
{% set filterExternalStatus = craft.app.request.getParam('filter')|default('all') %}

{% set filterDateFrom = craft.app.request.getParam('date-from') %}
{% set filterDateTo = craft.app.request.getParam('date-to') %}
{% set filterCompany = craft.app.request.getParam('company')|default('all') %}

{% set sortParam = craft.app.request.getParam('sort') %}
{% set validSorts = ['title', 'id', 'dateCreated', 'packageStatus'] %}
{% set sort = sortParam in validSorts ? sortParam : 'title' %}
{% set order = craft.app.request.getParam('order') == 'desc' ? 'desc' : 'asc' %}

{% set criteria = craft.lantra.packagesCriteria(filterSearch, pageLimit, sort ~ ' ' ~ order, 'external', filterExternalStatus, filterDateFrom, filterDateTo, filterCompany) %}

{% if criteria %}{% paginate criteria as pageInfo, packageEntries %}{% endif %}

{% block content %}
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <section class="page">
        <div class="page-header secondary-bg">
            <h2>{{ pageTitle }}</h2>
            <p>View {{ taskbookLabel|pluralize }}</p>.</p>
            <div class="header-controls">
                <div class="header-search">{% include '_includes/filter' with{filterDays:false, filterExternalStatus:filterExternalStatus, filterCompany:filterCompany} %}</div>
            </div>
        </div>
        {% if packageEntries is defined and packageEntries|length %}
            <div class="page-content">
                {% if filterExternalStatus != 'all' %}
                    <p style="margin-bottom: 30px;">Select complete {{ taskbookLabel|pluralize|lower }} below to {{ filterExternalStatus == 'sampled' ? 'unsample' : 'sample' }} for external review.</p>
                {% endif %}
                <form id="external" method="post" accept-charset="UTF-8">
                <table class="data">
                    {{ csrfInput() }}
                    {{ actionInput('sp/packages/external-status') }}
                    {{ hiddenInput('userId', currentUser.id) }}
                    {{ hiddenInput('externalStatus', filterExternalStatus == 'sampled' ? 'notSampled' : 'sampled') }}
                    <thead>
                    <tr>
                        <th>{% if filterExternalStatus == 'all' %}Sampled{% endif %}</th>
                        <th><a href="?sort=id&order={{ order == 'desc' ? 'asc' : 'desc' }}">ID</a></th>
                        <th><a href="?sort=dateCreated&order={{ order == 'desc' ? 'asc' : 'desc' }}">Date Created</a></th>
                        <th>Company</th>
                        <th>Member</th>
                        <th>{{ taskbookLabel }}</th>
                        <th>Current Step</th>
                        <th>Current Reviewer</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for package in packageEntries %}
                        {% set user = package.author %}
                        {% set nextStepReviewer = package.nextStepReviewer %}
                        {% set company = craft.lantra.userCompany(user.id) %}
                        <tr>
                            <td>
                                {% if filterExternalStatus == 'all' %}
                                    {{ package.externalStatus == 'sampled' ? 'Sampled' : 'Not Sampled' }}
                                {% else %}
                                    <input name="ids[]" type="checkbox" value="{{ package.id }}" />
                                {% endif %}
                            </td>
                            <td><p class="td-title-responsive">ID: </p>{{ user.id }}</td>
                            <td><p class="td-title-responsive">Date Created: </p>{{ package.dateCreated|date(dateFormat) }}</td>
                            <td><p class="td-title-responsive">Company: </p>{{ company.title }}</td>
                            <td><p class="td-title-responsive">Member: </p><a href={{ craft.lantra.packageUrl(user.id, package.id) }}>{{ user.fullname }}</a></td>
                            <td><p class="td-title-responsive">Taskbook: </p>
                                <a href="/cpd/{{ package.author.id }}/taskbooks/{{ package.id }}">{{ package.taskbook.title }}</a>
                            </td>
                            <td><p class="td-title-responsive">Current Step:</p>{{ package.nextStep ? package.nextStep.reviewStepName }}</td>
                            <td><p class="td-title-responsive">Current Reviewer:</p>{{ package.nextStep and nextStepReviewer ? nextStepReviewer.fullName }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% if filterExternalStatus != 'all' %}
                    <div class="container-btn">
                        <button type="submit" class="button primary-bg">{{ filterExternalStatus == 'sampled' ? 'Unsample' : 'Sample' }} Selected</button>
                    </div>
                {% endif %}
                </form>
                {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
            </div>
        {% else %}
            <div class="page-content">
                <h3>There are no packages to display.</h3>
            </div>
        {% endif %}
    </section>
{% endblock %}
