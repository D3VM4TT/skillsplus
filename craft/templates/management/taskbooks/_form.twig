{% do craft.lantra.requirePermission('editTaskbooks') %}
{% set packageId = craft.app.request.getSegment(4) %}
{% if packageId and package is not defined %}
    {% set package = craft.entries.id(packageId).one %}
{% endif %}
{% set isAdmin = currentUser.admin or currentUser.isInGroup('schemeManagers') %}

{% extends "_layout" %}
{% import "_macros" as ui %}
{% set metaTitle = "Management > Taskbooks" %}

{% block content %}
    <div class="page-subHeader primary-bg">
        <a class="back-link" href="/management/taskbook-assessments"><strong>&laquo; back</a>
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <h2>Manage taskbook</h2>
        <p>{{ package.author.fullName  }} - {{ package.coreModule.title }}</p>
    </div>

    {{ ui.errorList(package.getFirstErrors()) }}

    <form class="page-form" method="post" role="form" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('sp/users/update-package') }}
        <input type="hidden" name="packageId" value="{{ package.id }}">
        {% if package.canAssign() %}
            <label>Assigned Managers</label>
            <table class="data">
                <thead>
                    <tr>
                        <th>Step</th>
                        <th>Manager</th>
                    </tr>
                </thead>
            {% for step in package.packageReviews %}
                {% if package.canAssignStep(step) %}
                <tr>
                    <td>{{ step.reviewStepName }}</td>
                    <td>
                        {% set userCompanyManagers = craft.users.group('companyManagers').limit(null).orderBy('lastName') %}
                        <select name="step[{{ step.id }}][manager]">
                            <option value="">Select Manager:</option>
                            {% for cm in userCompanyManagers %}
                                <option value="{{ cm.id }}"{% if step.reviewUser and step.reviewUser.id == cm.id %} selected{% endif %}>{{ cm.fullname }}</option>
                            {% endfor %}
                        </select>
                    </td>
                </tr>
                {% endif %}
            {% endfor %}
            </table>
        {% endif %}

            <div class="field--wrapper">
                <label for="packageStatus" class="">Status:</label>
                <select name="packageStatus">
                    <option value="active"{% if package.packageStatus == 'active' %} selected{% endif %}>Active</option>
                    <option value="assessed"{% if package.packageStatus == 'assessed' %} selected{% endif %}>Assessed</option>
                    <option value="reviewed"{% if package.packageStatus == 'reviewed' %} selected{% endif %}>Reviewed</option>
                    <option value="complete"{% if package.packageStatus == 'complete' %} selected{% endif %}>Complete</option>
                  </select>
            </div>
            <div class="field--wrapper">
                <label for="packageComment" class="">Comment:</label>
                <textarea name="packageComment"></textarea>
            </div>
            <div class="container-btn">
                <button class="button primary-bg" type="submit">Update package</button>
            </div>

        {% include '_includes/packageLog' with {package:package, admin:true} %}
    </form>
{% endblock %}
