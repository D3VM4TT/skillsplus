{% do craft.lantra.requirePermission('editTaskbooks') %}
{% set packageId = craft.app.request.getSegment(4) %}
{% if packageId and package is not defined %}
    {% set package = craft.entries.id(packageId).one %}
{% endif %}
{% set review = craft.app.request.getSegment(5) == 'review' %}

{% set isAdmin = currentUser.admin or currentUser.isInGroup('schemeManagers') %}
{% set nextStep = package.nextStep %}

{% extends "_layout" %}
{% import "_macros" as ui %}
{% set metaTitle = "Management > Taskbooks" %}

{% block content %}
    <div class="page-subHeader primary-bg">
        <a class="back-link" href="{{ craft.lantra.packageUrl(package.author.id, package.id) }}"><strong>&laquo; back</a>
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <h2>Manage taskbook</h2>
        <p>{{ package.author.fullName  }} - {{ package.moduleGroup.title }}</p>
    </div>

    {{ ui.errorList(package.getFirstErrors()) }}

    <form class="page-form" method="post" role="form" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('sp/packages/update-package') }}
        <input type="hidden" name="packageId" value="{{ package.id }}">
        {% if review  %}
            {% include 'management/taskbooks/_review' %}
        {% else %}
            {% include 'management/taskbooks/_assign' %}
        {% endif %}
        {% include '_includes/packageLog' with {package:package, admin:true} %}
    </form>
{% endblock %}
