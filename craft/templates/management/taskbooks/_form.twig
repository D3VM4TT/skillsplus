{% do craft.lantra.requirePermission('editPackages') %}

{% set authorId = craft.app.request.getRequiredParam('userId') %}
{% set user = craft.app.users.getUserById(authorId) %}
{% if not user %}{% exit 404 %}{% endif %}

{% extends "_layout" %}
{% import "_macros" as ui %}
{% set metaTitle = "Management > Taskbooks" %}

{% set packageModuleGroup = entry is defined and entry.packageModuleGroup ? entry.packageModuleGroup.one : null %}
{% set section = craft.sections.getSectionByHandle('packages') %}
{% set isTaskbooks = true %}
{% set taskbookLabel = craft.lantra.setting('taskbookLabel', 'Taskbook') %}

{% set entryId = craft.app.request.getSegment(4) %}
{% if entryId and entry is not defined %}
    {% set entry = craft.entries.id(entryId).one %}
    {% if not entry %}{% exit 404 %}{% endif %}
{% endif %}

{% set authorId = craft.app.request.getParam('userId') %}
{% set user = craft.app.users.getUserById(authorId) %}
{% set userCompany = user.userCompany.one() %}

{% block content %}
    <div class="page-subHeader primary-bg">
        <a class="back-link" href="/management/taskbooks"><strong>&laquo; back</a>
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <h2>{{ entryId ? 'Edit' : 'Create' }} {{ taskbookLabel }} for {{ user.fullname }}</h2>
    </div>

    {% if not userCompany %}
        <p style="color:red;">Only users assigned to a company can create {{ taskbookLabel|pluralize|lower  }}.</p>
    {% else %}
        {% set levelsOptions = '' %}
        {% for option in craft.lantra.taskbookLevels() %}
            {% set levelsOptions = levelsOptions ~ '<option value="' ~ option.value ~ '">' ~ option.label ~ '</option>' %}
        {% endfor %}

        {% if entry is defined %}
            {{ ui.errorList(entry.getFirstErrors()) }}
        {% endif %}

        <form class="page-form" id="taskbooks" method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('entries/save-entry') }}
            {{ hiddenInput('sectionId', section.id) }}
            {{ hiddenInput('enabled', 1) }}
            {{ redirectInput('management/users/edit/' ~ authorId) }}
            {{ hiddenInput('author[]', authorId) }}

            {% include '_forms/taskbook' with {packageUserId:authorId, options:true, taskbooks:userCompany.companyTaskbooks} %}

            <div class="container-btn">
                <button type="submit" class="button primary-bg">Continue</button>
            </div>
        </form>
    {% endif %}
{% endblock %}
