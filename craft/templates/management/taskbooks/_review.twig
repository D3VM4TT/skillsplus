<table class="data">
    <thead>
        <th>{{ taskbookLabel }}</th>
        <th>Result</th>
        <th>Comment</th>
    </thead>
    <tbody>
    {% for assessment in package.packageAssessment %}
        {% set enabled = not assessment.assessmentDate %}
        {% set moduleGroup = assessment.assessmentModuleGroup.one %}
        {% if moduleGroup %}
        <tr>
            <td style="width:25%;">{{ moduleGroup.title }}</td>
            <td style="width:10%;">
                <select {% if not enabled %} disabled{% endif %} id="result-{{ assessment.id }}" name="assessments[{{ assessment.id }}][assessmentPassed]">
                    <option value="1"{% if not enabled and assessment.assessmentPassed %} selected{% endif %}>Passed</option>
                    <option value="0"{% if not enabled and not assessment.assessmentPassed %} selected{% endif %}>Failed</option>
                </select>
            </td>
            <td style="width:60%;">
                <textarea {% if not enabled %} disabled{% endif %} rows="4" style="width:100%;" id="comment-{{ assessment.id }}" name="assessments[{{ assessment.id }}][assessmentComment]">{{ assessment.assessmentComment }}</textarea>
            </td>
        </tr>
        {% endif %}
    {% endfor %}
    </tbody>
</table>
{% for step in package.packageReviews %}
    {% set workflowStep = package.getPackageWorkflowStep(step.reviewStepId) %}
    {% if nextStep and step.id == nextStep.id and package.isReviewUser(currentUser, nextStep, true) %}
        <h2>{{ step.reviewStepName }}</h2>
        {% if step.reviewStepType == 'review' or step.reviewStepType == 'complete' %}
            <div class="field--wrapper">
                <input type="hidden" name="steps[{{ nextStep.id }}][sampled]" value="0" />
                <label for="reviewSampled">Sampled: <input id="reviewSampled" type="checkbox" name="steps[{{ nextStep.id }}][sampled]" value="1" /></label>
            </div>
        {% endif %}
        <div class="field--wrapper">
            <label for="reviewResult">Result:</label>
            <select id="reviewResult" name="steps[{{ nextStep.id }}][result]">
                <option value="">Please select:</option>
                <option value="1">Complete</option>
                <option value="0">Retry</option>
            </select>
        </div>
        <div class="field--wrapper">
            <label for="comment">Comment:</label>
            <textarea name="steps[{{ nextStep.id }}][comment]"></textarea>
        </div>
        <div class="field--wrapper">
            {{ workflowStep ? workflowStep.stepMessage : '' }}
        </div>
        <div class="container-btn">
            <button class="button primary-bg" type="submit">Submit Result</button>
        </div>
    {% elseif step.reviewDate|length %}
        <h2>{{ step.reviewStepName }}</h2>
        <p>{{ step.reviewDate|date(dateFormat) }}</p>
        {% if step.stepType == 'review' or step.stepType == 'complete' %}
        <p>{{ step.reviewSampled ? 'Sampled' : 'Not Sampled'  }}</p>
        {% endif %}
        <div class="field--wrapper">
            <label for="result">Review Step Result:</label>
            <select disabled id="result" name="steps[{{ step.id }}][result]">
                <option{% if step.reviewPassed == '' %} selected{% endif %} value="">Please select:</option>
                <option{% if step.reviewPassed == 1 %} selected{% endif %}  value="1">Complete</option>
                <option{% if step.reviewPassed == 0 %} selected{% endif %}  value="0">Retry</option>
            </select>
        </div>
        <div class="field--wrapper">
            <label for="comment">Comment:</label>
            <textarea disabled name="steps[{{ step.id }}][comment]"> {{ step.reviewComment }}</textarea>
        </div>
    {% endif %}
{% endfor %}