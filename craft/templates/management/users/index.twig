{% requirePermission 'editUsers' %}

{% extends "_layout" %}

{% set metaTitle = "Management > Users" %}
{% set pageTitle = "Users" %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}
{% set filterSearch = craft.app.request.getParam('search')|default('') %}
{% set filterUserStatus = craft.app.request.getParam('status')|default('active') %}
{% set userStatus = filterUserStatus == 'suspended' ? 'suspended' : null %}
{% set sortParam = craft.app.request.getParam('sort') %}
{% set validSorts = ['lastName', 'id', 'legacyId', 'userCompanyName'] %}
{% set sort = sortParam in validSorts ? sortParam : 'lastName' %}
{% set order = craft.app.request.getParam('order') == 'desc' ? 'desc' : 'asc' %}

{# company users #}
{% set companyId = false %}
{% if craft.app.request.segment(3) == 'company' and craft.app.request.segment(4) %}
    {% set companyId = craft.app.request.segment(4) %}
    {% set company = craft.entries.id(companyId).one() %}
    {% set pageTitle = company.title %}
{% endif %}

{% set criteria = craft.lantra.userCriteria(filterSearch, filterUserStatus, companyId, pageLimit, sort ~ ' ' ~ order) %}

{% if criteria%}{% paginate criteria as pageInfo, userEntries %}{% endif %}

{% block content %}
<div class="page-subHeader primary-bg">
    {% if companyId and craft.app.request.referrer %}
        <a class="back-link" href="{{ craft.app.request.referrer }}">&laquo; back to Companies</a>
    {% endif %}
{% include '_includes/topNavigation' %}
</div>
<section class="page">
    <div class="page-header secondary-bg">
        <h2>{{ pageTitle }}</h2>
        <p>Add, Edit and view the Dashboard of Users within {{ companyId ? company.title : 'your Scheme' }}.</p>
                    <div class="header-controls">
                {% if not companyId %}
                    <div class="header-search">{% include '_includes/filter' with{filterDays:false, filterUserStatus:filterUserStatus} %}</div>
                {% endif %}
                {% if not currentUser.managerReadOnly %}
                    <div class="container-btn primary-bg">
                    {#<button class="btn-add-new primary-bg">#}
                    <a class="btn-add-new" href="/management/users/new">Add a New User</a>
                    {#</button>#}
                    </div>
                {% endif %}
            </div>
    </div>
    {% if userEntries is defined and userEntries|length %}
    <div class="page-content">
        <table class="data">
            <thead>
            <tr>
                <th style="width:30px;"></th>
                {% for row in craft.lantra.userProfileFields('tableColumn') %}
                <th>
                {% switch row.field %}
                {% case 'id' %}
                    <a href="?sort=id&order={{ order == 'desc' ? 'asc' : 'desc' }}">ID</a>
                {% case 'legacyId' %}
                    <a href="?sort=legacyId&order={{ order == 'desc' ? 'asc' : 'desc' }}">Legacy ID</a>
                {% case 'fullName' %}
                    <a href="?sort=lastName&order={{ order == 'desc' ? 'asc' : 'desc' }}">Name</a>
                {% case 'userCompany' %}
                    <a href="?sort=userCompanyName&order={{ order == 'desc' ? 'asc' : 'desc' }}">Company</a>
                {% case 'userLocation' %}
                    <a href="?sort=userLocation&order={{ order == 'desc' ? 'asc' : 'desc' }}">Location</a>
                {% case 'role' %}
                    <a href="?sort=role&order={{ order == 'desc' ? 'asc' : 'desc' }}">Role</a>
                {% case 'lastLogin' %}
                    Last Login
                {% endswitch %}
                </th>
                {% endfor %}
                <th>&nbsp;</th>
            </tr>
            </thead>
            <tbody>
            {% for user in userEntries %}
                {% set company = craft.lantra.userCompany(user.id) %}
                {% set managerCompanies = [] %}
                {% if user.isInGroup('companyManagers') %}
                    {% set primaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: user, field: 'companyPrimaryManagers'}).limit(null) %}
                    {% set secondaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: user, field: 'companySecondaryManagers'}).limit(null) %}
                    {% set managerCompanies = primaryManagerCompanies|merge(secondaryManagerCompanies) %}
                {% endif %}
                <tr class="type-{{ user.userType }}">
                    <td>{% if user.userType == 'manager' %}<a class="icon" href="#"><img src="/assets/img/manager.svg"></a>{% endif %}</td>
                    {% for row in craft.lantra.userProfileFields('tableColumn') %}
                        <td>
                            {% switch row.field %}
                            {% case 'id' %}
                                <p class="td-title-responsive">ID: </p>{{ user.id }}
                            {% case 'legacyId' %}
                                <p class="td-title-responsive">Legacy ID: </p>{{ user.legacyId == 0 ? '~' : user.legacyId }}
                            {% case 'fullName' %}
                                <p class="td-title-responsive">Name: </p><a title="Dashboard" href="/cpd/{{ user.id }}">{{ user.fullname }}</a> {% if user.status == 'suspended' %}(suspended){% endif %}
                            {% case 'userCompany' %}
                                <p class="td-title-responsive">Company: </p>{{ company ? company.title }}
                            {% case 'userLocation' %}
                                <p class="td-title-responsive">Location: </p>{{ company ? company.companyLabel }}
                            {% case 'role' %}
                                <p class="td-title-responsive">Role: </p>
                                {% if user.userRole.count %}
                                    {% for role in user.userRole %}{{ role.title }}{% if loop.index != loop.length %}, {% endif %}{% endfor %}
                                {% else %}
                                    ~
                                {% endif %}
                            {% case 'lastLogin' %}
                                <p class="td-title-responsive">Last Login:</p>{{ user.lastLoginDate ? user.lastLoginDate|date('d/m/y H:i') : 'Never' }}
                            {% endswitch %}
                        </td>
                    {% endfor %}
                    <td class="icons" style="width:140px;text-align:right">
                        {% if not user.userDummyEmail %}
                            <a class="icon" href="mailto:{{ user.email }}"><img src="/assets/img/email.svg" title="Email" /></a>
                        {% endif %}
                        {% if not currentUser.managerReadOnly %}
                            <a class="icon" href="/management/users/edit/{{ user.id }}"><img src="/assets/img/edit.svg" title="Edit" /></a>
                            {% if user.status == 'active' %}
                                <a class="icon action" href="#" data-action="users/suspend-user" data-id="{{ user.id }}"><img src="/assets/img/suspend.svg" title="Suspend" /></a>
                            {% elseif currentUser.isInGroup('schemeManagers') or currentUser.admin %}
                                <a class="icon action" href="#" data-action="users/restore-user" data-id="{{ user.id }}"><img src="/assets/img/endorse.svg" title="Restore" /></a>
                            {% endif %}
                            {#
                            {% if currentUser.isInGroup('schemeManagers') or currentUser.admin %}
                                | <a class="action" href="#" data-action="users/delete-user" data-id="{{ user.id }}">delete</a>
                            {% endif %}
                            #}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
        <div class="page-content">
            <h3>There are no users to display.</h3>
    {% endif %}
    </div>
</section>
{% endblock %}
