{% requirePermission 'editUsers' %}

{% extends "_layout" %}

{% set metaTitle = "Management > Users" %}
{% set pageTitle = "Users" %}
{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set pageLimit = globalsSystem.defaultLimit|default(10) %}
{% set filterSearch = craft.request.getParam('search')|default('') %}
{% set sortParam = craft.request.getParam('sort') %}
{% set validSorts = ['lastName', 'id', 'legacyId', 'userCompanyName'] %}
{% set sort = sortParam in validSorts ? sortParam : 'lastName, userCompanyName' %}
{% set order = craft.request.getParam('order') == 'desc' ? 'desc' : 'asc' %}
{% set excludeIdsString = 'not ' ~ currentUser.id %}

{# company users #}
{% set companyId = false %}
{% if craft.request.segment(3) == 'company' and craft.request.segment(4) %}
    {% set companyId = craft.request.segment(4) %}
    {% set company = craft.entries.id(companyId).first() %}
    {% set pageTitle = pageTitle ~ " > " ~ company.title %}
{% endif %}

{% if filterSearch and craft.users.id(filterSearch).total() %}
    {% set excludeIdsString = filterSearch %}
    {% set filterSearch = '' %}
{% endif %}

{% if currentUser.isInGroup('schemeManagers') or currentUser.admin %}
    {% if companyId %}
        {% set criteria = craft.users.status(null).admin('not 1').relatedTo(companyId).limit(pageLimit).order(sort ~ ' ' ~ order) %}
    {% else %}
        {% set criteria = craft.users.status(null).admin('not 1').id(excludeIdsString).search(filterSearch).limit(pageLimit).order(sort ~ ' ' ~ order) %}
    {% endif %}
{% elseif currentUser.isInGroup('companyManagers') %}
    {% if companyId %}
        {% set companies = [companyId] %}
    {% else %}
        {% set companies = craft.lantra.managerCompanies(currentUser.id, true) %}
    {% endif %}
    {% set teams = craft.entries.section('teams').relatedTo(companies) %}
    {% set criteria = craft.users.admin('not 1').group(['users', 'teamManagers']).relatedTo("or", { targetElement: companies }, { targetElement: teams }).id(excludeIdsString).search(filterSearch).limit(pageLimit).order(sort ~ ' ' ~ order)  %}
{% elseif currentUser.isInGroup('teamManagers') %}
    {% set teams = craft.entries.section('teams').relatedTo(currentUser) %}
    {% set criteria = craft.users.admin('not 1').group('users, teamManagers').relatedTo(teams).id(excludeIdsString).search(filterSearch).limit(pageLimit).order(sort ~ ' ' ~ order)  %}
{% endif %}

{% if criteria%}{% paginate criteria as pageInfo, userEntries %}{% endif %}

{% block content %}
<div class="page-subHeader primary-bg">
{% include '_includes/topNavigation' %}
</div>
<section class="page">
    <div class="page-header secondary-bg">
        <h2>{{ pageTitle }}</h2>
        <p>Add, Edit and view the Dashboard of Users within {{ companyId ? company.title : 'your Scheme' }}.</p>
                    <div class="header-controls">
                {% if not companyId %}
                    <div class="header-search">{% include '_includes/filter' with{filterDays:false} %}</div>
                {% endif %}
                {% if not currentUser.managerReadOnly %}
                    <div class="container-btn primary-bg">
                    {#<button class="btn-add-new primary-bg">#}
                    <a class="btn-add-new" href="/management/users/new">Add a new User</a>
                    {#</button>#}
                    </div>
                {% endif %}
            </div>
    </div>
    {% if userEntries is defined and userEntries|length %}
    <div class="page-content">
        <table class="data">
            <thead>
            <tr>
                <th><a href="?sort=id&order={{ order == 'desc' ? 'asc' : 'desc' }}">ID</a></th>
                <th><a href="?sort=legacyId&order={{ order == 'desc' ? 'asc' : 'desc' }}">Legacy ID</a></th>
                <th class="title"><a href="?sort=lastName&order={{ order == 'desc' ? 'asc' : 'desc' }}">Name</a></th>
                <th><a href="?sort=userCompanyName&order={{ order == 'desc' ? 'asc' : 'desc' }}">Company</a></th>
                {% if globalsScheme.schemeTeams|default(false) %}
                    <th>Team</th>
                {% endif %}
                <th>&nbsp;</th>
            </tr>
            </thead>
            <tbody>
            {% for user in userEntries %}
                {% set company = craft.lantra.userCompany(user.id) %}
                {% set managerCompanies = [] %}
                {% if user.isInGroup('companyManagers') %}
                    {% set primaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: user, field: 'companyPrimaryManager'}).limit(null) %}
                    {% set secondaryManagerCompanies = craft.entries.section('companies').relatedTo({targetElement: user, field: 'companySecondaryManagers'}).limit(null) %}
                    {% set managerCompanies = primaryManagerCompanies|merge(secondaryManagerCompanies) %}
                {% endif %}
                <tr>
                    <td><p class="td-title-responsive">ID: </p>{{ user.id }}</td>
                    <td><p class="td-title-responsive">Legacy ID: </p>{{ user.legacyId == 0 ? '~' : user.legacyId }}</td>
                    <td><p class="td-title-responsive">Name: </p>{{ user.fullname }} {% if user.status == 'suspended' %}(suspended){% endif %}</td>
                    <td><p class="td-title-responsive">Company: </p>
                        {% if company %}
                            {{ craft.lantra.companyLabel(company) }}
                        {% elseif managerCompanies|length %}
                            {% for company in managerCompanies %}
                                {{ company.title }}{{ not loop.last ? ', ' }}
                            {% endfor %}
                        {% endif %}
                    </td>
                    {% if globalsScheme.schemeTeams|default(false) %}
                        {% set team = user.userTeam.first() %}
                        <td>{{ team.title|default('') }}</td>
                    {%  endif %}
                    <td>
                        <a href="/cpd/{{ user.id }}">dashboard</a>
                        {% if not currentUser.managerReadOnly %}
                            | <a href="/management/users/edit/{{ user.id }}">edit</a> |
                            {% if user.status == 'active' %}
                                <a class="action" href="#" data-action="lantra/users/deleteUser" data-id="{{ user.id }}">suspend</a>
                            {% elseif currentUser.isInGroup('schemeManagers') or currentUser.admin %}
                                <a class="action" href="#" data-action="lantra/users/restoreUser" data-id="{{ user.id }}">restore</a>
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
        <div class="page-content">
            <h3>There are no users to display.</h3>
        </div>
    {% endif %}
    </div>
</section>
{% endblock %}
