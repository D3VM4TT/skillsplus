{% requirePermission 'editUsers' %}
{% if currentUser.managerReadOnly %}{% redirect 404 %}{% endif %}

{% set jsDateFormat = craft.lantra.setting('jsDateFormat', 'dd-mm-yyyy') %}
{% set dateFormat = craft.lantra.setting('dateFormat', 'd-m-Y') %}

{% extends "_layout" %}
{% import "_macros" as ui %}
{% set metaTitle = "Management > Users" %}

{% set userId = craft.request.getSegment(4) %}
{% if account is not defined and userId %}
    {% set account = craft.users.id(userId).status(null).first %}
    {% if not account %}{% exit 404 %}{% endif %}
{% endif %}

{% set hierarchyNode = craft.request.getParam('node') %}
{% set hierarchyCompany = craft.request.getParam('company') %}
{% set hierarchyTeam = craft.request.getParam('team') %}

{% set companyEntries = craft.entries.section('companies').id('not ' ~ craft.lantra.individualCompanyId()).limit(null).order('companyLabel') %}
{% set isCompanyManager = account is defined and account.isInGroup('companyManagers') or craft.request.getPost('companyManagers') %}

{% block content %}
    <div class="page-subHeader primary-bg">
     {% if hierarchyNode %}
        <a class="back-link" href="/management/hierarchy?node={{ hierarchyNode }}">&laquo; back</a>
    {% else %}
        <a class="back-link" href="/management/users">&laquo; back</a>
    {% endif %}
    {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        {% if account is defined and account.id %}
            <h2>Edit user</h2>
        {% else %}
            <h2>Create a New User</h2>
        {% endif %}
    </div>
    {% if account is defined %}
        {{ ui.errorList(account.getAllErrors()) }}
    {% endif %}
    <form class="page-form" method="post" role="form" accept-charset="UTF-8" autocomplete="off">
        {{ getCsrfInput() }}
        <input type="hidden" name="action" value="lantra/users/saveUser">
        <input type="hidden" name="fields[userDummyEmail]" value="{{ account.userDummyEmail|default(0) }}">
        <input type="hidden" name="editUserId" value="{{ account.id|default('') }}">
        {% if hierarchyNode %}
            <input type="hidden" name="redirect" value="/management/hierarchy?node={{ hierarchyNode }}">
        {% else %}
            <input type="hidden" name="redirect" value="/management/users">
        {% endif %}

        {% if account is defined and account.id %}
            <div id="name-fields">
                <div class="col-6 field--wrapper">
                    <h3>Account ID: {{ account.id }}</h3>
                </div>
            </div>
        {% endif %}
        
        <div id="name-fields">
        <div class="col-6 field--wrapper">
            <label for="firstName" class="no-float"><em class="required">*</em> First name:</label>
            <input type="text" required="required" id="firstName" name="firstName" class="float-label" placeholder="Enter the first name" value="{{ account.firstName|default('') }}">
        </div>
        <div class="col-6 field--wrapper">
            <label for="lastName" class="no-float"><em class="required">*</em> Last name:</label>
            <input type="text" required="required" id="lastName" name="lastName" class="float-label" placeholder="Enter the last name" value="{{ account.lastName|default('') }}">
        </div>
        </div>
        <div id="name-fields">
        <div class="col-6 field--wrapper">
            <label for="email" class="no-float">Email:</label>
            <input type="text" id="email" name="email" class="float-label" placeholder="Enter the email" value="{{ account.email|default('') }}">
        </div>
        <div class="col-6 field--wrapper">
            <label for="dummyEmail" class="no-float">Generate Dummy Email?</label>
            <input type="checkbox" id="dummyEmail" name="fields[userDummyEmail]" value="1" {% if account.userDummyEmail is defined and account.userDummyEmail %}checked="checked"{% endif %}>
        </div>
        </div>
        <div id="date-fields">
        <div class="col-6 field--wrapper">
            {% set startDateValue = account is defined ? account.userStartDate : now %}
            {% include '_includes/date' with {label:'Start date', name:'fields[userStartDate]', value:startDateValue} %}
        </div>
        <div class="col-6 field--wrapper">
            {% set dateOfBirthValue = account is defined ? account.userDateOfBirth : false %}
            {% include '_includes/date' with {label:'Date of birth', name:'fields[userDateOfBirth]', value:dateOfBirthValue} %}
        </div>
        </div>
        <div id="address-fields">
        <div class="col-6 field--wrapper">
            <label for="address" class="no-float">Address:</label>
            <textarea id="address" name="fields[userAddress]" class="float-label" placeholder="Enter the address">{{ account.userAddress|default('') }}</textarea>
        </div>
        <div class="col-6 field--wrapper">
            <label for="telephone" class="no-float">Telephone:</label>
            <input type="text" id="telephone" name="fields[userTelephone]" class="float-label" placeholder="Enter the telephone" value="{{ account.userTelephone|default('') }}">
        </div>
        </div>
        {%  set userCustomFields = craft.lantra.setting('userEditCustomFields') %}
        {%  for block in userCustomFields %}
            <div class="field--wrapper">
                <label for="custom-{{ block.name }}" class="no-float">{{ block.label }}:</label>
                {% set userCustomBlock = account is defined ? account.userCustomFields.customName('='~block.name).first() : null %}
                {% set fieldId = userCustomBlock|length ? userCustomBlock.id : 'new'~loop.index %}
                <input type="hidden" name="fields[userCustomFields][{{ fieldId }}][type]" value="userCustomField">
                <input type="hidden" name="fields[userCustomFields][{{ fieldId }}][enabled]" value="1">
                <input type="hidden" name="fields[userCustomFields][{{ fieldId }}][fields][customName]" value="{{ block.name }}" />
                <input type="text" id="custom-{{ block.name }}" class="float-label" name="fields[userCustomFields][{{ fieldId }}][fields][customValue]" value="{{ userCustomBlock.customValue|default('') }}">
            </div>
        {%  endfor %}
        <h2>User settings</h2>
        {% if account['userReadOnly'] is defined %}
            <div class="field--wrapper">
                <input type="hidden" name="fields[userReadOnly]" value="0">
                <input type="checkbox" id="readOnly" name="fields[userReadOnly]" value="1"
                       {% if account is defined and account.userReadOnly %}checked="checked"{% endif %}>
                <span>Make Read Only User</span>
            </div>
        {% endif %}
        <div class="field--wrapper">
            <label for="userRole">Job Roles (optional):</label>
            {% set roleCategories = craft.categories.group('roles') %}
            <input type="hidden" name="fields[userRole]" value="" />
            <select multiple class="js-select2" name="fields[userRole][]" id="userRole">
                {% for roleCategory in roleCategories %}
                    <option value="{{ roleCategory.id }}"
                            {% if account is defined and roleCategory.id in account.userRole.ids() %} selected="selected{% endif %}">{{ roleCategory.title() }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field--wrapper">
            <label for="userCompany">Primary Location: For Hierarchy and Reporting</label>
            <select data-relation="fields[userCompany]" data-value="{{ account.userCompany.first().id|default(hierarchyCompany) }}" id="userCompany" >
                {% for companyEntry in companyEntries %}
                    <option value="{{ companyEntry.id }}">{{ companyEntry.companyLabel }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field--wrapper">

            {# just in case validation fails #}
            {% if saveUserError is defined and saveUserError %}
                {% set isCompanyManager = craft.request.post('companyManagers')  %}
            {% endif %}
            <div>
                <label style="display:inline-block">
                    <input type="radio" id="userMember" name="companyManagers" value="0" {% if not isCompanyManager %}checked="checked"{% endif %} /> Member
                </label>
            </div>
            <div>
                <label style="display:inline-block">
                    <input type="radio" id="userManager" name="companyManagers" value="1" {% if isCompanyManager %}checked="checked"{% endif %} /> Manager
                </label>
            </div>
        </div>
        <div class="field--wrapper">
            <div id="manager-fields" class="{% if not isCompanyManager %}hide{% endif %}">
                <div class="col-6">
                    <h2>Manager settings</h2>
                    {% if currentUser.isInGroup('schemeManagers') or currentUser.admin %}{% endif %}

                    <div class="field--wrapper">
                        <input type="hidden" name="fields[managerReadOnly]" value="0">
                        <input type="checkbox" id="readOnly" name="fields[managerReadOnly]" value="1"
                               {% if account is defined and account.managerReadOnly %}checked="checked"{% endif %}>
                        <span>Make Read Only Manager</span>
                    </div>

                    {% set secondaryManagerCompanies = [] %}

                    <div class="field--wrapper">
                        <label for="userCompany">Secondary manager companies:</label>

                        {# just in case validation fails #}
                        {% if saveUserError is defined and saveUserError %}
                            {% set postedCompanies = craft.request.post('userSecondaryManagerCompanies') %}
                        {% else %}
                            {% set postedCompanies = [] %}
                        {% endif %}

                        <select multiple class="js-select2" name="userSecondaryManagerCompanies[]" id="userSecondaryManagerCompanies">
                            {% for companyEntry in companyEntries %}
                                {% set selected = '' %}
                                {% if account is defined and account.id in companyEntry.companySecondaryManagers.ids() or companyEntry.id in postedCompanies %}
                                    {% set secondaryManagerCompanies = secondaryManagerCompanies|merge([companyEntry]) %}
                                    {% set selected = ' selected="selected"' %}
                                {% endif %}
                                <option{{ selected }}
                                        value="{{ companyEntry.id }}">{{ companyEntry.companyLabel }}</option>
                            {% endfor %}
                        </select>
                        {% if account is defined %}
                            {% set managerCompanies = craft.lantra.managerCompanies(account) %}
                            {% if managerCompanies|length %}
                                <div class="field--wrapper">
                                    <h3>Existing manager of:</h3>
                                    <p>
                                        {% for company in managerCompanies %}{{ company.title }}<br/>{% endfor %}
                                    </p>
                                </div>
                            {% endif %}
                        {% endif %}
                        {% if craft.lantra.setting('schemeTeams', false) %}
                    </div>
                </div>
                <div class="col-6">
                    <input type="checkbox" id="teamManagers" name="teamManagers" value="1"
                           {% if account is defined and account.isInGroup('teamManagers') or craft.request.getPost('teamManagers') %}checked="checked"{% endif %}>
                         <span>Make Team manager</span>
                    {% endif %}
                    {% if craft.lantra.setting('schemeTeams', false) %}
                        <div id="team-fields" class="hide">
                            <div class="field--wrapper">
                                {#<label for="userCompany">User team:</label>#}
                                {% set teamEntries = craft.entries.section('teams').limit(null) %}
                                <select data-relation="fields[userTeam]"
                                        data-value="{{ account.userTeam.first().id|default(hierarchyTeam) }}" id="userTeam">
                                    <option value="">Select User Team</option>
                                    {% for teamEntry in teamEntries %}
                                        <option value="{{ teamEntry.id }}">{{ craft.lantra.teamLabel(teamEntry) }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        {% if currentUser.isInGroup('schemeManagers') or currentUser.admin %}
            <h2>Advanced</h2>
            <div class="field--wrapper">
                <label for="username" class="no-float">Username:</label>
                <input type="text" autocomplete="off" id="username" name="username" class="float-label" placeholder="Enter the username" value="{{ account.username|default('') }}">
            </div>
            <div class="field--wrapper">
                <label for="password" class="no-float">New Password:</label>
                <input type="password" autocomplete="off" id="password" name="newPassword" class="float-label" placeholder="Enter the password" value="">
            </div>
            <div class="field--wrapper">
                <label for="password" class="no-float">Confirm Password:</label>
                <input type="password" autocomplete="off" id="password" name="confirmPassword" class="float-label" placeholder="Enter the password" value="">
            </div>
        {% endif %}
        <div class="container-btn">
            <button class="button primary-bg" type="submit">Save user</button>
        </div>
    </form>
{% endblock %}
