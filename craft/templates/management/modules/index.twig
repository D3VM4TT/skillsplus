{% requirePermission 'editEntries:6' %}

{% extends "_layout" %}

{% set metaTitle = "Management > Modules" %}
{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set pageLimit = globalsSystem.defaultLimit|default(10) %}
{% set filterSearch = craft.request.getParam('search')|default('') %}

{% set criteria = craft.entries.section('modules').order('title').search(filterSearch).limit(pageLimit) %}
{% if criteria %}{% paginate criteria as pageInfo, moduleEntries %}{% endif %}

{% block content %}

<section class="page">
    <div class="page-header">
        <h2>Modules / Roles</h2>
        {% include '_includes/filter' with{filterDays:false} %}
    </div>
    {% if moduleEntries is defined and moduleEntries|length %}
        <table class="data">
            <thead>
                <tr>
                    <th class="title">Module</th>
                    <th>Job Role</th>
                </tr>
            </thead>
            <tbody>
            {% for module in moduleEntries %}
                {% for role in module.moduleRoles %}
                <tr>
                    <td>{{ module.title }}</td>
                    <td style="text-align: left">{{ role.title }}</td>
                </tr>
                {% endfor %}
            {% endfor %}
            </tbody>
        </table>
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
        <div class="page-content">
            <h3>There are no modules to display.</h3>
        </div>
    {% endif %}
</section>
{% endblock %}
