{% requirePermission 'editCategories:1' %}

{% extends "_layout" %}

{# {% set metaTitle = "Management > Roles" %} #}
{# {% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set pageLimit = globalsSystem.defaultLimit|default(10) %} #}

{# {% set criteria = craft.categories('roles').limit(pageLimit) %}
{% if criteria %}{% paginate criteria as pageInfo, roleCategories %}{% endif %} #}

{% block content %}
<section class="list">
    
    <div class="page-header">
        <h2>Scheme</h2>
    </div>

    <div id="action--buttons">

        <a href="/management/companies/new?openat=-1" class="button button--lg">Create Company</a>
        <a href="/management/teams/new?openat=-1" class="button button--lg">Create Team</a>
        <a href="/management/users/new?openat=-1" class="button button--lg">Create User</a>

    </div>

    <div id="container">
        <ul>
            <li>Companies
                <ul>
                    <li>Loading...</li>
                </ul>
            </li>
        </ul>
    </div>

</section>
{% endblock %}

{% set companies = craft.entries.section('companies').id('not ' ~ craft.lantra.individualCompanyId()).search() %}

{% block js %}
<script type="text/javascript" src="/assets/js/vendor/jqtree/jstree.min.js"></script>
<script type="text/javascript" src="/assets/js/vendor/jqtree/jstree-actions.min.js"></script>
<script>
$(document).ready(function() {
    $('#container').jstree({
        'core' : {
            'data' : [
                {
                    "icon"  : '/assets/img/tree-root.png',
                    "text" : "Companies",
                    "state" : {"opened" : true },
                    "children" : [
                    {% for company in companies %}
                            {% set companyTitle = company.title %}
                            {% set companyManager = company.companyManager %}
                        {
                            "text" : "{{ company.title }}",
                            "entryId"    : "{{ company.id }}",
                            "nodeType" : "companies",
                            "icon"  : '/assets/img/group.svg',
                            {% if company.id == craft.request.getParam('openat') %}
                            "state"       : {
                                "opened"    : true,
                                "selected" : true
                            },
                            {% endif %}
                            {% set teams = craft.entries.section('teams').id('not ' ~ craft.lantra.individualTeamId()).search(companyTitle) %}
                            "children" : [
                                {% for user in company.companyManager %}
                                    {
                                        "text" : "Company Manager: {{ user.firstName }} {{ user.lastName }}",
                                        "nodeType" : "users",
                                        "entryId"    : "{{ user.id }}",
                                        "icon"  : '/assets/img/person.svg',
                                        {% if user.id == craft.request.getParam('openat') %}
                                        "state"       : {
                                            "opened"    : true,
                                            "selected" : true
                                        },
                                        {% endif %}
                                    },
                                {% endfor %}                            
                                {% for team in teams %}
                                    {% set teamTitle = team.title %}
                                    {% set teamID = team.id %}
                                {
                                    "text" : "Team: {{ team.title }}",
                                    {% set teamMembers = craft.users.group('users').search(teamTitle) %}
                                    // {% set teamManager = craft.users.group('teamManagers').search(teamTitle) %}
                                    // {% set teamManager = craft.entries.section('teams').search(teamTitle) %}
                                    "nodeType" : "teams",
                                    "entryId"    : "{{ team.id }}",
                                    "icon"  : '/assets/img/group.svg',
                                    {% if team.id == craft.request.getParam('openat') %}
                                    "state"       : {
                                        "opened"    : true,
                                        "selected" : true
                                    },
                                    {% endif %}
                                    "children" : [
                                    {% for user in teamMembers %}
                                        {
                                            "nodeType" : "users",
                                            "text" : "Team Member: {{ user.firstName }} {{ user.lastName }}",
                                            "entryId"    : "{{ user.id }}",
                                            "icon"  : '/assets/img/person.svg',
                                            {% if user.id == craft.request.getParam('openat') %}
                                            "state"       : {
                                                "opened"    : true,
                                                "selected" : true
                                            },
                                            {% endif %}
                                        },
                                    {% endfor %}
                                    {% for user in team.teamPrimaryManager %}
                                        {
                                            "nodeType" : "users",
                                            "text" : "Team Manager: {{ user.firstName }} {{ user.lastName }}",
                                            "entryId"    : "{{ user.id }}",
                                            "icon"  : '/assets/img/person.svg',
                                            {% if user.id == craft.request.getParam('openat') %}
                                            "state"       : {
                                                "opened"    : true,
                                                "selected" : true
                                            },
                                            {% endif %}
                                        },
                                    {% endfor %}
                                    {% for user in team.teamSecondaryManagers %}
                                        {
                                            "nodeType" : "users",
                                            "text" : "Secondary Manager: {{ user.firstName }} {{ user.lastName }}",
                                            "entryId"    : "{{ user.id }}",
                                            "icon"  : '/assets/img/person.svg',
                                            {% if user.id == craft.request.getParam('openat') %}
                                            "state"       : {
                                                "opened"    : true,
                                                "selected" : true
                                            },
                                            {% endif %}
                                        },
                                    {% endfor %}
                                    ]
                                },
                                {% endfor %}
                            ]
                        },
                    {% endfor %}
                    ]
                }
            ]
        },
        "plugins" : ["actions"]
    });
    $('#container').jstree(true).add_action("all", {
        "id": "action_remove",
        "class": "button pull-right",
        "title": "Edit",
        "text": "Edit",
        "after": true,
        "selector": "a",
        "event": "click",
        "callback": function(node_id, node, action_id, action_el){
            var nodeType = node.original.nodeType;
            var entryId = node.original.entryId;
            location.href="/management/"+nodeType+"/edit/"+entryId+"?openat="+entryId;
        }
    });

});
</script>

{% endblock %}

{% block css %}
<link rel="stylesheet" type="text/css" href="/assets/js/vendor/jqtree/themes/default/style.min.css" />
<style>
#action--buttons {
    margin:1em 0;
}
.button {
    background: #1C2B39;
    padding:3px 5px 3px 3px;
    display: inline-block;
    border-radius: 3px;
    font-size: 10px;
    color:white;
    cursor: pointer;
    line-height: 10px;
    text-align: center;
}
.button--lg {
    padding:1em;
    font-size:16px;
}
.button--lg:hover {
    text-decoration: underline;
    color:white;
    background-color: rgba(28,43,57, 0.7);
}
#j1_1 > i.button.pull-right {display:none;}
.jstree-default .jstree-clicked {
    background: #c3e2ff;
    border-radius: 2px;
    box-shadow: none;
}
</style>
{% endblock %}