{% if not craft.lantra.canManage() %}{% exit 404 %}{% endif %}

{% do craft.lantra.resetEndorsementCount() %}

{% extends "_layout" %}
{% import "_macros" as ui %}

{% set metaTitle = "Management > Endorsements" %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}

{% set filterEndorsedView = craft.app.request.getParam('filterEndorsedView', 'users') %}
{% set filterEndorsedUsers = craft.app.request.getParam('filterEndorsedUsers', 'all') %}
{% set filterUnit = craft.app.request.getParam('filterUnit', 'all') %}
{% set filterModule = craft.app.request.getParam('filterModule', 'all') %}

{% set filterUnitLabel = 'Units' %}

{% set criteria = craft.lantra.managerEndorsementCriteria(null, pageLimit, filterEndorsedView, filterEndorsedUsers, filterModule, filterUnit) %}
{% if criteria %}{% paginate criteria as pageInfo, endorsementResults %}{% endif %}

{% set taskbookModuleIds = craft.lantra.taskbookModuleIds() %}
{% set taskbookModuleIdsString = 'not ' ~ taskbookModuleIds|join(', not ') %}
{% set moduleEntriesCriteria = craft.entries.section('modules').id(taskbookModuleIdsString).order('title') %}
{% set allModuleEntries = moduleEntriesCriteria.all() %}

{% set allUnitEntries = craft.entries.section('units').order('title').relatedTo({
    sourceElement: moduleEntriesCriteria.ids,
    field: 'moduleUnitGroups.unitEntries'
}).all() %}

    {% block content %}
<div class="page-subHeader primary-bg">
{% include '_includes/topNavigation' %}
</div>
<section class="page">
    <div class="page-header secondary-bg">
        <h2>Endorsements</h2>
        <div class="header-search">{% include '_includes/filter' with {filterDays:false, filterHideSearch:true} %}</div>
        <p style="clear: both">
            <strong><a href="/management/endorsements">Reset all filters</a></strong>
        </p>
    </div>
    <div class="page-content">
    {% if endorsementResults is defined and endorsementResults|length %}
            <table class="data">
                <thead>
                    <tr>
                        <th class="title">User ID</th>
                        <th class="title">Name</th>
                        <th class="title">Company</th>
                        <th class="title">Location</th>
                        {% if filterEndorsedView == 'units' %}
                            <th class="title">Unit Title</th>
                        {% endif %}
                </thead>
                <tbody>
                {% for result in endorsementResults %}
                    {% set user = filterEndorsedView == 'users' ? result : result.author %}
                    {% set company = craft.lantra.userCompany(user.id) %}
                    <tr>
                        <td><p class="td-title-responsive">ID: </p>{{ user.id }}</td>
                        <td><p class="td-title-responsive">Name: </p><a href="/cpd/{{ user.id }}">{{ user.fullname }}</a></td>
                        <td><p class="td-title-responsive">Company: </p>{{ company ? company.title }}</td>
                        <td><p class="td-title-responsive">Location: </p>{{ company ? company.companyLabel }}</td>
                        {% if filterEndorsedView == 'units' %}
                            {% set unitTitle = result.resultUnit.one ? result.resultUnit.one.title : result.title %}
                            <td><p class="td-title-responsive">Unit Title: </p>{{ unitTitle }}</td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
            <h3>You have no users to endorse.</h3>
    {% endif %}
    </div>
</section>
{% endblock %}
