{% if not craft.lantra.canManage() %}{% exit 404 %}{% endif %}

{% extends "_layout" %}
{% import "_macros" as ui %}

{% set metaTitle = "Management > Endorsements" %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}
{% set filterDirect = craft.app.request.getParam('direct')|default(false) %}

{% set criteria = craft.lantra.managerEndorsementUsers(null, pageLimit, false, filterDirect) %}
{% if criteria %}{% paginate criteria as pageInfo, endorseUsers %}{% endif %}

{% block content %}
<div class="page-subHeader primary-bg">
{% include '_includes/topNavigation' %}
</div>
<section class="page">
    <div class="page-header secondary-bg">
        <h2>Endorsements - {{ filterDirect ? 'My Direct Members' : 'All Members' }}</h2>
        <p>Display:
        {% if filterDirect %}
            <a href="/management/endorsements">All Members</a>
        {% else %}
            <a href="/management/endorsements?direct=true">My Direct Members</a>
        {% endif %}
        </p>
    </div>
    <div class="page-content">
    {% if endorseUsers is defined and endorseUsers|length %}
            {{ csrfInput() }}
            <table width="100%" class="data">
                <thead>
                    <tr>
                        <th class="title">ID</th>
                        <th class="title">Name</th>
                        <th class="title">Company</th>
                        <th class="title">Location</th>
                </thead>
                <tbody>
                {% for user in endorseUsers %}
                    {% set company = craft.lantra.userCompany(user.id) %}
                    <tr>
                        <td><p class="td-title-responsive">ID: </p>{{ user.id }}</td>
                        <td><p class="td-title-responsive">Name: </p><a href="/cpd/{{ user.id }}">{{ user.fullname }}</a></td>
                        <td><p class="td-title-responsive">Company: </p>{{ company ? company.title }}</td>
                        <td><p class="td-title-responsive">Location: </p>{{ company ? company.companyLabel }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
            <h3>You have no users to endorse.</h3>
    {% endif %}
    </div>
</section>
{% endblock %}
