{% requirePermission 'editEntries:5' %}

{% extends "_layout" %}

{% set metaTitle = "Management > Teams" %}
{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set pageLimit = globalsSystem.defaultLimit|default(10) %}
{% set filterSearch = craft.request.getParam('search')|default('') %}

{% if currentUser.isInGroup('companyManagers') %}
    {% set companies = craft.entries.section('companies').relatedTo(currentUser) %}
    {% set criteria = craft.entries.section('teams').relatedTo(companies).id('not ' ~ craft.lantra.individualTeamId()).search(filterSearch).limit(pageLimit) %}
{% elseif currentUser.isInGroup('schemeManagers') %}
    {% set criteria = craft.entries.section('teams').id('not ' ~ craft.lantra.individualTeamId()).search(filterSearch).limit(pageLimit) %}
{% else %}
    {% set criteria = craft.entries.section('teams').search(filterSearch).limit(pageLimit) %}
{% endif %}

{% if criteria %}{% paginate criteria as pageInfo, teamEntries %}{% endif %}

{% block content %}
<section class="list">
    <div class="page-header">
        <h2>Teams</h2>
    </div>
    {% include '_includes/filter' with{filterDays:false} %}
    {% if teamEntries is defined and teamEntries|length %}
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Company</th>
                        <th>Name</th>
                        <th>&nbsp;</th>
                    </tr>
                </thead>
                <tbody>
                {% for team in teamEntries %}
                    <tr class="item">
                        <th>{{ team.id }}</th>
                        <th>{{ team.teamCompany.first.title }}</th>
                        <th>{{ team.title }}</th>
                        <th>
                            <a href="/management/teams/edit/{{ team.id }}">edit</a> |
                            <a class="action" href="#" data-action="lantra/entries/deleteEntry" data-id="{{ team.id }}">delete</a>
                        </th>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
        <div class="table-actions">
            <h4>There are no teams to display.</h4>
        </div>
    {% endif %}
    <div class="table-actions freetext-procedure">
        <a href="/management/teams/new">Create team</a>
    </div>
</section>
{% endblock %}
