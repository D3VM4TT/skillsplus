{% set moduleId = craft.app.request.getSegment(4) %}
{% set moduleEntry = craft.entries.section('modules').isSkillsMatrix(true).id(moduleId).one %}
{% if not moduleId or not moduleEntry %}
    {% exit 404 %}
{% endif %}

{% extends "_layout" %}
{% import "_macros" as ui %}
{% set metaTitle = "Management > Skills > " ~ moduleEntry.title %}

{% set tableView = craft.app.request.getSegment(5)|default('users') %}
{% set filterStatus = craft.app.request.getParam('filterStatus')|default('all') %}
{% set filterUnitGroup = craft.app.request.getParam('filterUnitGroup')|default('all') %}
{% set filterUnit = craft.app.request.getParam('filterUnit')|default('all') %}

{#  reset unit/unitGroup #}
{% set filterUnitGroup = filterUnit == 'all' ? filterUnitGroup : 'all' %}
{% set filterUnit = filterUnitGroup == 'all' ? filterUnit : 'all' %}

{% set filterMinSkill = craft.app.request.getParam('filterMinSkill')|default('none') %}
{% set filterMaxSkill = craft.app.request.getParam('filterMaxSkill')|default('none') %}

{# returns array of unit and user ids #}
{% set skillsMatrixIds = craft.lantra.skillsMatrixIds(moduleEntry, filterUnitGroup, filterUnit, filterMinSkill, filterMaxSkill, filterStatus) %}

{% set allUnitEntries = craft.entries.section('units').id(skillsMatrixIds['unitIds']) %}

{% set filteredUnitEntries = craft.entries.section('units').id(skillsMatrixIds['filterUnitIds']) %}
{% set users = craft.users.id(skillsMatrixIds['userIds']) %}

{% block content %}
    <div class="page-subHeader primary-bg">
        <a class="back-link" href="/management/skills">&laquo; back</a>
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <h2>{{ moduleEntry.title }}</h2>
        <div class="header-controls">
            <div class="header-search">{% include '_includes/filter' with {filterDays:false, filterHideSearch:true} %}</div>
        </div>
    </div>
    <div class="page-content">
        {% if users.count %}
        <div class="sm-scroll">
            <table class="data">
                <thead>
                    <tr>
                        <th><a class="icon" href="/management/skills/matrix/{{ moduleId }}/{{ tableView == 'users' ? 'units' : 'users' }}?{{ craft.app.request.queryStringWithoutPath }}"><img src="/assets/img/toggle.svg" /></a></th>
                        {% if tableView == 'users' %}
                            {% for user in users %}
                                <th>
                                    <a href="/cpd/{{ user.id }}">
                                        <span title="{{ user.fullName }}" class="sm-dot sm-initials">{{ user.firstName|first }}{{ user.lastName|first }}</span>
                                    </a>
                                </th>
                            {% endfor %}
                        {% else %}
                            {% for unit in filteredUnitEntries %}
                                <th>{{ unit.title }}</th>
                            {% endfor %}
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                {% if tableView == 'users' %}
                    {% for unit in filteredUnitEntries %}
                        <tr>
                            <td>
                                {{ unit.title }}
                            </td>
                            {% for user in users %}
                                <td>
                                    {% include 'management/skills/_result' %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                {% else %}
                    {% for user in users %}
                        <tr>
                            <td>
                                <a href="/cpd/{{ user.id }}">{{ user.fullName }}</a>
                            </td>
                            {% for unit in filteredUnitEntries %}
                                <td>
                                    {% include 'management/skills/_result' %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>
        </div>
        {% else %}
            <h3>There are no users to display.</h3>
        {% endif %}
    </div>
{% endblock %}