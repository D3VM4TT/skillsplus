{% requirePermission 'editEntries:13' %}

{% extends "_layout" %}

{% set metaTitle = "Management > Custom Reports" %}
{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set pageLimit = globalsSystem.defaultLimit|default(10) %}
{% set filterSearch = craft.request.getParam('search')|default('') %}

{% set criteria = craft.entries.section('reports').limit(pageLimit) %}
{% if criteria %}{% paginate criteria as pageInfo, reportEntries %}{% endif %}

{% block content %}
<section class="list">
    <div class="page-header">
        <h2>Custom Reports</h2>
    </div>
    {% if reportEntries is defined and reportEntries|length %}
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Author</th>
                <th>Type</th>
                <th>Frequency</th>
                <th>Last Sent</th>
                <th>&nbsp;</th>
            </tr>
            </thead>
            <tbody>
            {% for report in reportEntries %}
            <tr class="item">
                <td>{{ report.id }}</td>
                <td>{{ report.title }}</td>
                <td>{{ report.author.fullName }}</td>
                <td>{{ report.reportType|title }}</td>
                <td>{{ report.reportSendFrequency|title }}</td>
                <td>{{ report.reportLastSentDate|format(dateFormat)|default('Never') }}</td>
                <td>
                    <a class="action" href="#" data-action="lantra/entries/runReport" data-id="{{ report.id }}">run</a> |
                    <a href="/management/reports/edit/{{ report.id }}">edit</a> |
                    <a class="action" href="#" data-action="lantra/entries/deleteEntry" data-id="{{ report.id }}">delete</a> |
                    <a href="/management/reports/{{ report.id }}">data ({{ report.reportData|length }})</a>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
        <div class="table-actions">
            <h4>There are no reports to display.</h4>
        </div>
    {% endif %}
    <div class="table-actions freetext-procedure">
        <a href="/management/reports/new">Create report</a>
    </div>
</section>
{% endblock %}
