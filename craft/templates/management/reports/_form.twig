{% requirePermission 'editEntries:13' %}

{% extends "_layout" %}
{% import "_macros" as ui %}
{% set metaTitle = "Management > Custom Reports" %}

{% set entryId = craft.request.getSegment(4) %}
{% if entryId and entry is not defined %}
    {% set entry = craft.entries.id(entryId).first %}
{% endif %}

{% block content %}

<div class="page-header">
    {% if entry is defined and entry.id %}
        <h2>Edit report</h2>
    {% else %}
        <h2>Create a new report</h2>
    {% endif %}
    <p><a href="/management/reports">&laquo; back to reports</a></p>
</div>

{% if entry is defined %}
    {{ ui.errorList(entry.getAllErrors()) }}
{% endif %}

<form class="page-form" method="post" role="form" accept-charset="UTF-8">
    {{ getCsrfInput() }}
    <input type="hidden" name="action" value="entries/saveEntry">
    <input type="hidden" name="redirect" value="management/reports">
    <input type="hidden" name="sectionId" value="13">
    <input type="hidden" name="enabled" value="1">
    <input type="hidden" name="entryId" value="{{ entry.id|default('') }}">
    <div class="form-group-lantra float-label-control">
        <label for="title">Report title:</label>
        <input id="title" name="title" class="5000" placeholder="Enter the report title" value="{{ entry.title|default('') }}">
    </div>
    <div class="form-group-lantra float-label-control">
        <label for="reportType">Report type:</label>
        <select name="fields[reportType]" id="reportType">
            <option value="users" {% if entry is defined and entry.reportType == 'users' %} selected="selected{% endif %}">Users</option>
            <option value="results" {% if entry is defined and entry.reportType == 'results' %} selected="selected{% endif %}">Results</option>
        </select>
    </div>
    <div class="form-group-lantra float-label-control">
        <label>Report scope:</label>
    </div>
    <div id="reportScope">
        <div id="reportScopeCompanies">
            <strong>Report companies:</strong>
            <input type="hidden" name="fields[reportCompanies]" value="" />
            <div class="checkboxes" style="border:1px solid #CCC;height:200px;padding:10px;overflow-y:scroll;">
                {% set companyEntries = craft.entries.section('companies') %}
                {% for companyEntry in companyEntries %}
                    <label for="company-{{ companyEntry.id }}" style="display: block;">
                        <input
                            name="fields[reportCompanies][]"
                            data-id="{{ companyEntry.id }}"
                            class="scopeCompany"
                            {% if entry is defined and companyEntry.id in entry.reportCompanies.ids() %} checked{% endif %}
                            id="company-{{ companyEntry.id }}"
                            type="checkbox"
                            value="{{ companyEntry.id }}">
                        {{ companyEntry.title }}
                    </label>
                {% endfor %}
            </div>
            <p style="text-align: right">
                <label for="companies-all">Include data for all companies
                    <input class="scopeAll" name="fields[reportAllCompanies]" {% if entry is defined and entry.reportAllCompanies %} checked{% endif %} id="companies-all" type="checkbox" value="1">
                </label>
            </p>
        </div>
        <div id="reportScopeTeams">
            <strong>Report teams:</strong>
            <input type="hidden" name="fields[reportTeams]" value="" />
            <div class="checkboxes" style="border:1px solid #CCC;height:200px;padding:10px;overflow-y:scroll;">
                {% set teamEntries = craft.entries.section('teams') %}
                {% for teamEntry in teamEntries %}
                    <label class="company-{{ teamEntry.teamCompany.first.id }}" for="team-{{ teamEntry.id }}" style="display: block;">
                        <input
                            name="fields[reportTeams][]"
                            {% if entry is defined and teamEntry.id in entry.reportTeams.ids() %} checked{% endif %}
                            id="team-{{ teamEntry.id }}"
                            type="checkbox"
                            value="{{ teamEntry.id }}">
                        {{ teamEntry.title }}
                    </label>
                {% endfor %}
            </div>
            <p style="text-align: right">
                <label for="teams-all">Include data for all teams
                    <input class="scopeAll" name="fields[reportAllTeams]" {% if entry is defined and entry.reportAllTeams %} checked{% endif %} id="teams-all" type="checkbox" value="1">
                </label>
            </p>
        </div>
        <div id="reportScopeRoles">
            <strong>Report roles:</strong><br />
            <input type="hidden" name="fields[reportRoles]" value="" />
            <div class="checkboxes" style="border:1px solid #CCC;height:200px;padding:10px;overflow-y:scroll;">
                {% set roleCategories = craft.categories('roles') %}
                {% for roleCategory in roleCategories %}
                <label for="role-{{ roleCategory.id }}" style="display: block;">
                    <input
                        name="fields[reportRoles][]"
                        data-id="{{ roleCategory.id }}"
                        class="scopeRole"
                        {% if entry is defined and roleCategory.id in entry.reportRoles.ids() %} checked{% endif %}
                        id="role-{{ roleCategory.id }}"
                        type="checkbox"
                        value="{{ roleCategory.id }}">
                    {{ roleCategory.title }}
                </label>
                {% endfor %}
            </div>
            <p style="text-align: right">
                <label for="roles-all">Include data for all roles
                    <input class="scopeAll" name="fields[reportAllRoles]" {% if entry is defined and entry.reportAllRoles %} checked{% endif %} id="roles-all" type="checkbox" value="1">
                </label><br />
            </p>
        </div>
    </div>

    <div id="modulesResultsFields">
        <div id="reportScopeModules">
            <strong>Report modules:</strong>
            <input type="hidden" name="fields[reportModules]" value="" />
            <div class="checkboxes" style="border:1px solid #CCC;height:200px;padding:10px;overflow-y:scroll;">
                {% set moduleEntries = craft.entries.section('modules') %}
                {% for moduleEntry in moduleEntries %}
                <label class="{% for moduleRole in moduleEntry.moduleRoles %} role-{{ moduleRole.id }}{% endfor %}" style="display: block;">
                    <input
                        name="fields[reportModules][]"
                        {% if entry is defined and moduleEntry.id in entry.reportModules.ids() %} checked{% endif %}
                        id="module-{{ moduleEntry.id }}"
                        type="checkbox"
                        value="{{ moduleEntry.id }}">
                    {{ moduleEntry.title }}
                </label>
                {% endfor %}
            </div>
            <p style="text-align: right">
                <label for="modules-all">Include data for all modules
                    <input class="scopeAll" name="fields[reportAllModules]" {% if entry is defined and entry.reportAllModules %} checked{% endif %} id="modules-all" type="checkbox" value="1">
                </label>
            </p>
        </div>
        <div class="form-group-lantra float-label-control">
            <label for="reportResultExpiry">Result expiry:</label>
            <select name="fields[reportResultExpiry]" id="reportResultExpiry">
                <option value="0" {% if entry is defined and entry.reportResultExpiry == '0' %} selected="selected{% endif %}">Expired</option>
                <option value="30" {% if entry is defined and entry.reportResultExpiry == '30' %} selected="selected{% endif %}">30 days</option>
                <option value="90" {% if entry is defined and entry.reportResultExpiry == '90' %} selected="selected{% endif %}">90 days</option>
                <option value="180" {% if entry is defined and entry.reportResultExpiry == '180' %} selected="selected{% endif %}">180 days</option>
                <option value="365" {% if entry is defined and entry.reportResultExpiry == '365' %} selected="selected{% endif %}">365 days</option>
                <option value="365+" {% if entry is defined and entry.reportResultExpiry == '365+' %} selected="selected{% endif %}">more than 365 days</option>
            </select>
        </div>
    </div>
    <div class="form-group-lantra float-label-control">
        <label for="reportDescription">Report description:</label>
        <textarea id="reportDescription" name="fields[reportDescription]" placeholder="Enter the description">{{ entry.reportDescription|default('') }}</textarea>
    </div>
    <div class="form-group-lantra float-label-control">
        <label for="reportDescription">Report recipients:</label>
        <textarea id="reportRecipients" name="fields[reportRecipients]" placeholder="Enter the recipients (emails separated by a comma)">{{ entry.reportRecipients|default('') }}</textarea>
    </div>
    <div class="form-group-lantra float-label-control">
        <label for="reportSendFrequency">Report send frequency:</label>
        <select name="fields[reportSendFrequency]" id="reportSendFrequency">
            <option value="never" {% if entry is defined and entry.reportSendFrequency == 'never' %} selected="selected{% endif %}">Never</option>
            <option value="weekly" {% if entry is defined and entry.reportSendFrequency == 'weekly' %} selected="selected{% endif %}">Weekly</option>
            <option value="monthly" {% if entry is defined and entry.reportSendFrequency == 'monthly' %} selected="selected{% endif %}">Monthly</option>
        </select>
    </div>
    <div class="form-group-lantra float-label-control">
        <label for="reportSendValue">Report send day (1-7 for weekly):</label>
        <select name="fields[reportSendValue]" id="reportSendValue">
            {% for day in range(1, 31) %}
                <option value="{{ day }}">{{ day }}</option>
            {% endfor %}
        </select>
    </div>


    <br />
    <div class="freetext-procedure"><button type="submit">Save report</button></div>
</form>

{% endblock %}
