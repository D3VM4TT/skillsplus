{% requirePermission 'editEntries:3' %}

{% extends "_layout" %}

{% set metaTitle = "Management > companies" %}
{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set pageLimit = globalsSystem.defaultLimit|default(10) %}
{% set filterSearch = craft.request.getParam('search')|default('') %}

{% if currentUser.isInGroup('schemeManagers') %}
    {% set criteria = craft.entries.section('companies').search(filterSearch).limit(pageLimit).order('title') %}
{% else %}
    {% set criteria = craft.entries.section('companies').id('not ' ~ craft.lantra.individualCompanyId()).search(filterSearch).limit(pageLimit).order('title') %}
{% endif %}
{% if criteria %}{% paginate criteria as pageInfo, companyEntries %}{% endif %}

{% block content %}
<div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
        </div>
<section class="page">
     <div class="page-header secondary-bg">
         <h2>Companies</h2>
         <p>Add / Edit and Delete companies within in your scheme.</p>
            <div class="header-controls">
                <div class="header-search">{% include '_includes/filter' with{filterDays:false} %}</div>
                {% if not currentUser.managerReadOnly %}
                    <div class="container-btn primary-bg">
                    {#<button class="btn-add-new primary-bg">#}
                    <a class="btn-add-new" href="/management/companies/new">Add a new Company</a>
                    {#</button>#}
                    </div>
               {% endif %}
           </div>

     </div>
     {% if companyEntries is defined and companyEntries|length %}
     <div class="page-content">

         <table class="data">
             <thead>
                 <tr>
                    <th>ID</th>
                     <th class="title">Name</th>
                     <th class="title">Parent</th>
                     <th class="title">Primary Manager</th>
                     <th class=""></th>
                     <th class=""></th>
                     <th class=""></th>
                     <th class=""></th>
                     <th class=""></th>
                 </tr>
            <tbody>
            {% for company in companyEntries %}
            {% set parent = company.companyParent.first %}
            {% set primaryManager = company.companyPrimaryManager.first %}
            {% set userCount = craft.lantra.userCount(company.id) %}
                <tr>
                    <td><p class="td-title-responsive">ID: </p>{{ company.id }}</td>
                    <td><p class="td-title-responsive">Name: </p>{{ company.title }}</td>
                    <td><p class="td-title-responsive">Parent: </p>{{ parent.title|default('~ none ~') }}</td>
                    <td>
                        {% if primaryManager %}
                            <p class="td-title-responsive">Primary Manager: </p>
                            <a href="/management/users/edit/{{ primaryManager.id }}">{{ primaryManager.fullName }}</a>
                        {% endif %}
                    </td>
                    <td><p class="td-title-responsive">Licences: </p>
                    {{ company.companyRemainingLicences }}</td>
                    <td>
                        <p class="td-title-responsive">Users: </p>
                        {{ userCount }}
                    </td>
                    <td>
                        {% if not currentUser.managerReadOnly and userCount %}
                            <a href="/management/users/company/{{ company.id }}">view users</a>
                        {% endif %}
                    </td>
                    <td>
                        {% if not currentUser.managerReadOnly %}
                            {% set companyEmails = craft.lantra.emailList(company.id) %}
                            {% if companyEmails %}
                                <a href="mailto:{{ currentUser.email }}?bcc={{ companyEmails }}">email users</a>
                            {% endif %}
                        {% endif %}
                    </td>
                    <td>
                        {% if not currentUser.managerReadOnly %}
                            <a href="/management/companies/edit/{{ company.id }}">edit</a> |
                            <a class="action" href="#" data-action="lantra/entries/deleteEntry" data-id="{{ company.id }}">delete</a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
        <div class="page-content">
            <h3>There are no companies to display.</h3>
        </div>
    {% endif %}
    </div>
</section>
{% endblock %}
