{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}

{% set usersNotLicenced = craft.users.userNotLicenced(true).count() %}
{% set siteLicence = craft.lantra.siteLicence(false) %}
{% set schemeExpiryDate = siteLicence.siteExpiryDate  %}

{% extends "_layout" %}
{% block content %}
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <section class="page">
        <div class="page-header secondary-bg">
            <h2>Scheme Profile</h2>
            <p>An overview of your Scheme.</p>
        </div>
        <div class="page-content">
            <p class="scheme-profile">
                <span class="label">Scheme Name:</span> {{ craft.lantra.setting('schemeName', 'unknown') }}<br />
                <span class="label">Scheme Expiry Date:</span> {{ schemeExpiryDate ? schemeExpiryDate|date(dateFormat) : 'Never' }}<br />
                <span class="label">Licence Model:</span> {{ siteLicence.licenceModelLabel }}<br />
                <span class="label">Licenced Users:</span> {{ siteLicence.totalActive }}<br />
                <span class="label">Unlicenced Users:</span> {{ usersNotLicenced }}<br />
                {% if siteLicence.licenceTypeSite == 'advance' %}
                    <span class="label">Remaining Licences:</span> {{ siteLicence.totalRemaining }}
                {% endif %}
            </p>
        </div>
    </section>
{% endblock %}