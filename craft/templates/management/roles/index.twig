{% do craft.lantra.requirePermission('editRoles') %}
{% extends "_layout" %}

{% set metaTitle = "Management > Roles" %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}
{% set filterSearch = craft.app.request.getParam('search')|default('') %}

{% set criteria = craft.categories.group('roles').search(filterSearch).orderBy('title').limit(pageLimit) %}
{% if criteria %}{% paginate criteria as pageInfo, roleCategories %}{% endif %}

{% block content %}

<section class="page">
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <h2>Roles / Modules</h2>
        <p>Job roles and Modules within your scheme</p>
        {% include '_includes/filter' with{filterDays:false} %}
    </div>
    <div class="page-content">
    {% if roleCategories is defined and roleCategories|length %}
        <table class="data">
            <thead>
            <tr>
                <th>#</th>
                <th class="title">Name</th>
                <th>&nbsp;</th>
            </tr>
            </thead>
            <tbody>
            {% for role in roleCategories %}
            <tr>
                <td>{{ role.id }}</td>
                <td>{{ role.title }}</td>
                <td class="icons" style="width:140px;text-align:right">
                {% if not currentUser.managerReadOnly %}
                    <a class="icon" href="/management/roles/edit/{{ role.id }}"><img src="/assets/img/edit.svg" title="Edit" /></a>
                    <a class="icon action" href="#" data-action="categories/delete-category" data-id="{{ role.id }}"><img src="/assets/img/delete.svg" title="Delete" /></a>
                {% endif %}
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
    {% else %}
        <h3>There are no roles to display.</h3>
    {% endif %}
    {% if not currentUser.managerReadOnly %}
        <div class="container-btn">
            <a class="button primary-bg" href="/management/roles/new">Create role</a>
        </div>
    {% endif %}
    </div>
</section>
{% endblock %}
