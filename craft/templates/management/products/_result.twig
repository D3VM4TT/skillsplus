{% import "_macros" as ui %}

{% set section = craft.sections.getSectionByHandle('results') %}
{% set entryType = craft.app.sections.getEntryTypesByHandle('productResult')[0] %}

{% set entry = entry ?? create('craft\\elements\\Entry') %}
{% set isNew = resultId == 'new' %}
{% set resultEntry = isNew ? entry : craft.entries.section('results').status(null).id(resultId).one() %}

<form class="page-form" method="post" role="form" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('entries/save-entry') }}
    {{ redirectInput('/management/products/results/' ~ productId) }}
    <input type="hidden" name="sectionId" value="{{ section.id }}">
    <input type="hidden" name="typeId" value="{{ entryType.id }}">
    <input type="hidden" name="enabled" value="1">
    <input type="hidden" name="entryId" value="{{ resultEntry.id|default('') }}">
    <input type="hidden" name="fields[resultProduct][]" value="{{ productId }}">
    <input type="hidden" name="title" value="{{ productLabel }}">

    <div class="field--wrapper">
        {{ ui.errorList(resultEntry.getFirstErrors()) }}
    </div>

    {% set defaultStartDate = date('') %}
    {% set defaultExpiryDate = date('+1year') %}

    <div class="field--wrapper" data-type="date" data-required="1">
        {% include '_includes/date' with {label:productResultLabel ~ ' Date', name:'userStartDate', value: isNew ? defaultStartDate:resultEntry.resultStartDate, ys: now|date('Y') + 5, ye: now|date('Y') - 50} %}
    </div>

    <div class="field--wrapper" data-type="date" data-required="1">
        {% include '_includes/date' with {label:'Expiry Date', name:'userExpiryDate', value: isNew ? defaultExpiryDate:resultEntry.expiryDate  , ys: now|date('Y') + 5, ye: now|date('Y') - 50} %}
    </div>

    {% set customNew = 1 %}
    {% set showEvidence = true %}
    {% for row in productType.productResultCustomFields %}
        <div class="field--wrapper" data-type="{{ row.type }}" data-required="{{ row.required }}">
            {% set customBlockId = false %}
            {% set customValue = '' %}
            {% if not isNew %}
                {% set customBlockId = craft.lantra.resultCustom(resultEntry.id, row.name, true) %}
                {% set customValue = craft.lantra.resultCustom(resultEntry.id, row.name) %}
            {% endif %}
            {% set fieldKey = customBlockId ? customBlockId : 'new' ~ customNew %}
            {% set field = craft.app.fields.getFieldByHandle('resultCustom') %}
            {% set blocktype = craft.superTable.getSuperTableBlocks(field.id)[0] %}

            <label for="fields[resultCustom][{{ fieldKey }}][fields][customValue]" class="">{{ row.label|raw }}</label>

            {% if row.type == 'text' %}
                <input{% if row.required %} required{% endif %} name="fields[resultCustom][{{ fieldKey }}][fields][customValue]" type="text" class="float-label" value="{{ customValue }}">
            {% elseif row.type == 'textarea' %}
                <textarea{% if row.required %} required{% endif %}  name="fields[resultCustom][{{ fieldKey }}][fields][customValue]" type="text" class="float-label">{{ customValue }}</textarea>
            {% elseif row.type == 'passFail' %}
                {% set value = productCustomBlock.customValue|default(0) %}
                <select name="fields[customFields][{{ fieldKey }}][fields][customValue]">
                    <option{% if value == 0 %} selected{% endif %} value="0">Fail</option>
                    <option{% if value == 1 %} selected{% endif %} value="1">Pass</option>
                </select>
            {% elseif showEvidence and row.type == 'evidence' %}
                {# only show one evidence field #}
                {% set showEvidence = false %}
                {% set accountId = currentUser.id %}
                {% set evidenceFolderId = craft.lantra.evidenceFolderId(accountId) %}
                {% if evidenceFolderId %}
                    {% include '_includes/evidence' with {evidence:resultEntry.resultEvidence, accountId:accountId, fieldName:'fields[resultEvidence][]', autoSave:false} %}
                {% else %}
                    <p style="color:#FF0000;font-weight:700">ERROR: Could not create evidence folder, contact technical support.</p>
                {% endif %}
            {% endif %}
            <input type="hidden" name="fields[resultCustom][{{ fieldKey }}][type]" value="{{ blocktype.id }}">
            <input type="hidden" name="fields[resultCustom][{{ fieldKey }}][enabled]" value="1">
            <input type="hidden" name="fields[resultCustom][{{ fieldKey }}][fields][customKey]" value="{{ row.name }}">
            {# increment new1, new2 #}
            {% set customNew = customNew + 1 %}
        </div>
    {% endfor %}

    <div class="container-btn">
        <button class="button primary-bg" type="submit">Save {{ productResultLabel }}</button>
    </div>
</form>