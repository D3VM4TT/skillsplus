{% if not craft.lantra.setting('taskbooks')  %}
    {% exit 404 %}
{% endif %}

{% requireLogin %}

{% extends "_layout" %}

{% set userId = craft.app.request.getSegment(2) %}
{% if not userId or userId == currentUser.id %}
    {% set account = currentUser %}
{% else %}
    {% set account = craft.users.id(userId).status(null).one %}
    {% if not craft.lantra.isManager(account.id) %}{% exit 403 %}{% endif %}
{% endif %}

{% set accountPhoto = account.getPhoto() %}
{% set accountPhotoUrl = accountPhoto ? accountPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg' %}

{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}

{% set unpaidPackages = craft.entries.section('packages').authorId(account.id).packagePaid('not 1') %}
{% set paidPackages = craft.entries.section('packages').authorId(account.id).packagePaid('1') %}

{% set isTaskbooks = true %}
{% set taskbookLabel = craft.lantra.setting('taskbookLabel', 'Taskbook') %}

{% block content %}
<section class="page dashboard">
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <a href="/">
            <img src="{{ accountPhotoUrl }}" width="150" height="150" class="right rounded-circle" alt="{{ account.fullName }}">
        </a>
        {{ currentUserCompany|default('') }}
        <h2>Manage {{ taskbookLabel|pluralize }}</h2>
        <p>Manage your {{ taskbookLabel|lower }} packages.</p>
    </div>
    <div class="page-content">

        {% if unpaidPackages.count %}
            <h2>New {{ unpaidPackages.count == 1 ? taskbookLabel : taskbookLabel|pluralize }}</h2>
            {{ globalsHtml.pageNew }}
            {% for package in unpaidPackages.all %}
                {% set packageTitle = package.taskbook ? package.taskbook.title : package.title %}
                {% if craft.lantra.setting('taskbookLevels') %}
                    {% set packageTitle = packageTitle ~ ' ' ~ craft.lantra.taskbookLevel(package.packageLevel) %}
                {% endif %}
                <h3>{{ packageTitle }} </h3>
                <p>Date Created: {{ package.dateCreated|date(dateFormat) }}</p>
                {% if package.packageModuleGroups.count %}
                    <p>
                    {% for moduleGroupBlock in package.packageModuleGroups.all %}
                        {% set moduleGroup = moduleGroupBlock.moduleGroup.inReverse().one %}
                        {{ moduleGroup.title }}
                        {% if craft.lantra.setting('taskbookLevels') %}
                            ({{ craft.lantra.taskbookLevel(moduleGroupBlock.moduleGroupLevel) }})
                        {% endif %}
                        <br />
                    {% endfor %}
                    </p>
                {% endif %}
                <p>&nbsp;</p>
                {% set paymentMeta = {
                    'product' : packageTitle,
                    'packageId' : package.id,
                    'redirect' : '/cpd/' ~ userId ~ '/taskbooks'
                } %}
                {{ craft.lantra.basePaypalButton(account.id, package.packageCost, 'new-' ~ package.id, paymentMeta, 'Pay £' ~ package.packageCost)|raw }}
                <p>&nbsp;</p>
                <p>&nbsp;</p>
            {% endfor %}
        {% endif %}

        {% if craft.lantra.setting('taskbookNew') %}
            <div class="container-btn">
                <p><a href="/cpd/{{ account.id }}/taskbooks/new" class="button primary-bg">Add {{ taskbookLabel }}</a></p>
            </div>
        {% else %}
            {{ globalsHtml.pageNewDisabled }}
        {% endif %}
    </div>
</section>
{% endblock %}
