{% requireLogin %}

{% if not craft.lantra.setting('taskbooks')  %}{% exit 404 %}{% endif %}

{% set cpdUser = craft.lantra.cpdUser(craft.app.request.getSegment(2)) %}
{% set isManager = cpdUser.id != currentUser.id %}

{% if isManager and not craft.lantra.isManager(cpdUser.id) %}{% exit 403 %}{% endif %}

{% extends "_layout" %}

{% set accountPhoto = cpdUser.getPhoto() %}
{% set accountPhotoUrl = accountPhoto ? accountPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg' %}

{% import "_macros" as ui %}

{% set packageTaskbook = entry is defined and entry.packageTaskbook ? entry.packageTaskbook.one : null %}
{% set section = craft.sections.getSectionByHandle('packages') %}
{% set isTaskbooks = true %}
{% set taskbookLabel = craft.lantra.setting('taskbookLabel', 'Taskbook') %}
{% set taskbookCompanies = craft.lantra.setting('taskbookCompanies') %}
{% set userCompany = cpdUser.userCompany.one() %}

{% if taskbookCompanies %}
    {% set availableTaskbooks = userCompany ? userCompany.companyTaskbooks : [] %}
{% else %}
    {% set availableTaskbooks = craft.entries.section('taskbooks').all() %}
{% endif %}

{% block content %}
    <section class="page dashboard">
        <div class="page-subHeader primary-bg">
            {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <a href="/">
                <img src="{{ accountPhotoUrl }}" width="150" height="150" class="right rounded-circle" alt="{{ cpdUser.fullName }}">
            </a>
            {{ currentUserCompany|default('') }}
            <h2>Create {{ taskbookLabel }}</h2>
            <p>Purchase a package of module groups.</p>
        </div>
        <div class="page-content">
            {{ globalsHtml.pageCreate }}
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            {% if taskbookCompanies and not userCompany %}
                <p style="color:red;">Only users assigned to a company can create {{ taskbookLabel|pluralize|lower  }}.</p>
            {% else %}
                {% set levelsOptions = '' %}
                {% for option in craft.lantra.taskbookLevels() %}
                    {% set levelsOptions = levelsOptions ~ '<option value="' ~ option.value ~ '">' ~ option.label ~ '</option>' %}
                {% endfor %}
                {% if entry is defined %}
                    {{ ui.errorList(entry.getFirstErrors()) }}
                {% endif %}
                <form class="page-form" id="taskbooks" method="post" accept-charset="UTF-8">
                    {{ csrfInput() }}
                    {{ actionInput('entries/save-entry') }}
                    {{ hiddenInput('sectionId', section.id) }}
                    {{ hiddenInput('enabled', 1) }}
                    {{ redirectInput('cpd/' ~ cpdUser.id ~ '/taskbooks') }}
                    {{ hiddenInput('author[]', cpdUser.id) }}
                    {% include '_forms/taskbook' with {taskbooks:availableTaskbooks} %}
                    <div class="container-btn">
                        <button type="submit" class="button primary-bg">Continue</button>
                    </div>
                </form>
            {% endif %}
        </div>
    </section>
{% endblock %}
