{% requireLogin %}

{% extends "_layout" %}
{% import "_macros" as ui %}

{% set userId = craft.app.request.getSegment(2) %}
{% if not userId or userId == currentUser.id %}
    {% set account = currentUser %}
{% else %}
    {% set account = craft.users.id(userId).status(null).one %}
    {% if not craft.lantra.isManager(account.id) %}{% exit 403 %}{% endif %}
{% endif %}

{% set accountPhoto = account.getPhoto() %}
{% set accountPhotoUrl = accountPhoto ? accountPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg' %}

{% set packageId = craft.request.getParam('packageId') %}
{% set moduleGroupId = craft.request.getParam('moduleGroupId') %}
{% set singleType = craft.request.getParam('type') %}
{% set payment = craft.request.getParam('payment') %}
{% set package = craft.entries.id(packageId).one() %}
{% set unpaidCost = package.unpaidCost %}

{% if not package %}
    {% exit 404 %}
{% endif %}

{% if payment and not unpaidCost %}
    {# redirect back to package if nothing to pay #}
    {% redirect 'cpd/' ~ account.id ~ '/taskbooks/' ~ package.id %}
{% endif %}

{% set availableModuleGroups = package.moduleGroups('available') %}
{% set cost = craft.lantra.getModuleGroupCost(package.taskbook, singleType) %}

{% set isTaskbooks = true %}

{% block content %}
    <section class="page dashboard">
        <div class="page-subHeader primary-bg">
            {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <a href="/">
                <img src="{{ accountPhotoUrl }}" width="150" height="150" class="right rounded-circle" alt="{{ account.fullName }}">
            </a>
            {{ currentUserCompany|default('') }}
            <h2>Add {{ singleType }} modules</h2>
            <p>{{ package.taskbook.title }}</p>
        </div>
        <div class="page-content">
        {% if payment %}
            <div class="field--wrapper">
                <p>There is £{{ unpaidCost }} outstanding to pay.</p>
                <p>&nbsp;</p>
                {{ craft.lantra.payPalButton(package.title ~ ' [optional]', unpaidCost, 'Pay £' ~ unpaidCost, siteUrl('sp/paypal/pay/' ~ package.id), package.unpaidPayPalParams)|raw }}
            </div>
        {% elseif not availableModuleGroups|length %}
            <div class="field--wrapper">
                <p style="color:red;">There are currently no modules available.</p>
            </div>
        {% else %}
            {% set levelsOptions = '' %}
            {% for option in craft.lantra.taskbookLevels() %}
                {% set levelsOptions = levelsOptions ~ '<option value="' ~ option.value ~ '">' ~ option.label ~ '</option>' %}
            {% endfor %}

            {% if entry is defined %}
                {{ ui.errorList(entry.getFirstErrors()) }}
            {% endif %}
            <form class="page-form" id="taskbooks" method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('sp/packages/add-module-groups') }}
                {{ hiddenInput('packageId', package.id) }}
                {{ redirectInput('cpd/' ~ account.id ~ '/taskbooks') }}
                {{ hiddenInput('singleType', singleType) }}
                <div class="field--wrapper">
                    {% if cost %}
                        <p>Additional modules cost £{{ cost }} each.</p>
                        <p>&nbsp;</p>
                    {% endif %}
                    {% include '_forms/taskbookOptionalModuleGroups' with {package:package, optionalModuleGroups:availableModuleGroups} %}
                </div>
                <div class="container-btn">
                    <button type="submit" class="button primary-bg">Add Module</button>
                </div>
            </form>
        {% endif %}
        </div>
    </section>
{% endblock %}
