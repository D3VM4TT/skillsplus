{% requireLogin %}

{% if not craft.lantra.setting('taskbooks')  %}{% exit 404 %}{% endif %}

{% set cpdUser = craft.lantra.cpdUser(craft.app.request.getSegment(2)) %}
{% set isManager = cpdUser.id != currentUser.id %}

{% if isManager and not craft.lantra.isManager(cpdUser.id) %}{% exit 403 %}{% endif %}

{% extends "_layout" %}

{% set accountPhoto = cpdUser.getPhoto() %}
{% set accountPhotoUrl = accountPhoto ? accountPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg' %}

{% set packageId = craft.request.getParam('packageId') %}
{% set moduleGroupId = craft.request.getParam('moduleGroupId') %}
{% set singleType = craft.request.getParam('type') %}
{% set payment = craft.request.getParam('payment') %}
{% set package = craft.entries.section('packages').id(packageId).one() %}
{% set unpaidCost = package.unpaidCost %}
{% set redirect = 'cpd/' ~ cpdUser.id ~ '/taskbooks/' ~ package.id %}

{% if not package %}
    {% exit 404 %}
{% endif %}

{% if payment and not unpaidCost %}
    {# redirect back to package if nothing to pay #}
    {% redirect redirect %}
{% endif %}

{% set availableModuleGroups = package.moduleGroups('available') %}
{% set cost = craft.lantra.getModuleGroupCost(package.taskbook, singleType) %}
{% set packageTitle = package.taskbook ? package.taskbook.title : package.title %}

{% set isTaskbooks = true %}

{% block content %}
    <section class="page dashboard">
        <div class="page-subHeader primary-bg">
            {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <a href="/">
                <img src="{{ accountPhotoUrl }}" width="150" height="150" class="right rounded-circle" alt="{{ cpdUser.fullName }}">
            </a>
            {{ currentUserCompany|default('') }}
            <h2>Add {{ singleType }} modules</h2>
            <p>{{ package.taskbook.title }}</p>
        </div>
        <div class="page-content">
        {% if payment %}
            <div class="field--wrapper">
                <p>There is £{{ unpaidCost }} outstanding to pay.</p>
                <p>&nbsp;</p>
                {% set paymentMeta = {
                    'product' : packageTitle ~ ' [optional]',
                    'packageId' : package.id,
                    'moduleGroupIds' : package.unpaidModuleGroupIds,
                    'redirect' : redirect
                } %}
                {{ craft.lantra.basePaypalButton(cpdUser.id, unpaidCost, 'optional-' ~ package.id, paymentMeta, 'Pay £' ~ unpaidCost)|raw }}
            </div>
        {% elseif not availableModuleGroups|length %}
            <div class="field--wrapper">
                <p style="color:red;">There are currently no modules available.</p>
            </div>
        {% else %}

            {% include '_includes/taskbooks/taskbookRequired' with {taskbook: package.taskbook} %}

            {% set levelsOptions = '' %}
            {% for option in craft.lantra.taskbookLevels() %}
                {% set levelsOptions = levelsOptions ~ '<option value="' ~ option.value ~ '">' ~ option.label ~ '</option>' %}
            {% endfor %}

            {% if entry is defined %}
                {{ ui.errorList(entry.getFirstErrors()) }}
            {% endif %}
            <form class="page-form" id="taskbooks" method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('sp/packages/add-module-groups') }}
                {{ hiddenInput('packageId', package.id) }}
                {{ redirectInput('cpd/' ~ cpdUser.id ~ '/taskbooks/' ~ package.id ) }}
                {{ hiddenInput('singleType', singleType) }}
                <div class="field--wrapper">
                    {% if cost %}
                        <p>Additional modules cost £{{ cost }} each.</p>
                        <p>&nbsp;</p>
                    {% endif %}
                    {% include '_forms/taskbookOptionalModuleGroups' with {package:package, optionalModuleGroups:availableModuleGroups, taskbook:package.taskbook} %}
                </div>
                <div class="container-btn">
                    <button type="submit" class="button primary-bg">Add Module</button>
                </div>
            </form>
        {% endif %}
        </div>
    </section>
{% endblock %}
