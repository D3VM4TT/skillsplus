{% if resultEntry and resultEntry.resultStatus == 'incomplete' %}
    <p>This unit is {{ resultEntry.resultStatus }}.</p>
{% elseif resultEntry  %}
    <p>You submitted evidence for this unit on {{ resultEntry.postDate|date(dateFormat) }} and your result status is {{ resultEntry.resultStatus }}.</p>
    <p>&nbsp;</p>
{% endif %}
{% import "_macros" as ui %}
{% if entry is defined %}
    {{ ui.errorList(entry.getFirstErrors()) }}
{% endif %}
{# result is locked when a result entry is pending or endorsed #}
{% set resultLocked = cpdUser.id == currentUser.id and resultEntry and resultEntry.resultStatus == 'endorsed' %}
{% set resultCompany = moduleResultEntry and moduleResultEntry.resultCompany ? moduleResultEntry.resultCompany.one : null %}
{# undo result locked #}
{% set resultLocked = false %}
<form method="post" role="form" accept-charset="UTF-8" enctype="multipart/form-data" class="result no-loading {{ readOnly ? 'read-only' : '' }}">
    {{ csrfInput() }}
    <input type="hidden" name="action" value="entries/save-entry">
    {{ redirectInput(craft.lantra.returnRef()) }}
    {% if resultEntry is defined and resultEntry %}
        <div id="name-fields">
            <div class="col-6 field--wrapper">
                <h3>{{ resultCompany ? resultCompany.title ~ ' - ' }}Unit Result ID: {{ resultEntry.id }}
                {% if resultEntry.resultRecurringCycleCode %}
                    {% set cyclePeriod = craft.lantra.unitResultRecurringCycle(moduleResultEntry, resultEntry.resultRecurringCycleCode, unitEntry.unitRecurringPeriod) %}
                    {{ cyclePeriod.name }} {{ cyclePeriod.year }}
                {% endif %}
                </h3>
            </div>
        </div>
    {% endif %}
    <input type="hidden" name="fields[resultModuleResult][]" value="{{ moduleResultEntry.id }}" />
    <input type="hidden" name="fields[resultIsTaskbook]" value="{{ isTaskbook }}" />
    {# if rollover is off unit results are locked to package and module #}
    {% if resultPackageId is defined and resultPackageId %}
        <input type="hidden" name="fields[resultPackage][]" value="{{ resultPackageId }}" />
        <input type="hidden" name="fields[resultModuleGroup][]" value="{{ resultModuleGroupId }}" />
    {% endif %}
    {% if moduleResultEntry.resultCompany.count %}
        <input type="hidden" name="fields[resultCompany][]" value="{{ moduleResultEntry.resultCompany.one.id }}" />
    {% endif %}
    {% set section = craft.app.sections.getSectionByHandle('results') %}
    {% set entryType = craft.app.sections.getEntryTypesByHandle('unitResult')[0] %}
    <input type="hidden" name="typeId" value="{{ entryType.id }}">
    <input type="hidden" name="sectionId" value="{{ section.id }}">
    <input type="hidden" name="enabled" value="1">
    {% if resultEntry is defined and resultEntry and resultEntry.id %}
        <input type="hidden" name="entryId" value="{{ resultEntry.id }}">
    {% endif %}
    {% if isManager %}
        <input type="hidden" name="author[]" value="{{ userId }}">
        <input type="hidden" name="title" value="[unit {{ entry.id }}] {{ cpdUser.firstName }} {{ cpdUser.lastName }}">
    {% endif %}
    <input type="hidden" name="fields[resultStatus]" value="{{ resultEntry.resultStatus|default('pending') }}">
    <input type="hidden" name="fields[resultUnit][]" value="{{ entry.id }}">
    {% set skillLevels = moduleEntry.skillLevels %}
    {% if moduleEntry.isSkillsMatrix and skillLevels.count %}
        {% set resultSkillLevel = resultEntry is defined and resultEntry ? resultEntry.skillLevel.one : false %}
        <div class="field--wrapper">
            <label for="fields[skillsMatrixLevel]">Level</label>
            <select name="fields[skillLevel][]" id="fields[skillLevel]">
                {% for skillLevel in skillLevels.all %}
                    <option {% if resultSkillLevel and resultSkillLevel.id == skillLevel.id %}selected="selected"{% endif %}
                            value="{{ skillLevel.id }}">{{ skillLevel.title }}</option>
                {% endfor %}
            </select>
        </div>
    {% endif %}
    {% if moduleEntry.isSkillsMatrix %}
        <div class="field--wrapper">
            <label for="fields[resultUpskiller]">Upskiller?</label>
            <input type="hidden" name="fields[resultUpskiller]" value="0" />
            <input
                type="checkbox"
                name="fields[resultUpskiller]"
                id="fields[resultUpskiller]"
                value="1"
                {% if resultEntry and resultEntry.resultUpskiller %}checked{% endif %}
            />
        </div>
    {% endif %}
    {% include 'record/_units/fields' with {moduleGroup:moduleGroup, resultEntry:resultEntry, accountId:cpdUser.id, resultLocked:resultLocked, isManager:isManager} %}
    {% if not readOnly %}
        {% include 'record/_units/buttons' with {resultEntry:resultEntry, resultLocked:resultLocked, autoEndorse:moduleGroup.moduleGroupAutoEndorse} %}
    {% endif %}
</form>
