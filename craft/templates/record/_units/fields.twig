{% set resultEndorsed = resultEntry is defined and resultEntry and resultEntry.resultStatus == 'endorsed' %}
{% set resultExists = resultEntry is defined and resultEntry %}
{% set customNew = 1 %}
{% set jsDateFormat = craft.lantra.setting('jsDateFormat', 'dd-mm-yyyy') %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set readOnly = readOnly is defined and readOnly %}


{%- do view.registerJsFile(view.getAssetManager().getPublishedUrl('@vendor/craftcms/redactor/src/assets/redactor/dist/redactor.min.js')) -%}
{%- do view.registerCssFile(view.getAssetManager().getPublishedUrl('@vendor/craftcms/redactor/src/assets/redactor/dist/redactor.css')) -%}

{% includeJs "$('.redactor').redactor();" %}
<style>
    .redactor-styles ul,
    .redactor-styles ol {
        list-style: outside !important;
    }
    .redactor-styles strong {
        font-weight:bold !important;
    }
    .redactor-styles em {
        font-style:italic !important;
    }
</style>

{% if (columnLayout is not defined or not columnLayout.count) and moduleGroup is defined %}
    {% set columnLayout = moduleGroup.columnLayout %}
{% endif %}
{% for row in columnLayout.all() %}
    {% if row.fieldDisplay != 'table' %}
    {% set fieldDisabled = row.fieldManagerOnly and not isManager %}
    {% set label = row.fieldLabel|default(row.fieldType.label) %}
    {% if row.fieldRequired %}
        {% set label = '<span style="color:red;margin-right:10px;">*</span>' ~ label %}
    {% endif %}
    {% if row.fieldType == 'resultExpiryDate' %}
        <div class="field--wrapper" data-type="date" data-required="{{ row.fieldRequired }}">
        {% include '_includes/date' with {label:label, name:'userExpiryDate', value: resultExists ? resultEntry.expiryDate : null, ys: now|date('Y') + 5, ye: now|date('Y') - 50} %}
        </div>
    {% elseif row.fieldType == 'resultStartDate' %}
        <div class="field--wrapper" data-type="date" data-required="{{ row.fieldRequired }}">
        {% include '_includes/date' with {label:label, name:'userStartDate', value: resultExists ? resultEntry.resultStartDate : null, ys: now|date('Y') + 5, ye: now|date('Y') - 50} %}
        </div>
    {% elseif row.fieldType == 'resultFinishDate' %}
        <div class="field--wrapper" data-type="date" data-required="{{ row.fieldRequired }}">
        {% include '_includes/date' with {label:label, name:'userFinishDate', value: resultExists ? resultEntry.resultFinishDate : null, ys: now|date('Y') + 5, ye: now|date('Y') - 50} %}
        </div>
    {% elseif row.fieldType == 'resultLocation' %}
        <div class="field--wrapper" data-type="text" data-required="{{ row.fieldRequired }}">
            <label for="resultLocation" class="">{{ label|raw }}</label>
            <input{% if resultLocked or fieldDisabled %} disabled{% endif %}  name="fields[resultLocation]" type="text" class="float-label"
                    value="{{ resultExists ? resultEntry.resultLocation|default('') }}">
        </div>
    {% elseif row.fieldType == 'resultPoints' %}
        <div class="field--wrapper" data-type="number" data-required="{{ row.fieldRequired }}">
            <label for="fields[resultPoints]" class="">{{ label|raw }}</label>
            <input{% if resultLocked or fieldDisabled %} disabled{% endif %} name="fields[resultPoints]" type="number"
                    value="{{ resultExists ? resultEntry.resultPoints|default('') }}" />
        </div>
    {% elseif row.fieldType == 'resultHours' %}
        <div class="field--wrapper" data-type="number" data-required="{{ row.fieldRequired }}">
            <label for="resultLocation" class="">{{ label|raw }}</label>
            <p style="color:#000000;font-weight:700">Enter hours as decimals i.e. 1.5 for an hour and a half or 1.75 an hour and 45 minutes.  Only enter number values (no words or explanation).</p>
            <input{% if resultLocked or fieldDisabled %} disabled{% endif %}  name="fields[resultHours]" type="text" class="float-label"
                   value="{{ resultExists ? resultEntry.resultHours|default('') }}">
        </div>
    {% elseif row.fieldType == 'resultNarrative' %}
        <div class="field--wrapper" data-type="text" data-required="{{ row.fieldRequired }}">
            <label for="resultNarrative" class="">{{ label|raw }}</label>
            <textarea{% if resultLocked or fieldDisabled %} disabled{% endif %}  name="fields[resultNarrative]" type="text" class="float-label redactor">
                {{ resultExists ? resultEntry.resultNarrative|default('') }}
            </textarea>
        </div>
    {% elseif row.fieldType == 'resultEvidence' %}
        {# try to move legacy result files #}
        {% set resultEntry = craft.lantra.legacyResultFiles(resultEntry) %}
        {% set resultEvidence = resultExists ? resultEntry.resultEvidence : false %}
        <div class="field--wrapper" data-type="asset" data-required="{{ row.fieldRequired }}">
            {% if not resultLocked and not fieldDisabled %}
                {% set evidenceFolderId = craft.lantra.evidenceFolderId(accountId) %}
                {% if evidenceFolderId %}
                    {% include '_includes/evidence' with {evidence:resultEvidence, accountId:cpdUser.id, fieldName:'fields[resultEvidence][]', autoSave:false} %}
                {% else %}
                    <p style="color:#FF0000;font-weight:700">ERROR: Could not create evidence folder, contact technical support.</p>
                {% endif %}
            {% endif %}
        </div>
    {% endif %}
    {% if row.fieldType == 'resultCustom' %}
        <div class="field--wrapper" data-type="{{ row.fieldCustomType }}" data-required="{{ row.fieldRequired }}">
            {% set customBlockId = false %}
            {% set customValue = '' %}
            {% if resultExists %}
                {% set customBlockId = craft.lantra.resultCustom(resultEntry.id, row.fieldCustomKey, true) %}
                {% set customValue = craft.lantra.resultCustom(resultEntry.id, row.fieldCustomKey) %}
            {% endif %}
            {% set fieldKey = customBlockId ? customBlockId : 'new' ~ customNew %}
            {% set field = craft.app.fields.getFieldByHandle('resultCustom') %}
            {% set blocktype = craft.superTable.getSuperTableBlocks(field.id)[0] %}

            <label for="fields[resultCustom][{{ fieldKey }}][fields][customValue]" class="">{{ label|raw }}</label>

            {% if row.fieldCustomType == 'text' %}
                <input{% if resultLocked or fieldDisabled %} disabled{% endif %} name="fields[resultCustom][{{ fieldKey }}][fields][customValue]" type="text" class="float-label" value="{{ customValue }}">
            {% elseif row.fieldCustomType == 'dropdown' %}
                {% set customOptions =  row.fieldCustomOptions|split(',') %}
                <select {% if resultLocked  or fieldDisabled %} disabled{% endif %} name="fields[resultCustom][{{ fieldKey }}][fields][customValue]">
                    {% for opt in customOptions %}
                        {% set optValue = opt|trim %}
                        <option{% if optValue == customValue %} selected{% endif %}>{{ optValue }}</option>
                    {% endfor %}
                </select>
            {% endif %}
            <input type="hidden" name="fields[resultCustom][{{ fieldKey }}][type]" value="{{ blocktype.id }}">
            <input type="hidden" name="fields[resultCustom][{{ fieldKey }}][enabled]" value="1">
            <input type="hidden" name="fields[resultCustom][{{ fieldKey }}][fields][customKey]" value="{{ row.fieldCustomKey }}">
            {# increment new1, new2 #}
            {% set customNew = customNew + 1 %}
        </div>
    {% endif %}
    {# force git push - delete comment #}
    {% endif %}
{% endfor %}
<div class="field--wrapper">
    <label for="resultComment" style="" class="">Comments</label>
    {% if resultExists and resultEntry.resultComments.count is defined and resultEntry.resultComments.count %}
        {% for comment in resultEntry.resultComments %}
            <p>
                <span style="font-weight:700;">{{ comment.date|date('d/m/y') }}</span> {{ comment.user.one.fullName }}
                : <em>{{ comment.comment }}</em>
                {% if not comment.read %}
                    <span style="color:#008800;">[new]</span>
                    {{ craft.lantra.readComment(comment) }}
                {% endif %}
            </p>
        {% endfor %}
    {% endif %}
    {% if not resultLocked %}
        <textarea placeholder="Add new comment" id="resultComment" name="comment"></textarea>
    {% endif %}
</div>
{% if readOnly and not resultLocked %}
    <div class="container-btn">
        <input type="hidden" name="readOnly" value="1" />
        <button id="resultCommentButton" class="button primary-bg" type="submit">Save Comment</button>
    </div>
{% endif %}