{% set totalComments = resultEntry ? resultEntry.resultComments.count : 0 %}
{% set unreadComments = resultEntry ? craft.lantra.unreadComments(resultEntry) : 0 %}

<tr class="{{ rowClass is defined and rowClass ? rowClass : '' }}">
    <td>
        {{ rowTitle|raw }}
        <div class="cpd-icons">
            {% if unit is defined and unit.unitDescription %}
            <a href="#" data-tooltip title="{{ unit.unitDescription|raw }}">
                <img src="/assets/img/files.svg" width="16" height="16" class="" alt="">
            </a>
            {% endif %}
            {% if totalComments %}
                <div class="cpd-comment" data-tooltip title="Click the unit title above to view comments">
                    <div class="cpd-comment-number">
                        <p>{{ totalComments }}</p>
                    </div>
                    <div class="cpd-comment-txt">
                        comment{{ unreadComments != 1 ? 's' }}
                    </div>
                </div>
            {% endif %}
        </div>
    </td>
    {% include '_includes/columnLayout' with {
        unitType: unitType,
        unitPoints: unitPoints,
        resultEntry: resultEntry,
        columnLayout: columnLayout,
        isManager: isManager
    } %}
    <td class="icons">
        {% if not readOnly and resultEntry and craft.lantra.isManager(cpdUser.id) and resultEntry.resultStatus != 'incomplete' %}
            {% set managerDelete = resultEntry.resultOwner.count and resultEntry.resultOwner.one.id == currentUser.id %}
            {% set managerEndorse = craft.lantra.canEndorse(resultEntry) and package is not defined %}
            {% if currentUser.admin or currentUser.isInGroup('schemeManagers') or managerDelete %}
                <a class="icon action" href="#" title="Delete this result" data-tooltip
                    {% if moduleElementId is defined %}data-ref="module{{ moduleElementId }}"{% endif %}
                   data-action="entries/delete-entry"
                   data-id="{{ resultEntry.id }}"
                >
                    <img src="/assets/img/delete.svg" alt="Delete">
                </a>
            {% endif %}
            {% if managerEndorse and resultEntry and resultEntry.resultStatus == 'pending' %}
                <a class="icon action endorse" href="#" title="Endorse this result" data-tooltip
                   {% if moduleElementId is defined %}data-ref="module{{ moduleElementId }}"{% endif %}
                   data-action="entries/endorse-evidence"
                   data-id="{{ resultEntry.id }}"
                >
                    <img src="/assets/img/endorse.svg" alt="Endorse">
                </a>
            {% endif %}
        {% endif %}
    </td>
    <td class="icons">
        {% if not readOnly %}
            {% if editLink is defined and editLink and resultEntry %}
                <a class="icon" href="{{ editLink }}" data-tooltip title="Edit this result">
                    <img src="/assets/img/edit.svg" title="Edit" />
                </a>
            {% endif %}
            {% if newLink is defined and newLink %}
                <a class="icon" href="{{ newLink }}" data-tooltip title="Add new result">
                    <img src="/assets/img/add.svg" title="Add" />
                </a>
            {% endif %}
        {% endif %}
    </td>
</tr>