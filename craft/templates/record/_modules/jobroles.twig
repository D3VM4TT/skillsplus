{% set recordResultIds = craft.lantra.recordResults(cpdUser.id, 'ids') %}
{% if recordResultIds|length %}
    {% set resultArchive = craft.entries.section('results').type(['userResult', 'unitResult']).authorId(cpdUser.id).status('live, expired').resultCompany(':empty:').id('and, not ' ~ recordResultIds|join(', not ')) %}
{% else %}
    {% set resultArchive = craft.entries.section('results').type(['userResult', 'unitResult']).authorId(cpdUser.id).status('live, expired').resultCompany(':empty:') %}
{% endif %}
<div id="job-role-cpd">
    {% if not cpdUser.record.jobRoles|length %}
        <h2>{{ craft.lantra.setting('labelJobRole', 'Job Role') }}</h2>
        <div class="col-pd-btm col-flex">
            <img src="/assets/img/delete.svg" class="test-icon" alt="">
            <p>
                {% if isManager %}
                    This user has no job role(s) allocated to their account.
                {% else %}
                    You have no job role(s) allocated to your account.
                {% endif %}
            </p>
        </div>
    {% else %}
        {% for roleItem in cpdUser.record.jobRoles %}
            {% set role = cpdUser.record.getElement(roleItem.elementId) %}
            {% if role.isDashboard %}
                {% include 'record/_modules/role' with{cpdUser:cpdUser, role:role} %}
            {% endif %}
        {% endfor %}
    {% endif %}
</div>
{% if not craft.lantra.setting('themeDisableResultHistory') and resultArchive|length %}
    {% include 'record/_archive' with {resultEntries:resultArchive, isManager:isManager, readOnly:readOnly} %}
{% endif %}
<p style="text-align:right">
    {% if craft.lantra.setting('themeResultHistoryLink') and resultArchive|length %}
        {% if craft.app.request.getSegment(3) == 'archive' %}
            <a class="button no-shadow primary-bg" href="/cpd/{{ cpdUser.id }}">
                <span>Dashboard</span>
            </a>
        {% else %}
            <a class="button no-shadow primary-bg" href="/cpd/{{ cpdUser.id }}/archive">
                <span>{{ craft.lantra.setting('themeResultHistoryTitle', 'Result History') }}</span>
            </a>
        {% endif %}
    {% endif %}
    <a class="button no-shadow primary-bg" target="_blank" href="/cpd/{{ cpdUser.id }}/print">
        <span>Print Version</span>
    </a>
</p>