<div class="job-role tab-container" style="position: relative;">
    <div class="align-vertical">
        <div class="align-horizontal"><img src="/assets/img/tool-job-role-management.svg" width="120" height="120" class="" alt=""></div>
        <div class="align-horizontal">
            <div><h4>{{ craft.lantra.setting('labelJobRole', 'Job Role') }}</h4></div>
            <div><h2>{{ role.title }}</h2></div>
            {% if jobRoleEndorse %}
                <a class="jobroleEndorseExpand" href="javascript:" data-target="#j{{ role.id }}"><img src="/assets/img/img-arrow-down.png"></a>
            {% endif %}
        </div>
    </div>
    <div id="j{{ role.id }}" {% if jobRoleEndorse %}class="open"{% endif %}>
        {% if not roleItem.modules|length %}
            <p>No modules have been assigned to this role.</p>
        {% else %}
            <div class="module-group-tabs">
                <ul class="tabs clearfix" data-tabgroup="groups-tab-group-{{ role.id }}">
                    {% for moduleGroupItem in roleItem.moduleGroups %}
                        {% set moduleGroup = cpdUser.record.getElement(moduleGroupItem.elementId) %}
                        {% set moduleGroupElementId = role.id ~ moduleGroup.id %}
                        <li>
                            <a href="#tab{{ moduleGroupElementId }}" class="primary-bg">
                                <h4>{{ moduleGroup.title }}</h4>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            <section id="groups-tab-group-{{ role.id }}" class="tabgroup">
                {% for moduleGroupItem in roleItem.moduleGroups %}
                    {% set moduleGroup = cpdUser.record.getElement(moduleGroupItem.elementId) %}
                    {% if moduleGroup.moduleGroupReadOnly and cpdUser.id == currentUser.id %}
                        {% set readOnly = true %}
                    {% endif %}
                    {% set moduleGroupElementId = role.id ~ moduleGroup.id %}
                    {% include 'record/_modules/moduleGroup' with {moduleGroupItem:moduleGroupItem, moduleGroup:moduleGroup} %}
                {% endfor %}
            </section>
        {% endif %}
    </div>
    {% if jobRoleEndorse and roleItem.modules|length %}
        <p class="jobroleEndorse">
            {% set totalUnits = craft.lantra.totalUnits(roleItem) %}
            {% set totalComplete = craft.lantra.totalComplete(roleItem) %}
            {% if totalComplete >= totalUnits %}
                <a class="action button no-shadow primary-bg" href="#" data-id="{{ role.id }}" data-ref="jobRole"
                   data-userid="{{ cpdUser.id }}" data-action="entries/pending-result">Submit for Endorsement</a>
            {% else %}
                Complete {{ totalUnits - totalComplete }} more unit(s) and then submit for endorsement.
            {% endif %}
        </p>
    {% endif %}
</div>