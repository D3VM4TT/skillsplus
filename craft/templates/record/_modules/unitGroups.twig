<div id="m{{ moduleElementId }}" class="unit-groups">
    {% for unitGroup in module.unitGroups %}
        {% set addResult = unitGroup.enableSubmissions %}
        <div class="unit-group">
            <div class="header primary-bg" data-target="#u{{ moduleElementId ~ unitGroup.id }}">
                <h5>{{ unitGroup.groupName|default('') }}&nbsp;</h5>
                <div class="status">
                    View status and Endorsements
                    <img src="/assets/img/img-arrow-down-white-trans.png">
                </div>
            </div>
            <div id="u{{ moduleElementId ~ unitGroup.id }}" class="units">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Unit title</th>
                        {% include '_includes/columnLayout' with {header:true, columnLayout:columnLayout, isManager:isManager} %}
                        <th colspan="2"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set rowClass = 'odd' %}
                    {% for unit in unitGroup.units %}
                        {% set unitEntry = unit.getElement() %}
                        {% set resultEntry = null %}
                        {% set totalComments = 0 %}

                        {% set unitType = unitEntry.unitType %}
                        {% set unitPoints = craft.lantra.unitPoints(unitEntry, moduleEntry) %}
                        {% if unitEntry.unitRecurring %}
                            {# get or create results for recurring period #}
                            {% set resultQuery = craft.lantra.recurringResultsQuery(cpdUser.id, unitEntry.id, cycle, moduleResultEntry.id) %}
                        {% else %}
                            {# get only results linked to this module result if a cpd type module #}
                            {% set resultQuery = craft.lantra.unitResultsQuery(cpdUser.id, unitEntry.id, addResult ? null : 1, moduleEntry.type == 'cpd' ? moduleResultEntry.id : null) %}
                        {% endif %}

                        {% set hasResult = resultQuery.count() %}
                        {% set multipleRows = unitEntry.unitRecurring or (addResult and hasResult) %}
                        {% set singleRow = not unitEntry.unitRecurring and not addResult %}

                        {% set rowName =  unitEntry.title ~ ' ' ~ unitEntry.unitHeading %}
                        {# url format cpd/<userId>/<moduleId>/<unitId>/<resultId> #}
                        {% set baseUrl = '/cpd/' ~ cpdUser.id ~ '/' ~ moduleEntry.id ~ '/' ~ unitEntry.id ~ '/' %}
                        {% set params = '?ref=module' ~ moduleElementId ~ '&moduleResultId=' ~ moduleResultEntry.id %}
                        {% set newUrl = baseUrl ~ 'new' ~ params %}
                        {% set editUrl = baseUrl ~ params %}

                        {# if multple rows - reccuring or multiple submissions #}
                        {% if multipleRows %}
                            {% for unitResultEntry in resultQuery.all() %}

                                {% set newLink = '' %}
                                {% set editLink = '' %}

                                {# append this result id to url #}
                                {% set resultUrl = baseUrl ~ unitResultEntry.id ~ '/' ~ params %}

                                {# recurring rows #}
                                {% if unitEntry.unitRecurring %}
                                    {% set cyclePeriod = craft.lantra.unitResultRecurringCycle(moduleResultEntry, unitResultEntry.resultRecurringCycleCode, unitEntry.unitRecurringPeriod) %}
                                    {# i.e. january, february etc. #}
                                    {% set rowTitle = cyclePeriod ? cyclePeriod.name : 'unknown' %}
                                    {% if cyclePeriod and (cyclePeriod.isCurrent() or cyclePeriod.isPast()) %}
                                        {# show add icon #}
                                        {% if unitResultEntry.resultStatus == 'incomplete' %}
                                            {% set newLink = resultUrl %}
                                        {# show edit icon #}
                                        {% else %}
                                            {% set editLink = resultUrl %}
                                        {% endif %}
                                    {% endif %}
                                {# if multiple submissions #}
                                {% elseif addResult %}
                                    {% set rowTitle = loop.first ? rowName : '' %}
                                    {% set editLink = resultUrl %}
                                {% endif %}
                                {% include 'record/_modules/row' with {
                                    resultEntry: unitResultEntry,
                                    rowClass: rowClass,
                                    editLink: editLink,
                                    newLink: newLink
                                } %}
                            {% endfor %}
                        {% endif %}
                        {# add extra row for a new multiple submission unit #}
                        {% if addResult %}
                            {% set rowTitle = hasResult ? '' : rowName %}
                            {% include 'record/_modules/row' with {
                                rowClass: rowClass,
                                newLink: newUrl
                            } %}
                        {# just show the single unit/result row #}
                        {% elseif singleRow %}
                            {% set rowTitle = rowName %}
                            {% set unitResultEntry = null %}
                            {% if hasResult %}
                                {% set unitResultEntry = resultQuery.one() %}
                            {% endif %}
                            {% include 'record/_modules/row' with {
                                resultEntry: unitResultEntry,
                                rowClass: rowClass,
                                editLink: addResult ? newUrl : editUrl,
                                newLink: not hasResult ? newUrl
                            } %}
                        {% endif %}
                        {% set rowClass = rowClass == 'odd' ? 'even' : 'odd' %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endfor %}
    {# get user results related to module #}
    {% set moduleUserResults = craft.entries.section('results').type('userResult').authorId(cpdUser.id).relatedTo(moduleEntry.id).status('live, expired').limit(null) %}
    {% if moduleUserResults|length %}
        <div class="unit-group">
            <div class="header" data-target="#u{{ moduleElementId }}-user">
                <h5>My Achievements</h5>
                <div class="status">
                    View status and Endorsements
                    <img src="/assets/img/img-arrow-down-trans.png">
                </div>
            </div>
            <div id="u{{ moduleElementId }}-user" class="units">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Result title</th>
                        {% include '_includes/columnLayout' with {header:true, columnLayout:columnLayout, isManager: isManager} %}
                        <th colspan="2"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for userResultEntry in moduleUserResults.all %}
                        {% set rowTitle = userResultEntry.title %}
                        {% set editUrl = '/cpd/' ~ cpdUser.id ~ '/result/' ~ userResultEntry.id %}
                        {% set unitType = 'evidence' %}
                        {% set unitPoints = userResultEntry.unitPoints %}
                        {% include 'record/_modules/row' with {
                            resultEntry: userResultEntry,
                            editLink: editUrl
                        } %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
    {% if moduleGroup is defined and moduleGroup.addAchievement and not module.addAchievementHide and not readOnly %}
        <a class="button no-shadow primary-bg" href="/cpd/{{ cpdUser.id }}/achievement/{{ module.id }}">
            <span>Add</span>
        </a>
    {% endif %}
</div>