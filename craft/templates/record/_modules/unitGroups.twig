<div id="m{{ role.id ~ module.id }}" class="unit-groups">
    {% for unitGroup in module.moduleUnitGroups.all() %}
        {% set addResult = unitGroup.enableSubmissions %}
        {% set unitGroupEntries = unitGroup.unitEntries %}
        <div class="unit-group">
            <div class="header primary-bg" data-target="#u{{ role.id ~ module.id ~ unitGroup.id }}">
                <h5>{{ unitGroup.groupName|default('') }}&nbsp;</h5>
                <div class="status">
                    View status and Endorsements
                    <img src="/assets/img/img-arrow-down-white-trans.png">
                </div>
            </div>
            <div id="u{{ role.id ~ module.id ~ unitGroup.id }}" class="units">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Unit title</th>
                        {% include '_includes/columnLayout' with {header:true, columnLayout:columnLayout, isManager:isManager} %}
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set rowClass = 'odd' %}
                    {% for unitEntry in unitGroupEntries.all() %}
                        {% set resultEntry = null %}
                        {% set totalComments = 0 %}

                        {% set unitType = unitEntry.unitType %}
                        {% set unitPoints = craft.lantra.unitPoints(unitEntry, module) %}
                        {% if unitEntry.unitRecurring %}
                            {# get or create results for recurring period #}
                            {% set resultQuery = craft.lantra.recurringResultsQuery(cpdUser.id, unitEntry.id, cycle, moduleResultEntry.id) %}
                        {% else %}
                            {# get only results linked to this module result if a cpd type module #}
                            {% set resultQuery = craft.lantra.unitResultsQuery(cpdUser.id, unitEntry.id, addResult ? null : 1, module.type == 'cpd' ? moduleResultEntry.id : null) %}
                        {% endif %}
                        {% set hasResult = resultQuery.count() %}
                        {% set multipleRows = unitEntry.unitRecurring or (addResult and hasResult) %}

                        {% set rowName =  unitEntry.title ~ ' ' ~ unitEntry.unitHeading %}
                        {% set editUrl = '/cpd/' ~ cpdUser.id ~ '/' ~ module.id ~ '/' ~ unitEntry.id ~ '/' %}

                        {% set editLink = editUrl ~ '?ref=module' ~ moduleElementId ~ '&moduleResultId=' ~ moduleResultEntry.id %}
                        {% if addResult and hasResult %}
                            {% set newLink = editUrl ~ 'new?ref=module' ~ moduleElementId ~ '&moduleResultId=' ~ moduleResultEntry.id %}
                        {% endif %}

                        {# if a single row (no multiple submissions or no results yet #}
                        {% if multipleRows %}
                            {% for unitResultEntry in resultQuery.all() %}
                                {% if unitEntry.unitRecurring %}
                                    {% set cyclePeriod = craft.lantra.unitResultRecurringCycle(moduleResultEntry, unitResultEntry.resultRecurringCycleCode) %}
                                    {% set rowTitle = cyclePeriod ? cyclePeriod.name : 'unknown' %}
                                    {% set editLink = cyclePeriod and (cyclePeriod.isCurrent() or cyclePeriod.isPast()) ? editUrl ~ unitResultEntry.id ~ '/?ref=module' ~ moduleElementId : '' %}
                                {% else %}
                                    {% set rowTitle = readOnly ? rowName : '<a href="' ~ newLink ~ '">' ~ rowName ~ '</a>' %}
                                    {% set rowTitle = loop.first ? rowTitle : '' %}
                                    {% set editLink = readOnly ? rowName : editUrl ~ unitResultEntry.id ~ '/?ref=module' ~ moduleElementId %}
                                {% endif %}
                                {# remember all result ids so as to get user results below #}
                                {% set existingResultIds = existingResultIds|merge([unitResultEntry.id]) %}
                                {% set totalComments = unitResultEntry ? unitResultEntry.resultComments.count : 0 %}
                                {% set unreadComments = unitResultEntry ? craft.lantra.unreadComments(unitResultEntry) : 0 %}
                                {% include 'record/_modules/row' with{resultEntry: unitResultEntry, rowClass:rowClass} %}
                            {% endfor %}
                        {% else %}
                            {% set rowTitle = readOnly ? rowName : '<a href="' ~ editLink ~ '">' ~ rowName ~ '</a>' %}
                            {% set jobRoleNoResult = jobRoleNoResult + 1 %}
                            {% set unitResultEntry = hasResult ? resultQuery.one() : null %}
                            {% include 'record/_modules/row' with{resultEntry: unitResultEntry, rowClass:rowClass} %}
                        {% endif %}
                        {% set rowClass = rowClass == 'odd' ? 'even' : 'odd' %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endfor %}
    {# get user results related to module #}
    {% set moduleUserResults = craft.entries.section('results').type('userResult').authorId(cpdUser.id).relatedTo(module.id).status('live, expired').limit(null) %}
    {% if moduleUserResults|length %}
        {% set existingResultIds = existingResultIds|merge(moduleUserResults.ids()) %}
        <div class="unit-group">
            <div class="header" data-target="#u{{ role.id ~ module.id }}-user">
                <h5>My Achievements</h5>
                <div class="status">
                    View status and Endorsements
                    <img src="/assets/img/img-arrow-down-trans.png">
                </div>
            </div>
            <div id="u{{ role.id ~ module.id }}-user" class="units">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Result title</th>
                        {% include '_includes/columnLayout' with {header:true, columnLayout:columnLayout, isManager: isManager} %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for userResultEntry in moduleUserResults %}
                        {% set totalComments = userResultEntry.resultComments.count %}
                        {% set unreadComments = craft.lantra.unreadComments(userResultEntry) %}
                        {% set rowTitle = userResultEntry.title %}
                        {% set rowUrl = '/cpd/' ~ cpdUser.id ~ '/result' ~ userResultEntry.id %}
                        {% set unitType = 'evidence' %}
                        {% set unitPoints = userResultEntry.unitPoints %}
                        {% include 'record/_modules/row' with{resultEntry: userResultEntry} %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
    {% if moduleGroup.addAchievement and not module.addAchievementHide and not readOnly %}
        <a class="button no-shadow primary-bg" href="/cpd/{{ cpdUser.id }}/achievement/{{ module.id }}">
            <span>Add</span>
        </a>
    {% endif %}
</div>