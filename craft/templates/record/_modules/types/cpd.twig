{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
<div class="header" data-target="#m{{ role.id ~ module.id }}">
    {% set cycle = craft.lantra.resultCycle(moduleResultEntry) %}
    <h4 style="display:block">{{ module.title }}<span style="float: right">{{ cycle.name }}</span></h4>
    {% if cycle.isGrace %}
        <h5 style="display:block;text-align:right;color:red">ACTIVE until {{ cycle.graceDate|date(dateFormat) }}</h5>
    {% endif %}
    {% if cycle.isLocked %}
        <h5 style="display:block;text-align:right;color:black">LOCKED</h5>
    {% endif %}
    {% if moduleResultEntry.resultStatus == 'complete' %}
        <p style="color:green;">
        <span class="status-complete"></span>Congratulations, this module is complete!</p>
    {% else %}
        <p>
            {% set unitResultCount = craft.lantra.getModuleResultUnitResults(moduleResultEntry.id, null, true) %}
            {% set unitResultExpiredCount = craft.lantra.getModuleResultUnitResults(moduleResultEntry.id, 'expired', true) %}
            {% set remaining = craft.lantra.remaining(moduleResultEntry) %}
            {% set pending = craft.lantra.pending(moduleResultEntry, cpdUser.id) %}

            {% if unitResultExpiredCount %}
                {% set status = 'expired' %}
            {% elseif unitResultCount %}
                {% set status = 'inprogress' %}
            {% else %}
                {% set status = 'active' %}
            {% endif %}

            <span class="status-{{ status }}"></span>
            Overall:
            {% if remaining.pointsScore %}{{ remaining.pointsScore }} Points{% endif %}
            {% if remaining.hoursScore  %}{{ remaining.hoursScore }} Hours{% endif %}
        </p>

        {% if moduleResultEntry.resultComponentResults|length %}
        <p style="padding-left:40px;">
        {% for componentRow in moduleResultEntry.resultComponentResults %}
            {% if componentRow.targetHours or componentRow.targetPoints %}
                {% set status = 'inprogress' %}
                {% if (componentRow.targetHours and componentRow.endorsedHours < componentRow.targetHours) or (componentRow.targetPoints and componentRow.endorsedPoints < componentRow.targetPoints) %}
                    {% set status = 'expired' %}
                {% endif %}
                <span class="status-{{ status }}"></span>
                {{ componentRow.title }}:
                {% if componentRow.targetHours %}
                    {{ componentRow.endorsedHours }}/{{ componentRow.targetHours }} Hours
                {% endif %}
                {% if componentRow.targetPoints %}
                    {{ componentRow.endorsedPoints }}/{{ componentRow.targetPoints }} Points
                {% endif %}
                <br />
            {% endif %}
        {% endfor %}
        </p>
        {% endif %}

        {% if pending.total %}
        <p>
            You have {{ pending.total }} result{{ pending.total > 1 ? 's' : '' }} waiting for endorsement worth {{ pending.text }}.
        </p>
        {% endif %}
        <p>
            Result ID: {{ moduleResultEntry.id }}
        </p>
{% endif %}
</div>
{% include 'record/_modules/unitGroups' with {'cycle':cycle, 'moduleResultEntry':moduleResultEntry, 'readOnly':readOnly or (not readOnly and cycle.isLocked) } %}