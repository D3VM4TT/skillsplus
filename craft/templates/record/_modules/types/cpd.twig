<div class="header" data-target="#m{{ role.id ~ module.id }}">
    {% set cycle = craft.lantra.resultCycle(moduleResultEntry) %}
    <h4 style="display:block">{{ module.title }}<span style="float: right">{{ cycle.name }}</span></h4>
    {% if cycle.isGrace %}
        <h5 style="display:block;text-align:right;color:green">ACTIVE until {{ cycle.graceDate|date('d/m/y') }}</h5>
    {% endif %}
    {% if cycle.isLocked %}
        <h5 style="display:block;text-align:right;color:red">LOCKED</h5>
    {% endif %}
    {% if moduleResultEntry.resultStatus == 'complete' %}
    <p><span class="status-complete"></span>Congratulations, this module is complete!</p>
    {% else %}
    {% set remainingText = craft.lantra.remainingText(moduleResultEntry) %}
    <p><span class="status-inprogress"></span>You need {{ remainingText }} to complete this module.</p>
{% endif %}
</div>
{% include 'record/_modules/unitGroups' with {'cycle':cycle} %}