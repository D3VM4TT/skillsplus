<div class="header" data-target="#m{{ role.id ~ module.id }}">
    {% set cycle = craft.lantra.resultCycle(moduleResultEntry) %}
    <h4 style="display:block">{{ module.title }}<span style="float: right">{{ cycle.name }}</span></h4>
    {% if cycle.isGrace %}
        <h5 style="display:block;text-align:right;color:red">ACTIVE until {{ cycle.graceDate|date('d/m/y') }}</h5>
    {% endif %}
    {% if cycle.isLocked %}
        <h5 style="display:block;text-align:right;color:black">LOCKED</h5>
    {% endif %}
    {% if moduleResultEntry.resultStatus == 'complete' %}
        <p style="color:green;">
        <span class="status-complete"></span>Congratulations, this module is complete!</p>
    {% else %}
        <p>

            {% set unitResultCount = craft.lantra.getModuleResultUnitResults(moduleResultEntry.id, null, true) %}
            {% set unitResultExpiredCount = craft.lantra.getModuleResultUnitResults(moduleResultEntry.id, 'expired', true) %}
            {% set remaining = craft.lantra.remaining(moduleResultEntry) %}
            {% set pending = craft.lantra.pending(moduleResultEntry, cpdUser.id) %}

            {% if unitResultExpiredCount %}
                {% set status = 'expired' %}
            {% elseif unitResultCount %}
                {% set status = 'inprogress' %}
            {% else %}
                {% set status = 'active' %}
            {% endif %}

            <span class="status-{{ status }}"></span>

            {% if remaining.pointsScore  %}Points: {{ remaining.pointsScore }} {% endif %}
            {% if remaining.hoursScore  %}Hours: {{ remaining.hoursScore }} {% endif %}<br />
            <br />You need {{ remaining.text }} to complete this module.
            {% if pending.total %}<br />You have {{ pending.total }} result{{ pending.total > 1 ?? 's' }} waiting for endorsement worth {{ pending.text }}.{% endif %}
        </p>
{% endif %}
</div>
{% include 'record/_modules/unitGroups' with {'cycle':cycle, 'moduleResultEntry':moduleResultEntry, 'readOnly':readOnly or (not readOnly and cycle.isLocked) } %}