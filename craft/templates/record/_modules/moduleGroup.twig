<div class="{% if package is not defined %}groups-tab-group{% endif %} endorse-wrapper" id="tab{{ moduleGroupElementId }}" data-label="{{ moduleGroup.title }}">
    {% if moduleGroup.isCompany and cpdUser.userCompany %}
        {% set userCompany = cpdUser.userCompany.one %}
        <div class="assessment" style="border-color: {{ craft.lantra.setting('themeColorPrimary') }}">
            <p>Company Name:
                {% if craft.lantra.isManager(cpdUser.id) %}
                    <a href="/management/companies/edit/{{ userCompany.id  }}">{{ userCompany.title }}</a>
                {% else %}
                    {{ userCompany.title }}
                {% endif %}
            </p>
        </div>
    {% endif %}
    {% if package is defined %}
        {% set assessment = package.moduleGroupAssessment(moduleGroup.id) %}
        {% if assessment and assessment.assessmentDate %}
            <div class="assessment {{ assessment.assessmentPassed ? 'passed' : 'failed' }}">
                <p>
                    {{ assessment.assessmentDate|date(dateFormat) }} {{ assessment.assessmentPassed ? 'Passed' : 'Failed' }}
                    <br />{{ assessment.assessmentComment }}
                </p>
            </div>
        {% endif %}
    {% endif %}
    <div class="module-tabs">
        <ul class="tabs clearfix" data-module-group="{{ moduleGroup.id }}" data-tabgroup="tab-group-{{ moduleGroup.id }}" {% if moduleGroup.moduleGroupMenu == 'dropdown' %}style="display:none"{% endif %}>
            <div class="tabs-group">
                {% if not moduleGroupItem.modules|length %}
                    No modules have been added to this module group.
                {% endif %}
                {% set options = '' %}
                {% for moduleItem in moduleGroupItem.modules %}
                    {% set module = cpdUser.record.getElement(moduleItem.elementId) %}
                    {% set moduleElementId = moduleGroupElementId ~ module.id %}
                    {% set options = options ~ '<option value="#module' ~ moduleElementId ~ '">' ~ module.title ~ '</option>' %}
                    <li>
                        <a href="#module{{ moduleElementId }}" class="module-status">
                            <span class="status-active"></span>
                            {{ module.title }}
                        </a>
                    </li>
                    {% if not loop.last and loop.index is divisible by(4) %}
                </div>
                <div class="tabs-group">
                    {% endif %}
                {% endfor %}
            </div>
        </ul>
        {% if moduleGroup.moduleGroupMenu == 'dropdown' and options %}
            <div class="field--wrapper" style="margin-top:30px;">
                <p>Please select module below:</p>
                <select class="module-menu" id="module-select-{{ moduleGroup.id }}">
                    {{ options|raw }}
                </select>
            </div>
        {% endif %}
    </div>
    <div id="tab-group-{{ moduleGroup.id }}" class="tabgroup module-wrapper">
        {% for moduleItem in moduleGroupItem.modules %}
            {% set module = cpdUser.record.getElement(moduleItem.elementId) %}
            {% set moduleElementId = moduleGroupElementId ~ module.id %}
            {% set columnLayout = module.columnLayout.count ?  module.columnLayout : (moduleGroup.columnLayout.count ? moduleGroup.columnLayout : globalsTheme.columnLayout) %}
            {% include 'record/_modules/module' %}
        {% endfor %}
    </div>
</div>