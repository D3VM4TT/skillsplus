<div class="groups-tab-group" id="tab{{ moduleGroupElementId }}">
    {% if package is defined %}
        {% set assessment = package.moduleGroupAssessment(moduleGroup.id) %}
        {% if assessment and assessment.assessmentDate %}
            <div class="assessment {{ assessment.assessmentPassed ? 'passed' : 'failed' }}">
                <p>
                    {{ assessment.assessmentDate|date(dateFormat) }} {{ assessment.assessmentPassed ? 'Passed' : 'Failed' }}
                    <br />{{ assessment.assessmentComment }}
                </p>
            </div>
        {% endif %}
    {% endif %}
    <div class="module-tabs">
        <ul class="tabs clearfix" data-tabgroup="tab-group-{{ moduleGroup.id }}">
            <div class="tabs-group">
                {% if not moduleGroupItem.modules|length %}
                    No modules have been added to this module group.
                {% endif %}
                {% for moduleItem in moduleGroupItem.modules %}
                    {% set module = cpdUser.record.getElement(moduleItem.elementId) %}
                    {% set moduleElementId = moduleGroupElementId ~ module.id %}
                    {% set moduleResultEntry = craft.entries.section('results').type('moduleResult').authorId(cpdUser.id).relatedTo(module).resultStatus('complete').status('live, expired').one() %}
                    <li>
                        <a href="#module{{ moduleElementId }}" class="module-status">
                            <span class="status-active"></span>
                            {{ module.title }}
                        </a>
                    </li>
                    {% if not loop.last and loop.index is divisible by(4) %}
                </div>
                <div class="tabs-group">
                    {% endif %}
                {% endfor %}
            </div>
        </ul>
    </div>
    <div id="tab-group-{{ moduleGroup.id }}" class="tabgroup module-wrapper">
        {% for moduleItem in moduleGroupItem.modules %}
            {% set module = cpdUser.record.getElement(moduleItem.elementId) %}
            {% set moduleElementId = moduleGroupElementId ~ module.id %}
            {% set columnLayout = module.columnLayout.count ?  module.columnLayout : (moduleGroup.columnLayout.count ? moduleGroup.columnLayout : globalsTheme.columnLayout) %}
            {% include 'record/_modules/module' %}
        {% endfor %}
    </div>
</div>