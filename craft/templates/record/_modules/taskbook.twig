{% set package = cpdUser.record.getElement(packageId) %}
{% set resitModuleGroups = package.resitModuleGroupCategories %}
{% set isModuleGroup = false %}
{% if moduleGroupId %}
    {% set isModuleGroup = true %}
    {% set moduleGroup = cpdUser.record.getElement(moduleGroupId) %}
    {% set moduleGroupItem = cpdUser.record.getItem(moduleGroupId) %}
    {% set moduleGroupElementId = package.id ~ moduleGroupId %}
    {% set packageModuleGroup = package.moduleGroup(moduleGroupId) %}
    {% set level = packageModuleGroup.level %}
{% endif %}

{% set packageComments =  package.comments %}

<div class="package tab-container" style="position: relative;">
    <div class="align-vertical">
        <div class="align-horizontal">
            <img src="/assets/img/tool-job-role-management.svg" width="120" height="120" class="" alt="">
        </div>
        <div class="align-horizontal">
            <div><h4>{{ craft.lantra.setting('taskbookLabel', 'Taskbook') }}</h4></div>
            <div><h2>{{ package.taskbook.title }}</h2></div>
            <p>
                {% if isModuleGroup %}
                    <a href="/cpd/{{ cpdUser.id }}/taskbooks/{{ package.id }}">&laquo; back to {{ taskbookLabel }}</a>
                {% elseif package.isManager(currentUser, true) and package.hasNextStep %}
                    Current Step: {{ package.nextStep.reviewStepName }}
                {% endif %}
            </p>
            {% set certificateUrl = craft.lantra.certificateUrl(package) %}
            {% if certificateUrl %}
                <p><a href="{{ certificateUrl }}">Download Certificate</a></p>
            {% endif %}
        </div>
        <div class="align-horizontal" style="margin-left:auto;width:25%;text-align:right">
            {% if package.isComplete %}
                {% if package.hasNextStep and package.isReviewUser(currentUser, package.nextStep, true) %}
                    {% if package.isNextStepAssigned %}
                        <a class="button no-shadow primary-bg" href="/management/taskbooks/manage/{{ package.id }}/review">Submit {{ package.nextStep.reviewStepName }}</a>
                    {% else %}
                        Step reviewer not assigned
                    {% endif %}
                {% endif %}
            {% endif %}
        </div>
    </div>
    <div id="j{{ package.id }}" class="open">
        <div class="module-group-tabs">
            <ul class="tabs clearfix" data-tabgroup="groups-tab-group-{{ package.id }}">
                {% if moduleGroupId %}
                    {% set moduleGroupItem = cpdUser.record.getItem(moduleGroupId) %}
                    {% set totalUnits = moduleGroupItem.allUnits|length %}
                    {% set totalComplete = craft.lantra.totalComplete(moduleGroupItem, cpdUser.id) %}
                    {% set isComplete = totalComplete >= totalUnits %}
                    <li>
                        <a href="#tab{{ moduleGroupElementId }}" class="primary-bg">
                            <h4>
                                {{ moduleGroup.magicTitle }}
                                {% if isComplete %} [complete]{% endif %}
                            </h4>
                        </a>
                    </li>
                {% else %}
                <li>
                    <a href="#tab{{ package.id }}taskbook" class="primary-bg">
                        <h4>{{ taskbookLabel }}</h4>
                    </a>
                </li>
                <li>
                    <a href="#tab{{ package.id }}evidence" class="primary-bg evidence-tab" data-id="{{ package.id }}">
                        <h4>Evidence</h4>
                    </a>
                </li>
                <li>
                    <a href="#tab{{ package.id }}reviews" class="primary-bg">
                        <h4>Reviews</h4>
                    </a>
                </li>
                {% if package.packageLog|length %}
                    <li>
                        <a href="#tab{{ package.id }}log" class="primary-bg">
                            <h4>Log</h4>
                        </a>
                    </li>
                {% endif %}
                {% if isManager and packageComments|length %}
                    <li>
                        <a href="#tab{{ package.id }}comments" class="primary-bg">
                            <h4>Unread Comments ({{ packageComments|length }})</h4>
                        </a>
                    </li>
                {% endif %}
                {% if alias('@site') == 'bics' and not isManager %}
                    {% if resitModuleGroups|length %}
                        <li>
                            <a href="#tab{{ package.id }}resits" class="primary-bg">
                                <h4>Resit {{ taskbookLabel }} Groups ({{ resitModuleGroups|length }})</h4>
                            </a>
                        </li>
                    {% endif %}
                {% endif %}
                {% endif %}
            </ul>
        </div>
        <section id="groups-tab-group-{{ package.id }}" class="tabgroup">
            {% if moduleGroupId %}
                {% include 'record/_modules/moduleGroup' %}
            {% else %}
            <div class="groups-tab-group-{{ package.id }}" id="tab{{ package.id }}taskbook">
                <div style="margin-top:20px;margin-bottom:20px">
                    {{ package.taskbook.taskbookIntro }}
                </div>
                {% if package.taskbook.taskbookFiles.count  %}
                    <h4>Supporting Files &amp; Images</h4>
                    <table class="data unit-files" width="100%">
                        <thead>
                        <tr>
                            <th>Filename</th>
                            <th style="text-align: right;padding-right:0;">Date Uploaded</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for file in package.taskbook.taskbookFiles.all()  %}
                            <tr>
                                <td><a target="_blank" href="{{ file.url }}">{{ file.filename }}</a></td>
                                <td style="text-align: right">{{ file.dateCreated|date('d/m/Y') }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
                {% if package.packageStatus == 'locked' %}
                    <h4>{{ taskbookLabel }} Locked</h4>
                    <p>Your {{ taskbookLabel|lower }} has been submitted for assessment.</p>
                {% else %}
                    <h4>Requirements</h4>
                    <div style="width: 50%;display: inline;float:left;">
                        {% include '_includes/taskbooks/taskbookRequired' with {taskbook: package.taskbook} %}
                        {% if package.taskbook.moduleMinimumCredits %}
                            <p{% if not package.creditsSelected %} style="background-color:#FFFF00;"{% endif %}>
                                Your current selection includes <strong>{{ package.totalCredits }}</strong> {{ 'credit' |pluralize(package.totalCredits) }}
                                {% if package.taskbook.moduleGroupMinimumLevel %}including <strong>{{ package.totalCredits(true) }}</strong> {{ 'credit' |pluralize(package.totalCredits) }} at or above level <strong>{{ package.taskbook.moduleGroupMinimumLevel }}</strong>{% endif %}.
                            </p>
                        {% endif %}
                    </div>
                    {% if package.isComplete(true) %}
                        <div style="width: 50%;display: inline;float:right;text-align: right">
                            <p style="color:#006600;margin-bottom:10px;">You have completed your {{ taskbookLabel|lower }}.<br />Click below to request assessment.</p>
                                <a style="margin:0;" class="action button no-shadow primary-bg" href="#" data-id="{{ package.id }}"
                                   data-ref="package"
                                   data-confirm="Are you sure you want to submit this {{ taskbookLabel|lower }}? You will no longer be able to make any changes."
                                   data-userid="{{ cpdUser.id }}"
                                   data-action="packages/request-assessment"
                                >Request Assessment</a>
                        </div>
                    {% endif %}
                {% endif %}
                <p style="clear: both">&nbsp;</p>
                <hr />
                <p>&nbsp;</p>
                <h4>Your Current Selection</h4>
                {% set mandatoryModuleGroups = package.moduleGroups('mandatory')  %}
                {% set optionalModuleGroups = package.moduleGroups('optional')  %}
                <table class="data" width="100%">
                    <thead>
                    <tr>
                        <th style="width: 60%;">Mandatory</th>
                        <th style="width: 10%;">Level</th>
                        {% if package.taskbook.moduleMinimumCredits %}
                            <th style="width: 10%;">Credit</th>
                        {% endif %}
                        <th>Units Complete</th>
                        {% if package.taskbook.unitEndorse %}
                            <th>Units Endorsed</th>
                        {% endif %}
                        <th style="width:100px;"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for moduleGroup in mandatoryModuleGroups %}
                        {% set moduleGroupItem = cpdUser.record.getItem(moduleGroup.category.id) %}
                        {% set totalUnits = moduleGroupItem.allUnits|length %}
                        {% set totalComplete = craft.lantra.totalComplete(moduleGroupItem, cpdUser.id) %}
                        {% set isComplete = totalComplete >= totalUnits %}
                        {% set totalEndorsed = craft.lantra.totalEndorsed(moduleGroupItem, cpdUser.id) %}
                        {% set isEndorsed = totalEndorsed >= totalUnits %}
                        {% set totalPending = craft.lantra.totalPending(moduleGroupItem, cpdUser.id)  %}
                        <tr class="taskbook-module-group {% if package.taskbook.unitEndorse and totalPending %}endorse{% endif %}">
                            <td>
                                <a href="/cpd/{{ cpdUser.id }}/taskbooks/{{ package.id }}/{{ moduleGroup.category.id }}">{{ moduleGroup.category.title }}</a>
                                {% if isComplete %} [<span style="color:#006600">complete</span>]{% endif %}
                            </td>
                            <td>{{ craft.lantra.taskbookLevel(moduleGroup.level) }}</td>
                            {% if package.taskbook.moduleMinimumCredits %}
                                <td>{{ moduleGroup.credit }}</td>
                            {% endif %}
                            <td>{{ totalComplete ~ '/' ~ totalUnits }}</td>
                            {% if package.taskbook.unitEndorse %}
                                <td>{{ totalEndorsed ~ '/' ~ totalUnits }}</td>
                            {% endif %}
                            <td></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% if optionalModuleGroups %}
                <table class="data" width="100%">
                    <thead>
                    <tr>
                        <th style="width: 60%;">Optional</th>
                        <th style="width: 10%;">Level</th>
                        {% if package.taskbook.moduleMinimumCredits %}
                            <th style="width: 10%;">Credit</th>
                        {% endif %}
                        <th>Units Complete</th>
                        {% if package.taskbook.unitEndorse %}
                            <th>Units Endorsed</th>
                        {% endif %}
                        <th style="width:100px;"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for moduleGroup in package.moduleGroups('optional')  %}
                        {% set moduleGroupItem = cpdUser.record.getItem(moduleGroup.category.id) %}
                        {% set totalUnits = moduleGroupItem.allUnits|length %}
                        {% set totalComplete = craft.lantra.totalComplete(moduleGroupItem, cpdUser.id) %}
                        {% set isComplete = totalComplete >= totalUnits %}
                        {% set totalEndorsed = craft.lantra.totalEndorsed(moduleGroupItem, cpdUser.id) %}
                        {% set isEndorsed = totalEndorsed >= totalUnits %}
                        {% set totalPending = craft.lantra.totalPending(moduleGroupItem, cpdUser.id)  %}
                        <tr class="taskbook-module-group {% if package.taskbook.unitEndorse and totalPending %}endorse{% endif %}">
                            <td>
                                <a href="/cpd/{{ cpdUser.id }}/taskbooks/{{ package.id }}/{{ moduleGroup.category.id }}">{{ moduleGroup.category.title }}</a>
                                {% if isComplete %} [<span style="color:#006600">complete</span>]{% endif %}
                            </td>
                            <td>{{ craft.lantra.taskbookLevel(moduleGroup.level) }}</td>
                            {% if package.taskbook.moduleMinimumCredits %}
                                <td>{{ moduleGroup.credit }}</td>
                            {% endif %}
                            <td>{{ totalComplete ~ '/' ~ totalUnits }}</td>
                            {% if package.taskbook.unitEndorse %}
                                <td>{{ totalEndorsed ~ '/' ~ totalUnits }}</td>
                            {% endif %}
                            <td style="text-align: right;"><a href="/confirm?controller=packages&method=remove-module-group&packageId={{ package.id }}&moduleGroupId={{ moduleGroup.category.id }}">Remove</a></a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% endif %}
                {% if package.hasAvailable %}
                    <hr />
                    <p>&nbsp;</p>
                    <h4>Available Modules</h4>
                    <table class="data" width="100%">
                        <thead>
                        <tr>
                            <th style="width: 60%;">Available</th>
                            <th style="width: 10%;">Level</th>
                            {% if package.taskbook.moduleMinimumCredits %}
                                <th style="width: 10%;">Credit</th>
                            {% endif %}
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for moduleGroup in package.moduleGroups('available')  %}
                            <tr>
                                <td>{{ moduleGroup.category.title }}</td>
                                <td>{{ craft.lantra.taskbookLevel(moduleGroup.level) }}</td>
                                {% if package.taskbook.moduleMinimumCredits %}
                                    <td>{{ moduleGroup.credit }}</td>
                                {% endif %}
                                <td></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    <p style="text-align: right">
                        <a class="button no-shadow primary-bg" href="/cpd/{{ cpdUser.id }}/taskbooks/single?type=optional&packageId={{ package.id }}">Add Optional Modules</a>
                    </p>
                {% endif %}
                {% if package.moduleGroups('unpaid') %}
                    <hr />
                    <p>&nbsp;</p>
                    <h4>Unpaid Module Groups</h4>
                    <table class="data" width="100%">
                        <thead>
                        <tr>
                            <th>Module Group</th>
                            <th style="text-align: right;padding-right:0">Cost</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for moduleGroup in package.moduleGroups('unpaid')  %}
                            <tr>
                                <td>{{ moduleGroup.category.title }}</td>
                                <td style="text-align: right">£{{ moduleGroup.cost }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    <p style="text-align: right">
                        <a class="button no-shadow primary-bg" href="/cpd/{{ cpdUser.id }}/taskbooks/single?payment=true&packageId={{ package.id }}">Pay Now</a>
                    </p>
                {% endif %}
            </div>
            <div class="groups-tab-group-{{ package.id }} evidence-pane" id="tab{{ package.id }}evidence">
            </div>
            <div class="groups-tab-group-{{ package.id }}" id="tab{{ package.id }}reviews">
                {% include '_includes/taskbooks/packageReviews' with {admin:false} %}
                {% if package.canAssign(currentUser) or package.isManager(currentUser, true) %}
                    <a class="button no-shadow primary-bg" href="/management/taskbooks/manage/{{ package.id }}">Manage Reviewers</a>
                {% endif %}
            </div>
            {% if package.packageLog|length %}
                <div class="groups-tab-group-{{ package.id }}" id="tab{{ package.id }}log">
                    {% include '_includes/taskbooks/packageLog' with {admin:false} %}
                </div>
            {% endif %}
            {% if isManager and packageComments|length %}
                <div class="groups-tab-group-{{ package.id }}" id="tab{{ package.id }}comments">
                    {% include '_includes/taskbooks/packageComments' with {packageComments:packageComments} %}
                </div>
            {% endif %}
            {% if not isManager %}
                {% if resitModuleGroups|length %}
                    <div class="groups-tab-group-{{ package.id }}" id="tab{{ package.id }}resits">
                        {% include '_includes/taskbooks/packageResits' with {admin:false, resitModuleGroups:resitModuleGroups} %}
                    </div>
                {% endif %}
            {% endif %}
            {% endif %}
        </section>
    </div>
</div>