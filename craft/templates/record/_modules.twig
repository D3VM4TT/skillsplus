{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set isManager = false %}
{% set isAssessor = false %}
{% set readOnly = (craft.lantra.setting('schemeUserReadOnly') or (cpdUser['userReadOnly'] is defined and cpdUser.userReadOnly)) %}
{% if cpdUser.id != currentUser.id %}
    {% set isManager = true %}
    {% set readOnly = currentUser.managerReadOnly %}
    {% set isPackageManager = craft.lantra.isPackageManager(cpdUser.id, currentUser.id) %}
{% endif %}

{% set jobRoleEndorse = craft.lantra.setting('jobRoleEndorse', false) %}

<article id="cpd-wrapper" class="cpd" data-ref="{{ craft.app.request.getParam('ref')|default('') }}">
    {% if craft.lantra.setting('enableTaskbooks') %}
        {% include 'record/_modules/taskbooks' with {cpdUser:cpdUser} %}
    {% endif %}
    {% if craft.lantra.setting('enableJobRoles') %}
        {% include 'record/_modules/jobroles' with {cpdUser:cpdUser} %}
    {% endif %}
</article>
