{% extends "_layout" %}

{% if userId != currentUser.id %}
    {% set account = craft.users.id(userId).one %}
    {% if not account or not craft.lantra.isManager(account.id) %}{% exit 403 %}{% endif %}
    {% set isManager = true %}
{% else %}
    {% set account = currentUser %}
    {% set isManager = false %}
{% endif %}

{% set dashboardUri = '/cpd/' ~ account.id %}

{# if save-entry fails #}
{% if entry is defined %}
    {% set resultEntry = entry %}
{% endif %}

{% if resultEntry is not defined %}
    {% set moduleEntry = false %}
    {% set resultEntry = false %}
{% endif %}

{% set moduleResultEntry = false %}
{% set isPackage = false %}

{% set userUnitIds = craft.lantra.userUnitIds(account.id) %}
{% set excludeString = userUnitIds|length ? 'and, not ' ~ userUnitIds|join(', not ') : '' %}
{% set optionalUnits = craft.entries.section('units').id(excludeString).orderBy('title') %}

{# module id in URL #}
{% if craft.app.request.segment(3) == 'achievement' and entryId %}
    {% set moduleEntry = craft.entries.id(entryId).one %}
    {% if not moduleEntry %}{% exit 404 %}{% endif %}
    {% set dashboardUri = '/cpd/' ~ account.id ~ '#m' ~ moduleEntry.id %}
{# editing result #}
{% elseif not resultEntry and craft.app.request.segment(3) == 'result' and entryId %}
    {% set resultEntry = craft.entries.id(entryId).status('live, expired').one %}
    {% if not resultEntry %}{% exit 404 %}{% endif %}
    {% set moduleEntry = resultEntry.resultModule.one %}
{% endif %}

{% set achievementLabel = 'Achievement' %}

{% if moduleEntry %}
    {% set moduleGroup = moduleEntry.moduleGroup.one %}
    {% if moduleEntry.type == 'cpd' %}
        {% set moduleResultId = craft.app.request.getParam('moduleResultId') %}
        {% if moduleResultId %}
            {% set moduleResultEntry = craft.entries.id(moduleResultId).one() %}
        {% else %}
            {% set moduleResultEntry = craft.lantra.currentModuleResult(moduleEntry.id) %}
        {% endif %}
    {% endif %}
    {% set achievementLabel = moduleEntry.achievementLabel ? moduleEntry.achievementLabel : 'achievement' %}
{% endif %}

{% set userModules = [] %}
{% for role in account.userRole %}
    {% for roleModule in craft.entries.relatedTo(role).orderBy('title') %}
        {% set userModules = userModules|merge([roleModule]) %}
    {% endfor %}
{% endfor %}
{# result is locked when a result entry is pending or endorsed #}
{% set resultLocked = account.id == currentUser.id and resultEntry and resultEntry.resultStatus == 'endorsed' %}
{# undo result locked #}
{% set resultLocked = false %}
{% set metaTitle = achievementLabel|pluralize ~ ' > ' ~ account.fullname %}

{% block content %}
    <section class="page">
        <div class="page-subHeader primary-bg">
            <a class="back-link" href="{{ dashboardUri }}">&laquo; back</a>
            {% include '_includes/topNavigation' %}
        </div>
        <div class="page-header secondary-bg">
            <h2>{{ achievementLabel }} for {{ account.fullname }}</h2>
            <p>{% if moduleEntry %}{{ moduleEntry.title }} {{ moduleResultEntry ? moduleResultEntry.cycleName }}{% endif %}</p>
        </div>
        <div class="page-form">
            <div class="col-pd-btm">
            {% if resultEntry and resultEntry.id %}
                <h3>Edit {{ achievementLabel }}</h3>
            {% else %}
                <h3>Create new {{ achievementLabel }}</h3>
            {% endif %}
            </div>
            {% if resultEntry and resultEntry.hasErrors %}
                <div class="col-pd-btm">
                    <ul class="errors">
                        {% for error in resultEntry.getFirstErrors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            <form method="post" role="form" accept-charset="UTF-8" enctype="multipart/form-data" class="result no-loading">

                {% if resultEntry is defined and resultEntry %}
                    <div id="name-fields">
                        <div class="col-6 field--wrapper">
                            <h3>Result ID: {{ resultEntry.id }}</h3>
                        </div>
                    </div>
                {% endif %}

                {{ csrfInput() }}
                <input type="hidden" name="action" value="entries/save-entry">
                {{ redirectInput('cpd/' ~ account.id ~ '/?ref=' ~ craft.app.request.getParam('ref')) }}
                {% if resultEntry %}
                    <input type="hidden" name="fields[resultModuleResult][]" value="{{ resultEntry.resultModuleResult.one ? resultEntry.resultModuleResult.one.id }}" />
                {% else %}
                    <input type="hidden" name="fields[resultModuleResult][]" value="{{ moduleResultEntry ? moduleResultEntry.id }}" />
                {% endif %}
                <input type="hidden" name="typeId" value="17">
                <input type="hidden" name="sectionId" value="10">
                <input type="hidden" name="enabled" value="1">
                <input type="hidden" name="entryId" value="{{ resultEntry ? resultEntry.id : '' }}">
                {% if userId %}
                    <input type="hidden" name="author[]" value="{{ account.id }}">
                {%  endif %}
                <input type="hidden" name="fields[resultStatus]" value="{{ resultEntry ? resultEntry.resultStatus : 'pending' }}">
                <input type="hidden" name="fields[unitEndorsementManagerLevel]" value="1">
                <div class="field--wrapper" id="resultTitle">
                    <label for="title" class="float">Result Title</label>
                    <input value="{{ resultEntry ? resultEntry.title }}" type="text" name="title" class="float-label" placeholder="Enter the result title" />
                </div>
                {% if optionalUnits|length %}
                <div class="field--wrapper">
                    <label for="resultUnit" class="">Result unit</label>
                    <select data-relation="fields[resultUnit]" data-value="{{ resultEntry and resultEntry.resultUnit.count ? resultEntry.resultUnit.one.id }}" id="resultUnit">
                        <option value="">Not applicable</option>
                        {% for unit in optionalUnits %}
                            <option value="{{ unit.id }}">{{ unit.title }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                {% if moduleEntry %}
                    <input type="hidden" name="fields[resultModule][]" value="{{ moduleEntry.id }}">
                {% elseif not resultEntry and userModules|length %}
                    <div class="field--wrapper">
                        <label for="resultModule" class="float">Result module</label>
                        <select data-relation="fields[resultModule]"  id="resultModule">
                            <option value="">Not applicable</option>
                            {% for userModule in userModules %}
                                <option value="{{ userModule.id }}">{{ userModule.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
                {% if moduleEntry %}
                    {% include 'record/_units/fields' with {moduleGroup:moduleGroup, resultEntry:resultEntry, accountId:account.id, resultLocked:resultLocked, isManager:isManager} %}
                {% endif %}
                {% include 'record/_units/buttons' with {resultEntry:resultEntry, resultLocked:resultLocked, autoEndorse:moduleGroup.moduleGroupAutoEndorse} %}
            </form>
        </div>
    </section>
{% endblock %}