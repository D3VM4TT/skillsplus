{% set packageId = craft.app.request.getSegment(4) %}
{% set moduleGroupId = craft.app.request.getSegment(5) %}

{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set isManager = false %}
{% set isAssessor = false %}
{% set readOnly = (craft.lantra.setting('schemeUserReadOnly') or (cpdUser['userReadOnly'] is defined and cpdUser.userReadOnly)) %}
{% set taskbookLabel = craft.lantra.setting('taskbookLabel', 'Taskbook') %}
{% if cpdUser.id != currentUser.id %}
    {% set isManager = true %}
    {% set readOnly = currentUser.managerReadOnly %}
    {% set isPackageManager = craft.lantra.isPackageManager(cpdUser.id, currentUser.id) %}
{% endif %}

{% set unpaidPackages = craft.lantra.getUnpaidPackages(cpdUser.id) %}

{{ craft.lantra.syncUserPayments(cpdUser.id) }}

{% if packageId %}
    {% set packageItem = cpdUser.record.getItem(packageId) %}
    <article id="cpd-wrapper" class="cpd" data-ref="{{ craft.app.request.getParam('ref')|default('') }}">
        {% include 'record/_modules/taskbook' with{cpdUser:cpdUser, packageItem:packageItem, moduleGroupId:moduleGroupId} %}
    </article>
{% else %}
    {{ globalsHtml.pageCurrent }}
    {% if unpaidPackages|length %}
        <h4>Unpaid {{ taskbookLabel|lower }} packages</h4>
        <table class="data">
            <thead>
            <tr>
                <th>{{ taskbookLabel }}</th>
                {% if craft.lantra.setting('taskbookLevels') %}
                    <th>Level</th>
                {% endif %}
                <th>Date Created</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for package in unpaidPackages %}
                {% set packageTitle = package.taskbook ? package.taskbook.title : package.title %}
                <tr>
                    <td>{{ packageTitle }}</td>
                    {% if craft.lantra.setting('taskbookLevels') %}
                        <td>
                            {{ craft.lantra.taskbookLevel(package.packageLevel) }}
                        </td>
                    {% endif %}
                    <td>
                        {{ package.dateCreated|date(dateFormat) }}
                    </td>
                    <td>
                        {% set paymentMeta = {
                            'product' : packageTitle,
                            'packageId' : package.id,
                            'redirect' : '/cpd/' ~ userId ~ '/taskbooks'
                        } %}
                        {{ craft.lantra.basePaypalButton(account.id, package.packageCost, 'new-' ~ package.id, paymentMeta, 'Pay £' ~ package.packageCost)|raw }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
    {% if cpdUser.record.packages|length %}
    <table class="data">
        <thead>
        <tr>
            <th>{{ taskbookLabel }}</th>
            {% if craft.lantra.setting('taskbookLevels') %}
                <th>Level</th>
            {% endif %}
            <th>Date Created</th>
            <th>Payment Method</th>
            <th>Payment Reference</th>
            <th>Cost</th>
            <th>Status</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
            {% for packageItem in cpdUser.record.packages %}
                {% set package = cpdUser.record.getElement(packageItem.elementId) %}
                {% set packageTitle = package.taskbook ? package.taskbook.title : package.title %}
                <tr>
                    <td>
                        <a href="{{ craft.lantra.packageUrl(cpdUser.id, package.id) }}">{{ package.taskbook.title }}</a>
                    </td>
                    {% if craft.lantra.setting('taskbookLevels') %}
                    <td>
                        {{ craft.lantra.taskbookLevel(package.packageLevel) }}
                    </td>
                    {% endif %}
                    <td>
                        {{ package.dateCreated|date(dateFormat) }}
                    </td>
                    <td>
                        {{ package.paymentMethod }}
                    </td>
                    <td>
                        {{ package.paymentReference }}
                    </td>
                    <td>£{{ package.packageCost }}</td>
                    <td>
                        {{ package.packageStatus|title }}
                    </td>
                    <td>
                        {% set certificateUrl = craft.lantra.certificateUrl(package) %}
                        {% if certificateUrl %}
                            <a target="_blank" class="icon" href="{{ certificateUrl }}" data-tooltip title="Download certificate">
                                <img src="/assets/img/certificate.svg" title="Download certificate" />
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
        <p>You have no {{ taskbookLabel|lower }} packages.</p>
        <p>&nbsp;</p>
    {% endif %}
    {% if craft.lantra.setting('taskbookNew') %}
        <div class="container-btn">
            <p><a href="/cpd/{{ account.id }}/taskbooks/new" class="button primary-bg">Add {{ taskbookLabel }}</a></p>
        </div>
    {% endif %}
{% endif %}



