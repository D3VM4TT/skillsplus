{% requireLogin %}
{% set hierarchyNode = craft.app.request.getParam('node') %}
{% set userId = craft.app.request.getSegment(2) %}
{% extends "_layout" %}

{% set userId = craft.app.request.getSegment(2) %}
{% if not userId or userId == currentUser.id %}
    {% set account = currentUser %}
{% else %}
    {% set account = craft.users.id(userId).status(null).one %}
    {% if not craft.lantra.isManager(account.id) %}{% exit 403 %}{% endif %}
{% endif %}

{% set isManager = false %}
{% if account.id != currentUser.id %}
    {% set isManager = true %}
{% endif %}

{% set isTaskbooks = craft.request.getSegment(3) == 'taskbooks' %}
{% set taskbookLabel = craft.lantra.setting('taskbookLabel', 'Taskbook') %}

{% set accountPhoto = account.getPhoto() %}
{% set accountPhotoUrl = accountPhoto ? accountPhoto.getUrl('thumb') : '/assets/img/img-team-management.jpg' %}

{% set metaTitle = 'CPD > ' ~ account.fullname %}

{% block content %}
<div class="page-subHeader primary-bg">
    {% if isManager %}
        <a class="back-link" href="/management/hierarchy">&laquo; back to Hierarchy</a>
        <a class="back-link" href="/management/users">&laquo; back to Users</a>
    {% endif %}
{% include '_includes/topNavigation' %}
</div>
<section class="page">
    <div class="page-header secondary-bg">
        {% if isManager %}
            {% if hierarchyNode %}
                <a href="/management/hierarchy?node={{ hierarchyNode }}"><img src="{{ accountPhotoUrl }}" width="150" height="150" class="right rounded-circle" alt="{{ account.fullName }}"></a>
            {% else %}
                <a href="/management/users"><img src="{{ accountPhotoUrl }}" width="150" height="150" class="right rounded-circle" alt="{{ account.fullName }}"></a>
            {% endif %}
        {% endif %}
        <h2>{{ isManager ? account.fullname ~ "'s" : 'My' }} {{ isTaskbooks ? taskbookLabel|pluralize : 'Dashboard' }}</h2>
        {% if not isManager and isTaskbooks %}
            <div class="header-controls">
                <div class="container-btn primary-bg" style="margin-left:0;">
                    <a class="btn-add-new" href="/profile/taskbooks">Manage {{ taskbookLabel|pluralize }}</a>
                </div>
            </div>
        {% endif %}
    </div>
    {% include '_includes/account' with{cpdUser:account} %}
    <div class="page-content">
        {% if isTaskbooks %}
            {% include 'record/_taskbooks' with{cpdUser:account} %}
        {% else %}
            {% include 'record/_modules' with{cpdUser:account} %}
        {% endif %}
    </div>
</section>
{% endblock %}
