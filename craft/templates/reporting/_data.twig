{% do craft.lantra.requirePermission('editReports') %}
{% extends "_layout" %}

{% set entryId = craft.app.request.getSegment(3) %}
{% set reportEntry = craft.entries.id(entryId).one %}

{% set filterDays = craft.app.request.getParam('days')|default(28) %}
{% set filterSearch = craft.app.request.getParam('search')|default('') %}

{% set metaTitle = "Reporting > Data" %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set reportTypePageLimit = craft.lantra.reportTypeSetting(reportEntry.reportType, 'pageLimit') %}
{% set pageLimit = reportTypePageLimit ? reportTypePageLimit : craft.lantra.setting('themeDefaultLimit', 10) %}

{% set criteria = craft.lantra.reportDataCriteria(reportEntry, pageLimit) %}
{% if criteria %}{% paginate criteria as pageInfo, elements %}{% endif %}

{% block content %}
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <div class="page-header secondary-bg">
        <h2>{{ reportEntry.title }}</h2>
        <div class="header-controls">
            <div class="container-btn primary-bg" style="margin-left:0;">
                <a class="btn-add-new" href="/reporting/edit/{{ reportEntry.id }}">Edit Report</a>
            </div>
        </div>
    </div>
    <section class="page">
        <div class="page-content">
        {% if elements is defined and elements|length %}
            <div id="downloadButtons" style="width:100%;text-align: right;margin-bottom:20px;">
                <p>
                    Download:
                    <a href="/sp/reports/download-report/csv/{{ reportEntry.id }}?{{ craft.app.request.getQueryStringWithoutPath }}">CSV</a> |
                    <a href="/sp/reports/download-report/xlsx/{{ reportEntry.id }}?{{ craft.app.request.getQueryStringWithoutPath }}">Excel</a> |
                    <a href="/sp/reports/download-report/pdf/{{ reportEntry.id }}?{{ craft.app.request.getQueryStringWithoutPath }}">PDF</a>

                </p>
            </div>
            <table width="100%" class="data">
                <thead>
                <tr>
                    {{ craft.lantra.reportHeader(reportEntry)|raw }}
                </tr>
                </thead>
                <tbody>
                {% for element in elements %}
                    <tr>
                        {{ craft.lantra.reportRow(reportEntry, element)|raw }}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
        {% else %}
                <h3>There are no results to display.</h3>
        {% endif %}
        </div>
    </section>
{% endblock %}
