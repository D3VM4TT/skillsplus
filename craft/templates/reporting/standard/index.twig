 {% if not craft.lantra.canManage() %}{% exit 404 %}{% endif %}

{% set reportType = craft.app.request.segment(3)|default('users') %}
{% set filterDays = craft.app.request.getParam('days')|default(28) %}
{% set filterSearch = craft.app.request.getParam('search')|default('') %}
{% if craft.app.request.segment(4) == 'csv' %}{% do craft.lantra.exportReport(reportType, filterDays, filterSearch) %}{% endif %}

{% extends "_layout" %}
{% import "_macros" as ui %}

{% set metaTitle = "Reporting > " ~ reportType|ucwords ~ " Report" %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}

{% set reportEntries = [] %}
{% set criteria = craft.lantra.managerReport(reportType, currentUser.id, filterDays, filterSearch, pageLimit) %}
{% if criteria %}
    {% paginate criteria as pageInfo, reportEntries %}
{% endif %}

{% block content %}
<div class="page-subHeader primary-bg">
{% include '_includes/topNavigation' %}
</div>
<section class="page">
    {% include 'reporting/standard/_tables/' ~ reportType with{reportType:reportType, reportEntries:reportEntries} %}
    {% if reportEntries|length %}
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}

            <div class="container-btn">
                <a class="button primary-bg" href="/reporting/standard/{{ reportType }}/csv?{{ craft.app.request.getQueryStringWithoutPath }}">Download as CSV</a>
            </div>

    {% else %}
        <div class="page-content">
            <h3>There are no results to display.</h3>
        </div>
    {% endif %}
</section>
{% endblock %}
