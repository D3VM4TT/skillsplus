<div class="page-header secondary-bg">
    <h2>Users Report</h2>
    <p>View User reports within your scheme.</p>
    {% include '_includes/filter' with{reportType:'users', filterDays:false} %}
</div>
{% if reportEntries|length %}
<div class="page-content">
    <table width="100%" class="data">
        <thead>
            <tr>
                <th>User</th>
                <th>Team</th>
                <th>Company</th>
                <th>Email</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for subordinate in reportEntries %}
        {% set userTeam = subordinate.userTeam.first() %}
        {% set userCompany = craft.lantra.userCompany(subordinate.id) %}
        <tr>
            <td>{{ subordinate.getFullName() }}</td>
            <td>{{ userTeam.title|default('~') }}</td>
            <td>{{ userCompany.title|default('~') }}</td>
            <td><a href="mailto:{{ subordinate.email }}">{{ subordinate.email }}</a></td>
            <td><a href="/reporting/user/{{ subordinate.id }}">view cpd</a></td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
