<div class="page-header">
    <h2>Reporting</h2>
    <p><strong>Users Report</strong></p>
    {% include '_includes/filter' with{reportType:'users', filterDays:false} %}
</div>
{% if reportEntries|length %}
    <table width="100%" class="data">
        <thead>
            <tr>
                <th>User</th>
                <th>Team</th>
                <th>Company</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
        {% for subordinate in reportEntries %}
        {% set userTeam = subordinate.userTeam.first() %}
        <tr>
            <td><a href="/reporting/user/{{ subordinate.id }}">{{ subordinate.getFullName() }}</a></td>
            <td>{{ userTeam.title }}</td>
            <td>{{ userTeam.teamCompany.first.title }}</td>
            <td><a href="mailto:{{ subordinate.email }}">{{ subordinate.email }}</a></td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
