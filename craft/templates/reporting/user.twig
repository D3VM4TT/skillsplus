{% set subordinate = craft.users.id(craft.app.request.segment(3)).one() %}
{% if not subordinate or not craft.lantra.isManager(subordinate.id) %}{% redirect 'reporting/users' %}{% endif %}

{% extends "_layout" %}
{% import "_macros" as ui %}

{% set metaTitle = "Reporting > CPD > " ~ subordinate.fullName %}
{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}

{% block content %}
<div class="page-subHeader primary-bg">
{% include '_includes/topNavigation' %}
</div>
<section class="page">
    <div class="page-header secondary-bg">
        <h2>CPD {{ subordinate.fullname }}</h2>
    </div>
    {% include 'record/_modules' with{cpdUser:subordinate} %}
</section>
{% endblock %}
