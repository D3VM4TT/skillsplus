{% if not craft.lantra.canManage() %}{% exit 404 %}{% endif %}

{% set reportType = craft.request.segment(2)|default('users') %}
{% set filterDays = craft.request.getParam('days')|default(28) %}
{% set filterSearch = craft.request.getParam('search')|default('') %}
{% if craft.request.segment(3) == 'csv' %}{% do craft.lantra.exportReport(reportType, filterDays, filterSearch) %}{% endif %}

{% extends "_layout" %}
{% import "_macros" as ui %}

{% set metaTitle = "Reporting > " ~ reportType|ucwords ~ " Report" %}
{% set dateFormat = globalsSystem.dateFormat|default('d/m/y') %}
{% set pageLimit = globalsSystem.defaultLimit|default(10) %}

{% set reportEntries = [] %}
{% set criteria = craft.lantra.managerReport(reportType, currentUser.id, filterDays, filterSearch, pageLimit) %}
{% if criteria %}
    {% paginate criteria as pageInfo, reportEntries %}
{% endif %}

{% block content %}
<section class="list">
    <div class="page-header">
        <h1>Reporting</h1>
    </div>
    {% include 'reporting/_tables/' ~ reportType with{reportType:reportType, reportEntries:reportEntries} %}
    {% if reportEntries|length %}
        {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
        <div class="table-actions freetext-procedure">
            <a href="/reporting/{{ reportType }}/csv?{{ craft.request.getQueryStringWithoutPath }}">Download as CSV</a></div>
    {% else %}
        <div class="table-actions">
            <p>There are no results to display.</p>
        </div>
    {% endif %}
</section>
{% endblock %}
