{% extends "_layout" %}
{% import "_macros" as ui %}
{% set metaTitle = "Management > Reports" %}

{% set entryId = craft.request.getSegment(4) %}
{% if entryId and entry is not defined %}
    {% set entry = craft.entries.id(entryId).first %}
{% endif %}

{% if currentUser.isInGroup('schemeManagers') or currentUser.admin %}
    {% set companyEntries = craft.entries.section('companies').id('not ' ~ craft.lantra.individualCompanyId()).limit(null).order('companyLabel') %}
{% else %}
    {% set companyEntries = craft.lantra.managerCompanies(currentUser.id, true) %}
{% endif %}
{% set unitEntries = craft.entries.section('units').limit(null).order('title') %}
{% set allManagers = craft.users.group('teamManagers', 'companyManagers', 'schemeManagers').order('firstName').limit(null) %}

{% set dateFormat = craft.lantra.setting('themeDateFormat', 'd-m-Y') %}

{% block content %}
<div class="page-subHeader primary-bg">
    {% include '_includes/topNavigation' %}
</div>
<div class="page-header secondary-bg">
    {% if entry is defined and entry.id %}
        <h2>Edit report</h2>
    {% else %}
        <h2>Create a New Report</h2>
    {% endif %}
</div>

{% if entry is defined %}
    {{ ui.errorList(entry.getAllErrors()) }}
{% endif %}

<form id="reports" class="page-form no-loading" method="post" role="form" accept-charset="UTF-8">
    {{ getCsrfInput() }}
    <input type="hidden" name="action" value="lantra/reports/save">
    <input type="hidden" name="entryId" value="{{ entry.id|default('') }}">
    <div class="field--wrapper">
        <label for="reportType">Report Type</label>
        <select id="reportType" name="fields[reportType]">
            <option value="users" {% if entry is defined and entry.reportType == 'user' %} selected="selected"{% endif %}>
                Users (Hierarchy Report)
            </option>
            <option value="results" {% if entry is defined and entry.reportType == 'results' %} selected="selected"{% endif %}>
                Results (Qual User)
            </option>
            <option value="expired" {% if entry is defined and entry.reportType == 'expired' %} selected="selected"{% endif %}>
                Expired (Expired Training)
            </option>
            <!--
            <option value="required" {% if entry is defined and entry.reportType == 'required' %} selected="selected"{% endif %}>
                Required (Required Training)
            </option>
            -->
        </select>
    </div>
    <div class="field--wrapper">
        <label for="reportCompanies" class="no-float">Filter Companies</label>
        <input type="hidden" name="fields[reportCompanies]" value="" />
        <select multiple class="js-select2" name="fields[reportCompanies][]" id="reportCompanies">
            {% for companyEntry in companyEntries %}
                <option {% if entry is defined and companyEntry.id in entry.reportCompanies.ids() %} selected="selected"{% endif %}
                    value="{{ companyEntry.id }}">{{ companyEntry.companyLabel }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="field--wrapper">
        <label for="reportAllCompanies" class="no-float">
            <input name="fields[reportAllCompanies]" id="reportAllCompanies" type="checkbox" value="1"
                {% if entry is defined and entry.reportAllCompanies %} checked{% endif %}>
            Include all companies
        </label>
        <label for="reportIncludeHierarchy" class="no-float">
            <input name="fields[reportIncludeHierarchy]" id="reportIncludeHierarchy" type="checkbox" value="1"
                    {% if entry is defined and entry.reportIncludeHierarchy %} checked{% endif %}>
            Include hierarchy
        </label>
    </div>
    <div class="field--wrapper fields fields-results fields-required fields-expired">
        <label for="reportResultType" class="no-float">Result Type</label>
        <select name="fields[reportResultType]" id="reportResultType">
            <option value="all" {% if entry is defined and entry.reportResultType == 'all' %} selected="selected"{% endif %}>
                Both Mandatory & Non Mandatory
            </option>
            <option value="unitResult" {% if entry is defined and entry.reportResultType == 'unitResult' %} selected="selected"{% endif %}>
                Mandatory
            </option>
            <option value="userResult" {% if entry is defined and entry.reportResultType == 'userResult' %} selected="selected"{% endif %}>
                Non Mandatory
            </option>
        </select>
        <div id="reportUnitsDropdown" style="margin-top:30px;">
            <label for="unitIds" class="no-float">Filter Mandatory Units</label>
            <input type="hidden" name="fields[reportUnits]" value="" />
            <select multiple class="js-select2" name="fields[reportUnits][]" id="reportUnits">
                {% for unitEntry in unitEntries %}
                    <option {% if entry is defined and unitEntry.id in entry.reportUnits.ids() %} selected="selected"{% endif %}
                            value="{{ unitEntry.id }}">{{ unitEntry.title }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
    <div class="field--wrapper fields fields-expired">
        <label for="reportResultExpiry" class="no-float">Result expiry:</label>
        <select name="fields[reportResultExpiry]" id="reportResultExpiry">
            <option value="0" {% if entry is defined and entry.reportResultExpiry == '0' %} selected="selected{% endif %}">All Expired</option>
            <option value="30" {% if entry is defined and entry.reportResultExpiry == '30' %} selected="selected{% endif %}">Expiring within 30 days</option>
            <option value="90" {% if entry is defined and entry.reportResultExpiry == '90' %} selected="selected{% endif %}">Expiring within 90 days</option>
            <option value="180" {% if entry is defined and entry.reportResultExpiry == '180' %} selected="selected{% endif %}">Expiring within 180 days</option>
            <option value="365" {% if entry is defined and entry.reportResultExpiry == '365' %} selected="selected{% endif %}">Expiring within 365 days</option>
            <option value="365+" {% if entry is defined and entry.reportResultExpiry == '365+' %} selected="selected{% endif %}">Expiring after 365 days</option>
        </select>
        <label for="reportIncludeExpired" class="no-float">
            <input name="fields[reportIncludeExpired]" id="reportIncludeExpired" type="checkbox" value="1"
                    {% if entry is defined and entry.reportIncludeExpired %} checked{% endif %}>
            Include expired results with expiring results
        </label>
        <label for="reportIncludeRequired" class="no-float">
            <input name="fields[reportIncludeRequired]" id="reportIncludeRequired" type="checkbox" value="1"
                    {% if entry is defined and entry.reportIncludeRequired %} checked{% endif %}>
            Include incomplete mandatory units
        </label>
    </div>
    <div class="field--wrapper fields fields-results">
        <label for="reportDisplayField" class="no-float">Display Field</label>
        <select name="fields[reportDisplayField]" id="reportDisplayField">
            <option value="expiryDate" {% if entry is defined and entry.reportDisplayField == 'expiryDate' %} selected="selected"{% endif %}>
                Expiry Date
            </option>
            <option value="resultStartDate" {% if entry is defined and entry.reportDisplayField == 'resultStartDate' %} selected="selected"{% endif %}>
                Start Date
            </option>
            <option value="resultFinishDate" {% if entry is defined and entry.reportDisplayField == 'resultFinishDate' %} selected="selected"{% endif %}>
                Finish Date
            </option>
        </select>
    </div>

    <div {% if entry is not defined %}id="reportAutomated"{% endif %}>
        <h2>Automated Report Settings</h2>
        <div class="field--wrapper">
            <label for="reportTitle" class="">Report title:</label>
            <input id="reportTitle" type="text" name="title" value="{{ entry is defined ? entry.title }}" />
        </div>
        <div class="field--wrapper">
            <label for="reportRecipients" class="">Report recipients (managers):</label>
            <input type="hidden" name="fields[reportRecipients]" value="" />
            <select multiple class="js-select2" name="fields[reportRecipients][]" id="reportRecipients">
                {% for manager in allManagers %}
                    {% set primaryCompany = craft.entries.section('companies').relatedTo(manager).first() %}
                    <option {% if entry is defined and manager.id in entry.reportRecipients.ids() %} selected="selected"{% endif %}
                        value="{{ manager.id }}">
                            {{ manager.fullName }}
                            {% if primaryCompany|length %}({{ primaryCompany.title }}){% endif %}
                    </option>
                {% endfor %}
            </select>
        </div>
        {% if currentUser.isInGroup('schemeManagers') or currentUser.admin %}
        <div class="field--wrapper">
            <label for="reportEmails" class="">Report recipients (emails):</label>
            <input id="reportEmails" type="text" name="fields[reportEmails]" value="{{ entry is defined ? entry.reportEmails }}" />
        </div>
        {% endif %}
        <div class="field--wrapper">
            <label for="reportSendFrequency">Report send frequency:</label>
            <select name="fields[reportSendFrequency]" id="reportSendFrequency">
                <option value="never" {% if entry is defined and entry.reportSendFrequency == 'never' %} selected="selected"{% endif %}">
                    Never
                </option>
                <option value="weekly" {% if entry is defined and entry.reportSendFrequency == 'weekly' %} selected="selected"{% endif %}">
                    Weekly
                </option>
                <option value="monthly" {% if entry is defined and entry.reportSendFrequency == 'monthly' %} selected="selected"{% endif %}">
                    Monthly
                </option>
            </select>
        </div>
        <div class="field--wrapper">
            <label for="reportSendValue">Report send day (1-7 for weekly):</label>
            <select name="fields[reportSendValue]" id="reportSendValue">
                {% for day in range(1, 31) %}
                    <option {% if entry is defined and entry.reportSendValue == day %} selected="selected"{% endif %}
                        value="{{ day }}">{{ day }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    {% if entry is defined %}
        <div class="container-btn">
            <button id="buttonSubmit" type="submit" class="button primary-bg">Save Report</button>
        </div>
    {% else %}
        <div class="container-btn">
            <button id="buttonSubmit" type="submit" class="button primary-bg">Download Data</button>
        </div>
        {% if currentUser.admin or currentUser.isInGroup('schemeManagers') %}
        <div class="container-btn">
            <button id="buttonAutomated" type="button" class="button primary-bg">Create Automated</button>
            <input type="hidden" name="automated" value="0">
        </div>
        {% endif %}
    {% endif %}

    {% if entry is defined and entry.reportData|length %}
        <h2>Report Archive</h2>
        <table class="data">
            <thead>
            <tr>
                <th>#</th>
                <th>Filename</th>
                <th>Date Created</th>
                <th>Size</th>
                <th>&nbsp;</th>
            </tr>
            </thead>
            <tbody>
            {% for report in entry.reportData %}
                <tr>
                    <td>{{ report.id }}</td>
                    <td>{{ report.filename }}</td>
                    <td>{{ report.dateCreated|format(dateFormat) }}</td>
                    <td>{{ report.size|filesize }}</td>
                    <td style="text-align: right;"><a href="/internal/{{ report.id }}" rel="external">download</a></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</form>
{% endblock %}