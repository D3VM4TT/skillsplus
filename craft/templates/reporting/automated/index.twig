{% requirePermission 'editEntries:1d590683-b16e-4955-be62-315accb3e628' %}

{% extends "_layout" %}

{% set metaTitle = "Reporting > Automated Reports" %}
{% set dateFormat = 'd-m-y H:i' %}
{% set pageLimit = craft.lantra.setting('themeDefaultLimit', 10) %}
{% set filterSearch = craft.app.request.getParam('search')|default('') %}

{% set criteria = craft.lantra.reportCriteria(filterSearch, pageLimit, 'id desc', true) %}
{% if criteria %}{% paginate criteria as pageInfo, reportEntries %}{% endif %}

{% block content %}
    <div class="page-subHeader primary-bg">
        {% include '_includes/topNavigation' %}
    </div>
    <section class="page">
        <div class="page-header secondary-bg">
            <h2>Automated Reports</h2>
            <div class="header-controls">
                <div class="header-search">
                    {% include '_includes/filter' with{filterDays:false} %}
                </div>
                <div class="container-btn primary-bg">
                    <a class="btn-add-new" href="/reporting/custom/new">Create New Report</a>
                </div>
            </div>
        </div>
        {% if reportEntries is defined and reportEntries|length %}
            <div class="page-content">
                <table class="data">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th class="title">Title</th>
                        <th>Author</th>
                        <th>Type</th>
                        <th>Frequency</th>
                        <th>Last Sent</th>
                        <th>Archive</th>
                        <th>&nbsp;</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for report in reportEntries %}
                        <tr>
                            <td>{{ report.id }}</td>
                            <td>{{ report.title }}</td>
                            <td>{{ report.author.fullName }}</td>
                            <td>{{ report.reportType|title }}</td>
                            <td>{{ report.reportSendFrequency|title }}</td>
                            <td>{{ report.reportLastSentDate ? report.reportLastSentDate|date(dateFormat) : 'Never' }}</td>
                            <td>
                                {{ report.reportData|length }}
                                {% if report.reportData|length %}
                                    {% set asset = report.reportData.orderBy('id desc').one() %}
                                    <a href="/internal/{{ asset.id }}" rel="external">download latest</a>
                                {% endif %}
                                </td>
                            <td style="text-align: right;">
                                <a class="action" href="#" data-action="reports/run-report" data-id="{{ report.id }}">run</a> |
                                <a href="/reporting/custom/edit/{{ report.id }}">edit</a> |
                                <a class="action" href="#" data-action="entries/delete-entry" data-id="{{ report.id }}">delete</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include '_includes/pagelinks' with {pageInfo:pageInfo} %}
        {% else %}
            <div class="page-content">
                <h3>There are no reports to display.</h3>
            </div>
        {% endif %}
    </section>
{% endblock %}
