{% extends "_layouts/cp" %}
{% set title = 'Lantra Tools' %}

{% block content %}

<div id="settings-cp">

    <p><a href="/admin/lantra/settings/tools?tool=saveCompanies" class="btn btn-small">Re-save all companies</a></p>

    <p><a href="/admin/lantra/settings/tools?tool=saveUsers" class="btn btn-small">Re-save all users</a></p>

    <p><a href="/admin/lantra/settings/tools?tool=setManagerReadOnly" class="btn btn-small">Set all managers to read only</a></p>

    <hr />

    {% set totalManagers = craft.users.status(null).group('companyManagers').total() %}

    <p><a href="/admin/lantra/settings/tools?tool=removeManagersChildren" class="btn btn-small">Remove company manager duplicates from hierarchy (100)</a></p>

    <p>
        {{ dataCleanManagersChildrenTotal }}/{{ totalManagers }} managers processed.</p>

    <p><a href="/admin/lantra/settings/tools?tool=dataResetManagersChildren" class="btn btn-small">Reset managers (data clean)</a></p>

    <hr />

    <p><a href="/admin/lantra/settings/tools?tool=setManagerUserCompany" class="btn btn-small">Add managers' company as user company (100)</a></p>

    <p>
        {{ dataCleanManagersUserCompanyTotal }}/{{ totalManagers }} managers processed.</p>

    <p><a href="/admin/lantra/settings/tools?tool=dataResetManagersUserCompany" class="btn btn-small">Reset managers (data clean)</a></p>

</div>

{% endblock %}