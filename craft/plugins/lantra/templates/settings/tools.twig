{% extends "_layouts/cp" %}
{% set title = 'Lantra Tools' %}

{% block content %}

<div id="settings-cp">

    <p><a href="/admin/lantra/settings/tools?tool=saveCompanies" class="btn btn-small">Re-save all companies</a></p>

    <p><a href="/admin/lantra/settings/tools?tool=saveUsers" class="btn btn-small">Re-save all users</a></p>

    <p><a href="/admin/lantra/settings/tools?tool=setUsernames" class="btn btn-small">Set usernames as firstname.lastname</a></p>

    <p><a href="/admin/lantra/settings/tools?tool=setPasswords" class="btn btn-small">Set passwords as DOB</a></p>

    <p><a href="/admin/lantra/settings/tools?tool=setManagerReadOnly" class="btn btn-small">Set all managers to read only</a></p>


    <hr />

    <p>{{ craft.users.status(null).group('users').search('dataClean:0').total() }} users remaining to process.</p>

    <p>{{ craft.users.status(null).group('companyManagers').search('dataClean:0').total() }} managers remaining to process.</p>

    <p><a href="/admin/lantra/settings/tools?tool=dataDirtyUsers" class="btn btn-small">Reset all users (data clean)</a></p>

    <p><a href="/admin/lantra/settings/tools?tool=removeManagersChildren" class="btn btn-small">Remove company manager duplicates from hierarchy (1000)</a></p>

    <p><a href="/admin/lantra/settings/tools?tool=setManagerUserCompany" class="btn btn-small">Add managers' company as user company (1000)</a></p>

</div>

{% endblock %}