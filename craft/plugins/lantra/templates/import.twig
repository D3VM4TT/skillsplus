<!DOCTYPE html>
<html>
<head>
    <title>Import Lantra Data</title>
</head>
<body>

<h1>Import Lantra Data</h1>
{% if complete %}
    <p>Import complete in {{ time }} seconds!</p>
    <p>{{ success }} elements imported, {{ failed }} failed.</p>

    <p>ERRORS:</p>
    {% for l in log %}
    <p>{{ l }}</p>
    {% endfor %}
{% else %}
    <p>Companies: {{ companies }}</p>
    <p>Job Roles: {{ jobRoles }}</p>
    <p>User Accounts: {{ users }}</p>
    <p>Company Managers: {{ companyManagers }}</p>
    <p>Company Users: {{ companyUsers }}</p>
    <p>Results : {{ results }}</p>
{% endif %}
<p>
    <a href="/actions/lantra/import/delete">Delete Existing Data</a>
    <a href="/actions/lantra/import/companies">Import Companies</a>
    <a href="/actions/lantra/import/roles">Import Roles</a>
    <a href="/actions/lantra/import/users">Import Users</a>
    <a href="/actions/lantra/import/managers">Assign Company Managers</a>
    <a href="/actions/lantra/import/companyUsers">Assign Company Users</a>
    <a href="/actions/lantra/import/assignJobRoles">Assign Job Roles</a>
    <a href="/actions/lantra/import/results">Import Results</a>
</p>

<form enctype="multipart/form-data" action="/actions/lantra/import/upload" method="post">
    <input type="file" name="import[]" />
    <input type="submit" />
</form>

</body>
</html>