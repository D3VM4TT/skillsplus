<!DOCTYPE html>
<html>
<head>
    <title>Import Lantra Data</title>
</head>
<body>

<h1>Import Lantra Data</h1>

<p>Companies: {{ companies }}</p>
<p>Job Roles: {{ jobRoles }}</p>
<p>Users: {{ users }}</p>

{% if complete %}
    <p>Import complete in {{ time }} seconds!</p>
    <p>{{ success }} elements imported, {{ failed }} failed.</p>

    <p>ERRORS:</p>
    {% for l in log %}
    <p>{{ l }}</p>
    {% endfor %}

{% endif %}
<p>
        <a href="/actions/lantra/import/companies">Import Companies</a>
        <a href="/actions/lantra/import/roles">Import Roles</a>
        <a href="/actions/lantra/import/users">Import Users</a>
</p>


</body>
</html>