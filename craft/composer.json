{
  "require": {
    "amici/craft-super-pdf": "5.0.1",
    "besteadfast/craft-preparse-field": "2.1.2",
    "craftcms/ckeditor": "3.13.0",
    "craftcms/cms": "4.15.3",
    "craftcms/redactor": "3.1.0",
    "dompdf/dompdf": "^2.0",
    "ether/logs": "4.0.1",
    "lantra/sp": "^2.0.0",
    "league/csv": "^9.4.1",
    "mmikkel/incognito-field": "1.3.0",
    "nthmedia/entry-gps-coordinates": "2.3.0",
    "nystudio107/craft-typogrify": "4.0.4",
    "phpoffice/phpspreadsheet": "^1.18",
    "putyourlightson/craft-dashboard-begone": "2.0.0",
    "robuust/craft-reverserelations": "2.0.0",
    "verbb/super-table": "3.0.15",
    "vlucas/phpdotenv": "5.6.1"
  },
  "autoload": {
    "psr-4": {
      "lantra\\spbase\\": "../src/repository/spbase/src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "../src/repository/sp"
    },
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ]
}