{
  "require": {
    "besteadfast/craft-preparse-field": "1.2.5",
    "craftcms/cms": "3.7.8",
    "craftcms/redactor": "2.8.8",
    "dompdf/dompdf": "^1.0",
    "ether/logs": "^3.0",
    "lantra/sp": "^2.0.0",
    "league/csv": "^9.4.1",
    "mmikkel/incognito-field": "1.2.0",
    "nthmedia/entry-gps-coordinates": "^1.3.0",
    "nystudio107/craft-typogrify": "^1.1",
    "phpoffice/phpspreadsheet": "^1.18",
    "putyourlightson/craft-dashboard-begone": "^1.0.1",
    "robuust/craft-reverserelations": "1.2.5",
    "verbb/super-table": "2.6.8",
    "vlucas/phpdotenv": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "lantra\\spbase\\": "../src/repository/spbase/src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "7.2.33"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "../src/repository/sp"
    }
  ]
}
