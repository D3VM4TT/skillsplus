{
  "require": {
    "aelvan/preparse-field": "v1.1.0",
    "craftcms/cms": "3.4.18",
    "craftcms/redactor": "2.6.1",
    "lantra/sp": "^2.0.0",
    "league/csv": "^9.4.1",
    "mmikkel/incognito-field": "1.1.1.1",
    "verbb/super-table": "2.4.9",
    "robuust/craft-reverserelations": "1.2.0",
    "vlucas/phpdotenv": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "7.0.32"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "../src/repository/sp"
    }
  ]
}
