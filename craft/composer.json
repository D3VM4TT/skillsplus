{
  "require": {
    "amici/craft-super-pdf": "1.1.1",
    "besteadfast/craft-preparse-field": "1.5.1",
    "craftcms/cms": "3.9.15",
    "craftcms/redactor": "2.10.12",
    "dompdf/dompdf": "^2.0",
    "ether/logs": "3.0.6",
    "lantra/sp": "^2.0.0",
    "league/csv": "^9.4.1",
    "mmikkel/incognito-field": "1.3.0",
    "nthmedia/entry-gps-coordinates": "^1.3.0",
    "nystudio107/craft-typogrify": "1.1.23",
    "phpoffice/phpspreadsheet": "^1.18",
    "putyourlightson/craft-dashboard-begone": "^1.0.1",
    "robuust/craft-reverserelations": "1.3.2",
    "verbb/super-table": "2.7.5.1",
    "vlucas/phpdotenv": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "lantra\\spbase\\": "../src/repository/spbase/src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "7.2.33"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "../src/repository/sp"
    }
  ]
}
